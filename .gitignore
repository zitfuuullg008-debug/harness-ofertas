node_modules/
.browser-data/
data/raw/
*.log
logs/
saidas/**/midia/*.mp4
.perf-*

# repositório público: fichas de produto ficam só na sua máquina
produtos/*
!produtos/_TEMPLATE.md
!produtos/README.md

# estado pessoal do painel (favoritos, anotacoes)
data/painel.json

# paginas validadas: ativo comercial, fica so na sua maquina
templates/*
!templates/README.md

# tudo da Utmify fica so na sua maquina: credencial, dado de venda e o
# codigo que fala com ela
.env.utmify
data/termometro/
app/utmify.mjs
app/publico/termometro.html
.claude/commands/termometro.md

# imagens das ofertas ficam no repo (viram URL publica pelo Pages)
!imagens/

# pasta de entrada: os PNG crus do ChatGPT. O que vai pro ar e a pasta imagens/
imagens-novas/

# o app e o produto que a pessoa paga pra receber. A pagina de vendas e publica
# por natureza; o app, nao — repo publico daria o produto de graca
saidas/modelagem/**/app-*.html
