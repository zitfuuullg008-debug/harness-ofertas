document.body.insertAdjacentHTML("afterbegin","\n<div class=\"progress-bar\" id=\"progressBar\"></div>\n<div class=\"urgencia-bar\">\n  <span class=\"urgencia-dot\"></span>\n  <span id=\"urgencia-txt\">🔥 Oferta especial solo hoy</span>\n  <span class=\"urgencia-dot\"></span>\n</div>\n\n\n<!-- ============ 1 · VENTA INMEDIATA ============ -->\n<section class=\"hero\">\n  <div class=\"chuva-pao\" aria-hidden=\"true\"><span style=\"--x:4%;--t:40px;--d:13s;--a:-2s;--v:30px;--r:200deg\">🍎</span><span style=\"--x:13%;--t:32px;--d:16s;--a:-9s;--v:-20px;--r:-160deg\">🥣</span><span style=\"--x:22%;--t:36px;--d:14s;--a:-5s;--v:25px;--r:240deg\">🥕</span><span style=\"--x:31%;--t:30px;--d:17s;--a:-12s;--v:-15px;--r:-200deg\">🍌</span><span style=\"--x:40%;--t:42px;--d:12s;--a:-7s;--v:20px;--r:180deg\">🥣</span><span style=\"--x:49%;--t:34px;--d:15s;--a:-1s;--v:-25px;--r:-220deg\">🍎</span><span style=\"--x:58%;--t:30px;--d:18s;--a:-14s;--v:15px;--r:160deg\">🥕</span><span style=\"--x:66%;--t:44px;--d:19s;--a:-4s;--v:-10px;--r:210deg\">🥣</span><span style=\"--x:74%;--t:34px;--d:13s;--a:-10s;--v:22px;--r:-170deg\">🍐</span><span style=\"--x:81%;--t:38px;--d:16s;--a:-6s;--v:-18px;--r:190deg\">🥕</span><span style=\"--x:86%;--t:30px;--d:14s;--a:-11s;--v:12px;--r:-210deg\">🥣</span><span style=\"--x:45%;--t:32px;--d:20s;--a:-3s;--v:-22px;--r:170deg\">🍎</span></div>\n  <h1>El único menú que vas a necesitar para la <em>alimentación complementaria</em> de tu bebé</h1>\n  <div class=\"hero-pills\">\n    <div class=\"hero-pill\"><i class=\"emo\">🥄</i><span>+160 recetas</span></div>\n    <div class=\"hero-pill\"><i class=\"emo\">👶</i><span>De los 6 meses a los 2 años</span></div>\n    <div class=\"hero-pill\"><i class=\"emo\">🛒</i><span>Lista de compras automática</span></div>\n    <div class=\"hero-pill\"><i class=\"emo\">⏰</i><span>Listas en 15 minutos o menos</span></div>\n  </div>\n  <img loading=\"eager\" fetchpriority=\"high\" class=\"hero-img\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/hero-1.webp?v=84c66964\" alt=\"Menú Pequeño Paladar\" decoding=\"async\" width=\"832\" height=\"670\">\n  <p class=\"hero-sub\"><strong>+160 recetas</strong> divididas en menús por edad, de los 6 meses a los 2 años, con lista de compras automática y <strong>listas en 15 minutos o menos</strong>.</p>\n</section>\n\n<!-- ============ 2 · DEMOSTRATIVO ============ -->\n<section class=\"demo\">\n  <div class=\"demo-inner\">\n    <h2>Todo está listo dentro del Menú Pequeño Paladar</h2>\n    <p class=\"demo-sub\">Mira un ejemplo real del menú por dentro:</p>\n  </div>\n  <div class=\"carousel-wrapper\">\n    <div class=\"carousel-track\" id=\"carouselTrack\">\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-1.webp?v=d0d77205\" alt=\"Receta 1: Papilla de Manzana con Ciruela\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-2.webp?v=10479f5f\" alt=\"Receta 2: Polenta con Pollo y Zanahoria\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-3.webp?v=f43ffe77\" alt=\"Receta 3: Puré de Papa con Carne\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-4.webp?v=7264f117\" alt=\"Receta 4: Papilla de Pera con Avena\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-5.webp?v=1e811f56\" alt=\"Receta 5: Omelet de Brócoli\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-6.webp?v=33227cd9\" alt=\"Receta 6: Muffin de Manzana y Canela\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-7.webp?v=40292f9b\" alt=\"Receta 7: Papilla de Mango con Banana\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-8.webp?v=00ccafc6\" alt=\"Receta 8: Ensaladita de Frutas con Yogur y Avena\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-9.webp?v=381b3b07\" alt=\"Receta 9: Croquetitas de Remolacha y Zanahoria\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-10.webp?v=6ca690df\" alt=\"Receta 10: Croquetitas de Arroz con Verduras\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-11.webp?v=f3cba4f3\" alt=\"Receta 11: Fideítos con Brócoli y Salsa de Zanahoria\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-12.webp?v=d4ced440\" alt=\"Receta 12: Panquequitas de Banana y Avena\" decoding=\"async\"></div>\n      <div class=\"carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/demo-13.webp?v=ea0ae16f\" alt=\"Receta 13: Papilla de Lentejas, Zanahoria y Calabaza\" decoding=\"async\"></div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 3 · DOR ============ -->\n<section class=\"dor\">\n  <h2>Desde los 6 meses hasta los 2 años, tu bebé va a tener de <em>1.000 a 1.500 comidas</em>.</h2>\n  <p>Y repetir siempre las mismas dos o tres papillas, con la textura equivocada para su etapa, puede hacer que le cueste más aceptar alimentos nuevos.</p>\n  <p>El <strong>Menú Pequeño Paladar</strong> fue creado justamente para esas mamás, que se preocupan, pero necesitan un plan listo para seguir.</p>\n  <ul class=\"checklist\"><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>+160 recetas listas en 15 minutos o menos</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Menús listos desde los 6 meses hasta los 2 años</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Lista de compras por etapa, solo la llevas al supermercado</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>La textura correcta para su edad, sin que tengas que decidir</li></ul>\n  <div style=\"margin-top:28px\"><a href=\"#plano-completo\" class=\"btn\">QUIERO MI MENÚ</a></div>\n</section>\n\n<!-- ============ 4 · IDEAL PARA TI ============ -->\n<section class=\"ideal\">\n  <h2 class=\"ideal-titulo\">El Menú Pequeño Paladar es ideal para ti, que:</h2>\n  <div class=\"ideal-card-wrap\"><div class=\"ideal-card\"><div class=\"card-icon-img\"><img loading=\"lazy\" decoding=\"async\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/ideal-1.webp?v=5c6f6286\" alt=\"Ícono: Mamá dando la primera papilla\" width=\"56\" height=\"56\"></div><div><h3>Quieres acertar con la primera papilla</h3><p>Tu bebé está empezando a comer ahora y no quieres probar a ciegas. Quieres seguir algo listo, hecho para esta etapa.</p></div></div></div>\n  <div class=\"ideal-card-wrap\"><div class=\"ideal-card\"><div class=\"card-icon-img\"><img loading=\"lazy\" decoding=\"async\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/ideal-2.webp?v=0db8838f\" alt=\"Ícono: Mamá con poco tiempo\" width=\"56\" height=\"56\"></div><div><h3>No tienes tiempo para pensar qué cocinar</h3><p>Entre la rutina y el cansancio, queda poco tiempo para buscar qué preparar. Aquí ya viene todo definido por edad.</p></div></div></div>\n  <div class=\"ideal-card-wrap\"><div class=\"ideal-card\"><div class=\"card-icon-img\"><img loading=\"lazy\" decoding=\"async\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/ideal-3.webp?v=55e6cf0a\" alt=\"Ícono: Plato con comida de bebé\" width=\"56\" height=\"56\"></div><div><h3>Quieres darle comida sólida con seguridad</h3><p>Quieres saber la textura correcta y el alimento correcto para cada etapa, con una respuesta clara en lugar de intentar adivinar.</p></div></div></div>\n  <div class=\"ideal-card-wrap\"><div class=\"ideal-card\"><div class=\"card-icon-img\"><img loading=\"lazy\" decoding=\"async\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/ideal-4.webp?v=191dfced\" alt=\"Ícono: Plato de papilla repetida\" width=\"56\" height=\"56\"></div><div><h3>Estás cansada de repetir siempre la misma papilla</h3><p>¿Cansada de cocinar siempre lo mismo? El menú cambia con la etapa de tu bebé, sin que tengas que pensar en nada.</p></div></div></div>\n  <div class=\"ideal-card-wrap\"><div class=\"ideal-card\"><div class=\"card-icon-img\"><img loading=\"lazy\" decoding=\"async\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/ideal-5.webp?v=56d8fcb3\" alt=\"Ícono: Bebé feliz comiendo\" width=\"56\" height=\"56\"></div><div><h3>Quieres ver a tu bebé crecer fuerte y seguro</h3><p>Del primer puré a los 2 años, sigues cada etapa sabiendo exactamente qué ofrecerle, sin perderte en el camino.</p></div></div></div>\n  <div class=\"ideal-cta\"><a href=\"#plano-completo\" class=\"btn\">QUIERO EMPEZAR HOY</a></div>\n</section>\n\n<!-- ============ 5 · TODO LO QUE VAS A RECIBIR ============ -->\n<section class=\"produto\">\n  <p class=\"produto-eyebrow\">VAS A RECIBIR ACCESO INMEDIATO A:</p>\n  <div class=\"produto-inner\">\n    <img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/planos-2.webp?v=e7560ea8\" alt=\"Menú Pequeño Paladar\" decoding=\"async\" class=\"produto-img\" >\n    <p class=\"produto-nome\">Menú Pequeño Paladar</p>\n    <div class=\"produto-divider\"></div>\n    <ul class=\"checklist\"><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>+160 recetas organizadas por edad</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Menús listos desde los 6 meses hasta los 2 años</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Desayuno, almuerzo, merienda y cena organizados</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Lista de compras y tabla de sustituciones</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Acceso inmediato y de por vida</li></ul>\n  </div>\n</section>\n\n<!-- ============ 6 · BONOS ============ -->\n<div class=\"bonus-bridge\">\n  <p class=\"bridge-eyebrow\">Y ESO NO ES TODO</p>\n  <p class=\"bridge-sub\">también vas a recibir…</p>\n  <h3 class=\"bridge-titulo\">7 BONOS<br>EXCLUSIVOS</h3>\n</div>\n<section class=\"bonuses\">\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-1.webp?v=76ccf3fd\" alt=\"Bono 1: +30 Postres Sin Azúcar para el Bebé\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #1 · ¡BONO DE HOY!</span><h3>+30 Postres Sin Azúcar para el Bebé</h3><div class=\"bonus-divider\"></div><p>Recetas de postres endulzados solo con fruta, seguros para la edad de tu bebé. Tu bebé también merece algo rico, sin que tengas que preocuparte.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-2.webp?v=199e7bd7\" alt=\"Bono 2: +40 Recetas de Frutas por Etapa\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #2 · ¡BONO DE HOY!</span><h3>+40 Recetas de Frutas por Etapa</h3><div class=\"bonus-divider\"></div><p>Recetas solo de frutas, organizadas por la textura segura de cada etapa, para variar sin miedo a equivocarte.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-3.webp?v=e25a4438\" alt=\"Bono 3: 20 Meriendas para Llevar\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #3 · ¡BONO DE HOY!</span><h3>20 Meriendas para Llevar</h3><div class=\"bonus-divider\"></div><p>Recetas prácticas y fáciles de transportar, para cuando sales con el bebé y necesitas llevar algo listo sin depender de comida procesada.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-4.webp?v=907855a8\" alt=\"Bono 4: Guía de Seguridad al Comer\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #4 · ¡BONO DE HOY!</span><h3>Guía de Seguridad al Comer</h3><div class=\"bonus-divider\"></div><p>Qué hacer en caso de atragantamiento o de reacción durante la alimentación complementaria, para que actúes con calma si lo necesitas.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-5.webp?v=5dc72788\" alt=\"Bono 5: Guía de Alimentos Nuevos y Reacciones\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #5 · ¡BONO DE HOY!</span><h3>Guía de Alimentos Nuevos y Reacciones</h3><div class=\"bonus-divider\"></div><p>Cómo introducir los alimentos que más causan reacción, sabiendo qué observar con cada alimento nuevo.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-6.webp?v=ad0699e6\" alt=\"Bono 6: Diario de Primeras Veces\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #6 · ¡BONO DE HOY!</span><h3>Diario de Primeras Veces</h3><div class=\"bonus-divider\"></div><p>Un espacio para registrar las primeras veces de tu bebé, como la primera fruta y la primera vez que come solito.</p></div></div>\n  <div class=\"bonus-card\"><div class=\"bonus-img-area\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/bonuses-7.webp?v=0f84a5fc\" alt=\"Bono 7: +50 Recetas para Después de los 2 Años\" decoding=\"async\"></div><div class=\"bonus-body\"><span class=\"bonus-num-tag\">🔥 #7 · ¡BONO DE HOY!</span><h3>+50 Recetas para Después de los 2 Años</h3><div class=\"bonus-divider\"></div><p>La extensión del menú para después de los 2 años, para que sigas sin necesidad de comprar otro producto.</p></div></div>\n</section>\n\n<!-- ============ 7 · PRUEBA SOCIAL ============ -->\n<section class=\"depoimentos\">\n  <div class=\"depo-topo\">\n    <h2>Mira lo que dicen las mamás que ya eligieron el Menú Pequeño Paladar</h2>\n  </div>\n  <style>.depo-carousel-item img.depo-vazio{display:block;width:100%;aspect-ratio:1/1;background:#FFFFFF;border:2px dashed var(--creme-line);border-radius:18px}.conv-moeda{margin-top:10px}.preco-num{letter-spacing:-.03em}</style>\n  <div class=\"depo-carousel-wrapper\">\n    <div class=\"depo-carousel-track\" id=\"depoCarouselTrack\">\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-1.webp?v=2bba9346\" alt=\"Testimonio de Valentina Rojas\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-2.webp?v=e8f2c760\" alt=\"Testimonio de Sofía Martínez\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-3.webp?v=817d1274\" alt=\"Testimonio de Mariana Torres\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-4.webp?v=11a6ce85\" alt=\"Testimonio de Paula García\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-5.webp?v=ea0ba26e\" alt=\"Testimonio de Beatriz Herrera\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-6.webp?v=d175945f\" alt=\"Testimonio de Camila Fernández\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-7.webp?v=c7be395e\" alt=\"Testimonio de Verónica Ramírez\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-8.webp?v=e9eda94e\" alt=\"Testimonio de Lucía Morales\" decoding=\"async\"></div>\n      <div class=\"depo-carousel-item\"><img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/depoimentos-9.webp?v=750be7ae\" alt=\"Testimonio de Diego Sánchez\" decoding=\"async\"></div>\n    </div>\n  </div>\n  <div class=\"depo-cta\"><a href=\"#plano-completo\" class=\"btn\">QUIERO EMPEZAR HOY</a></div>\n</section>\n\n<!-- ============ 8 · OFERTA ============ -->\n<div class=\"planos-bridge\">\n  <p><strong>APROVECHA HOY</strong> todo lo que necesitas para la alimentación complementaria de tu bebé:</p>\n  <span class=\"arrow-bounce\">↓</span>\n</div>\n<section class=\"planos\" id=\"oferta\">\n  <div class=\"plano-recomendado-wrap\" id=\"plano-completo\">\n    <span class=\"plano-rec-badge\">🔥 Oferta de hoy</span>\n    <div class=\"plano-rec-card\">\n      <div class=\"plano-rec-titulo\">PLAN<br>COMPLETO</div>\n      <div class=\"plano-body\">\n        <img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/planos-2.webp?v=e7560ea8\" alt=\"Plan Completo\" class=\"mockup-completo\" decoding=\"async\">\n        <p class=\"plano-sub\">Todo lo que recibes en el Plan Completo:</p>\n        <ul class=\"checklist\"><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Menú Pequeño Paladar completo, con las +160 recetas</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>+30 Postres Sin Azúcar para el Bebé</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>+40 Recetas de Frutas por Etapa</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>20 Meriendas para Llevar</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Guía de Seguridad al Comer</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Guía de Alimentos Nuevos y Reacciones</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Diario de Primeras Veces</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>+50 Recetas para Después de los 2 Años</li><li><span class=\"check-ico\"><svg viewBox=\"0 0 12 10\"><polyline points=\"1.5,5 4.5,8.5 10.5,1.5\"/></svg></span>Acceso de por vida</li></ul>\n        <div class=\"preco-stack\">\n          <div class=\"preco-de\">Antes $ 47.90 USD</div>\n          <div class=\"preco-hoje-label\">Tu acceso completo por</div>\n          <div class=\"preco-valor\"><span class=\"preco-moeda\">$</span><span class=\"preco-num\">8.70</span><span class=\"preco-cent\"> USD</span></div>\n          <p class=\"preco-ancora\">OFERTA POR TIEMPO LIMITADO: mientras esta página esté en línea, ahorras $ 39.20 USD y además llevas 7 bonos de regalo.</p>\n        </div>\n        <a href=\"{{CHECKOUT}}\" class=\"btn btn-laranja btn-shimmer btn-pulse\" target=\"_blank\" rel=\"noopener\">QUIERO EL PLAN COMPLETO</a>\n        <p class=\"btn-micro conv-moeda\">El precio se convierte automáticamente a tu moneda local. Pago único, sin mensualidades ni cargos ocultos.</p>\n        <div class=\"selos\">\n          <div class=\"selo-item\"><svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg>Compra segura</div>\n          <div class=\"selo-item\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg>Acceso inmediato tras la confirmación</div>\n          <div class=\"selo-item\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 21s7-3.5 7-9V5l-7-2.5L5 5v7c0 5.5 7 9 7 9z\"/></svg>Garantía incondicional de 30 días</div>\n        </div>\n        <p class=\"btn-micro\"><b>APROVECHA AHORA:</b> ¡No vas a volver a ver este precio especial!</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 9 · GARANTÍA ============ -->\n<section class=\"garantia\">\n  <div class=\"garantia-selo\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M12 21s7-3.5 7-9V5l-7-2.5L5 5v7c0 5.5 7 9 7 9z\"/></svg>\n    <span>Garantía incondicional de 30 días</span>\n  </div>\n  <h2>Tienes 30 días para probarlo con tu bebé</h2>\n  <p>Entra, haz dos o tres recetas y mira si las acepta. Después decides. Si no te convence, solo pides el reembolso dentro de los 30 días.</p>\n  <div class=\"gar-lista\">\n    <div class=\"gar-item\"><div class=\"gar-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M20 6L9 17l-5-5\"/></svg></div><div><strong>Así de simple</strong><span>Pides el reembolso dentro del plazo</span></div></div>\n    <div class=\"gar-item\"><div class=\"gar-ico\"><svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg></div><div><strong>Sin trámites</strong><span>Un mensaje y listo</span></div></div>\n    <div class=\"gar-item\"><div class=\"gar-ico\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v5M12 16h.01\"/></svg></div><div><strong>Sin preguntas difíciles</strong><span>No tienes que explicar por qué</span></div></div>\n  </div>\n</section>\n\n<!-- ============ 10 · AUTORIDAD ============ -->\n<section class=\"autoridade\">\n  <div class=\"autoridade-inner\">\n    <img loading=\"lazy\" src=\"https://zitfuuullg008-debug.github.io/harness-ofertas/imagens/menu-pequeno-paladar/autoridade-1.webp?v=3ba13685\" alt=\"Chef Mari Dias\" decoding=\"async\">\n    <div class=\"autoridade-text\">\n      <p class=\"autoridade-eyebrow\">Quién creó el Menú Pequeño Paladar:</p>\n      <p class=\"autoridade-nome\">Chef Mari Dias</p>\n      <p class=\"autoridade-bio\">La Chef Mari Dias creó el Menú Pequeño Paladar después de darse cuenta de que muchas mamás querían acertar con la comida del bebé, pero tropezaban siempre con las mismas dificultades: la falta de tiempo, el miedo a equivocarse con la textura y el miedo a que el bebé no lo aceptara.</p>\n      <p class=\"autoridade-bio\">Por eso, organizó el menú mes a mes, desde los 6 meses hasta los 2 años, con ingredientes simples, preparación rápida y la textura correcta para cada etapa.</p>\n      <p class=\"autoridade-bio\">La idea no es convertirte en chef. Es ayudarte a saber siempre qué ofrecer, en cada etapa de tu bebé.</p>\n    </div>\n  </div>\n</section>\n\n<!-- ============ CÓMO FUNCIONA EL ACCESO ============ -->\n<section class=\"acesso\">\n  <h2>Cómo funciona el acceso</h2>\n  <p class=\"acesso-sub\">Desde que pagas hasta la primera papilla.</p>\n\n  <div class=\"passos\">\n    <div class=\"passo\">\n      <span class=\"passo-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 4h2l2.4 10.5a2 2 0 0 0 2 1.5h7.2a2 2 0 0 0 2-1.5L21 7H6\"/><circle cx=\"10\" cy=\"20\" r=\"1.2\"/><circle cx=\"17\" cy=\"20\" r=\"1.2\"/></svg></span>\n      <div class=\"passo-txt\"><span class=\"passo-num\">Paso 1</span><h3>Pagas</h3><p>Con <b>tarjeta o con el método de pago de tu país</b>, por Hotmart.</p></div>\n    </div>\n\n    <div class=\"passo\">\n      <span class=\"passo-ico\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg></span>\n      <div class=\"passo-txt\"><span class=\"passo-num\">Paso 2</span><h3>Llega a tu correo</h3><p>En cuanto se confirma el pago. <b>Sin esperas.</b></p></div>\n    </div>\n\n    <div class=\"passo\">\n      <span class=\"passo-ico\"><svg viewBox=\"0 0 24 24\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"2.5\"/><path d=\"M10.5 18.2h3\"/></svg></span>\n      <div class=\"passo-txt\"><span class=\"passo-num\">Paso 3</span><h3>Eliges cómo usarlo</h3><p>En la app desde el celular o impreso en la cocina. <b>Es tuyo para siempre.</b></p></div>\n    </div>\n\n    <div class=\"passo\">\n      <span class=\"passo-ico\"><svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 12l2 2 4-4\"/></svg></span>\n      <div class=\"passo-txt\"><span class=\"passo-num\">Paso 4</span><h3>Abres el mes de tu bebé</h3><p>La <b>lista de compras ya viene lista</b>. Mañana mismo ya puede comer del menú.</p></div>\n    </div>\n  </div>\n</section>\n\n<!-- ============ 11 · FAQ ============ -->\n<section class=\"faq\">\n  <h2>Preguntas frecuentes</h2>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Y si mi bebé no acepta las recetas?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">Que un bebé rechace comida nueva es normal, y la mayoría de las veces no es falta de hambre, es cansancio de comer siempre lo mismo. Justamente por eso el menú trae más de 160 recetas separadas por etapa: cuando una no funciona, tienes otra ya preparada para el mismo día, sin tener que pensar. Y si aun así no funciona para ustedes, tienes 30 días para pedir el reembolso.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Desde qué edad puedo usar el menú?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">Desde los 6 meses, cuando empieza la alimentación complementaria. El menú acompaña mes a mes hasta los 2 años, y el bono de recetas para después de los 2 años sigue a partir de ahí.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Cómo sé que la textura es la correcta para su etapa?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">No tienes que decidirlo tú. El menú ya viene separado por edad, y cada receta está en la etapa que le corresponde. Abres el mes en que está tu bebé y haces lo que está ahí.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Necesito saber cocinar o comprar ingredientes difíciles?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">No. Las recetas usan ingredientes de cualquier supermercado y el paso a paso está escrito para quien cocina con poco tiempo. Además, tienes la tabla de sustituciones, para cuando te falte algo en casa.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Cuánto tiempo toma preparar una receta?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">Las recetas fueron hechas para estar listas en 15 minutos o menos.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">Ya empecé con la alimentación complementaria. ¿Todavía vale la pena?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">Sí. El menú está organizado por etapa, no desde cero. Entras en el mes en que está tu bebé ahora y sigues desde ahí, hasta los 2 años. No pierdes nada de lo que ya pasó.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Necesito licuadora o procesador?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">No. Las recetas fueron hechas con lo que ya hay en la cocina: olla, tenedor y horno. Ninguna depende de un aparato que tengas que comprar.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿La compra es segura? ¿Cómo puedo pagar?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">El pago se procesa por Hotmart, una de las plataformas de productos digitales más grandes del mundo. Puedes pagar con tarjeta o con el método de pago de tu país, y el precio se convierte automáticamente a tu moneda local.</div></div>\n  <div class=\"faq-item\"><button class=\"faq-question\">¿Y si no me gusta?<span class=\"faq-arrow\">▼</span></button><div class=\"faq-answer\">Tienes 30 días de garantía incondicional. Entras, lo pruebas con tu bebé y, si no te convence, solo pides el reembolso. Sin trámites y sin preguntas difíciles.</div></div>\n  <div class=\"demo-cta\">\n    <a href=\"#plano-completo\" class=\"btn btn-laranja btn-shimmer btn-pulse\">QUIERO MI MENÚ</a>\n  </div>\n</section>\n\n<footer>\n  <strong>Copyright 2026 | Menú Pequeño Paladar</strong><br><br>\n  Todos los derechos sobre la obra «Menú Pequeño Paladar» están reservados. La reproducción no autorizada de esta publicación, total o parcial, por cualquier medio, constituye una violación de los derechos de autor, sujeta a las sanciones civiles y penales previstas en la legislación aplicable.<br><br>\n  Este contenido es informativo y no sustituye la consulta con tu pediatra.\n</footer>\n\n\n\n\n\n");
})();

(function(){const t=new Date(),d=String(t.getDate()).padStart(2,'0'),m=String(t.getMonth()+1).padStart(2,'0');document.getElementById('urgencia-txt').textContent='🔥 Oferta especial solo hoy '+d+'/'+m+'/'+t.getFullYear();})();


window.addEventListener('scroll',()=>{const el=document.getElementById('progressBar');if(!el)return;const t=document.body.scrollHeight-window.innerHeight;el.style.width=Math.min((window.scrollY/t)*100,100)+'%';},{passive:true});
(function(){const track=document.getElementById('carouselTrack');if(!track||track.dataset.cloned)return;const items=Array.from(track.children);items.forEach(i=>track.appendChild(i.cloneNode(true)));track.dataset.cloned='true';function upd(){const f=track.children[items.length];if(f)track.style.setProperty('--scroll-distance',f.offsetLeft+'px');}upd();track.style.animationPlayState='running';setTimeout(upd,300);setTimeout(upd,1000);window.addEventListener('resize',upd,{passive:true});})();
(function(){const track=document.getElementById('depoCarouselTrack');if(!track||track.dataset.cloned)return;const items=Array.from(track.children);items.forEach(i=>track.appendChild(i.cloneNode(true)));track.dataset.cloned='true';function upd(){const f=track.children[items.length];if(f)track.style.setProperty('--depo-scroll-distance',f.offsetLeft+'px');}upd();track.style.animationPlayState='running';setTimeout(upd,300);setTimeout(upd,1000);window.addEventListener('resize',upd,{passive:true});})();
document.querySelectorAll('.faq-question').forEach(btn=>{btn.addEventListener('click',function(){const item=this.closest('.faq-item');const open=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));if(!open)item.classList.add('open');});});
document.querySelectorAll('a[href^="#"]').forEach(a=>{a.addEventListener('click',e=>{e.preventDefault();const id=a.getAttribute('href').slice(1);const t=document.getElementById(id);if(t)t.scrollIntoView({behavior:'smooth',block:'start'});});});
(function(){
  const lists=document.querySelectorAll('.checklist, .demo-check');
  if(!('IntersectionObserver' in window)){lists.forEach(l=>l.classList.add('animated'));return;}
  const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('animated');io.unobserve(e.target);}});},{threshold:.25});
  lists.forEach(l=>io.observe(l));
})();


(function(){
  var s=document.getElementById('stick'),o=document.getElementById('plano-completo'),seen=false;
  /* Barra so aparece depois que a pessoa ROLOU ate o plano completo (fotos lazy sem altura no
     carregamento faziam o plano "aparecer" na tela e a barra subir cedo demais). */
  function u(){
    if(!seen && window.scrollY>400 && o.getBoundingClientRect().top < window.innerHeight*0.75) seen=true;
    if(s)s.classList.toggle('show',seen);
  }
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
    var sel='.rz-card,.ideal-card-wrap,.bonus-card,.calc-box,.gar-item,.passo,.autoridade-inner,.produto-inner,.plano-rec-card,.prat-img,.demo-check li';
    document.querySelectorAll(sel).forEach(function(el,i){el.classList.add('rv');el.style.setProperty('--d',((i%3)*.07)+'s');io.observe(el)});
  }
  window.addEventListener('scroll',u,{passive:true});u();
  var big=document.getElementById('calcLucro');
  if(big){new MutationObserver(function(){big.classList.remove('bump');void big.offsetWidth;big.classList.add('bump')}).observe(big,{childList:true,characterData:true,subtree:true})}
})();


(function(){
  var reduz=window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(!('IntersectionObserver' in window)||reduz)return;
  // títulos e etiquetas entram subindo
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.2});
  document.querySelectorAll('section:not(.hero) h2,.bridge-titulo,section:not(.hero) .eyebrow').forEach(function(el){el.classList.add('rv');io.observe(el)});
  // números que contam até o valor quando aparecem
  var cont=new IntersectionObserver(function(es){es.forEach(function(e){
    if(!e.isIntersecting)return;cont.unobserve(e.target);
    var el=e.target,alvo=+el.dataset.count,t0=null;
    function passo(t){t0=t0||t;var p=Math.min((t-t0)/1100,1),v=Math.round(alvo*(1-Math.pow(1-p,3)));
      el.textContent=v.toLocaleString('pt-BR');if(p<1)requestAnimationFrame(passo)}
    requestAnimationFrame(passo)})},{threshold:.6});
  document.querySelectorAll('[data-count]').forEach(function(el){cont.observe(el)});
  // carrosséis e botões pulsando só enquanto estão na tela (economiza bateria)
  var pausa=new IntersectionObserver(function(es){es.forEach(function(e){
    e.target.style.animationPlayState=e.isIntersecting?'running':'paused'})},{rootMargin:'120px'});
  document.querySelectorAll('.carousel-track,.depo-carousel-track,.btn-pulse').forEach(function(el){pausa.observe(el)});
})();

