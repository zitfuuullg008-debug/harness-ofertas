document.body.insertAdjacentHTML("afterbegin","<nav class=\"nav\"><div class=\"logo\">Menú <span>Pequeño Paladar</span></div><div class=\"nav-links\" id=\"navLinks\"><button data-route=\"home\">Inicio</button> <button data-route=\"recipes\">Recetas</button> <button data-route=\"cardapios\">Menús</button> <button data-route=\"lista\">Lista de compras</button></div></nav><main class=\"page\" id=\"app\"></main><nav class=\"bottom-nav\"><button data-route=\"home\"><span class=\"bn-icon\">🏠</span><span class=\"bn-label\">Inicio</span></button> <button data-route=\"recipes\"><span class=\"bn-icon\">🍽️</span><span class=\"bn-label\">Recetas</span></button> <button data-route=\"cardapios\"><span class=\"bn-icon\">📋</span><span class=\"bn-label\">Menús</span></button> <button data-route=\"lista\"><span class=\"bn-icon\">🛒</span><span class=\"bn-label\">Lista</span></button></nav><div class=\"modal-overlay\" id=\"listModal\" onclick=\"if(event.target===this) closeListModal()\"><div class=\"modal-box\" onclick=\"event.stopPropagation()\"><div class=\"modal-head\"><div><div class=\"eyebrow\">LISTA INTELIGENTE</div><h2 style=\"font-family:Fraunces,serif;font-size:24px;color:var(--forest);margin-top:4px\">Elige las recetas</h2></div><button class=\"modal-close\" onclick=\"closeListModal()\">✕</button></div><div class=\"modal-search-wrap\"><div class=\"search-box\" style=\"margin:14px 0 12px\"><span>🔍</span> <input placeholder=\"Buscar por nombre o ingrediente...\" oninput=\"setModalSearch(this.value)\"></div><div class=\"filter-row\" id=\"modalFilters\"></div></div><div class=\"modal-body\" id=\"modalGrid\"></div><div class=\"modal-foot\"><div><div style=\"font-weight:800;font-size:14px\" id=\"modalCount\">0 recetas seleccionadas</div><a class=\"back-link\" style=\"margin:0\" onclick=\"clearListSelection()\">Borrar selección</a></div><button class=\"btn-terracotta\" onclick=\"closeListModal()\">Listo</button></div></div></div><div class=\"modal-overlay\" id=\"ratingModal\" onclick=\"if(event.target===this) closeRatingModal(true)\"><div class=\"rating-modal-box\" onclick=\"event.stopPropagation()\" id=\"ratingModalContent\"></div></div><button class=\"to-top\" id=\"toTop\" onclick=\"window.scrollTo({top:0,behavior:'smooth'})\" aria-label=\"Volver arriba\">↑</button><div class=\"footer\">MENÚ PEQUEÑO PALADAR · HECHO CON ♥ POR LA CHEF MARI DIAS · PARA CADA ETAPA DE TU BEBÉ</div>");
