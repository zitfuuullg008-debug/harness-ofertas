/* ==================== BÔNUS ==================== */
/* hasRecipes:true → tem seu próprio pool em BONUS_RECIPES (mini-catálogo igual ao produto
   principal). hasRecipes:false → é um bônus de conteúdo em texto, renderizado via GUIDES.
   As capas (cover) são as ARTES OFICIAIS da oferta, hospedadas no banco de imagens da
   Atomicat — as mesmas que a mãe viu na página de vendas. Isso mantém o app coerente com
   a compra: ela reconhece cada bônus pela mesma imagem que a convenceu a comprar. */
const BONUSES = [{"n":1,"icon":"🍮","title":"+30 Postres Sin Azúcar para el Bebé","text":"Postrecitos ricos endulzados solo con fruta, pensados para la edad de tu bebé, sin azúcar refinada.","color":"var(--b1)","bg":"var(--b1-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-1-1.webp"},{"n":2,"icon":"🍓","title":"+40 Recetas de Frutas por Etapa","text":"Frutas en distintas texturas y etapas, para ampliar el paladar del bebé de forma segura.","color":"var(--b2)","bg":"var(--b2-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-2-2.webp"},{"n":3,"icon":"🎒","title":"20 Meriendas para Llevar","text":"Opciones prácticas para llevar en la pañalera, en los paseos y en las consultas, sin perder lo nutritivo.","color":"var(--b3)","bg":"var(--b3-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-3-3.webp"},{"n":4,"icon":"🚑","title":"Guía de Seguridad al Comer","text":"Consejos prácticos para prevenir y saber qué hacer ante un atragantamiento durante la alimentación complementaria. Consulta con tu pediatra.","color":"var(--bg-guide1)","bg":"var(--bg-guide1-bg)","hasRecipes":false,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-4-4.webp"},{"n":5,"icon":"🩺","title":"Guía de Alimentos Nuevos y Reacciones","text":"Cómo darle de forma segura los alimentos que más causan alergia y reconocer las señales que merecen atención. Consulta con tu pediatra.","color":"var(--bg-guide2)","bg":"var(--bg-guide2-bg)","hasRecipes":false,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-5-5.webp"},{"n":6,"icon":"📔","title":"Diario de Primeras Veces","text":"Una forma sencilla de anotar las primeras experiencias con la comida y los logros de tu bebé.","color":"var(--bg-guide3)","bg":"var(--bg-guide3-bg)","hasRecipes":false,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-6-1.webp"},{"n":7,"icon":"🍽️","title":"+50 Recetas para Después de los 2 Años","text":"Recetas de familia para seguir después de los 2 años, sin dejar de variar el menú.","color":"var(--b7)","bg":"var(--b7-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/bonuses-7-2.webp"},{"n":8,"extra":true,"badge":"EXTRA 1","icon":"❄️","title":"+30 Recetitas para Congelar","text":"Cocina el domingo y ten la semana entera lista en frasquitos, cada receta con el tiempo que dura en el congelador.","color":"var(--b8)","bg":"var(--b8-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-8-3.webp"},{"n":9,"extra":true,"badge":"EXTRA 2","icon":"🥤","title":"+30 Licuados de Frutas para el Bebé","text":"Licuados de fruta cremosos y ricos para variar la alimentación del bebé, cada uno con la edad correcta para darlo.","color":"var(--b9)","bg":"var(--b9-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-9-4.webp"},{"n":10,"extra":true,"badge":"EXTRA 3","icon":"✋","title":"+40 Recetas BLW: Comer con las Manos","text":"Comiditas en forma de palito que agarra con la manita, con el corte correcto para cada edad.","color":"var(--b10)","bg":"var(--b10-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-10-5.webp"},{"n":11,"extra":true,"badge":"EXTRA 4","icon":"⏱️","title":"+30 Recetas SOS en 5 Minutos","text":"Para los días apurados: platitos que salen en cinco minutos con lo que ya tienes en el refrigerador, sin tener que descongelar nada.","color":"var(--b11)","bg":"var(--b11-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-11-1.webp"},{"n":12,"extra":true,"badge":"EXTRA 5","icon":"🙅","title":"40 Recetas para Cuando Tu Bebé Dice «No» a Todo","text":"Para el bebé que rechaza todo. En vez de esconder la verdura, cada receta cambia la textura, el color y la forma del mismo alimento hasta que acepte probarlo de nuevo.","color":"var(--b12)","bg":"var(--b12-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-12-2.webp"},{"n":13,"extra":true,"badge":"EXTRA 6","icon":"🍟","title":"+50 Recetas en Freidora de Aire para el Bebé","text":"Cincuenta recetas en freidora de aire con el tiempo y la temperatura ya definidos por edad: sin aceite caliente, sin ensuciar y sin estar pendiente de la olla.","color":"var(--b13)","bg":"var(--b13-bg)","hasRecipes":true,"cover":"https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/extra-13-3.webp"}];
/* Capa oficial do produto principal (mesma arte do "Plano Completo" na página de vendas). */
const MAIN_COVER_IMG = "https://media.atomicatmedia.net/u/R0WcDrorg9R9KKEPi5I7WCKJiu93/Pictures/mcp/B8az/planos-2-1.webp";
const BONUS_RECIPES = {"1":[{"id":1000,"name":"Muffin de Banana sin Azúcar","icon":"🧁","time":"~35 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/16248206/pexels-photo-16248206.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 unidades","ageRec":"A partir de los 10 meses","ingredients":["2 bananas (plátanos) maduras machacadas con tenedor","2 huevos","1 taza de harina de avena","1 cucharadita de canela"],"tip":"Harina de avena → harina de arroz, en la misma cantidad, para una versión sin gluten.","steps":["Machaca las 2 bananas maduras con un tenedor hasta formar un puré.","Mezcla los 2 huevos con el puré de banana hasta que se integren bien.","Agrega la harina de avena y la canela, y revuelve hasta formar una masa uniforme.","Reparte la masa en moldecitos pequeños engrasados, llenándolos hasta la mitad.","Hornea en el horno precalentado a 180 °C por unos 20 minutos, hasta que se doren y un palillo salga limpio del centro.","Deja enfriar hasta que estén tibios y córtalos en trozos pequeños antes de servir."],"alerta":"Espera a que se enfríen bien antes de servir, porque el centro del muffin guarda el calor por más tiempo que la superficie."},{"id":1001,"name":"Paletita de Mango y Yogur Natural","icon":"🥭","time":"~10 min + congelación","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4663464/pexels-photo-4663464.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 unidades","ageRec":"A partir de los 10 meses","ingredients":["1/2 mango maduro sin cáscara y sin hueso","3 cucharadas de yogur natural entero"],"tip":"Mango → fresa (frutilla) bien madura licuada, en la misma cantidad.","steps":["Corta el mango en trozos y lícualo con las 3 cucharadas de yogur natural hasta formar una crema lisa, sin grumos.","Vierte la crema en moldes para paletas especiales para bebés, sin palito rígido.","Lleva al congelador por lo menos 4 horas, hasta que se congele por completo.","Desmolda pasando el molde rápidamente por agua tibia, si hace falta.","Ofrécela por ratos cortos, siempre con el bebé sentado y con supervisión, cuidando que no se derrita y escurra demasiado."],"alerta":"Usa solo moldes especiales para bebé, sin palito rígido, y nunca dejes que el niño camine con la paletita en la mano."},{"id":1002,"name":"Bolitas de Camote con Cacao","icon":"🍫","time":"~25 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/27850066/pexels-photo-27850066.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 unidades","ageRec":"A partir de los 2 años","ingredients":["1 camote (batata) mediano cocido y machacado (alrededor de 1 taza)","1 cucharada de cacao 100 % sin azúcar","1 cucharadita de mantequilla"],"tip":"Cacao 100 % → cacao en polvo sin azúcar, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese fácilmente y machácalo bien hasta que quede liso.","Llévalo a fuego bajo con el cacao 100 % sin azúcar y la mantequilla, revolviendo siempre por 3 a 4 minutos, hasta que tome consistencia y se despegue de la olla.","Apaga el fuego y deja enfriar por completo antes de manipular.","Con las manos engrasadas, forma bolitas pequeñas, del tamaño de una aceituna.","Sirve a temperatura ambiente o un poco frías."],"alerta":"El cacao solo entra después de los 2 años: hasta entonces, haz la versión sin cacao, solo con el camote machacado. Forma bolitas pequeñas y aplasta cada una antes de servir."},{"id":1003,"name":"Galletita de Avena y Banana","icon":"🍪","time":"~30 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/35578518/pexels-photo-35578518.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"10 unidades","ageRec":"A partir de los 10 meses","ingredients":["1 banana (plátano) madura machacada con tenedor","1 taza de avena en hojuelas","1 cucharadita de canela"],"tip":"Avena en hojuelas → avena en hojuelas finas, en la misma cantidad, para una textura más suave.","steps":["Machaca la banana con un tenedor hasta formar un puré.","Mezcla la avena en hojuelas y la canela hasta formar una masa que no se pegue a las manos.","Forma galletitas aplanadas, del tamaño de la palma de la mano del bebé, de alrededor de 1 cm de grosor.","Hornea en el horno precalentado a 180 °C por unos 15 minutos, hasta que se doren un poco en los bordes.","Deja enfriar por completo sobre una rejilla, para que queden más firmes y fáciles de agarrar.","Sirve a temperatura ambiente, partiéndolas en trozos más pequeños si hace falta."],"alerta":"Deja enfriar por completo antes de servir; si están muy tibias, la galleta queda blanda y puede deshacerse en trozos grandes en la boca."},{"id":1004,"name":"Mousse de Manzana con Canela","icon":"🍏","time":"~15 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/32255837/pexels-photo-32255837.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 manzanas cocidas hasta quedar bien suaves y machacadas","2 cucharadas de yogur natural entero","1 pizca de canela"],"tip":"Yogur natural entero → yogur natural sin lactosa, en la misma cantidad, si hay intolerancia.","steps":["Cocina las manzanas peladas y sin semillas hasta que un tenedor las atraviese sin resistencia, unos 10 minutos.","Machaca bien las manzanas cocidas con un tenedor hasta formar un puré.","Mezcla el puré todavía tibio con las 2 cucharadas de yogur natural entero.","Agrega la pizca de canela y revuelve bien, hasta que quede repartida en todo el mousse.","Lleva al refrigerador por 20 minutos antes de servir, para que el mousse quede más firme y frío.","Sirve fresco, en un recipiente pequeño, con una cucharita suave, en porciones pequeñas que el bebé pueda tomar solo."],"alerta":"Receta ajustada a partir de los 10 meses porque lleva yogur, que necesita la aprobación de tu pediatra a partir de esta etapa."},{"id":1005,"name":"Chips Suaves de Pera Deshidratada","icon":"🍐","time":"~2 h (horno bajo)","kcal":"40 kcal (estimado)","img":"https://images.pexels.com/photos/10245189/pexels-photo-10245189.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["2 peras bien maduras, sin semillas","1 pizca de canela"],"tip":"Pera → manzana bien madura, con la misma preparación.","steps":["Lava las peras y córtalas en rodajas muy finas, de unos 2 mm, quitando todas las semillas.","Acomoda las rodajas en una bandeja para horno cubierta con papel para hornear, sin encimarlas.","Espolvorea la pizca de canela sobre las rodajas, repartiéndola bien antes de llevar al horno.","Hornea a temperatura muy baja, a 100 °C, por unas 2 horas, volteando las rodajas a la mitad del tiempo.","Apaga el horno y deja que las rodajas se enfríen por completo dentro, para que queden suaves y un poco secas, nunca duras ni crujientes.","Sirve en trozos pequeños, siempre con la supervisión de un adulto, por el riesgo de atragantamiento."],"alerta":"Las rodajas deben quedar suaves, nunca duras como un chip crujiente: así evitas que se rompan en astillas y causen atragantamiento."},{"id":1006,"name":"Pastel de Banana y Zanahoria sin Azúcar","icon":"🍰","time":"~35 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/830894/pexels-photo-830894.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 rebanadas","ageRec":"A partir de 1 año","ingredients":["2 bananas (plátanos) maduras machacadas","1/2 taza de zanahoria rallada fina","1 y 1/2 taza de harina de avena","2 huevos"],"tip":"Harina de avena → harina de arroz, en la misma cantidad, para una versión sin gluten.","steps":["Machaca las bananas y mézclalas con la zanahoria rallada fina y los huevos.","Agrega la harina de avena poco a poco, revolviendo hasta formar una masa uniforme, sin grumos.","Vierte la masa en un molde pequeño engrasado y extiéndela bien hasta que la superficie quede pareja.","Hornea en el horno precalentado a 180 °C por unos 30 minutos, hasta que se dore y un palillo salga limpio del centro.","Deja enfriar por completo antes de desmoldar y cortar, para que el pastel no se desmorone.","Corta en rebanadas pequeñas y sirve a temperatura ambiente, en trozos que el bebé pueda agarrar."],"alerta":"Corta las rebanadas pequeñas; si todavía están calientes, el centro puede quemar la boca aunque la superficie esté tibia."},{"id":1007,"name":"Paleta de Sandía y Hierbabuena","icon":"🍉","time":"~10 min + congelación","kcal":"35 kcal (estimado)","img":"https://images.pexels.com/photos/8881949/pexels-photo-8881949.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 unidades","ageRec":"A partir de 1 año","ingredients":["1 taza de sandía sin semillas, en cubos","1 hoja de hierbabuena (menta) bien picadita (opcional)"],"tip":"Sandía → fresa (frutilla) bien madura licuada, en la misma cantidad.","steps":["Licúa la sandía en cubos hasta formar un jugo espeso, sin trozos.","Mezcla la hierbabuena bien picadita, si la vas a usar.","Vierte el líquido en moldes para paletas especiales para bebés, sin palito rígido.","Lleva al congelador por lo menos 4 horas, hasta que se congele por completo.","Sirve con supervisión constante, cuidando que no se derrita y escurra."],"alerta":"Ofrécela siempre con el niño sentado y con supervisión; las paletas heladas pueden escurrir rápido y el niño puede intentar morder un trozo grande."},{"id":1008,"name":"Pudín de Chía con Mango","icon":"🍮","time":"~15 min + refrigerador","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/2294137/pexels-photo-2294137.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["2 cucharadas de semillas de chía","1/2 taza de leche (a partir de 1 año) o leche vegetal sin azúcar","1/2 mango maduro machacado"],"tip":"Mango → durazno maduro machacado, en la misma cantidad.","steps":["Mezcla las semillas de chía con la leche o la leche vegetal en un recipiente.","Lleva al refrigerador y deja hidratar por lo menos 3 horas, revolviendo una vez a la mitad del tiempo, hasta que tenga textura de pudín, sin granos duros sueltos.","Machaca el mango maduro con un tenedor hasta formar un puré liso.","Mezcla el puré de mango con el pudín de chía ya hidratado.","Sirve fresco, directo del refrigerador, en un recipiente pequeño con cuchara."],"alerta":"Hidrata la chía durante todo el tiempo indicado; las semillas todavía duras o secas son un riesgo de atragantamiento."},{"id":1009,"name":"Banana Horneada con Canela","icon":"🍌","time":"~15 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/1278005/pexels-photo-1278005.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) firme, cortada por la mitad a lo largo","1 pizca de canela"],"tip":"Canela → un poquito de ralladura muy fina de cáscara de limón, si prefieres.","steps":["Acomoda la banana cortada por la mitad, a lo largo, en una bandeja para horno pequeña engrasada.","Espolvorea la pizca de canela sobre la banana, repartiéndola bien antes de llevar al horno.","Hornea en el horno precalentado a 180 °C por unos 12 minutos, hasta que la banana esté suave y un poco dorada.","Saca del horno y deja entibiar unos minutos, para no quemar la boca del bebé.","Corta en trozos pequeños, del tamaño de un dedo, antes de servir.","Sirve tibia, probando la temperatura en el dorso de la mano, en trocitos suaves adecuados para los 8 meses."],"alerta":"Corta siempre la banana a lo largo y luego en trozos pequeños, nunca en rodajas, que es la forma que más causa atragantamiento."},{"id":1010,"name":"Gelatina Natural de Frutos Rojos","icon":"🍇","time":"~15 min + refrigerador","kcal":"40 kcal (estimado)","img":"https://images.pexels.com/photos/6550713/pexels-photo-6550713.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de fresas (frutillas) o frambuesas maduras","1 cucharada de gelatina sin sabor","1 taza de agua"],"tip":"Fresa → mango maduro licuado, en la misma cantidad.","steps":["Licúa los frutos rojos con la mitad del agua hasta formar un jugo.","Disuelve la gelatina sin sabor en la otra mitad del agua, tibia, según las instrucciones del empaque.","Mezcla el jugo de frutas con la gelatina ya disuelta, revolviendo bien.","Reparte en recipientes pequeños y lleva al refrigerador por lo menos 3 horas, hasta que cuaje por completo.","Corta o saca trozos pequeños con una cuchara antes de servir, siempre fría."],"alerta":"Sirve en trozos pequeños con cuchara; nunca ofrezcas la gelatina entera y firme en un bloque grande."},{"id":1011,"name":"Muffin de Manzana y Avena en Microondas","icon":"🍎","time":"~10 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/36897253/pexels-photo-36897253.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 manzana rallada","3 cucharadas de avena en hojuelas finas","1 huevo"],"tip":"Avena en hojuelas finas → harina de arroz, en la misma cantidad, para una versión sin gluten.","steps":["Mezcla la manzana rallada, la avena en hojuelas finas y el huevo hasta formar una masa uniforme.","Pon la masa en una taza o moldecito engrasado apto para microondas, llenándolo hasta la mitad.","Lleva al microondas a potencia alta por unos 2 minutos, hasta que el centro esté firme por completo.","Pincha un palillo en el centro para confirmar que sale limpio, sin masa cruda pegada.","Deja entibiar el muffin unos minutos fuera de la taza, porque el centro guarda calor y puede quemar la boca del bebé.","Corta en trozos pequeños y suaves, del tamaño que el bebé pueda agarrar con la mano, y sirve tibio, probando la temperatura en el dorso de tu mano antes de ofrecer."],"alerta":"El microondas calienta de forma desigual; prueba siempre la temperatura del centro del muffin en el dorso de la mano antes de servir."},{"id":1012,"name":"Crema de Aguacate con Cacao","icon":"🥑","time":"~10 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/17303221/pexels-photo-17303221.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 2 años","ingredients":["1/2 aguacate (palta) maduro","1 cucharadita de cacao 100 % sin azúcar","1 cucharada de banana (plátano) machacada"],"tip":"Cacao 100 % → cacao en polvo sin azúcar, en la misma cantidad.","steps":["Machaca el aguacate maduro con un tenedor hasta formar una crema lisa.","Mezcla el cacao 100 % sin azúcar y la banana machacada hasta que se integren bien, sin grumos.","Revisa la consistencia: debe quedar cremosa, pero lo bastante firme para no escurrirse de la cuchara.","Sirve de inmediato, en un recipiente pequeño, con una cuchara suave."],"alerta":"El cacao solo entra después de los 2 años. Antes de eso, sirve la crema solo de aguacate con banana, sin el cacao."},{"id":1013,"name":"Bolitas de Coco con Banana","icon":"🥥","time":"~15 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/11700718/pexels-photo-11700718.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 unidades","ageRec":"A partir de 1 año","ingredients":["1 banana (plátano) madura machacada","3 cucharadas de coco rallado sin azúcar"],"tip":"Coco rallado → avena en hojuelas finas, en la misma cantidad, para quien no le gusta el coco.","steps":["Machaca la banana madura con un tenedor hasta formar un puré.","Mezcla el coco rallado sin azúcar hasta formar una masa que no se pegue a las manos.","Con las manos un poco engrasadas, forma bolitas pequeñas, del tamaño de una aceituna.","Pasa las bolitas ligeramente por más coco rallado, si quieres.","Sirve a temperatura ambiente, en trozos pequeños."],"alerta":"Forma bolitas pequeñas y suaves; evita que queden muy compactas y duras para que no sean un riesgo de atragantamiento."},{"id":1014,"name":"Helado Casero de Banana","icon":"🍦","time":"~5 min + congelación","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/22484696/pexels-photo-22484696.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones pequeñas","ageRec":"A partir de los 6 meses","ingredients":["2 bananas (plátanos) bien maduras"],"tip":"Banana → mango maduro bien machacado, en la misma cantidad, siguiendo el mismo proceso de congelación.","steps":["Corta las bananas en rodajas gruesas y machácalas bien con un tenedor hasta formar un puré espeso, sin trozos duros.","Reparte el puré en cubeteras pequeñas y lleva al congelador por lo menos 4 horas, hasta que se congele por completo.","Saca las cubeteras del congelador y déjalas a temperatura ambiente de 5 a 10 minutos, hasta que se puedan machacar fácilmente con el tenedor.","Machaca otra vez con el tenedor hasta que quede una crema suave, sin partes duras ni demasiado heladas.","Sirve de inmediato, en cucharadas pequeñas, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Nunca ofrezcas el puré todavía duro y helado del congelador: deja que se ablande y pruébalo con el tenedor antes de servir, para que no sea un riesgo de atragantamiento."},{"id":1015,"name":"Galletita de Banana y Canela","icon":"🍪","time":"~25 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/9651304/pexels-photo-9651304.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"10 galletitas pequeñas","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) madura machacada","1 taza de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad, para una masa todavía más lisa.","steps":["Machaca la banana con un tenedor hasta hacerla puré y mézclala con la avena y la canela hasta formar una masa que no se pegue a las manos.","Forma galletitas pequeñas y bien aplanadas, del tamaño de una cucharadita, de alrededor de 1 cm de grosor.","Acomódalas en una bandeja para horno cubierta y hornea en el horno precalentado a 180 °C por unos 15 minutos, hasta que estén un poco firmes al tacto.","Saca del horno y deja enfriar por completo, hasta que estén tibias.","Antes de ofrecer, aprieta una galletita entre el pulgar y el índice: debe aplastarse con facilidad, nunca quedar rígida como una galleta común."],"alerta":"La galletita horneada puede quedar dura en los bordes: revisa que se aplaste fácil entre los dedos antes de dársela al bebé, y nunca la ofrezcas si está crujiente."},{"id":1016,"name":"Discos de Coco sin Azúcar","icon":"🥥","time":"~15 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/38441742/pexels-photo-38441742.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 unidades aplanadas","ageRec":"A partir de 1 año","ingredients":["1 banana (plátano) madura machacada","3 cucharadas de coco rallado sin azúcar, bien fino","1 cucharadita de leche de vaca entera (para que tome consistencia)"],"tip":"Coco rallado → avena en hojuelas finas, en la misma cantidad, para que sea más fácil de masticar.","steps":["Mezcla la banana machacada con el coco rallado y la leche en una olla pequeña.","Lleva a fuego bajo por unos 3 minutos, revolviendo siempre, hasta que la mezcla se despegue del fondo de la olla.","Deja enfriar por completo antes de manipular.","Forma porciones pequeñas y aplasta cada una con la palma de la mano, formando discos, nunca bolitas redondas.","Pásalos ligeramente por más coco rallado, si quieres, y sirve a temperatura ambiente."],"alerta":"Nunca los sirvas en forma de bolita redonda: aplasta bien cada porción, porque el coco rallado necesita masticación y la forma redonda aumenta el riesgo de atragantamiento."},{"id":1017,"name":"Barquitas de Banana con Canela","icon":"🍌","time":"~15 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/8829460/pexels-photo-8829460.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 barquitas (4 trozos)","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) firme, cortada por la mitad a lo largo","1 pizca de canela en polvo","1/2 cucharadita de aceite de coco"],"tip":"Aceite de coco → aceite de oliva extra virgen, en la misma cantidad.","steps":["Acomoda las dos mitades de la banana en una bandeja para horno pequeña, con el lado cortado hacia arriba.","Báñalas con el aceite de coco derretido y espolvorea la canela por encima.","Hornea en el horno precalentado a 180 °C por unos 10 minutos, hasta que la banana esté suave y un poco dorada en los bordes.","Saca del horno y deja entibiar unos minutos.","Corta cada mitad en trozos del tamaño de un dedo de adulto y sirve tibia."]},{"id":1018,"name":"Pudín de Leche con Mango","icon":"🍮","time":"~20 min + refrigerador","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/12669167/pexels-photo-12669167.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 recipientes pequeños","ageRec":"A partir de 1 año","ingredients":["1 taza de leche de vaca entera","1 cucharada de fécula de maíz","1/2 mango maduro, machacado"],"tip":"Leche de vaca → leche vegetal sin azúcar (de avena o de coco), en la misma cantidad, si todavía no has introducido la leche de vaca.","steps":["Mezcla la leche con la fécula de maíz en una olla, todavía en frío, hasta que se disuelva bien.","Lleva a fuego bajo, revolviendo sin parar, hasta que espese y forme una crema que cubra el dorso de una cuchara, unos 6 a 8 minutos.","Retira del fuego y deja entibiar unos minutos antes de mezclar el mango machacado.","Reparte la crema todavía tibia en recipientes pequeños individuales, dejando espacio hasta el borde para que no se derrame en el refrigerador.","Lleva al refrigerador por lo menos 2 horas, hasta que cuaje, y sirve bien frío o tibio."]},{"id":1019,"name":"Trufa de Dátil con Cacao","icon":"🍫","time":"~15 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/27850068/pexels-photo-27850068.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 unidades aplanadas","ageRec":"A partir de los 2 años","ingredients":["4 dátiles sin hueso, bien picados","1 cucharadita de cacao 100 % sin azúcar","1 cucharada de agua tibia"],"tip":"Cacao 100 % → canela en polvo, en una versión sin cacao para niños menores de 2 años.","steps":["Deja los dátiles picados remojando en el agua tibia por 10 minutos, hasta que se ablanden bien.","Escurre y machaca con un tenedor hasta formar una pasta uniforme, sin trozos duros.","Agrega el cacao en polvo sin azúcar y mezcla bien hasta que el color quede parejo, sin partes claras ni grumos secos.","Forma porciones pequeñas y aplasta cada una con la palma de la mano, en forma de disco.","Sirve a temperatura ambiente, cortando cada disco por la mitad antes de ofrecer."],"alerta":"El dátil es una fruta seca y fibrosa: machácalo bien y nunca lo ofrezcas en bolita entera, siempre aplanado y cortado, para evitar atragantamiento."},{"id":1020,"name":"Pastel en Taza de Banana","icon":"☕","time":"~5 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/36950541/pexels-photo-36950541.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 taza (2 porciones pequeñas)","ageRec":"A partir de los 8 meses","ingredients":["1/2 banana (plátano) machacada","2 cucharadas de harina de avena","1 huevo"],"tip":"Harina de avena → harina de arroz, para una versión sin gluten.","steps":["Machaca la banana y mézclala con la harina de avena y el huevo en una taza apta para microondas, batiendo bien hasta que quede uniforme.","Lleva al microondas a potencia alta por unos 2 minutos, revisando que la masa haya crecido y esté firme y seca al tacto, sin partes líquidas de huevo.","Si todavía está húmedo en el centro, vuelve a llevarlo al microondas de 20 a 30 segundos más.","Deja entibiar unos minutos antes de desmoldar.","Corta en trozos pequeños y suaves del tamaño de un dedo antes de servir."],"alerta":"Revisa que el huevo se haya cocido por completo, sin partes mojadas o transparentes, antes de ofrecerlo al bebé."},{"id":1021,"name":"Helado Natural de Fresa","icon":"🍓","time":"~5 min + congelación","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/22484693/pexels-photo-22484693.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones pequeñas","ageRec":"A partir de los 10 meses","ingredients":["1 taza de fresas (frutillas) maduras, lavadas y congeladas","2 cucharadas de yogur natural entero"],"tip":"Fresa → mango maduro congelado, en la misma cantidad.","steps":["Congela las fresas enteras por lo menos 3 horas.","Procesa las fresas congeladas con el yogur hasta formar una crema lisa, sin trozos grandes de hielo.","Si la mezcla queda muy líquida, llévala al congelador por 15 minutos antes de servir.","Sirve de inmediato, en cucharadas pequeñas, en un recipiente pequeño.","No guardes el resto totalmente congelado: ofrécelo siempre recién procesado o apenas un poco firme."],"alerta":"Sirve siempre al momento, con consistencia cremosa: si se congela por completo, el helado queda demasiado duro y se vuelve un riesgo de atragantamiento."},{"id":1022,"name":"Galletita de Fécula de Maíz con Banana","icon":"🍪","time":"~25 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/37353911/pexels-photo-37353911.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"12 galletitas pequeñas","ageRec":"A partir de los 10 meses","ingredients":["1/2 banana (plátano) machacada","1 taza de fécula de maíz","1 cucharada de aceite"],"tip":"Fécula de maíz → harina de avena, en la misma cantidad, para una textura más suave.","steps":["Machaca la banana y mézclala con la fécula de maíz y el aceite hasta formar una masa lisa y moldeable.","Forma galletitas pequeñas y bien aplanadas, de 1/2 cm de grosor como máximo.","Acomódalas en una bandeja para horno cubierta y hornea en el horno precalentado a 180 °C por unos 15 minutos, hasta que estén apenas un poco doradas en los bordes.","Saca del horno en cuanto se doren un poco, sin dejar que se tuesten, y deja enfriar por completo.","Antes de servir, aprieta una galletita entre los dedos: debe ceder con facilidad, nunca crujir ni quedar rígida como un pan tostado."],"alerta":"La galletita de fécula se puede hornear de más y quedar dura como pan tostado: sácala del horno en cuanto se dore un poco y prueba que esté suave antes de ofrecer."},{"id":1023,"name":"Mousse de Mango con Yogur","icon":"🥭","time":"~10 min + refrigerador","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/38086494/pexels-photo-38086494.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 recipientes pequeños","ageRec":"A partir de los 10 meses","ingredients":["1/2 mango maduro","3 cucharadas de yogur natural entero"],"tip":"Mango → durazno maduro bien machacado, en la misma cantidad.","steps":["Machaca el mango con un tenedor hasta hacerlo un puré liso, sin hebras.","Mezcla el yogur natural entero hasta que se integre por completo, dejando el puré cremoso y sin partes separadas.","Reparte la mezcla en recipientes pequeños individuales, listos para enfriar o servir al momento.","Lleva al refrigerador por lo menos 1 hora, hasta que el mousse esté bien frío y firme, sin estar líquido.","Sirve fresco, en cucharadas pequeñas, ofreciendo de a poco para ver cómo acepta el bebé la consistencia cremosa."]},{"id":1024,"name":"Bombón de Banana Fría con Cacao","icon":"🍫","time":"~10 min + refrigerador","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/8098644/pexels-photo-8098644.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 rodajas","ageRec":"A partir de los 2 años","ingredients":["1 banana (plátano) cortada en rodajas finas","1 cucharada de cacao 100 % sin azúcar","1 cucharada de yogur natural entero"],"tip":"Cacao → un poquito de canela, en una versión sin cacao para niños menores de 2 años.","steps":["Mezcla el cacao con el yogur hasta formar una cobertura cremosa y uniforme.","Pasa cada rodaja fina de banana por la cobertura, cubriendo bien los dos lados.","Acomoda las rodajas en un molde cubierto, sin que se toquen entre sí.","Lleva al refrigerador por alrededor de 1 hora, solo hasta que la cobertura esté firme, sin congelar.","Sirve frío, nunca duro como piedra, cortando cada rodaja por la mitad antes de ofrecer, con supervisión constante."],"alerta":"Nunca dejes que se congele por completo: la banana congelada queda demasiado dura y es riesgo de atragantamiento. Corta siempre por la mitad antes de servir."},{"id":1025,"name":"Panecito de Especias sin Azúcar","icon":"🍯","time":"~30 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/34541190/pexels-photo-34541190.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"10 unidades pequeñas","ageRec":"A partir de 1 año","ingredients":["1 banana (plátano) madura machacada","1 taza de harina de avena","1 pizca de canela en polvo","1 pizca de jengibre en polvo"],"tip":"Harina de avena → harina de arroz, para una versión sin gluten.","steps":["Machaca bien la banana y mézclala con la harina de avena, la canela y el jengibre hasta formar una masa uniforme.","Reparte la masa en moldecitos pequeños engrasados, llenándolos hasta la mitad.","Hornea en el horno precalentado a 180 °C por unos 20 minutos, hasta que crezcan y estén firmes al tacto en el centro.","Espera a que se enfríen por completo antes de desmoldar.","Sirve a temperatura ambiente, revisando que cada unidad se aplaste con facilidad entre los dedos."]},{"id":1026,"name":"Compota de Frutos Rojos","icon":"🍓","time":"~20 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/8467178/pexels-photo-8467178.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones pequeñas","ageRec":"A partir de los 6 meses","ingredients":["1 taza de fresas (frutillas) y frambuesas maduras, picadas","Agua, la cantidad necesaria para cubrir el fondo de la olla"],"tip":"Frambuesa → arándanos cocidos, en la misma cantidad.","steps":["Pon las frutas picadas en una olla con un dedo de agua en el fondo.","Cocina a fuego bajo por unos 8 minutos, hasta que las frutas se deshagan fácilmente al tocarlas con la cuchara.","Machaca con un tenedor hasta hacer un puré espeso, sin trozos enteros.","Deja enfriar hasta que esté tibio antes de servir.","Guarda el resto en un recipiente cerrado en el refrigerador por 2 días o menos."]},{"id":1027,"name":"Buñuelitos Horneados sin Azúcar","icon":"🧁","time":"~30 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/34158234/pexels-photo-34158234.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 buñuelitos pequeños","ageRec":"A partir de 1 año","ingredients":["1 banana (plátano) madura machacada","1 taza de harina de avena","1/2 taza de leche de vaca entera"],"tip":"Leche de vaca → leche vegetal sin azúcar, en la misma cantidad.","steps":["Machaca la banana y mézclala con la harina de avena y la leche hasta formar una masa uniforme y sin grumos.","Reparte la masa en moldes para cupcakes engrasados, llenándolos hasta la mitad.","Hornea en el horno precalentado a 180 °C por unos 20 minutos, hasta que se doren un poco y estén firmes al tacto.","Espera a que se entibien antes de desmoldar.","Corta cada buñuelito en trozos pequeños antes de servir."]},{"id":1028,"name":"Rollo Dulce de Banana","icon":"🍌","time":"~30 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/35673217/pexels-photo-35673217.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 rebanadas","ageRec":"A partir de los 8 meses","ingredients":["2 huevos","1 banana (plátano) madura machacada","3 cucharadas de harina de avena"],"tip":"Harina de avena → harina de arroz, para una versión sin gluten.","steps":["Bate los huevos con la banana machacada y la harina de avena hasta formar una masa lisa y uniforme.","Extiende la masa en una bandeja para horno cubierta, en una capa fina de alrededor de 1 cm.","Hornea en el horno precalentado a 180 °C por unos 12 minutos, hasta que la masa esté firme y seca al tacto, sin partes húmedas de huevo.","Todavía tibia, enrolla la masa con cuidado, usando el papel para hornear como apoyo.","Deja enfriar por completo antes de cortar en trozos pequeños y servir."],"alerta":"Revisa que la masa se haya horneado por completo, sin partes húmedas de huevo, antes de enrollar y servir."},{"id":1029,"name":"Crema Ligera de Mango y Coco","icon":"🥥","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/7462565/pexels-photo-7462565.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 recipientes pequeños","ageRec":"A partir de los 6 meses","ingredients":["1/2 mango maduro, machacado","1/2 taza de leche de coco","1 cucharada de fécula de maíz"],"tip":"Mango → papaya madura machacada, en la misma cantidad.","steps":["Mezcla el mango machacado, la leche de coco y la fécula de maíz en una olla, todavía en frío, hasta que se disuelva bien.","Lleva a fuego bajo, revolviendo siempre, hasta que espese y forme una crema que cubra el dorso de una cuchara, unos 5 minutos.","Retira del fuego y deja entibiar la crema unos minutos antes de repartirla, revolviendo de vez en cuando para que no se forme una capa encima.","Reparte la crema todavía tibia en recipientes pequeños individuales para servir o guardar.","Sirve tibia, probando la temperatura en el dorso de la mano, o lleva al refrigerador por 1 hora y sirve bien fría, en cucharadas pequeñas."]}],"2":[{"id":1100,"name":"Puré de Mango con Yogur Natural","icon":"🥭","time":"~10 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/32149261/pexels-photo-32149261.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción pequeña","ageRec":"A partir de los 10 meses","ingredients":["1/2 mango maduro","2 cucharadas de yogur natural entero"],"tip":"Mango → durazno maduro, en la misma cantidad.","steps":["Machaca el mango con un tenedor hasta formar un puré liso, sin hebras.","Mezcla el yogur natural hasta integrarlo por completo.","Sirve a temperatura ambiente, en cucharadas pequeñas.","Guarda lo que sobre en un recipiente cerrado en el refrigerador por 24 horas o menos."]},{"id":1101,"name":"Ensalada de Frutas Machacadita","icon":"🍉","time":"~10 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/1646738/pexels-photo-1646738.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones pequeñas","ageRec":"A partir de los 8 meses","ingredients":["1 rebanada de sandía sin semillas, picada muy pequeña","1/2 banana (plátano) machacada","2 fresas (frutillas) maduras, picadas muy pequeñas"],"tip":"Fresa → papaya picada muy pequeña, en la misma cantidad.","steps":["Corta la sandía y las fresas en trocitos muy pequeños y suaves, quitando todas las semillas.","Machaca la banana con un tenedor hasta que quede un puré parejo, sin trozos grandes ni fibras duras.","Mezcla todas las frutas en un tazón, machacando un poco con el tenedor los trozos más firmes.","Revisa que cada trocito se aplaste fácil entre el pulgar y el índice antes de servir.","Sirve al momento, a temperatura ambiente, en cucharadas pequeñas."]},{"id":1102,"name":"Banana a la Plancha con Canela","icon":"🍌","time":"~8 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/34802737/pexels-photo-34802737.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) firme, cortada a la mitad a lo largo","1 pizca de canela en polvo","1/2 cucharadita de mantequilla"],"tip":"Mantequilla → aceite de coco, en la misma cantidad.","steps":["Calienta la mantequilla a fuego bajo en un sartén antiadherente.","Cocina la banana unos 2 minutos de cada lado, hasta que se dore un poco y se sienta suave al tocarla con el tenedor.","Espolvorea la pizca de canela encima mientras está caliente.","Deja que se entibie y córtala en tiras suaves del tamaño de un dedo adulto.","Revisa que cada tira se aplaste fácil entre los dedos antes de servir.","Sirve tibia, probando la temperatura en el dorso de la mano."],"alerta":"La banana a la plancha se enfría por fuera, pero puede guardar calor por dentro; prueba siempre la temperatura antes de servir."},{"id":1103,"name":"Compotita Casera de Manzana y Pera","icon":"🍐","time":"~20 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/10309290/pexels-photo-10309290.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 6 meses","ingredients":["1 manzana mediana, sin cáscara y sin semillas, en cubos","1 pera mediana, sin cáscara y sin semillas, en cubos","1/2 taza de agua (o la necesaria para cubrir)"],"tip":"Manzana → durazno maduro sin cáscara, con la misma preparación, sin necesidad de cocinarlo.","steps":["Corta la manzana y la pera en cubos, desechando toda la cáscara y las semillas.","Cocina las frutas en una olla con agua suficiente para cubrirlas, a fuego medio, unos 10 a 12 minutos.","Revisa el punto: un tenedor debe atravesar los cubos sin resistencia.","Escurre el exceso de agua y guarda un poco para ajustar la textura.","Machaca con un tenedor hasta formar un puré espeso que se queda en la cuchara sin escurrir.","Deja enfriar hasta que esté tibio y sirve, probando la temperatura en el dorso de la mano."],"alerta":"Quita todas las semillas de la manzana y de la pera antes de cocinar."},{"id":1104,"name":"Brochetita de Frutas Suaves","icon":"🍇","time":"~10 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/11745657/pexels-photo-11745657.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["4 fresas (frutillas) maduras, cortadas a la mitad","1/2 banana (plátano) mediana, cortada en trozos pequeños y no redondos","4 cubos pequeños de papaya madura"],"tip":"Papaya → mango muy maduro en cubos pequeños, en la misma cantidad.","steps":["Corta las fresas a la mitad, la banana en trozos pequeños no redondos y la papaya en cubos suaves.","Si quieres armar la brochetita para que se vea bonita, usa un palito solo para presentar la fruta en el plato.","Antes de dársela al niño, saca cada trozo de fruta del palito y sírvelo suelto en el plato o en su mano.","Nunca pongas el palito armado en la mano del bebé o del niño pequeño.","Sirve las frutas a temperatura ambiente, en porciones pequeñas.","Mantén a un adulto cerca durante toda la comida."],"alerta":"Nunca le des el palito de la brocheta en la mano al niño; saca todas las frutas antes de servir."},{"id":1105,"name":"Licuado de Banana y Avena sin Azúcar","icon":"🥤","time":"~5 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/11394965/pexels-photo-11394965.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 banana (plátano) madura","1 cucharada colmada de avena en hojuelas finas","1/2 taza (120 ml) de leche entera o bebida vegetal sin azúcar"],"tip":"Leche → bebida vegetal de avena o de arroz sin azúcar, en la misma cantidad.","steps":["Machaca la banana con un tenedor antes de licuar, para que sea más fácil.","Licúa la banana, la avena y la leche por 1 minuto, más o menos, hasta que quede parejo y sin grumos.","Revisa la consistencia: debe quedar un poco espeso, sin quedar demasiado aguado.","Sirve de inmediato en un vaso entrenador; no lo guardes para después.","Ofrécelo con el niño bien sentado y con supervisión todo el tiempo que esté tomando."],"alerta":"Sírvelo siempre en vaso entrenador y con supervisión; nunca en biberón."},{"id":1106,"name":"Puré de Durazno con Yogur","icon":"🍑","time":"~10 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/34005603/pexels-photo-34005603.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["1 durazno mediano, maduro, sin cáscara y sin hueso, picado","2 cucharadas de yogur natural entero, sin azúcar"],"tip":"Durazno → nectarina madura sin cáscara, en la misma cantidad.","steps":["Pela el durazno y quítale el hueso, cortando la pulpa en trozos pequeños.","Machaca los trozos con un tenedor hasta formar un puré espeso, con trocitos pequeños y suaves.","Revisa que los trocitos se aplasten fácil entre los dedos.","Mezcla las 2 cucharadas de yogur natural entero sin azúcar.","Sirve a temperatura ambiente, en cucharadas pequeñas, en cuanto lo prepares."],"alerta":"Usa siempre yogur natural entero sin azúcar y sin trozos de fruta industrializados."},{"id":1107,"name":"Ensalada de Sandía con Hierbabuena","icon":"🍉","time":"~10 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/4051492/pexels-photo-4051492.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["2 rebanadas (unos 200 g) de sandía, sin semillas, en cubos pequeños","1 hoja de hierbabuena (menta) fresca, picada muy finita (opcional)"],"tip":"Hierbabuena → puedes no ponerla y la receta queda igual de rica.","steps":["Quita con cuidado todas las semillas de la sandía, pasando los dedos por la pulpa para no dejar ninguna.","Corta la pulpa en cubos pequeños, del tamaño de una arveja grande.","Pica la hoja de hierbabuena muy finita, casi en polvo, para que el sabor se reparta sin riesgo de trozos grandes.","Mezcla la sandía con la hierbabuena en un tazón, repartiendo bien para que todos los cubitos queden con un poco de aroma.","Sirve de inmediato, porque la sandía suelta agua rápido y pierde la textura firme que ayuda al bebé a agarrar los trozos.","Ofrece en porciones pequeñas, con cuchara o con la mano, con supervisión."],"alerta":"Revisa bien que no haya quedado ninguna semilla de sandía en los cubos antes de servir."},{"id":1108,"name":"Mezcla de Frutos Rojos Machacaditos","icon":"🫐","time":"~10 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/4735542/pexels-photo-4735542.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["6 fresas (frutillas) maduras, picadas en trozos pequeños","8 arándanos azules maduros, cortados en cuatro","6 frambuesas maduras, machacadas con tenedor"],"tip":"Usa los frutos rojos que haya en temporada, siempre bien maduros y suaves.","steps":["Corta las fresas en trozos pequeños, quitando las hojitas verdes.","Corta cada arándano en cuatro a lo largo, nunca a la mitad ni entero.","Machaca un poco las frambuesas con un tenedor, dejando trocitos suaves.","Mezcla todas las frutas en un tazón, repartiendo bien los trozos de fresa, arándano y frambuesa.","Sirve al momento, en porciones pequeñas, con supervisión todo el tiempo."],"alerta":"Corta siempre el arándano en cuatro; nunca lo ofrezcas entero, porque es redondo y del tamaño de la vía respiratoria."},{"id":1109,"name":"Puré de Kiwi Machacado","icon":"🥝","time":"~5 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/15826289/pexels-photo-15826289.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 6 meses","ingredients":["1 kiwi maduro, sin cáscara"],"tip":"Kiwi → mango maduro machacado, en la misma cantidad.","steps":["Pela el kiwi por completo, quitando bien la cáscara fina para que no quede ningún trocito fibroso.","Machaca la pulpa con un tenedor hasta formar un puré liso y espeso que se queda en la cuchara sin escurrir.","Si prefieres, pasa la pulpa por un colador fino para quitar parte de las semillitas.","Sirve a temperatura ambiente, en cucharadas pequeñas, fijándote si al bebé le gusta el sabor un poco ácido de la fruta.","Ofrécelo en cuanto lo prepares, porque el kiwi se oscurece y pierde sabor rápido."]},{"id":1110,"name":"Puré de Ciruela con Yogur","icon":"🟣","time":"~15 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/39173258/pexels-photo-39173258.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["3 ciruelas frescas maduras, sin hueso, picadas","2 cucharadas de yogur natural entero, sin azúcar"],"tip":"Ciruela → pera cocida y machacada, en la misma cantidad.","steps":["Quita el hueso de las ciruelas y corta la pulpa en trozos.","Cocina los trozos en una olla con un poquito de agua en el fondo, a fuego bajo, unos 8 minutos.","Revisa el punto: un tenedor debe atravesar los trozos sin resistencia.","Machaca con un tenedor hasta formar un puré espeso.","Deja enfriar hasta que esté tibio y mezcla el yogur natural entero sin azúcar.","Sirve de inmediato, probando la temperatura en el dorso de la mano."],"alerta":"Usa siempre yogur natural entero sin azúcar."},{"id":1111,"name":"Ensalada de Frutas Tropicales","icon":"🍍","time":"~10 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/12203694/pexels-photo-12203694.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["1/2 mango maduro, en cubos pequeños","1 rebanada de papaya madura, en cubos pequeños","1/2 banana (plátano) madura, cortada en trozos pequeños no redondos"],"tip":"Mango → piña muy madura en cubos pequeños, a partir de los 12 meses, porque es más ácida.","steps":["Corta el mango y la papaya en cubos pequeños y suaves, fáciles de aplastar entre los dedos del bebé.","Corta la banana en trozos pequeños, evitando las rodajas redondas.","Mezcla todas las frutas en un tazón, repartiendo bien los trozos de mango, papaya y banana.","Sirve a temperatura ambiente, en porciones pequeñas, ofreciendo un poco cada vez para ver cómo lo acepta.","Ofrécelo con cuchara o deja que el bebé lo agarre con la mano, siempre con un adulto cerca mirando cada mordida."],"alerta":"Corta siempre la banana en trozos pequeños, nunca en rodajas redondas."},{"id":1112,"name":"Mezcla de Frutos Rojos con Avena","icon":"🫐","time":"~10 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/5604825/pexels-photo-5604825.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["6 fresas (frutillas) maduras, picadas en trozos pequeños","8 arándanos azules, cortados en cuatro","2 cucharadas de avena en hojuelas finas"],"tip":"Avena → harina de avena fina, en la misma cantidad.","steps":["Corta las fresas en trozos pequeños, lo bastante suaves para aplastarse entre los dedos.","Corta cada arándano en cuatro a lo largo, nunca entero.","Mezcla las frutas picadas con la avena en un tazón, revolviendo bien para repartir las hojuelas.","Deja reposar 5 minutos, hasta que la avena se suavice un poco con el jugo de las frutas.","Sirve al momento, en porciones pequeñas, con supervisión todo el tiempo que dure la comida."],"alerta":"Corta siempre el arándano en cuatro; nunca lo ofrezcas entero."},{"id":1113,"name":"Banana Machacada con Canela y Avena","icon":"🍌","time":"~5 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/33874707/pexels-photo-33874707.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 6 meses","ingredients":["1/2 banana (plátano) madura","1 cucharada de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"Avena → harina de avena, en la misma cantidad, para una textura todavía más lisa.","steps":["Machaca la banana con un tenedor hasta formar un puré espeso.","Mezcla la avena en hojuelas finas y la pizca de canela.","Deja reposar 2 minutos, para que la avena se suavice un poco.","Revisa que la consistencia sea de puré espeso, sin grumos duros de avena.","Sirve a temperatura ambiente, en cucharadas pequeñas, en cuanto lo prepares."]},{"id":1114,"name":"Puré de Manzana con Camote","icon":"🍎","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/7111466/pexels-photo-7111466.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 6 meses","ingredients":["1 manzana mediana, sin cáscara y sin semillas, en cubos","1/2 camote (batata) pequeño, cocido y sin cáscara","Agua de la cocción, la necesaria"],"tip":"Manzana → pera, con la misma preparación y el mismo tiempo de cocción.","steps":["Cocina la manzana en una olla con agua unos 10 minutos, hasta que un tenedor la atraviese sin resistencia.","Cocina el camote aparte en agua hasta que esté lo bastante suave para machacarlo con tenedor.","Machaca la manzana y el camote juntos hasta formar un puré espeso.","Ajusta la consistencia con un poco del agua de la cocción, si hace falta.","Deja que se enfríe solo hasta que quede apenas tibio, revolviendo de vez en cuando para que se enfríe parejo.","Sirve en cucharadas pequeñas, probando la temperatura en el dorso de la mano."]},{"id":1115,"name":"Ensalada de Frutas con Yogur Natural","icon":"🍑","time":"~10 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/3758121/pexels-photo-3758121.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["1 durazno maduro, en cubos pequeños","4 fresas (frutillas) maduras, picadas","2 cucharadas de yogur natural entero, sin azúcar"],"tip":"Durazno → nectarina madura, en la misma cantidad.","steps":["Corta el durazno y las fresas en trozos pequeños y suaves, fáciles de aplastar con los dedos del bebé.","Mezcla el durazno y las fresas en un tazón, repartiendo bien los trozos picados.","Agrega el yogur natural entero sin azúcar encima de las frutas, extendiéndolo bien con una cuchara.","Sirve de inmediato, a temperatura ambiente, para aprovechar la textura cremosa del yogur con las frutas.","Ofrécelo en cucharadas pequeñas, con supervisión todo el tiempo que dure la comida."],"alerta":"Usa siempre yogur natural entero sin azúcar."},{"id":1116,"name":"Puré de Guayaba con Yogur","icon":"🍈","time":"~10 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/8668726/pexels-photo-8668726.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["1 guayaba madura, sin semillas","2 cucharadas de yogur natural entero, sin azúcar"],"tip":"Guayaba → papaya madura machacada, en la misma cantidad.","steps":["Corta la guayaba a la mitad y quita bien todas las semillas, raspando la pulpa con una cuchara si hace falta.","Si está firme, cocínala unos 5 minutos hasta que se suavice; si está muy madura, úsala cruda.","Pasa la pulpa por un colador fino para quitar cualquier semillita que haya quedado.","Machaca la pulpa ya colada hasta formar un puré liso y espeso, sin trozos duros.","Mezcla el yogur natural entero sin azúcar y sirve a temperatura ambiente."],"alerta":"Quita bien todas las semillas de la guayaba antes de servir."},{"id":1117,"name":"Ensalada de Uvas sin Semillas Picadas","icon":"🍇","time":"~5 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/1098537/pexels-photo-1098537.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["10 uvas sin semillas, maduras"],"tip":"Uva → fresa picada en trozos pequeños, en la misma cantidad.","steps":["Lava bien las uvas sin semillas con agua corriente antes de empezar a cortar.","Corta cada uva a la mitad a lo largo y después corta cada mitad otra vez a la mitad, para que queden cuatro trozos alargados.","Revisa que ningún trozo haya quedado redondo o entero, porque la uva entera es un riesgo real de atragantamiento.","Sirve en un plato, poquito cada vez, para que sea más fácil vigilar cada trozo.","Ofrécelo siempre con el niño bien sentado y un adulto cerca durante toda la comida."],"alerta":"Nunca ofrezcas la uva entera ni cortada a la mitad a lo ancho; córtala siempre en cuatro a lo largo."},{"id":1118,"name":"Puré de Aguacate con Banana","icon":"🥑","time":"~5 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/6406160/pexels-photo-6406160.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 6 meses","ingredients":["1/4 de aguacate (palta) maduro","1/2 banana (plátano) madura"],"tip":"Banana → pera madura cocida y machacada, en la misma cantidad.","steps":["Machaca el aguacate con un tenedor hasta que quede muy liso, sin trozos firmes ni fibras.","Machaca la banana aparte con un tenedor hasta que quede un puré liso y parejo.","Mezcla bien las dos frutas hasta formar un puré espeso y parejo.","Sirve de inmediato, porque el aguacate se oscurece rápido con el aire.","Ofrécelo a temperatura ambiente, en cucharadas pequeñas, fijándote si al bebé le gusta la textura cremosa."]},{"id":1119,"name":"Mezcla de Mango y Maracuyá","icon":"🥭","time":"~10 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/38006276/pexels-photo-38006276.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción infantil","ageRec":"A partir de los 8 meses","ingredients":["1/2 mango maduro, cortado en cubos pequeños","Pulpa de 1/2 maracuyá, colada y sin semillas (más o menos 1 cucharada)"],"tip":"Maracuyá → unas gotas de jugo de naranja natural colado.","steps":["Corta el mango en cubos pequeños y muy suaves, del tamaño de una arveja grande.","Corta el maracuyá a la mitad y saca la pulpa con una cuchara.","Cuela la pulpa del maracuyá en un colador fino hasta quitar todas las semillas.","Baña el mango con la cucharada de pulpa colada.","Sirve al momento, a temperatura ambiente, con supervisión."],"alerta":"Cuela bien la pulpa del maracuyá para quitar todas las semillas antes de servir."},{"id":1120,"name":"Puré de Ciruela Negra","icon":"🍑","time":"~15 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/38579939/pexels-photo-38579939.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["3 ciruelas negras frescas, maduras y sin hueso","1/4 de taza de agua"],"tip":"Ciruela negra → pera muy madura cocida, en la misma cantidad.","steps":["Lava bien las ciruelas, córtalas a la mitad y quítales todo el hueso.","Cocina las ciruelas en una olla con 1/4 de taza de agua, a fuego bajo, unos 10 minutos, hasta que estén muy suaves.","Quita la cáscara con ayuda de un tenedor, si prefieres una textura más lisa.","Machaca bien con un tenedor hasta formar un puré espeso que se queda en la cuchara sin escurrir.","Deja enfriar hasta que esté tibio, probando la temperatura en el dorso de la mano antes de servir.","Sirve en cucharadas pequeñas, con el bebé bien sentado."]},{"id":1121,"name":"Puré de Higo Maduro con Yogur","icon":"🫐","time":"~10 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/12770829/pexels-photo-12770829.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["2 higos frescos muy maduros, que ceden al apretarlos un poco con el dedo","2 cucharadas de yogur natural entero sin azúcar","1 pizca de canela en polvo (opcional)"],"tip":"Higo fresco → 3 cucharadas de papaya muy madura, con la misma consistencia, cuando no sea temporada de higos. El higo maduro ya es dulce por sí solo: no le agregues azúcar, miel ni melaza.","steps":["Lava bien los higos con agua corriente, córtales el tallito y pélalos por completo, porque la cáscara es fina pero demasiado fibrosa para esta edad.","Corta la pulpa en trozos pequeños y machácala con el dorso de un tenedor por 1 minuto, más o menos, hasta que quede un puré sin ningún trozo más grande que un grano de arroz.","Mezcla las 2 cucharadas de yogur natural entero sin azúcar y revuelve hasta que el color quede parejo, sin rayas blancas.","Revisa la textura: el puré tiene que quedarse quieto en la cuchara inclinada sin escurrir; si queda aguado, agrega otro trocito de higo machacado.","Espolvorea la pizca de canela, si quieres, y sirve de inmediato, frío del refrigerador o a temperatura ambiente, en cucharadas pequeñas con el bebé bien sentado."],"alerta":"Las semillitas del higo son suaves y no son un riesgo, pero la cáscara tiene que salir completa: es fibrosa y se puede quedar pegada en el paladar del bebé."},{"id":1122,"name":"Puré de Caqui Machacado","icon":"🍊","time":"~5 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/7418940/pexels-photo-7418940.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 caqui (persimón) muy maduro y suave (tipo fuyu u otro dulce)"],"tip":"Caqui → durazno muy maduro, en la misma cantidad.","steps":["Elige un caqui muy maduro, con la pulpa suave al tacto; evita el caqui firme o verde.","Córtalo a la mitad y quítale la cáscara y las semillas, si tiene.","Machaca la pulpa con un tenedor hasta formar un puré espeso y parejo.","No hace falta cocinarlo ni usar procesador; la pulpa madura se machaca fácil.","Sirve a temperatura ambiente o un poco frío, en cucharadas pequeñas."],"alerta":"Usa solo caqui muy maduro; el caqui verde o firme tiene un sabor que raspa la boca y es difícil de machacar."},{"id":1123,"name":"Ensalada de Frutas con Chía","icon":"🍓","time":"~15 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/15766427/pexels-photo-15766427.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de fresa (frutilla) picada en cubos pequeños","1/2 taza de mango picado en cubos pequeños","1 cucharadita de chía hidratada en 2 cucharadas de agua (por 30 minutos)"],"tip":"Chía → linaza molida, en la misma cantidad.","steps":["Hidrata 1 cucharadita de chía en 2 cucharadas de agua por lo menos 30 minutos, hasta que forme un gel.","Lava y corta la fresa y el mango en cubos pequeños, del tamaño de una arveja, fáciles de aplastar entre los dedos.","Mezcla las frutas picadas con la chía ya hidratada.","Sirve al momento, en un tazón pequeño, dejando que el niño agarre los trozos con la pinza de los dedos.","Acompáñalo durante toda la comida, con el niño bien sentado."],"alerta":"Corta siempre en cubos pequeños y suaves; nunca ofrezcas la fresa entera ni el mango en trozos grandes."},{"id":1124,"name":"Papaya con Avena y Canela","icon":"🍈","time":"~5 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/28613331/pexels-photo-28613331.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 rebanada gruesa de papaya muy madura (unos 100 g)","1 cucharada de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad.","steps":["Quita la cáscara y las semillas de la rebanada de papaya muy madura, dejando solo la pulpa suave.","Machaca la pulpa con un tenedor hasta formar un puré espeso, sin trozos duros.","Mezcla 1 cucharada de avena en hojuelas finas, revolviendo bien para integrarla.","Termina con una pizca de canela en polvo, mezclando bien para dar aroma sin dejar grumos.","Sirve a temperatura ambiente, en cucharadas pequeñas, fijándote cómo reacciona el bebé al sabor de la canela."]},{"id":1125,"name":"Puré Doble de Manzana y Zanahoria","icon":"🍎","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/36468249/pexels-photo-36468249.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 manzana mediana, sin cáscara y sin semillas, en cubos","1/2 zanahoria pequeña, en cubos","1/2 taza de agua"],"tip":"Zanahoria → calabaza (zapallo) cocida, en la misma cantidad.","steps":["Pela la manzana y la zanahoria y corta las dos en cubos pequeños.","Cocina en una olla con 1/2 taza de agua, a fuego bajo, unos 15 minutos, hasta que un tenedor atraviese los cubos sin resistencia.","Escurre el exceso de agua y machaca todo con un tenedor hasta formar un puré espeso y parejo, sin usar licuadora ni procesador.","Deja que se entibie antes de servir, probando la temperatura en el dorso de la mano.","Sirve en cucharadas pequeñas, con el bebé bien sentado."]},{"id":1126,"name":"Puré de Uvas Oscuras Coladas","icon":"🍇","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/29985684/pexels-photo-29985684.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones de bebé","ageRec":"A partir de los 8 meses","ingredients":["1 taza de uvas oscuras sin semillas, muy maduras, de cáscara brillante","1/4 de taza de agua filtrada","1/2 banana (plátano) pequeña muy madura, para dar cuerpo"],"tip":"Uvas oscuras → 1 taza de moras muy maduras, cocidas de la misma forma e igual de coladas. La uva madura ya es dulce: no le agregues azúcar, miel ni melaza para corregir la acidez.","steps":["Lava las uvas una por una con agua corriente, frotando suave la cáscara, y desecha cualquier fruta arrugada, partida o con la cáscara opaca.","Pon las uvas en la olla con 1/4 de taza de agua y cocina a fuego bajo unos 10 minutos, revolviendo de vez en cuando, hasta que las cáscaras revienten y suelten la pulpa.","Apaga el fuego, deja que se entibie y pasa todo por un colador de malla fina, apretando con el dorso de una cuchara para sacar la pulpa y dejar TODAS las cáscaras en el colador.","Machaca la 1/2 banana con un tenedor y mézclala con el líquido colado, revolviendo hasta formar un puré espeso y parejo que se queda quieto en la cuchara inclinada.","Prueba la temperatura en el dorso de tu mano para asegurarte de que está tibio, nunca caliente, y sirve en cucharadas pequeñas con el bebé bien sentado y vigilado."],"alerta":"La uva entera es redonda y su cáscara es dura y resbalosa, una forma de alto riesgo de atragantamiento: ofrécesela al bebé solo cocida y pasada por el colador, nunca la fruta entera en la mano."},{"id":1127,"name":"Puré de Piña Cocida","icon":"🍍","time":"~15 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4195522/pexels-photo-4195522.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 rebanadas de piña madura, en cubos","1/4 de taza de agua"],"tip":"Piña → mango maduro, sin necesidad de cocinarlo.","steps":["Corta las rebanadas de piña madura en cubos pequeños, quitando el centro duro.","Cocina a fuego bajo con 1/4 de taza de agua unos 10 minutos, hasta que los cubos estén muy suaves; así también baja la acidez de la fruta.","Machaca con un tenedor hasta formar un puré espeso, sin usar licuadora ni procesador.","Deja enfriar hasta que esté tibio o sírvelo frío.","Ofrece cucharadas pequeñas la primera vez, fijándote si el niño tolera bien la acidez."],"alerta":"Cocinar bien la piña baja la acidez, que puede molestar el estómago sensible del bebé."},{"id":1128,"name":"Mezcla de Sandía y Hierbabuena","icon":"🍉","time":"~5 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/8899099/pexels-photo-8899099.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 taza de sandía sin semillas, en cubos pequeños","1 hoja de hierbabuena (menta) muy picadita (opcional)"],"tip":"Sandía → melón maduro, en la misma cantidad.","steps":["Corta la sandía en cubos pequeños, del tamaño de una aceituna, revisando y quitando todas las semillas.","Confirma que cada cubo se aplasta fácil entre el pulgar y el índice antes de servir.","Pica muy finita la hoja de hierbabuena, si la vas a usar.","Mezcla la hierbabuena por encima de los cubos de sandía, si quieres.","Sirve frío, en porción pequeña, con el bebé sentado y vigilado durante toda la comida."],"alerta":"Revisa con cuidado que no haya quedado ninguna semilla antes de servir."},{"id":1129,"name":"Puré de Uva Cocida","icon":"🍇","time":"~10 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/5847938/pexels-photo-5847938.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["10 uvas sin semillas, peladas","1/4 de taza de agua"],"tip":"Uva → pera muy madura cocida, en la misma cantidad.","steps":["Lava bien las uvas, córtalas a la mitad y quita todas las semillas con la punta de un cuchillo.","Pela cada mitad de uva antes de cocinarla, porque la cáscara queda dura aun después de cocida.","Cocina las uvas peladas a fuego bajo con 1/4 de taza de agua unos 8 minutos, hasta que estén muy suaves.","Machaca con un tenedor hasta formar un puré espeso y parejo, sin usar colador, licuadora ni procesador.","Sirve tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Nunca ofrezcas la uva entera ni en rodajas; aquí la uva va siempre pelada, sin semillas y totalmente machacada."},{"id":1130,"name":"Ensalada de Frutas con Granola Casera sin Azúcar","icon":"🍓","time":"~15 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/30530311/pexels-photo-30530311.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de fresa (frutilla) picada en cubos pequeños","1/2 banana (plátano) picada en cubos pequeños","1/2 taza de mango picado en cubos pequeños","2 cucharadas de granola casera sin azúcar, bien desmoronada"],"tip":"Granola → avena en hojuelas finas un poco tostada, en la misma cantidad.","steps":["Pica la fresa, la banana y el mango en cubos pequeños, lo bastante suaves para aplastarse entre los dedos.","Desmorona bien la granola casera sin azúcar con las manos, rompiendo los trozos grandes o duros.","Mezcla la granola desmoronada con las frutas solo al momento de servir, para que quede un poco crujiente.","Sirve una porción pequeña, animando al niño a agarrar los trozos con la pinza de los dedos.","Acompáñalo durante toda la comida, porque la granola exige más atención al masticar."],"alerta":"Desmorona bien la granola antes de servir; los trozos grandes o duros pueden causar atragantamiento."},{"id":1131,"name":"Puré de Mango con Chía","icon":"🥭","time":"~15 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/5150207/pexels-photo-5150207.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 mango maduro, sin cáscara y sin hueso","1 cucharadita de chía hidratada en 2 cucharadas de agua (por 30 minutos)"],"tip":"Chía → linaza molida, en la misma cantidad.","steps":["Hidrata 1 cucharadita de chía en 2 cucharadas de agua por lo menos 30 minutos, hasta que forme un gel.","Quita la cáscara y el hueso del mango muy maduro, dejando solo la pulpa suave.","Machaca la pulpa con un tenedor hasta formar un puré espeso y parejo.","Mezcla el gel de chía ya hidratado con el puré de mango, revolviendo bien hasta que quede parejo.","Sirve al momento, a temperatura ambiente, en cucharadas pequeñas."]},{"id":1132,"name":"Compota de Durazno","icon":"🍑","time":"~20 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/27429847/pexels-photo-27429847.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 duraznos maduros, sin cáscara y sin hueso, en cubos","1/4 de taza de agua"],"tip":"Durazno → nectarina madura, en la misma cantidad.","steps":["Pela los duraznos y córtalos en cubos, quitando bien el hueso.","Cocina a fuego bajo con 1/4 de taza de agua unos 12 minutos, hasta que un tenedor atraviese los cubos sin resistencia.","Machaca con un tenedor hasta formar una compota espesa, sin usar licuadora ni procesador.","Deja enfriar hasta que esté tibia, probando la temperatura en el dorso de la mano.","Sirve en cucharadas pequeñas, probando la temperatura en el dorso de la mano antes de ofrecérsela al bebé."]},{"id":1133,"name":"Banana con Yogur y Canela","icon":"🍌","time":"~5 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/35663668/pexels-photo-35663668.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 banana (plátano) madura, picada en trocitos pequeños","2 cucharadas de yogur natural entero, sin azúcar","1 pizca de canela en polvo"],"tip":"Yogur natural entero → jocoque o cuajada casera sin sal, en la misma cantidad.","steps":["Pica la banana madura en trocitos pequeños y suaves, fáciles de aplastar entre los dedos.","Mezcla 2 cucharadas de yogur natural entero, sin azúcar, con los trocitos de banana.","Termina con una pizca de canela en polvo por encima.","Sirve al momento, frío o a temperatura ambiente, para que el niño coma con cuchara o con las manos.","No guardes las sobras que ya tocaron la boca del niño."],"alerta":"Ofrece yogur solo a partir de los 10 meses y siempre natural, entero y sin azúcar."},{"id":1134,"name":"Puré de Frambuesa con Yogur","icon":"🍓","time":"~10 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/7937391/pexels-photo-7937391.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de frambuesas frescas","2 cucharadas de yogur natural entero, sin azúcar"],"tip":"Frambuesa → mora muy madura, en la misma cantidad.","steps":["Lava bien las frambuesas y machácalas con un tenedor hasta formar un puré.","Pásalas por un colador fino si quieres quitar las semillitas, para que la pulpa quede más lisa.","Mezcla 2 cucharadas de yogur natural entero, sin azúcar, con el puré de frambuesa.","Sirve al momento, frío o a temperatura ambiente.","Desecha lo que sobre después de unas horas fuera del refrigerador."],"alerta":"Ofrece yogur solo a partir de los 10 meses y siempre natural, entero y sin azúcar."},{"id":1135,"name":"Ensalada de Frutas Cítricas","icon":"🍊","time":"~10 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/3385449/pexels-photo-3385449.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 naranja, en gajos sin semillas y sin piel, picados","1 mandarina, en gajos sin semillas y sin piel, picados"],"tip":"Naranja → otra mandarina, en la misma cantidad.","steps":["Pela la naranja y la mandarina y separa los gajos.","Quita con cuidado toda la piel blanca que envuelve cada gajo y todas las semillas.","Pica los gajos en trozos pequeños, fáciles de aplastar entre los dedos.","Sirve al momento, en un tazón pequeño, para que el niño coma con la pinza de los dedos.","Acompáñalo durante toda la comida, porque algún pedacito de piel o semilla puede pasar sin que lo veas."],"alerta":"Quita toda la piel y las semillas de los gajos de cítricos antes de servir; pueden causar atragantamiento."},{"id":1136,"name":"Puré de Nectarina","icon":"🍑","time":"~10 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/9590263/pexels-photo-9590263.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 nectarina madura, sin cáscara y sin hueso"],"tip":"Nectarina → durazno maduro, en la misma cantidad.","steps":["Lava la nectarina y quítale la cáscara y el hueso.","Machaca la pulpa bien madura con un tenedor hasta formar un puré espeso y parejo.","No hace falta cocinarla si la fruta está bien madura y suave.","Sirve a temperatura ambiente, en cucharadas pequeñas.","Ofrécelo en cuanto lo prepares, porque la fruta se oscurece rápido."]},{"id":1137,"name":"Mezcla de Frutas Secas Hidratadas","icon":"🍇","time":"~2 horas (hidratación)","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/5425018/pexels-photo-5425018.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["3 chabacanos (damascos) secos, sin hueso","3 ciruelas pasas, sin hueso","1 taza de agua tibia para hidratar"],"tip":"Chabacano seco → dátil sin hueso bien hidratado y picado, en la misma cantidad.","steps":["Pon los chabacanos secos y las ciruelas pasas a remojar en 1 taza de agua tibia unas 2 horas, hasta que estén muy suaves.","Escurre el agua y pica las frutas muy pequeñas o machácalas con un tenedor hasta formar una pasta.","Nunca sirvas la fruta seca entera ni en trozos grandes, porque queda pegajosa y difícil de masticar aunque esté hidratada.","Sirve poquita cantidad, en cucharadas pequeñas, a temperatura ambiente.","Acompaña al niño todo el tiempo que esté masticando, sentado y sin prisa."],"alerta":"Las frutas secas son pegajosas y difíciles de masticar; hidrátalas bien y pícalas o machácalas siempre, nunca las ofrezcas enteras ni en trozos grandes."},{"id":1138,"name":"Puré de Carambola","icon":"⭐","time":"~10 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/7236893/pexels-photo-7236893.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 carambola madura, sin semillas"],"tip":"Carambola → manzana cocida y machacada, en la misma cantidad.","steps":["Lava bien la carambola y quita los bordes si están duros y todas las semillas.","Córtala en rebanadas finas y machácala con un tenedor hasta formar un puré espeso que se queda en la cuchara sin escurrir.","Si la prefieres más suave, cocina las rebanadas al vapor unos 3 minutos antes de machacarlas.","Nunca uses licuadora ni procesador; el puré debe quedar siempre machacado con tenedor.","Sirve tibio o a temperatura ambiente, en cucharadas pequeñas, en cuanto lo prepares."],"alerta":"Quita todas las semillas antes de machacar."},{"id":1139,"name":"Brochetita de Melón y Uva sin Semillas","icon":"🍈","time":"~10 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/6043408/pexels-photo-6043408.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 taza de melón cortado en cubos pequeños","8 uvas sin semillas, cortadas en cuatro a lo largo"],"tip":"Melón → papaya en cubos, en la misma cantidad.","steps":["Corta el melón en cubos pequeños, sin cáscara, de un tamaño fácil de agarrar con la mano.","Corta cada uva en cuatro a lo largo, nunca en rodajas.","Si quieres armar una brochetita para que se vea bonita, usa un palito de plástico sin punta solo para que lo manejen los adultos.","Antes de servirle al bebé, saca todos los trozos del palito y ponlos sueltos en el plato.","Sirve los trozos sueltos, a temperatura ambiente, con supervisión todo el tiempo que dure la comida."],"alerta":"Las uvas tienen que estar siempre cortadas en cuatro a lo largo, nunca en rodajas, y el bebé nunca debe recibir el palito."}],"3":[{"id":1200,"name":"Croquetitas de Arroz al Horno","icon":"🍙","time":"~30 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/17593643/pexels-photo-17593643.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 10 croquetitas (5 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arroz bien cocido y frío","1 huevo entero","2 cucharadas de queso fresco blanco rallado, bajo en sodio (opcional)"],"tip":"Queso blanco → se puede omitir sin afectar la receta. Evita el parmesano y el queso rallado de sobre, demasiado salados para esta edad.","steps":["Mezcla el arroz con el huevo batido y el queso, si lo usas, hasta formar una masa húmeda y pareja.","Con las manos ligeramente mojadas, forma bolitas del tamaño de una aceituna grande y aplana cada una con la palma de la mano hasta formar un disco delgado: nunca las dejes en forma de esfera.","Acomódalas en una bandeja engrasada y hornea en horno precalentado a 190°C unos 15 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se enfríen por completo a temperatura ambiente antes de guardarlas.","Guárdalas en un recipiente bien cerrado; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas y cómelas en 1 día o menos."],"alerta":"Aplana bien las croquetitas en forma de disco, nunca en esferas redondas; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas."},{"id":1201,"name":"Palitos de Camote al Horno","icon":"🍟","time":"~25 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/13428154/pexels-photo-13428154.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unos 8 palitos (4 porciones)","ageRec":"A partir de los 8 meses","ingredients":["1 camote (batata) mediano, sin cáscara, cortado en palitos gruesos del tamaño de un dedo de adulto","1 chorrito de aceite de oliva (más o menos 1 cucharadita)"],"tip":"Camote → papa en palitos, con la misma preparación.","steps":["Lava y corta el camote en palitos gruesos, del tamaño de un dedo de adulto, sin cáscara.","Acomoda los palitos en una bandeja para horno, rocíalos con el aceite de oliva y repártelo bien.","Hornea a 200°C unos 20 minutos, hasta que un tenedor los atraviese fácilmente y los palitos estén lo bastante suaves para aplastarse entre los dedos.","Deja que se enfríen por completo antes de guardarlos.","Guárdalos en un recipiente cerrado; como no llevan huevo, carne ni pescado, pueden quedarse a temperatura ambiente unas horas, pero lo ideal es comerlos el mismo día."],"alerta":"Los palitos tienen que quedar muy suaves, aplastándose con facilidad entre los dedos, antes de servirlos."},{"id":1202,"name":"Muffin Salado de Zanahoria y Queso","icon":"🧁","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/17741888/pexels-photo-17741888.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 6 muffins (6 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 taza de harina de avena","2 huevos","1/2 taza de zanahoria rallada fina","2 cucharadas de queso fresco blanco rallado, bajo en sodio"],"tip":"Queso fresco blanco → ricota aplastada, en la misma cantidad. Evita el parmesano y el queso rallado de sobre, demasiado salados para esta edad.","steps":["En un tazón, mezcla la harina de avena, los huevos batidos, la zanahoria rallada y el queso hasta formar una masa pareja y sin grumos.","Reparte la masa en moldes para muffin engrasados, llenándolos hasta 2/3 de su altura.","Hornea a 180°C unos 20 minutos, hasta que se doren por encima y un palillo salga limpio del centro.","Deja que se enfríen por completo sobre una rejilla antes de guardarlos.","Corta cada muffin en trozos pequeños y suaves al momento de servir.","Guarda el resto en un recipiente cerrado; como llevan huevo y queso, no los dejes fuera del refrigerador más de 2 horas."],"alerta":"Corta el muffin en trozos pequeños antes de servir; como lleva huevo, no puede quedarse horas fuera del refrigerador."},{"id":1203,"name":"Croquetas de Pollo al Horno","icon":"🍗","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/27609407/pexels-photo-27609407.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 8 croquetas (4 porciones)","ageRec":"A partir de los 10 meses","ingredients":["200 g de pollo cocido y deshebrado","1 papa pequeña cocida y aplastada","1 huevo"],"tip":"Pollo → carne molida magra bien cocida, en la misma cantidad.","steps":["Mezcla el pollo deshebrado, la papa aplastada y el huevo batido hasta formar una masa que se moldee bien.","Con las manos húmedas, forma croquetas alargadas y delgadas, del tamaño de un dedo de niño.","Acomódalas en una bandeja engrasada y hornea a 190°C unos 18 minutos, hasta que se doren por fuera y queden suaves por dentro.","Deja que se enfríen por completo antes de guardarlas.","Guárdalas en un recipiente bien cerrado; como llevan pollo y huevo, no las dejes fuera del refrigerador más de 2 horas y cómelas en 1 día o menos."],"alerta":"Como llevan pollo y huevo, no dejes las croquetas fuera del refrigerador más de 2 horas después de hechas."},{"id":1204,"name":"Barritas Caseras de Avena y Banana","icon":"🍫","time":"~30 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/3065512/pexels-photo-3065512.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 8 barritas (8 porciones)","ageRec":"A partir de los 10 meses","ingredients":["2 bananas (plátanos) maduras aplastadas","1 y 1/2 taza de avena en hojuelas","1 cucharada de crema de cacahuate lisa (opcional, según lo que indique tu pediatra sobre alérgenos)"],"tip":"Crema de cacahuate → se puede omitir, agregando un poco más de banana.","steps":["Mezcla las bananas aplastadas con la avena y la crema de cacahuate, si la usas, hasta formar una masa húmeda y pareja.","Extiende la masa en un molde pequeño engrasado, en una capa de unos 2 cm de alto.","Hornea a 180°C por 20 minutos, hasta que se dore ligeramente en las orillas y esté firme al tacto.","Deja que se enfríe por completo en el molde antes de cortarla.","Córtala en barritas suaves, del tamaño de un dedo, y revisa que se aplasten con facilidad entre los dedos antes de guardarlas.","Guárdalas en un recipiente cerrado y, de preferencia, cómelas en 2 días o menos."],"alerta":"La barrita tiene que quedar lo bastante suave para aplastarse entre los dedos; si queda dura como galleta, hornéala menos tiempo."},{"id":1205,"name":"Sandwichito Divertido de Pollo y Zanahoria","icon":"🥪","time":"~10 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/29747752/pexels-photo-29747752.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 rebanadas de pan integral muy suave","3 cucharadas de pollo cocido y deshebrado (sin sal)","2 cucharadas de zanahoria rallada muy fina"],"tip":"Pan integral → pan sin gluten, si hace falta.","steps":["Mezcla el pollo deshebrado, sin sal, con la zanahoria rallada muy fina.","Unta la mezcla sobre una rebanada de pan integral suave, sin corteza dura.","Cúbrela con la otra rebanada y presiona un poco.","Córtalo en tiras largas y delgadas, fáciles de agarrar con la mano para el niño.","Guárdalo en un recipiente cerrado; como lleva pollo, no lo dejes fuera del refrigerador más de 2 horas."],"alerta":"Usa siempre pan suave, sin corteza dura; como lleva pollo, no lo dejes fuera del refrigerador más de 2 horas."},{"id":1206,"name":"Croquetitas de Garbanzo al Horno","icon":"🧆","time":"~30 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/6631954/pexels-photo-6631954.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 10 croquetitas (5 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 taza de garbanzos bien cocidos y aplastados","1 huevo","2 cucharadas de avena en hojuelas finas"],"tip":"Garbanzos → lentejas bien cocidas y aplastadas, en la misma cantidad.","steps":["Mezcla los garbanzos aplastados con el huevo batido y la avena, hasta lograr una masa que no se pegue en las manos.","Forma bolitas pequeñas, del tamaño de una aceituna, y aplana cada una con la palma de la mano hasta que quede un disco delgado.","Acomódalas en una bandeja engrasada y hornea a 190°C unos 18 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se enfríen por completo antes de guardarlas.","Guárdalas en un recipiente cerrado; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas."],"alerta":"Aplana bien las croquetitas en forma de disco, nunca en esferas redondas, para evitar el riesgo de atragantamiento."},{"id":1207,"name":"Enrollado de Pollo y Zanahoria","icon":"🌯","time":"~25 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/36672490/pexels-photo-36672490.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 enrollado (4 porciones)","ageRec":"A partir de los 8 meses","ingredients":["2 huevos","1/2 taza de pollo cocido y deshebrado","2 cucharadas de zanahoria rallada"],"tip":"Pollo → ricota aplastada, para una versión vegetariana.","steps":["Bate los huevos y viértelos en un sartén antiadherente engrasado, formando una tortilla delgada, y cocina a fuego bajo hasta que esté firme de los dos lados.","Reparte encima el pollo deshebrado mezclado con la zanahoria rallada.","Enrolla la tortilla con cuidado, como un brazo de reina, y deja que se entibie antes de cortarla.","Córtala a lo largo, en tiras, nunca en rodajas redondas.","Deja que se enfríe por completo antes de guardarla en un recipiente cerrado; como lleva huevo y pollo, no la dejes fuera del refrigerador más de 2 horas."],"alerta":"Córtalo siempre en tiras a lo largo, nunca en rodajas redondas, para evitar atragantamientos."},{"id":1208,"name":"Bolitas de Arroz con Verduras","icon":"🍙","time":"~30 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/17692189/pexels-photo-17692189.png?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 10 bolitas (5 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arroz bien cocido","2 cucharadas de verduras ya cocidas y picadas muy menuditas (zanahoria, arvejas)","1 huevo"],"tip":"Verduras → usa las que tengas en casa, siempre bien cocidas y picadas finitas.","steps":["Mezcla el arroz, las verduras muy menuditas y el huevo batido hasta formar una masa pareja.","Forma bolitas pequeñas y aplana cada una con la palma de la mano, formando discos delgados.","Acomódalas en una bandeja engrasada y hornea a 190°C unos 15 minutos, hasta que se doren por fuera.","Deja que se enfríen por completo antes de guardarlas.","Guárdalas en un recipiente cerrado; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas."],"alerta":"Aplana las bolitas en forma de disco, nunca en esferas redondas."},{"id":1209,"name":"Barra de Cereal Casera sin Azúcar","icon":"🍫","time":"~30 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/14387798/pexels-photo-14387798.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 8 barritas (8 porciones)","ageRec":"A partir de los 12 meses","ingredients":["1 y 1/2 taza de avena en hojuelas","2 bananas (plátanos) maduras aplastadas","2 cucharadas de pasas picadas muy menuditas"],"tip":"Pasas → chabacano (durazno) seco picado muy menudito, en la misma cantidad.","steps":["Mezcla la avena con las bananas aplastadas y las pasas picadas muy menuditas, hasta formar una masa húmeda y pareja.","Extiéndela en un molde pequeño engrasado, en una capa de unos 2 cm.","Hornea a 180°C por 20 minutos, hasta que se dore ligeramente en las orillas y esté firme al tacto.","Deja que se enfríe por completo en el molde antes de cortarla.","Córtala en barritas suaves que se aplasten con facilidad entre los dedos antes de guardarlas.","Guárdalas en un recipiente cerrado y, de preferencia, cómelas en 2 días o menos."],"alerta":"Las pasas tienen que estar picadas muy menuditas, nunca enteras, para evitar atragantamientos."},{"id":1210,"name":"Palitos de Zanahoria Cocida","icon":"🥕","time":"~15 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/6546434/pexels-photo-6546434.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unos 8 palitos (4 porciones)","ageRec":"A partir de los 8 meses","ingredients":["2 zanahorias cortadas en palitos gruesos del tamaño de un dedo de adulto","1 chorrito de aceite de oliva"],"tip":"Zanahoria → calabacita en palitos, con la misma preparación.","steps":["Corta las zanahorias en palitos gruesos, del tamaño de un dedo de adulto.","Cocínalas al vapor unos 12 minutos, hasta que un tenedor las atraviese fácilmente y los palitos estén lo bastante suaves para aplastarse entre los dedos.","Rocía el chorrito de aceite de oliva sobre los palitos todavía calientes, lo que ayuda a absorber las vitaminas de la zanahoria.","Deja que se entibien por completo antes de guardarlos, y no los guardes calientes para que no se forme vapor en el recipiente.","Guárdalos en un recipiente cerrado; como no llevan huevo, carne ni pescado, pueden quedarse fuera del refrigerador unas horas, pero lo ideal es comerlos el mismo día."],"alerta":"Los palitos tienen que quedar muy suaves, aplastándose con facilidad entre los dedos, antes de servirlos."},{"id":1211,"name":"Bolitas de Papa con Pollo","icon":"🥔","time":"~30 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/30648979/pexels-photo-30648979.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 8 bolitas (4 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 papa cocida y aplastada","3 cucharadas de pollo cocido y deshebrado","1 huevo"],"tip":"Pollo → carne molida bien cocida, en la misma cantidad.","steps":["Mezcla la papa aplastada, el pollo deshebrado y el huevo batido hasta formar una masa pareja.","Forma bolitas pequeñas y aplana cada una con la palma de la mano, formando discos delgados.","Acomódalas en una bandeja engrasada y hornea a 190°C unos 18 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se enfríen por completo antes de guardarlas.","Guárdalas en un recipiente cerrado; como llevan pollo y huevo, no las dejes fuera del refrigerador más de 2 horas."],"alerta":"Aplana las bolitas en forma de disco, nunca en esferas redondas; como llevan pollo y huevo, no las dejes fuera del refrigerador más de 2 horas."},{"id":1212,"name":"Sándwich de Hummus y Pepino","icon":"🥒","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/9012028/pexels-photo-9012028.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 rebanadas de pan integral muy suave","2 cucharadas de hummus casero","1/2 pepino sin semillas, en rebanadas muy finas"],"tip":"Pepino → zanahoria rallada fina, en la misma cantidad.","steps":["Unta el hummus casero sobre una rebanada de pan integral suave.","Acomoda encima las rebanadas muy finas de pepino sin semillas.","Cúbrelo con la otra rebanada de pan y presiona un poco para que el relleno no se salga por las orillas.","Córtalo en tiras largas y delgadas, fáciles de agarrar con la mano.","Guárdalo en un recipiente cerrado para llevarlo, manteniendo el sándwich fresco hasta la hora de servir."],"alerta":"Usa siempre pan suave, sin corteza dura, y corta el pepino en rebanadas muy finas."},{"id":1213,"name":"Panquequitos de Banana para Llevar","icon":"🥞","time":"~15 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/14263510/pexels-photo-14263510.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unos 6 panquequitos (3 porciones)","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) madura aplastada","1 huevo","3 cucharadas de avena en hojuelas finas"],"tip":"Avena → harina de arroz, para una versión sin gluten.","steps":["Bate la banana aplastada con el huevo y la avena, hasta formar una masa pareja y sin grumos.","Engrasa un sartén antiadherente y vierte porciones pequeñas de la masa, del tamaño de una cucharada.","Cocina a fuego bajo hasta que aparezcan burbujas en la superficie, entonces voltéalos y dora el otro lado unos 2 minutos.","Deja que se enfríen por completo y corta cada panquequito en tiras: nunca sirvas el disco entero.","Guárdalos en un recipiente cerrado; como llevan huevo, no los dejes fuera del refrigerador más de 2 horas."],"alerta":"Corta el panquequito en tiras antes de servir; como lleva huevo, no lo dejes fuera del refrigerador más de 2 horas."},{"id":1214,"name":"Mini Muffins de Manzana y Avena","icon":"🧁","time":"~25 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/38939113/pexels-photo-38939113.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 8 mini muffins (8 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 manzana rallada fina","1 taza de avena en hojuelas finas","2 huevos"],"tip":"Avena en hojuelas → harina de avena, en la misma cantidad.","steps":["Mezcla la manzana rallada con la avena y los huevos batidos, hasta formar una masa pareja.","Reparte la masa en moldes para mini muffin engrasados, llenándolos hasta 2/3 de su altura.","Hornea a 180°C unos 18 minutos, hasta que se doren por encima y un palillo salga limpio del centro.","Deja que se enfríen por completo sobre una rejilla antes de guardarlos.","Corta cada mini muffin a la mitad antes de servir, porque la forma redondeada entera es riesgo de atragantamiento.","Guárdalos en un recipiente cerrado; como llevan huevo, no los dejes fuera del refrigerador más de 2 horas."],"alerta":"Corta el mini muffin a la mitad antes de servir; como lleva huevo, no lo dejes fuera del refrigerador más de 2 horas."},{"id":1215,"name":"Bolitas de Camote con Queso al Horno","icon":"🍠","time":"~35 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/37332306/pexels-photo-37332306.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 8 bolitas (4 porciones)","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) cocido y aplastado","2 cucharadas de queso cottage","1 huevo"],"tip":"Queso cottage → ricota aplastada, en la misma cantidad.","steps":["Mezcla el camote aplastado, el queso cottage y el huevo batido hasta formar una masa pareja.","Forma bolitas pequeñas y aplana cada una con la palma de la mano, formando discos delgados.","Acomódalas en una bandeja engrasada y hornea a 190°C unos 18 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se enfríen por completo antes de guardarlas.","Guárdalas en un recipiente cerrado; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas."],"alerta":"Aplana las bolitas en forma de disco, nunca en esferas redondas; como llevan huevo, no las dejes fuera del refrigerador más de 2 horas."},{"id":1216,"name":"Chips de Manzana al Horno","icon":"🍎","time":"~1h 30min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/39209381/pexels-photo-39209381.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unos 20 chips (5 porciones para llevar en la pañalera)","ageRec":"A partir de los 10 meses","ingredients":["1 manzana mediana sin semillas, cortada en rebanadas muy finas (de 2 a 3 mm)","1 pizca de canela en polvo"],"tip":"Manzana → pera, con la misma preparación, quitando bien las semillas.","steps":["Corta la manzana en rebanadas muy finas, de 2 a 3 milímetros, con una mandolina o un cuchillo afilado.","Acomoda las rebanadas una al lado de la otra en una bandeja forrada con papel para hornear, sin encimarlas.","Espolvorea la canela encima y hornea a 100°C más o menos 1 hora y 30 minutos, volteando las rebanadas a la mitad del tiempo.","Los chips están listos cuando se sienten secos al tacto, pero todavía flexibles: nunca crujientes como los de adulto.","Deja que se enfríen por completo sobre una rejilla antes de guardarlos en el recipiente, para que no se forme humedad.","Sírvelos en trozos pequeños y supervisa la masticación, aunque estén suaves."],"alerta":"Las rebanadas tienen que quedar suaves y flexibles, nunca duras ni quebradizas, para que no sean riesgo de atragantamiento."},{"id":1217,"name":"Wrap para Llevar de Hummus y Zanahoria","icon":"🌯","time":"~10 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/35440206/pexels-photo-35440206.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 wrap, cortado en 6 a 8 tiras","ageRec":"A partir de los 12 meses","ingredients":["1 tortilla integral pequeña (de unos 15 cm)","2 cucharadas de hummus casero","3 cucharadas de zanahoria rallada fina"],"tip":"Tortilla integral → rebanada de pan integral sin corteza, con la misma preparación.","steps":["Unta las 2 cucharadas de hummus por toda la tortilla, hasta la orilla.","Reparte la zanahoria rallada fina encima del hummus.","Enrolla la tortilla bien apretada, como un taco largo.","Córtala en tiras largas de más o menos un dedo de ancho, nunca en rodajas redondas.","Envuelve cada tira en plástico autoadherente o en un recipiente pequeño para llevarla."],"alerta":"Córtalo siempre en tiras largas: las rodajas del wrap enrollado quedan redondas y del tamaño de la vía respiratoria, con riesgo de atragantamiento."},{"id":1218,"name":"Galletitas Planas de Camote con Avena","icon":"🍠","time":"~30 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/8112780/pexels-photo-8112780.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde unas 10 galletitas","ageRec":"A partir de los 8 meses","ingredients":["1 camote (batata) mediano cocido y bien aplastado (más o menos 1 taza)","2 cucharadas de avena en hojuelas finas"],"tip":"Avena en hojuelas finas → harina de arroz, en la misma cantidad.","steps":["Aplasta el camote todavía tibio con un tenedor hasta que quede muy liso, más o menos 1 taza.","Mezcla la avena poco a poco hasta formar una masa que no se pegue en las manos.","Forma porciones aplanadas, en forma de galletita o de bastón, nunca bolitas redondas.","Acomódalas en una bandeja forrada y hornea a 180°C unos 20 minutos, hasta que estén ligeramente firmes.","Deja que se entibien sobre una rejilla antes de guardarlas para llevar en la pañalera."],"alerta":"Dales siempre forma plana, nunca de bolita redonda: la forma de bola es la que más atraganta a esta edad."},{"id":1219,"name":"Mini Sándwich de Atún con Zanahoria","icon":"🥪","time":"~10 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/38578723/pexels-photo-38578723.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 sándwich, cortado en 4 tiras","ageRec":"A partir de los 12 meses","ingredients":["2 rebanadas de pan integral","1/2 lata pequeña de atún en agua, bien escurrido (más o menos 3 cucharadas)","2 cucharadas de zanahoria rallada fina"],"tip":"Atún → pollo cocido y deshebrado, en la misma cantidad.","steps":["Escurre bien el atún y aplástalo con un tenedor hasta desmenuzarlo.","Mezcla el atún desmenuzado con la zanahoria rallada fina.","Rellena las dos rebanadas de pan integral con la mezcla.","Corta el sándwich en tiras largas, fáciles de agarrar con la mano.","Guárdalo en un recipiente térmico o en una bolsa térmica y sírvelo en 2 horas o menos: no lo dejes fuera del refrigerador por más tiempo."],"alerta":"El atún se da solo a partir de los 12 meses y como máximo 1 vez por semana; como lleva pescado, no dejes el sándwich horas fuera del refrigerador antes de servirlo."}],"7":[{"id":1600,"name":"Pasta de Colores para la Familia","icon":"🍝","time":"~25 min","kcal":"210 kcal (estimado)","img":"https://images.pexels.com/photos/6952392/pexels-photo-6952392.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["1 taza de pasta corta (tipo tornillo) ya cocida","1/2 taza de salsa de tomate casera (sin sal)","4 albóndigas de pollo pequeñas, ya listas (ver receta de bono), cortadas a la mitad","1 cucharada de queso fresco rallado, bajo en sodio"],"tip":"Albóndigas de pollo → carne molida magra salteada y desmenuzada, en la misma cantidad.","steps":["Cocina la pasta en agua hasta que esté bien suave al morder, unos 2 minutos más de lo que indica el paquete.","Corta la pasta en trozos cortos, de 2 a 3 centímetros como máximo, para evitar tiras largas.","Mezcla la pasta picada con la salsa de tomate casera tibia.","Corta las albóndigas de pollo a la mitad o en cuartos antes de mezclarlas con el plato.","Termina con el queso fresco rallado por encima y sirve tibio."],"alerta":"Corta siempre la pasta en trozos cortos y las albóndigas a la mitad: las tiras largas y las bolitas enteras son riesgo de atragantamiento."},{"id":1601,"name":"Pollo Empanizado al Horno","icon":"🍗","time":"~25 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/11710530/pexels-photo-11710530.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["2 filetes de pollo cortados en tiras (del tamaño de un dedo)","1 huevo batido","1/2 taza de pan rallado integral"],"tip":"Pan rallado → harina de avena fina, en la misma cantidad.","steps":["Pasa cada tira de pollo por el huevo batido y después por el pan rallado, cubriéndola bien.","Acomoda las tiras en una bandeja para horno engrasada, sin que se toquen entre sí.","Hornea a 200 °C unos 20 minutos, dándoles la vuelta a la mitad del tiempo, hasta que estén doradas por fuera.","Revisa que el pollo esté bien cocido por dentro, sin partes rosadas, antes de servir.","Sirve tibio, acompañado de verduras cocidas suaves."],"alerta":"Revisa que el centro del pollo esté totalmente blanco y sin partes crudas antes de ofrecerlo."},{"id":1602,"name":"Arroz al Horno con Verduras","icon":"🍚","time":"~35 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/7660429/pexels-photo-7660429.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 4 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz ya cocido","1/2 taza de verduras picadas muy pequeñas (zanahoria, arvejas (chícharos), maíz)","2 huevos batidos","1 cucharada de queso fresco rallado, bajo en sodio (opcional)"],"tip":"Queso fresco rallado → puedes omitirlo sin que la receta pierda nada.","steps":["Mezcla en un bol el arroz cocido, las verduras picadas muy pequeñas y los huevos batidos.","Vierte la mezcla en una fuente engrasada y espárcela en una capa de unos 2 centímetros.","Espolvorea el queso fresco por encima, si lo vas a usar.","Lleva al horno a 190 °C unos 20 minutos, hasta que se dore un poco y esté firme al tacto.","Deja entibiar y corta en cuadritos pequeños antes de servir."],"alerta":"Pica bien los granos de maíz y las arvejas antes de hornear, para reducir el riesgo de atragantamiento con trozos enteros."},{"id":1603,"name":"Albóndigas en Salsa Roja","icon":"🍖","time":"~30 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/17989471/pexels-photo-17989471.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 3 porciones infantiles (unas 8 albóndigas)","ageRec":"A partir de los 18 meses","ingredients":["200 g de carne molida magra","1 huevo","1 taza de salsa de tomate casera","1 cucharada de hierbas frescas picadas (perejil o albahaca)"],"tip":"Carne molida → pollo molido, en la misma cantidad.","steps":["Mezcla la carne molida, el huevo y las hierbas hasta tener una masa uniforme.","Forma bolitas pequeñas, del tamaño de una aceituna grande.","Cocina las albóndigas directamente en la salsa de tomate, a fuego bajo, unos 20 minutos, hasta que estén bien cocidas.","Revisa que no queden partes rosadas en el centro de las albóndigas antes de servir.","Corta cada albóndiga a la mitad o en cuartos al momento de servir, nunca entera."],"alerta":"Corta siempre las albóndigas a la mitad antes de servir: enteras son redondas y del tamaño de la vía respiratoria del niño."},{"id":1604,"name":"Panqueques Americanos Saludables","icon":"🥞","time":"~15 min","kcal":"155 kcal (estimado)","img":"https://images.pexels.com/photos/6758384/pexels-photo-6758384.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles (unos 4 panqueques pequeños)","ageRec":"A partir de los 12 meses","ingredients":["1 banana (plátano) mediana bien madura, machacada","1 huevo","1/2 taza de harina de avena","1 cucharadita de polvo para hornear"],"tip":"Harina de avena → harina de arroz, para una versión sin gluten.","steps":["Machaca la banana con un tenedor hasta que quede bien lisa.","Mezcla la banana, el huevo, la harina de avena y el polvo para hornear hasta tener una masa pareja, sin grumos.","Vierte porciones pequeñas (unas 2 cucharadas) en un sartén antiadherente engrasado, a fuego bajo.","Dale la vuelta al panqueque cuando salgan burbujas en la superficie y dóralo del otro lado por 1 minuto más o menos.","Corta en trozos pequeños y sirve tibio, con fruta picada por encima."]},{"id":1605,"name":"Pescado al Horno con Papas","icon":"🐟","time":"~35 min","kcal":"215 kcal (estimado)","img":"https://images.pexels.com/photos/34624944/pexels-photo-34624944.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 filete de pescado blanco (tilapia o merluza), sin espinas","1 papa mediana cortada en rodajas finas","1 cucharadita de aceite de oliva","1 cucharadita de hierbas frescas picadas (perejil o cebollín)"],"tip":"Pescado blanco → filete de pollo cocido en tiras, con la misma preparación.","steps":["Acomoda las rodajas de papa en una bandeja para horno y rocíalas con el aceite de oliva.","Lleva al horno a 200 °C por 15 minutos, hasta que las papas empiecen a ablandarse.","Pasa los dedos sobre el filete de pescado crudo, apretando suavemente, para buscar y quitar cualquier espina.","Coloca el pescado sobre las papas, espolvorea las hierbas y vuelve al horno 15 minutos más, hasta que el pescado se deshaga fácil con el tenedor.","Desmenuza el pescado en lascas pequeñas, revisando una vez más que no haya espinas, y sirve tibio."],"alerta":"Revisa el filete de pescado dos veces, antes y después de hornear, para asegurarte de que no quedó ninguna espina."},{"id":1606,"name":"Ñoquis en Salsa Blanca Ligera","icon":"🍝","time":"~35 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/9546272/pexels-photo-9546272.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["1 taza de ñoquis de papa caseros (o listos, sin sal)","1 taza de leche","1 cucharada de harina de trigo","1 cucharada de queso fresco rallado, bajo en sodio"],"tip":"Leche → bebida vegetal sin azúcar, en la misma cantidad.","steps":["Cocina los ñoquis en agua hirviendo hasta que todos suban a la superficie, señal de que están suaves por dentro.","En una olla aparte, mezcla la leche y la harina a fuego bajo, sin dejar de mover, hasta que espese en una crema lisa.","Agrega el queso fresco rallado a la crema y mezcla hasta que se derrita.","Corta cada ñoqui a la mitad antes de mezclarlo con la salsa, para deshacer la forma redonda.","Sirve la salsa sobre los ñoquis, tibia, en porciones pequeñas."],"alerta":"Corta siempre los ñoquis a la mitad: enteros son redondos y del tamaño de la vía respiratoria del niño."},{"id":1607,"name":"Pollo Salteado con Pimiento, Suave y Casero","icon":"🍗","time":"~25 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/27588097/pexels-photo-27588097.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 2 años","ingredients":["1 filete de pollo cortado en cubos pequeños","1/2 pimiento picado muy fino","1/2 cebolla picada muy fina","1 cucharadita de aceite de oliva"],"tip":"Pimiento → zanahoria picada muy fina, para una versión más suave.","steps":["Sofríe la cebolla y el pimiento en el aceite de oliva a fuego medio hasta que se ablanden, unos 5 minutos.","Agrega el pollo en cubos pequeños y cocina hasta que se dore por fuera.","Baja el fuego y sigue cocinando 5 minutos más, hasta que no quede ninguna parte rosada en el pollo.","Revisa que el pimiento esté bien suave antes de apagar el fuego.","Sirve tibio, con arroz, en porciones pequeñas, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":1608,"name":"Pastel de Licuadora con Verduras","icon":"🥧","time":"~40 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/6163259/pexels-photo-6163259.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 4 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["3 huevos","1 taza de leche","1 y 1/2 taza de harina de trigo","1 taza de verduras picadas muy pequeñas (zanahoria, calabacita (zucchini), maíz)"],"tip":"Harina de trigo → harina de avena, para una versión sin gluten.","steps":["Licúa los huevos, la leche y la harina hasta formar una crema lisa, sin grumos.","Agrega las verduras picadas muy pequeñas a la crema y mezcla con una cuchara.","Vierte en un molde engrasado, en una capa de unos 3 centímetros.","Hornea a 190 °C unos 30 minutos, hasta que se dore por encima y esté firme al tacto en el centro.","Deja entibiar y corta en trozos pequeños, sin la orilla crujiente, antes de servir."],"alerta":"Pica el maíz y las demás verduras muy pequeños antes de mezclar, para que no queden trozos enteros en el pastel."},{"id":1609,"name":"Ensalada de Garbanzos con Verduras","icon":"🥗","time":"~15 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/6750382/pexels-photo-6750382.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["1 taza de garbanzos cocidos","1/2 zanahoria rallada fina","1/2 pepino sin semillas, picado muy pequeño","1 cucharadita de aceite de oliva"],"tip":"Garbanzos → frijoles (porotos) blancos bien cocidos y machacados, en la misma cantidad.","steps":["Aplasta un poco cada garbanzo entre los dedos, revisando que se deshaga con facilidad.","Mezcla los garbanzos aplastados con la zanahoria rallada y el pepino picado muy pequeño.","Agrega el aceite de oliva y mezcla bien; esto ayuda al cuerpo a aprovechar las vitaminas de las verduras.","Sirve a temperatura ambiente, en porciones pequeñas en la cuchara."],"alerta":"Aplasta cada garbanzo entre los dedos antes de servir: entero y firme, el garbanzo es redondo y puede atragantar."},{"id":1610,"name":"Lasaña de Berenjena con Carne","icon":"🍆","time":"~45 min","kcal":"210 kcal (estimado)","img":"https://images.pexels.com/photos/1707917/pexels-photo-1707917.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 3 porciones infantiles","ageRec":"A partir de los 18 meses","ingredients":["1 berenjena pequeña, en rebanadas finas","200 g de carne molida magra","1 taza de salsa de tomate casera","2 cucharadas de queso fresco rallado, bajo en sodio"],"tip":"Berenjena → calabacita (zucchini) en rebanadas finas, con la misma preparación.","steps":["Asa rápidamente las rebanadas de berenjena por los dos lados, hasta que estén suaves.","Cocina la carne molida en su propio jugo, sin aceite extra, hasta que se dore, y mézclala con la salsa de tomate.","Arma capas alternando berenjena y carne con salsa en una fuente pequeña.","Termina con el queso fresco rallado por encima y lleva al horno a 190 °C por 20 minutos, hasta gratinar.","Deja entibiar y corta en trozos pequeños y suaves antes de servir."]},{"id":1611,"name":"Pollo al Curry Suave con Arroz","icon":"🍛","time":"~30 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/4611425/pexels-photo-4611425.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 2 años","ingredients":["1 filete de pollo en cubos pequeños","1/2 cucharadita de curry suave (sin picante)","1/2 taza de leche de coco sin azúcar","1/2 taza de arroz cocido para acompañar"],"tip":"Curry suave → pimentón dulce, para una versión todavía más ligera para el niño.","steps":["Sofríe el pollo a fuego medio hasta que se dore un poco por fuera.","Agrega el curry suave y la leche de coco, mezclando bien.","Cocina a fuego bajo por 10 minutos, hasta que el pollo esté suave y sin partes crudas en el centro.","Prueba un poquito antes de servir, para confirmar que el sabor está bien suave para el niño.","Sirve tibio, con el arroz abajo o al lado."],"alerta":"Usa el curry en cantidad mínima y sin picante; esta receta no se recomienda antes de los 2 años por el condimento."},{"id":1612,"name":"Ensalada de Colores con Verduras Cocidas","icon":"🥦","time":"~20 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/30635691/pexels-photo-30635691.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de brócoli en arbolitos muy pequeños","1/2 zanahoria cortada en medias lunas finas","2 cucharadas de maíz tierno cocido y machacado","1 cucharadita de aceite de oliva"],"tip":"Brócoli → coliflor en arbolitos pequeños, con la misma preparación.","steps":["Cocina el brócoli y la zanahoria al vapor hasta que estén bien suaves, de 10 a 12 minutos.","Machaca un poco los granos de maíz con un tenedor, para que no queden enteros.","Mezcla las verduras cocidas y el maíz machacado en un bol, repartiendo bien los pedacitos.","Agrega el aceite de oliva y mezcla bien para ayudar a aprovechar las vitaminas de las verduras.","Sirve tibio o a temperatura ambiente, en trozos pequeños que se aplasten entre los dedos."],"alerta":"Corta la zanahoria en medias lunas, nunca en rodajas redondas, y machaca el maíz: los granos enteros y las rodajas son riesgo de atragantamiento."},{"id":1613,"name":"Panqueques de Espinaca con Queso","icon":"🥬","time":"~15 min","kcal":"155 kcal (estimado)","img":"https://images.pexels.com/photos/6947228/pexels-photo-6947228.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles (unos 4 panqueques pequeños)","ageRec":"A partir de los 12 meses","ingredients":["1 taza de espinaca picada","2 huevos","3 cucharadas de harina de avena","2 cucharadas de queso fresco rallado, bajo en sodio"],"tip":"Espinaca → acelga picada muy fina, en la misma cantidad.","steps":["Bate los huevos con la harina de avena hasta formar una masa lisa, sin grumos.","Agrega la espinaca picada y el queso fresco rallado a la masa.","Vierte porciones pequeñas en un sartén antiadherente engrasado, a fuego bajo.","Dale la vuelta al panqueque cuando esté dorado por abajo, unos 2 minutos, y cocina hasta que se dore del otro lado.","Corta en trozos pequeños y sirve tibio, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":1614,"name":"Pescado a la Plancha con Verduras Salteadas","icon":"🐟","time":"~25 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/16845473/pexels-photo-16845473.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño de pescado blanco sin espinas, tipo tilapia o merluza (unos 100 g)","1/2 taza de calabacita (zucchini) cortada en tiras finas","1/2 taza de zanahoria cocida cortada en tiras finas","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)"],"tip":"Pescado blanco → pollo cocido y desmenuzado, en la misma cantidad, con la misma preparación.","steps":["Pon un chorrito de aceite de oliva al filete de pescado y cocínalo a la plancha a fuego medio unos 4 minutos por lado, hasta que esté dorado y blanco y opaco por dentro.","Desmenuza el pescado todavía tibio y pasa los dedos por toda la porción para asegurarte de que no quedó ninguna espina.","En el mismo sartén, con el aceite que quedó, saltea las tiras de calabacita y zanahoria unos 6 minutos, hasta que estén lo bastante suaves para aplastarse entre los dedos.","Corta las tiras de verdura y el pescado desmenuzado en trozos pequeños, del tamaño que el niño pueda tomar con la mano.","Deja entibiar y sirve probando la temperatura en el dorso de la mano."],"alerta":"Pasa siempre los dedos por toda la porción de pescado para revisar que no quedó ninguna espina antes de servir."},{"id":1615,"name":"Pasta Integral con Salsa de Albahaca y Aceite de Oliva","icon":"🍝","time":"~20 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/28767856/pexels-photo-28767856.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de pasta integral corta (tipo tornillo o penne) ya cocida","1 cucharada de hojas de albahaca fresca picadas","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)","1 cucharada de queso fresco bajo en sodio rallado (opcional)"],"tip":"Albahaca fresca → perejil fresco picado, en la misma cantidad.","steps":["Cocina la pasta integral corta en agua hasta que esté bien suave, unos 10 minutos, y escúrrela.","Corta cada trozo de pasta a la mitad con un cuchillo o unas tijeras, para reducir el riesgo de atragantamiento.","Mezcla la pasta cortada con el aceite de oliva y la albahaca fresca picada.","Si lo usas, termina con el queso fresco rallado por encima, todavía tibio.","Sirve en porción pequeña, tibia, probando la temperatura en el dorso de la mano."],"alerta":"Corta siempre la pasta en trozos cortos antes de servir; la pasta larga entera es riesgo de atragantamiento."},{"id":1616,"name":"Frijoles Negros con Cerdo para la Familia","icon":"🍲","time":"~50 min","kcal":"210 kcal (estimado)","img":"https://images.pexels.com/photos/34442359/pexels-photo-34442359.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de frijoles (porotos) negros cocidos y un poco machacados","3 cucharadas de carne de cerdo magra bien cocida, cortada en cubos pequeños","2 cucharadas de acelga salteada picadita","1/2 taza de arroz blanco cocido"],"tip":"Carne de cerdo → carne de res magra bien cocida, en la misma cantidad.","steps":["Cocina los frijoles negros hasta que los granos estén bien suaves y machaca más o menos la mitad con un tenedor para espesar el caldo, sin dejar líquido de más.","Cocina la carne de cerdo a fuego bajo hasta que esté bien suave y se deshebre con facilidad; después córtala en cubos muy pequeños.","Saltea la acelga picadita de 2 a 3 minutos, solo hasta que se marchite, sin agregar sal ni caldo de cubito.","Arma el plato con el arroz, los frijoles y la carne, mezclando un poco.","Sirve tibio, revisando que los trozos de carne se aplasten con facilidad entre los dedos."],"alerta":"Corta la carne en cubos muy pequeños y confirma que cada trozo se aplasta entre los dedos antes de ofrecerlo."},{"id":1617,"name":"Strogonoff de Pollo Casero","icon":"🍗","time":"~30 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/31233887/pexels-photo-31233887.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["100 g de pechuga de pollo cortada en cubos pequeños","1/2 taza de salsa de tomate casera (sin sal)","2 cucharadas de crema de leche fresca o yogur natural entero","2 cucharadas de champiñones frescos en rebanadas finas (opcional)"],"tip":"Crema de leche fresca → yogur natural entero, en la misma cantidad.","steps":["Cocina los cubos de pollo a fuego medio hasta que se doren un poco y queden totalmente blancos por dentro, sin partes rosadas.","Agrega la salsa de tomate casera y los champiñones en rebanadas, y cocina 8 minutos más hasta que el pollo esté bien suave.","Apaga el fuego e incorpora la crema de leche fresca o el yogur, mezclando hasta integrar.","Corta los cubos de pollo a la mitad, dejando trozos pequeños y fáciles de masticar.","Sirve tibio, acompañado de arroz blanco bien cocido."],"alerta":"Confirma que el pollo esté bien cocido y sin partes rosadas antes de servir; los champiñones, solo a partir de los 12 meses."},{"id":1618,"name":"Puré de Papa con Verduras Salteadas","icon":"🥔","time":"~30 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/36505855/pexels-photo-36505855.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["2 papas pequeñas cocidas y machacadas (cerca de 1 taza de puré)","1/4 taza de zanahoria en cubos pequeños","1/4 taza de ejotes (judías verdes) en cubos pequeños","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)"],"tip":"Ejotes → arvejas (chícharos) cocidas, en la misma cantidad.","steps":["Cocina las papas en agua hasta que un tenedor las atraviese fácil, unos 15 minutos; escúrrelas y machácalas hasta formar un puré cremoso.","Cocina la zanahoria y los ejotes en agua o al vapor hasta que estén bien suaves, unos 8 minutos.","Corta los ejotes y la zanahoria en cubos pequeños, del tamaño que se aplasta fácil entre el pulgar y el índice.","Saltea rápido las verduras ya cocidas en un chorrito de aceite de oliva por 1 minuto, solo para calentarlas.","Sirve las verduras encima o al lado del puré de papa, todavía tibio."],"alerta":"Corta los ejotes y la zanahoria en cubos muy pequeños y confirma que se aplastan entre los dedos antes de servir."},{"id":1619,"name":"Arroz al Horno con Atún","icon":"🐟","time":"~35 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/1122915/pexels-photo-1122915.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de arroz blanco cocido","3 cucharadas de atún en agua, escurrido y desmenuzado","1/4 taza de salsa de tomate casera (sin sal)","1 cucharada de queso fresco bajo en sodio rallado"],"tip":"Atún → pollo cocido y desmenuzado, en la misma cantidad.","steps":["Mezcla el arroz ya cocido con el atún escurrido y desmenuzado y la salsa de tomate casera.","Pon la mezcla en un molde pequeño engrasado y espárcela bien hasta formar una capa pareja.","Espolvorea el queso fresco rallado por encima, cubriendo toda la superficie.","Lleva al horno precalentado a 200 °C unos 15 minutos, hasta que el queso se derrita y se dore un poco.","Deja enfriar hasta que esté tibio antes de servir, probando en el dorso de la mano."],"alerta":"Ofrece atún una vez por semana o menos, y sirve el gratinado solo tibio, nunca caliente."},{"id":1620,"name":"Pastel de Carne con Puré de Papa","icon":"🥘","time":"~40 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/36040894/pexels-photo-36040894.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 papa mediana cocida y machacada (cerca de 1 taza)","100 g de carne molida magra","2 cucharadas de cebolla picadita","2 cucharadas de tomate (jitomate) picadito","2 cucharadas de zanahoria picadita"],"tip":"Papa → camote (batata), en la misma cantidad.","steps":["Cocina la papa en agua hasta que un tenedor la atraviese sin resistencia, unos 15 minutos; escúrrela y machácala bien.","Sofríe la carne molida con la cebolla, el tomate y la zanahoria picaditos hasta que la carne pierda todo el color rosado, unos 10 minutos.","Esparce la carne sofrita en un molde pequeño engrasado.","Cubre toda la carne con la papa machacada, formando una capa pareja.","Lleva al horno precalentado a 190 °C por 15 minutos, hasta que se dore un poco por encima.","Deja entibiar antes de servir en cucharadas pequeñas."],"alerta":"Espera a que el pastel se enfríe hasta estar tibio antes de servir; lo horneado sale muy caliente del horno."},{"id":1621,"name":"Panqueques de Maíz con Queso","icon":"🌽","time":"~20 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/7993304/pexels-photo-7993304.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de maíz tierno cocido y procesado","1 huevo","2 cucharadas de harina de avena","2 cucharadas de queso fresco bajo en sodio (tipo cottage)","1 chorrito de aceite para engrasar el sartén"],"tip":"Harina de avena → harina de arroz, en la misma cantidad.","steps":["Licúa o machaca bien el maíz cocido con el huevo y la harina de avena hasta formar una masa cremosa y pareja.","Mezcla el queso cottage con la masa.","Engrasa un sartén antiadherente con un chorrito de aceite y caliéntalo a fuego medio.","Pon porciones pequeñas de masa en el sartén y cocina unos 2 minutos por lado, hasta que se doren y estén firmes por dentro.","Corta cada panqueque en trozos pequeños y sirve tibio, probando la temperatura en el dorso de la mano."],"alerta":"Cocina hasta que el panqueque esté firme por dentro, sin nada de huevo líquido en el centro."},{"id":1622,"name":"Sopa de Frijoles con Verduras","icon":"🍲","time":"~35 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/30635687/pexels-photo-30635687.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de frijoles (porotos) cocidos","1/4 taza del caldo de los mismos frijoles","1/4 taza de zanahoria en cubos pequeños","1/4 taza de calabacita (zucchini) en cubos pequeños","1/4 taza de papa en cubos pequeños"],"tip":"Frijoles → lentejas cocidas, en la misma cantidad.","steps":["Cocina la zanahoria, la calabacita y la papa en agua hasta que estén bien suaves, unos 12 minutos.","Machaca los frijoles cocidos con un tenedor junto con un poco de su caldo, hasta formar una crema espesa, sin licuar.","Escurre las verduras y córtalas en cubos pequeños, del tamaño que se aplasta entre los dedos.","Mezcla las verduras picadas con la crema de frijoles.","Sirve tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano."],"alerta":"Machaca los frijoles con tenedor en lugar de licuarlos, dejando pedacitos suaves de verdura en la sopa."},{"id":1623,"name":"Bistec Encebollado Suave","icon":"🥩","time":"~20 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/34429591/pexels-photo-34429591.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 bistec pequeño de carne de res suave cortado en tiras finas (unos 100 g)","1/4 de cebolla pequeña en rebanadas finas","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)"],"tip":"Carne de res → filete de pollo cocido, con la misma preparación.","steps":["Sofríe la cebolla en rebanadas en el aceite de oliva a fuego bajo hasta que se marchite y quede transparente, unos 3 minutos.","Agrega la carne en tiras finas y cocina a fuego medio hasta que pierda todo el color rosado por dentro, unos 6 minutos.","Sigue cocinando a fuego bajo 5 minutos más, hasta que la carne esté bien suave y fácil de cortar con el tenedor.","Corta las tiras de carne en trozos pequeños, de 1 cm más o menos.","Sirve tibio, revisando que los trozos se aplasten con facilidad entre los dedos."],"alerta":"Corta siempre la carne en trozos pequeños y confirma que están bien suaves antes de servir."},{"id":1624,"name":"Pastel de Pollo con Masa de Papa","icon":"🥧","time":"~45 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/39070795/pexels-photo-39070795.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["2 papas medianas cocidas y machacadas (cerca de 1 y 1/2 taza)","100 g de pollo cocido y desmenuzado","1/4 taza de verduras picaditas (zanahoria y arvejas (chícharos))","1 chorrito de aceite de oliva para sofreír"],"tip":"Pollo → carne molida magra bien cocida, en la misma cantidad.","steps":["Cocina las papas hasta que un tenedor las atraviese sin resistencia; escúrrelas y machácalas bien.","Sofríe el pollo desmenuzado con las verduras picaditas en un chorrito de aceite de oliva unos 5 minutos, hasta que las verduras estén suaves.","Cubre el fondo de un molde pequeño engrasado con la mitad de la papa machacada.","Esparce el relleno de pollo con verduras por encima.","Cubre con el resto de la papa machacada y lleva al horno precalentado a 190 °C por 20 minutos, hasta que se dore un poco.","Deja entibiar antes de servir en trozos pequeños."],"alerta":"Deja enfriar el pastel hasta que esté tibio antes de servir; recién salido del horno está muy caliente."},{"id":1625,"name":"Pasta con Salsa de Calabaza","icon":"🍝","time":"~25 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/35450922/pexels-photo-35450922.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de pasta corta cocida","1/2 taza de calabaza (zapallo) cocida y machacada","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)","1 cucharada de queso fresco bajo en sodio rallado (opcional)"],"tip":"Calabaza → zanahoria cocida y machacada, en la misma cantidad.","steps":["Cocina la calabaza en agua hasta que un tenedor la atraviese fácil, unos 15 minutos; escúrrela y machácala hasta que quede como crema.","Cocina la pasta corta hasta que esté bien suave y corta cada trozo a la mitad.","Mezcla la pasta cortada con la crema de calabaza y el aceite de oliva.","Si lo usas, termina con el queso fresco rallado por encima, todavía tibio.","Sirve en porción pequeña, probando la temperatura en el dorso de la mano."],"alerta":"Corta siempre la pasta en trozos cortos antes de servir, para evitar el riesgo de atragantamiento."},{"id":1626,"name":"Pescado en Salsa de Hierbas","icon":"🐟","time":"~20 min","kcal":"155 kcal (estimado)","img":"https://images.pexels.com/photos/34636418/pexels-photo-34636418.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño de pescado blanco sin espinas (unos 100 g)","1 cucharada de perejil y cebollín picados","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)","unas gotas de jugo de limón"],"tip":"Pescado blanco → tilapia o merluza, en la misma cantidad.","steps":["Cocina el pescado al vapor unos 10 minutos, hasta que esté blanco, opaco y se separe fácil con el tenedor.","Desmenuza el pescado todavía tibio y pasa los dedos por toda la porción para revisar que no quedó ninguna espina.","Mezcla el perejil y el cebollín picados con el aceite de oliva y unas gotas de jugo de limón.","Baña el pescado desmenuzado con esta mezcla de hierbas.","Sirve tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano."],"alerta":"Desmenuza bien el pescado y revisa cada porción con los dedos para asegurarte de que no hay espinas."},{"id":1627,"name":"Arroz Integral con Verduras Salteadas","icon":"🍚","time":"~30 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/10695966/pexels-photo-10695966.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de arroz integral cocido","2 cucharadas de zanahoria en cubos pequeños","2 cucharadas de ejotes (judías verdes) en cubos pequeños","2 cucharadas de arvejas (chícharos)","1 chorrito de aceite de oliva (cerca de 1/2 cucharadita)"],"tip":"Arroz integral → arroz blanco, en la misma cantidad.","steps":["Cocina el arroz integral en agua hasta que esté bien suave, unos 25 minutos.","Cocina la zanahoria, los ejotes y las arvejas en agua hasta que estén bien suaves, unos 8 minutos.","Corta la zanahoria y los ejotes en cubos pequeños, del tamaño que se aplasta entre los dedos.","Saltea rápido las verduras ya cocidas en un chorrito de aceite de oliva por 1 minuto.","Mezcla el arroz con las verduras y sirve tibio."],"alerta":"Corta los ejotes y la zanahoria en cubos muy pequeños, confirmando que se aplastan entre los dedos."},{"id":1628,"name":"Albóndigas de Carne al Horno","icon":"🍖","time":"~35 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/28371803/pexels-photo-28371803.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["150 g de carne molida magra","1 huevo","2 cucharadas de harina de avena","1 cucharada de perejil y cebollín picados"],"tip":"Harina de avena → pan rallado casero sin sal, en la misma cantidad.","steps":["Mezcla la carne molida, el huevo, la harina de avena y el perejil con cebollín hasta formar una masa pareja.","Forma albóndigas pequeñas, del tamaño de una canica.","Acomoda las albóndigas en un molde engrasado, sin que se toquen entre sí.","Lleva al horno precalentado a 190 °C unos 20 minutos, hasta que se doren y estén firmes por dentro, sin ninguna parte rosada.","Corta una albóndiga a la mitad para confirmar que se cocinó por completo antes de servir las demás.","Deja entibiar antes de servir, cortando cada albóndiga a la mitad en trozos pequeños para el niño."],"alerta":"Corta una albóndiga a la mitad para confirmar que no quedó ninguna parte rosada antes de servirlas todas."},{"id":1629,"name":"Pollo Desmenuzado con Puré de Yuca","icon":"🍗","time":"~35 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/37073153/pexels-photo-37073153.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 1 porción infantil","ageRec":"A partir de los 12 meses","ingredients":["100 g de pechuga de pollo cocida y desmenuzada","1 yuca pequeña cocida y machacada (cerca de 1 taza)"],"tip":"Yuca → camote (batata) cocido y machacado, en la misma cantidad.","steps":["Cocina la yuca en agua hasta que un tenedor la atraviese sin resistencia, unos 20 minutos; escúrrela y machácala hasta formar un puré.","Cocina la pechuga de pollo hasta que esté bien suave y sin ninguna parte rosada, unos 15 minutos.","Desmenuza el pollo bien finito, revisando que no queden fibras gruesas o duras.","Sirve el pollo desmenuzado sobre el puré de yuca.","Ofrece tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano."],"alerta":"Desmenuza el pollo bien finito, sin dejar fibras gruesas que puedan causar atragantamiento."},{"id":1630,"name":"Quiche de Verduras sin Masa","icon":"🥧","time":"~35 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/33657187/pexels-photo-33657187.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["3 huevos batidos","1/4 taza de calabacita (zucchini) rallada","1/4 taza de zanahoria rallada","3 cucharadas de queso fresco bajo en sodio (tipo cottage)"],"tip":"Queso cottage → ricota fresca machacada, en la misma cantidad.","steps":["Bate bien los huevos y mézclalos con la calabacita y la zanahoria ralladas.","Agrega el queso cottage y mezcla hasta integrar.","Vierte la mezcla en un molde pequeño engrasado con un chorrito de aceite, esparciéndola bien hasta cubrir todo el fondo en una capa pareja.","Lleva al horno precalentado a 180 °C unos 25 minutos, hasta que esté firme por completo y no tiemble en el centro al mover el molde.","Deja enfriar hasta que esté tibia y corta en trozos pequeños antes de servir."],"alerta":"Espera a que la quiche se enfríe hasta estar tibia antes de servir; lo horneado sale muy caliente del horno."},{"id":1631,"name":"Carne a la Olla con Zanahoria y Papa","icon":"🍖","time":"~50 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/6545671/pexels-photo-6545671.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"Rinde 2 porciones infantiles","ageRec":"A partir de los 12 meses","ingredients":["150 g de carne de res magra en cubos pequeños","1/2 taza de zanahoria en cubos pequeños","1/2 taza de papa en cubos pequeños","1/2 taza de caldo casero de verduras (sin sal y sin condimento de sobre)"],"tip":"Carne de res → carne de cerdo magra bien cocida, en la misma cantidad.","steps":["Cocina la carne a fuego bajo con el caldo casero de verduras unos 25 minutos, hasta que empiece a ablandarse.","Agrega la zanahoria y la papa en cubos y sigue cocinando 15 minutos más, hasta que un tenedor atraviese las verduras sin resistencia.","Revisa que la carne esté bien suave y se deshebre con facilidad al presionarla con el tenedor.","Corta la carne y las verduras en trozos muy pequeños, del tamaño que se aplasta entre los dedos.","Sirve tibio, revisando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Usa solo caldo casero sin sal; nunca lo cambies por caldo en cubito o listo."},{"id":1632,"name":"Risotto de Champiñones con Pollo","icon":"🍚","time":"~30 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/8864543/pexels-photo-8864543.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arroz arborio o arroz blanco","1/2 taza de champiñones frescos picados muy pequeños","1/2 taza de pollo cocido y desmenuzado","2 tazas de caldo casero de verduras sin sal","1 cucharada de aceite de oliva"],"tip":"Champiñones → calabacita (zucchini) picada muy pequeña, en la misma cantidad.","steps":["Calienta el aceite de oliva en una olla y sofríe los champiñones picados muy pequeños con el pollo desmenuzado unos 3 minutos, hasta que los champiñones se marchiten.","Agrega el arroz y mueve por 1 minuto para cubrir los granos.","Añade el caldo casero sin sal, un cucharón a la vez, moviendo siempre y agregando más solo cuando el líquido se seque, hasta que el arroz esté suave (unos 18 minutos).","Revisa el punto: el arroz debe quedar cremoso, pero cada grano lo bastante suave para aplastarse entre los dedos.","Sirve tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Los champiñones deben quedar bien cocidos y picados muy pequeños, porque su textura es naturalmente gomosa y pueden causar atragantamiento si van en trozos grandes."},{"id":1633,"name":"Panqueques de Camote","icon":"🍠","time":"~20 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/33873563/pexels-photo-33873563.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de camote (batata) cocido y machacado","1 huevo","2 cucharadas de harina de avena","1 chorrito de aceite (para engrasar el sartén)"],"tip":"Harina de avena → harina de arroz, en la misma cantidad.","steps":["Machaca el camote cocido con un tenedor hasta formar un puré liso, sin trozos duros.","Mezcla el puré con el huevo y la harina de avena hasta formar una masa pareja y un poco espesa.","Engrasa un sartén antiadherente con el chorrito de aceite y caliéntalo a fuego medio.","Pon porciones pequeñas (cerca de 1 cucharada) en el sartén y cocina unos 2 minutos por lado, hasta que se doren y estén firmes en el centro.","Corta cada panqueque en tiras del tamaño de un dedo de adulto y sirve tibio."],"alerta":"Sirve siempre en tiras, nunca en trozos redondos, y revisa que el centro esté bien firme antes de ofrecer."},{"id":1634,"name":"Pescado Empanizado con Puré de Papa","icon":"🐟","time":"~30 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/17199132/pexels-photo-17199132.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño (unos 100 g) de pescado blanco sin espinas (como tilapia o merluza)","2 cucharadas de harina de avena (para empanizar)","1 taza de puré de papa sin sal","1 chorrito de aceite de oliva"],"tip":"Harina de avena → pan rallado casero, en la misma cantidad.","steps":["Pasa el filete de pescado, ya sin ninguna espina, por la harina de avena por los dos lados.","Rocía con un chorrito de aceite de oliva y lleva al horno precalentado a 200 °C unos 15 minutos, dándole la vuelta a la mitad del tiempo.","Revisa el punto: el pescado debe estar dorado por fuera y separarse fácil en lascas con un tenedor.","Desmenuza el pescado en lascas pequeñas, revisando con los dedos que no quedó ninguna espina.","Sirve tibio, mezclado o al lado del puré de papa, en cucharadas pequeñas."],"alerta":"Antes de servir, pasa los dedos por todas las lascas de pescado para asegurarte de que ninguna espina quedó escondida."},{"id":1635,"name":"Lomo de Cerdo Deshebrado","icon":"🍖","time":"~50 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/38980161/pexels-photo-38980161.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["200 g de lomo de cerdo magro, en un solo trozo","2 tazas de caldo casero de verduras sin sal","1 cucharadita de hierbas frescas picadas (como perejil u orégano)"],"tip":"Lomo de cerdo → pechuga de pollo, con la misma preparación.","steps":["Pon el lomo entero en la olla con el caldo casero sin sal y las hierbas picadas.","Cocina a fuego bajo, con la olla tapada, unos 40 minutos, hasta que la carne esté bien suave.","Revisa el punto: un tenedor debe atravesar la carne sin ninguna resistencia.","Deshebra la carne bien finita con dos tenedores, quitando cualquier parte de grasa o nervio más firme.","Sirve tibio, con arroz y verduras, en porciones pequeñas."],"alerta":"La carne de cerdo debe quedar bien cocida y deshebrada muy finita, sin ningún trozo fibroso o de grasa más dura."},{"id":1636,"name":"Pollo a la Plancha con Arroz con Brócoli","icon":"🥦","time":"~25 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/38095363/pexels-photo-38095363.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño de pechuga de pollo","1/2 taza de arroz cocido","1/4 de taza de brócoli cocido y picado muy pequeño","1 chorrito de aceite de oliva"],"tip":"Brócoli → coliflor cocida, en la misma cantidad.","steps":["Cocina el filete de pollo a la plancha con un chorrito de aceite de oliva a fuego medio, unos 5 minutos por lado, hasta que no quede ninguna parte rosada por dentro.","Deshebra el pollo bien finito con dos tenedores, en hebras cortas y suaves, sin ningún trozo grande que sea riesgo de atragantamiento.","Cocina el brócoli al vapor hasta que esté bien suave y pícalo en pedacitos muy pequeños.","Mezcla el arroz cocido con el brócoli picadito hasta repartir bien los pedacitos, dejando la mezcla pareja y fácil de tomar con la cuchara.","Sirve el pollo deshebrado sobre el arroz, tibio y en cucharadas pequeñas."],"alerta":"Confirma que el pollo esté bien cocido por dentro, sin ninguna parte rosada, antes de deshebrarlo."},{"id":1637,"name":"Pasta con Pollo y Queso Crema","icon":"🍝","time":"~25 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/9760210/pexels-photo-9760210.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 taza de pasta corta cocida (tipo tornillo o coditos)","1/2 taza de pollo cocido y desmenuzado","1 cucharada de queso crema casero sin sal (queso fresco cremoso bajo en sodio)"],"tip":"Queso crema casero → ricota machacada, en la misma cantidad.","steps":["Cocina la pasta corta en agua hasta que esté bien suave, casi deshaciéndose al apretarla entre los dedos, y escúrrela bien antes de seguir.","En una olla a fuego bajo, mezcla el pollo desmenuzado con el queso crema casero hasta formar una crema pareja.","Agrega la pasta cocida y mezcla bien, hasta que todos los trozos queden cubiertos con la crema.","Revisa que cada pedacito de pasta se aplaste con facilidad entre los dedos.","Sirve en un bol, tibio (prueba en el dorso de la mano para asegurarte de que no está caliente), en porciones pequeñas de dos a tres cucharadas."],"alerta":"Usa siempre pasta de forma corta y bien cocida, nunca pasta larga entera, para evitar el riesgo de atragantamiento."},{"id":1638,"name":"Pastel Salado de Atún","icon":"🥧","time":"~35 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/39070784/pexels-photo-39070784.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 lata pequeña de atún en agua, escurrido y sin piel","3 huevos","3 cucharadas de harina de avena","1/2 tomate (jitomate) maduro, sin semillas y picado muy pequeño"],"tip":"Atún → pollo desmenuzado, en la misma cantidad.","steps":["Bate los huevos y mézclalos con el atún escurrido, la harina de avena y el tomate picado hasta formar una masa pareja.","Vierte la masa en un molde pequeño engrasado con un chorrito de aceite, esparciéndola bien hasta cubrir todo el fondo en una capa pareja.","Hornea en horno precalentado a 180 °C unos 25 minutos, hasta que el pastel esté firme por completo y un poco dorado por encima.","Revisa el punto metiendo un palillo en el centro: debe salir limpio, sin masa cruda pegada.","Deja entibiar, corta en trozos pequeños del tamaño de un dedo y sirve."],"alerta":"El atún de lata se ofrece una vez por semana o menos, por el mercurio que tiene el pescado; espera a que el pastel se enfríe hasta estar tibio antes de servir."},{"id":1639,"name":"Verduras Gratinadas con Queso","icon":"🧀","time":"~30 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/17584225/pexels-photo-17584225.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de calabacita (zucchini) cocida en rebanadas finas","1/2 taza de zanahoria cocida en rebanadas finas","1/2 taza de papa cocida en rebanadas finas","3 cucharadas de queso fresco rallado bajo en sodio"],"tip":"Queso rallado → queso cottage esparcido por encima, en la misma cantidad.","steps":["Cocina las rebanadas de calabacita, zanahoria y papa al vapor hasta que estén lo bastante suaves para aplastarse fácil con el tenedor.","Acomoda las rebanadas cocidas en capas en un molde pequeño engrasado.","Espolvorea el queso fresco rallado sobre toda la superficie.","Lleva al horno precalentado a 200 °C unos 10 minutos, hasta que el queso se derrita y se dore un poco.","Deja entibiar y sirve en trozos pequeños, revisando que las verduras todavía se aplasten con facilidad entre los dedos."],"alerta":"Deja enfriar el gratinado hasta que esté tibio antes de servir, porque el queso derretido guarda mucho calor."},{"id":1640,"name":"Carne Molida con Calabaza","icon":"🍖","time":"~30 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/34429593/pexels-photo-34429593.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["150 g de carne molida magra","1 taza de calabaza (zapallo) cocida y machacada","1 chorrito de aceite de oliva"],"tip":"Calabaza → papa cocida y machacada, en la misma cantidad.","steps":["Calienta el aceite de oliva en una olla y sofríe la carne molida, deshaciendo bien los grumos con la cuchara, hasta que no quede ninguna parte rosada.","Revisa el punto: la carne debe estar totalmente cocida y sequita, sin líquido rosado.","Machaca bien la calabaza cocida con un tenedor hasta formar un puré liso y parejo, sin ningún trozo más firme ni fibra dura.","Mezcla la carne molida con el puré de calabaza hasta formar una crema pareja.","Sirve en un bol, tibio (revisa la temperatura en el dorso de la mano antes de ofrecer), en cucharadas pequeñas, observando cómo lo acepta el bebé."],"alerta":"Confirma que la carne molida esté completamente cocida, sin ningún punto rosado, antes de servir."},{"id":1641,"name":"Pescado en Salsa de Tomate Casera","icon":"🐟","time":"~25 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/36477072/pexels-photo-36477072.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño de pescado blanco sin espinas (como tilapia)","1 taza de salsa de tomate casera sin sal"],"tip":"Pescado blanco → tilapia o merluza, en la misma cantidad.","steps":["Calienta la salsa de tomate casera en una olla a fuego bajo, moviendo de vez en cuando para que no se pegue al fondo.","Agrega el filete de pescado entero y cocina con la olla tapada unos 10 minutos, hasta que esté bien suave y se separe en lascas.","Desmenuza el pescado dentro de la misma salsa, pasando los dedos por todas las lascas para revisar que no quedó ninguna espina.","Mezcla bien el pescado desmenuzado con la salsa de tomate, cuidando que todas las lascas queden cubiertas y revisando una vez más que no quedó ninguna espina.","Sirve tibio (prueba la temperatura en el dorso de la mano antes de ofrecer), acompañado de arroz o puré, en cucharadas pequeñas."],"alerta":"Revisa lasca por lasca del pescado con los dedos antes de servir, para asegurarte de que ninguna espina quedó escondida en la salsa."},{"id":1642,"name":"Panqueques de Zanahoria con Pollo Desmenuzado","icon":"🥕","time":"~20 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/5741136/pexels-photo-5741136.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de zanahoria cruda rallada finita","1 huevo","2 cucharadas de harina de avena","1/2 taza de pollo cocido y desmenuzado","1 chorrito de aceite (para engrasar el sartén)"],"tip":"Harina de avena → harina de arroz, en la misma cantidad.","steps":["Mezcla la zanahoria rallada finita con el huevo y la harina de avena hasta formar una masa pareja.","Agrega el pollo desmenuzado a la masa y mezcla bien.","Engrasa un sartén antiadherente con el chorrito de aceite y caliéntalo a fuego medio.","Pon porciones pequeñas en el sartén y cocina unos 2 minutos por lado, hasta que se doren y la zanahoria se cocine por dentro.","Corta en tiras del tamaño de un dedo de adulto y sirve tibio."],"alerta":"Ralla la zanahoria muy fina para que se cocine por completo dentro del panqueque, sin quedar cruda y dura."},{"id":1643,"name":"Arroz con Lentejas y Verduras","icon":"🍚","time":"~35 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/28674708/pexels-photo-28674708.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arroz cocido","1/2 taza de lentejas cocidas hasta que estén bien suaves","1/4 de taza de zanahoria cocida en cubos pequeños","1/4 de taza de calabacita (zucchini) cocida en cubos pequeños"],"tip":"Lentejas → frijoles (porotos) bien cocidos y machacados, en la misma cantidad.","steps":["Cocina las lentejas en agua hasta que estén bien suaves, casi deshaciéndose al presionarlas con el tenedor.","Cocina la zanahoria y la calabacita en cubos pequeños al vapor hasta que se aplasten con facilidad entre los dedos.","Mezcla bien las lentejas y las verduras cocidas con el arroz, repartiendo todo de forma pareja para que cada cucharada tenga un poco de cada ingrediente.","Machaca un poco con el tenedor para asegurarte de que no quede ningún cubo más firme.","Sirve en un bol, tibio (revisa en el dorso de la mano antes de ofrecer), en cucharadas pequeñas, observando si el bebé acepta bien cada bocado."],"alerta":"Los cubos de zanahoria y calabacita deben salir del fuego lo bastante suaves para aplastarse entre los dedos, para que no sean riesgo de atragantamiento."},{"id":1644,"name":"Pollo en Salsa de Yogur","icon":"🍗","time":"~25 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/8996122/pexels-photo-8996122.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de pechuga de pollo cocida y desmenuzada bien finita","3 cucharadas de yogur natural entero sin azúcar","1 cucharadita de hierbas frescas picadas (como perejil o cebollín)"],"tip":"Yogur natural → yogur griego natural sin azúcar, en la misma cantidad.","steps":["Cocina la pechuga de pollo hasta que no quede ninguna parte rosada y desmenúzala bien finita con dos tenedores.","Mezcla el yogur natural con las hierbas frescas picadas.","Fuera del fuego, cubre el pollo desmenuzado con la salsa de yogur hasta que quede bien integrado.","Sirve de inmediato con arroz, en cucharadas pequeñas."],"alerta":"La salsa de yogur no se calienta, para que no se corte; mézclala siempre fuera del fuego con el pollo ya tibio."},{"id":1645,"name":"Berenjena Rellena de Carne","icon":"🍆","time":"~40 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/29040190/pexels-photo-29040190.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 berenjena pequeña","150 g de carne molida magra","1/4 de taza de verduras picaditas (zanahoria y calabacita (zucchini))","1 chorrito de aceite de oliva"],"tip":"Berenjena → calabacita, con la misma preparación.","steps":["Corta la berenjena a la mitad a lo largo y saca un poco de la pulpa con una cuchara.","Cocina las mitades al vapor unos 10 minutos, hasta que la cáscara se ablande y se hunda fácil con el dedo.","Sofríe la carne molida con el aceite de oliva y las verduras picaditas hasta que la carne esté totalmente cocida y las verduras suaves.","Rellena las mitades de berenjena con la carne sofrita.","Lleva al horno precalentado a 190 °C por 15 minutos, hasta que la berenjena esté bien suave.","Deja entibiar, corta en trozos pequeños y sirve."],"alerta":"Sirve siempre en trozos pequeños y cortados, nunca la cáscara de la berenjena entera, y revisa que la carne esté completamente cocida."},{"id":1646,"name":"Puré de Arvejas con Pollo a la Plancha","icon":"🟢","time":"~20 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/10715471/pexels-photo-10715471.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arvejas (chícharos) cocidas","1/2 filete pequeño de pechuga de pollo a la plancha","1 chorrito de aceite de oliva"],"tip":"Arvejas → ejotes (judías verdes) cocidos y machacados, en la misma cantidad.","steps":["Cocina las arvejas en agua hasta que estén bien suaves, casi deshaciéndose al apretarlas entre los dedos, para que sea fácil machacarlas.","Machaca las arvejas cocidas con un tenedor hasta formar un puré liso, sin granos enteros.","Cocina el pollo a la plancha con el aceite de oliva a fuego medio hasta que no quede ninguna parte rosada por dentro.","Deshebra el pollo bien finito con dos tenedores, en hebras cortas y suaves, sin trozos grandes que sean riesgo de atragantamiento.","Sirve el puré de arvejas tibio, con el pollo deshebrado encima o al lado, en cucharadas pequeñas."],"alerta":"Machaca bien las arvejas para no dejar ningún grano entero, que podría tragarse sin masticar."},{"id":1647,"name":"Pasta con Verduras Salteadas y Aceite de Oliva","icon":"🍝","time":"~25 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/9399946/pexels-photo-9399946.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de pasta corta cocida (tipo tornillo o coditos)","1/4 de taza de calabacita (zucchini) picada pequeña","1/4 de taza de zanahoria picada pequeña","1/4 de taza de arvejas (chícharos) cocidas","1 cucharada de aceite de oliva"],"tip":"Verduras salteadas → verduras cocidas al vapor, en la misma cantidad.","steps":["Cocina la pasta corta en agua hasta que esté bien suave al morder y escúrrela bien antes de pasar al siguiente paso.","Calienta el aceite de oliva en un sartén y saltea la calabacita y la zanahoria picadas pequeñas unos 5 minutos, hasta que estén suaves.","Agrega las arvejas ya cocidas al sartén y saltea 1 minuto más, solo para calentar y juntar los sabores de las verduras.","Mezcla bien las verduras salteadas con la pasta cocida, repartiendo todo para que cada bocado tenga un poco de cada ingrediente.","Revisa que cada pedacito de verdura se aplaste con facilidad entre los dedos antes de servir.","Sirve en un bol, tibio (prueba en el dorso de la mano antes de ofrecer), en porciones pequeñas, observando si el bebé mastica bien los pedacitos de verdura."],"alerta":"Usa siempre pasta corta, nunca pasta larga sin cortar, para evitar el riesgo de atragantamiento."},{"id":1648,"name":"Pastel de Espinaca con Ricota","icon":"🥬","time":"~35 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/33433975/pexels-photo-33433975.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de espinaca salteada y picada","1/2 taza de ricota fresca machacada (queso fresco bajo en sodio)","2 huevos"],"tip":"Ricota → queso cottage machacado, en la misma cantidad.","steps":["Saltea la espinaca rápido en una olla hasta que se marchite y pícala bien.","Bate los huevos y mézclalos con la espinaca picada y la ricota machacada hasta formar una masa pareja.","Vierte la masa en un molde pequeño engrasado con un chorrito de aceite, esparciéndola bien hasta cubrir todo el fondo en una capa pareja.","Hornea en horno precalentado a 180 °C unos 25 minutos, hasta que el pastel esté firme por completo.","Revisa el punto metiendo un palillo en el centro: debe salir limpio.","Deja entibiar el pastel fuera del horno, córtalo en trozos pequeños del tamaño de un dedo y sírvelo en un bol, revisando la temperatura antes de ofrecer."],"alerta":"Deja enfriar el pastel hasta que esté tibio antes de servir, porque el relleno guarda calor por dentro."},{"id":1649,"name":"Albóndigas de Pescado en Salsa Blanca Ligera","icon":"🐟","time":"~30 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/18416603/pexels-photo-18416603.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 filete pequeño de pescado blanco sin espinas, procesado o bien picado","1 huevo","2 cucharadas de harina de avena","1 taza de leche entera","1 cucharada de harina de avena (para la salsa)"],"tip":"Harina de avena → pan rallado casero, en la misma cantidad.","steps":["Procesa o pica bien el filete de pescado, revisando con los dedos que no quedó ninguna espina.","Mezcla el pescado con el huevo y las 2 cucharadas de harina de avena hasta formar una masa que no se pegue a las manos.","Forma albóndigas pequeñas, del tamaño de una canica, y cocínalas al vapor por 15 minutos u hornéalas a 190 °C por 20 minutos, hasta que estén firmes por completo.","Para la salsa, calienta la leche a fuego bajo y agrega la cucharada de harina de avena, moviendo siempre hasta que espese un poco, sin dejar que hierva fuerte.","Revisa que las albóndigas estén bien cocidas por dentro, sin ninguna parte cruda o transparente.","Sirve las albóndigas tibias con la salsa blanca ligera por encima, cortadas a la mitad si hace falta."],"alerta":"Revisa el pescado procesado con los dedos antes de formar las albóndigas, para asegurarte de que ninguna espina pasó desapercibida."}],"8":[{"id":1700,"name":"Puré de Calabaza para Congelar","icon":"🎃","time":"~30 min","kcal":"70 kcal por porción (estimado)","img":"https://images.pexels.com/photos/5605569/pexels-photo-5605569.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 6 meses","ingredients":["3 tazas de calabaza (zapallo) kabocha pelada y en cubos medianos","1 taza de agua filtrada para la cocción","1 pizca muy pequeña de cúrcuma en polvo","1 cucharadita de aceite de oliva extra virgen"],"tip":"Calabaza kabocha → cualquier calabaza de pulpa naranja, en la misma cantidad. Congela siempre en frasquitos pequeños de vidrio con tapa, de una porción cada uno: así descongelas solo lo que el bebé va a comer y nunca tienes que volver a congelar lo que sobra.","steps":["Lava la calabaza todavía con cáscara, pélala y córtala en cubos de más o menos 2 dedos, para que todos se cocinen al mismo tiempo.","Pon los cubos en la olla con 1 taza de agua filtrada, tapa y cocina a fuego medio unos 15 minutos, hasta que un tenedor atraviese el cubo sin ninguna resistencia.","Escurre el agua de la cocción en una taza y guárdala, porque es la que vas a usar después para ajustar la textura.","Aplasta la calabaza todavía caliente con un tenedor, dentro de la misma olla, hasta que quede un puré espeso que se queda en la cuchara sin escurrir; si queda demasiado duro, agrega 1 cucharada del agua guardada cada vez.","Mezcla 1 cucharadita de aceite de oliva y una pizca muy pequeña de cúrcuma, revuelve y deja que el puré se enfríe por completo a temperatura ambiente antes de guardarlo.","Reparte el puré frío en 6 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio libre arriba (el puré se expande al congelarse), cierra, escribe la fecha en la tapa con cinta de papel y llévalo al congelador por 30 días o menos.","Para servir, pasa el frasquito del congelador al refrigerador la noche anterior y, al día siguiente, caliéntalo a baño maría o en una olla pequeña a fuego bajo, revolviendo, hasta que esté tibio; pruébalo en el dorso de la mano y ofrécelo en cucharadas pequeñas. ¿Sobró en el plato? Tíralo, nunca lo vuelvas a congelar."],"alerta":"Nunca uses licuadora ni colador en esta etapa: hasta los 9 meses la textura correcta es la del tenedor. Y nada de sal en el agua de la cocción."},{"id":1701,"name":"Puré de Zanahoria con Papa","icon":"🥕","time":"~30 min","kcal":"80 kcal por porción (estimado)","img":"https://images.pexels.com/photos/4451869/pexels-photo-4451869.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 6 meses","ingredients":["2 zanahorias medianas peladas y cortadas en rodajas gruesas","2 papas medianas peladas y cortadas en cubos","1 taza y media de agua filtrada","1 cucharadita de aceite de oliva extra virgen","1 pizca de perejil fresco bien picadito"],"tip":"Papa → camote (batata) o ñame, en la misma cantidad. Si quieres porciones muy pequeñas para empezar, congela parte del puré en un molde de hielo de silicona: cada cubito se vuelve una cucharada lista.","steps":["Pela las 2 zanahorias y las 2 papas, córtalas en trozos parecidos y lávalas bien con agua corriente antes de llevarlas al fuego.","Cocina todo junto en la olla con 1 taza y media de agua filtrada, tapada, a fuego medio unos 18 minutos, hasta que un tenedor atraviese la zanahoria sin resistencia (es la que más tarda).","Escurre y guarda media taza del agua de la cocción en una taza para ajustar el punto del puré.","Aplasta las verduras con un tenedor, sin licuadora, hasta formar un puré espeso y todavía un poquito rústico, que se queda quieto en la cuchara inclinada sin escurrir.","Mezcla 1 cucharadita de aceite de oliva y la pizca de perejil picadito, revuelve bien y extiende el puré en un plato plano para que se enfríe más rápido, sin dejarlo fuera del refrigerador más de 1 hora.","Guárdalo en 6 frasquitos pequeños de vidrio con tapa o en un molde de hielo de silicona cubierto con plástico; cuando estén firmes, pasa los cubitos a una bolsita para congelar, anota la fecha y mantenlos en el congelador por 30 días o menos.","A la hora de servir, descongela en el refrigerador de un día para otro y calienta en una olla pequeña a fuego bajo con 1 cucharada de agua, revolviendo hasta que esté tibio; pruébalo en el dorso de la mano antes de ofrecerlo."],"alerta":"La zanahoria solo entra bien cocida y aplastada: cruda o en rodaja firme es riesgo de atragantamiento."},{"id":1702,"name":"Puré de Manzana Cocida","icon":"🍎","time":"~20 min","kcal":"60 kcal por porción (estimado)","img":"https://images.pexels.com/photos/8896840/pexels-photo-8896840.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 frasquitos","ageRec":"A partir de los 6 meses","ingredients":["4 manzanas gala medianas peladas, sin semillas y en cubos","media taza de agua filtrada","1 pizca de canela en polvo"],"tip":"Manzana gala → manzana fuji o pera madura, en la misma cantidad. Nada de azúcar: la manzana cocida ya queda dulce sola, y antes de los 2 años el azúcar está fuera.","steps":["Pela las 4 manzanas, quita todo el centro con las semillas y corta la pulpa en cubos pequeños para que se cocinen parejo.","Lleva los cubos a la olla con media taza de agua filtrada y cocina a fuego bajo, con la olla semitapada, unos 12 minutos, hasta que la manzana se deshaga al apretarla con la cuchara.","Deja que el agua se seque casi por completo, revolviendo de vez en cuando para que no se pegue al fondo.","Aplasta la manzana con un tenedor hasta que quede un puré espeso y parejo, de los que se quedan en la cuchara sin escurrir, y mezcla la pizca de canela en polvo.","Espera a que se enfríe por completo y reparte en 5 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio arriba.","Cierra, escribe la fecha y congela por 30 días o menos; para empezar a ofrecer de a poco, parte de la receta puede ir a un molde de hielo y después a una bolsita para congelar.","Descongela el frasquito en el refrigerador de un día para otro y sírvelo tibio o a temperatura ambiente, probándolo en el dorso de la mano; lo que sobre en el platito se tira, nunca vuelve al congelador."],"alerta":"La manzana cruda y dura no se puede ofrecer en esta etapa: solo cocida hasta que se aplaste entre los dedos."},{"id":1703,"name":"Puré de Pera con Banana","icon":"🍐","time":"~20 min","kcal":"75 kcal por porción (estimado)","img":"https://images.pexels.com/photos/7636167/pexels-photo-7636167.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 frasquitos","ageRec":"A partir de los 6 meses","ingredients":["3 peras maduras peladas, sin semillas y en cubos","1 banana (plátano) madura","media taza de agua filtrada"],"tip":"Banana → cualquier banana bien madura, en la misma cantidad. La banana se oscurece un poco en el congelador, pero eso no echa a perder el puré: es solo oxidación natural.","steps":["Pela las 3 peras, quita el centro con las semillas y córtalas en cubos pequeños, para que se cocinen en pocos minutos.","Cocina las peras en la olla con media taza de agua filtrada, a fuego bajo y con la olla semitapada, unos 10 minutos, hasta que estén tan suaves que se deshagan al presionarlas con la cuchara.","Apaga el fuego, agrega la banana cortada en rodajas y deja reposar 2 minutos con el calor de la olla, solo para que se ablande.","Aplasta todo con un tenedor hasta que quede un puré espeso y cremoso que se queda en la cuchara volteada sin escurrir; si está aguado, vuelve a fuego bajo 2 minutos para que se seque un poco.","Deja que se enfríe por completo y reparte en 5 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio hasta el borde.","Anota la fecha en la tapa y llévalo al congelador por 30 días o menos, siempre en la parte de atrás del cajón, donde la temperatura cambia menos.","Para servir, deja que el frasquito se descongele en el refrigerador de un día para otro, mezcla bien con la cuchara para que vuelva a quedar parejo y ofrécelo frío o tibio, nunca caliente."],"alerta":"Nada de jugo de fruta antes de los 12 meses: en esta etapa la fruta se ofrece aplastada, no licuada en líquido."},{"id":1704,"name":"Papilla de Pollo con Calabacita y Arroz","icon":"🍗","time":"~40 min","kcal":"140 kcal por porción (estimado)","img":"https://images.pexels.com/photos/4224315/pexels-photo-4224315.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 6 meses","ingredients":["1 filete de pechuga de pollo mediano (unos 150 g) en cubos","1 calabacita (zucchini) pequeña en cubos, con cáscara","1 papa mediana pelada y en cubos","media taza de arroz blanco crudo y lavado","2 tazas de agua filtrada","1 cucharadita de cebolla bien picadita","1 diente pequeño de ajo machacado","1 cucharadita de aceite de oliva extra virgen"],"tip":"Pechuga de pollo → muslo deshuesado y sin piel, en la misma cantidad. Congela la papilla ya lista y completa: en el día apurado, solo descongelas un frasquito y la comida entera está resuelta.","steps":["Sofríe en una olla el aceite de oliva, 1 cucharadita de cebolla picadita y el diente de ajo machacado unos 2 minutos, a fuego bajo, solo hasta que estén transparentes y huelan rico.","Agrega los cubos de pollo y revuelve 4 minutos, hasta que pierdan el color rosado por fuera.","Añade la papa, la calabacita, el arroz lavado y las 2 tazas de agua filtrada, tapa y cocina a fuego medio-bajo unos 20 minutos, hasta que el agua se seque casi toda y un tenedor atraviese la papa sin resistencia.","Saca los cubos de pollo, deshébralos bien finito con dos tenedores y devuélvelos a la olla; en esta etapa el pollo tiene que quedar en hebras suaves, nunca en trozo entero.","Aplasta todo con el tenedor dentro de la olla hasta que quede una papilla espesa y pareja, que se queda en la cuchara sin escurrir, y prueba la textura frotando un poquito entre el pulgar y el índice: tiene que deshacerse sin esfuerzo.","Deja que se enfríe por completo, reparte en 6 frasquitos pequeños de vidrio con tapa (1 dedo de espacio arriba), escribe la fecha y congela por 30 días o menos.","Descongela en el refrigerador de un día para otro y recalienta a baño maría o en una olla a fuego bajo con 1 cucharada de agua, revolviendo hasta que esté tibia por igual; pruébala en el dorso de la mano y nunca vuelvas a congelar lo que ya se calentó."],"alerta":"Sin sal y sin caldo en cubo: el sabor viene del ajo, de la cebolla y de la propia cocción del pollo."},{"id":1705,"name":"Papilla de Carne con Papa","icon":"🥩","time":"~45 min","kcal":"155 kcal por porción (estimado)","img":"https://images.pexels.com/photos/10692537/pexels-photo-10692537.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 8 meses","ingredients":["150 g de carne molida de res magra (o carne de res para guisar en cubos pequeños)","2 papas medianas peladas y en cubos","1 zanahoria mediana pelada y en rodajas gruesas","2 tazas de agua filtrada","1 cucharadita de cebolla picadita","1 diente pequeño de ajo machacado","1 cucharadita de aceite de oliva extra virgen","1 pizca de perejil picado"],"tip":"Carne molida magra → otro corte magro molido o carne de res bien cocida y deshebrada, en la misma cantidad. Si toda la familia come, haz el doble y congela la mitad: la carne molida congelada en frasquito alcanza para toda la semana del bebé.","steps":["Calienta el aceite de oliva en una olla, agrega la cebolla y el ajo y sofríe 2 minutos a fuego bajo, revolviendo para que no se quemen.","Añade los 150 g de carne molida y sofríe unos 6 minutos, deshaciendo los grumos con la cuchara, hasta que la carne cambie de color por completo.","Agrega la papa, la zanahoria y las 2 tazas de agua filtrada, tapa y cocina a fuego medio-bajo unos 20 minutos, hasta que un tenedor atraviese la zanahoria sin resistencia.","Aplasta con el tenedor dejando trocitos suaves que se noten, como pide la etapa de los 8 meses: nada de puré liso, sino una papilla espesa con textura, en la que los trocitos se deshacen entre el pulgar y el índice.","Mezcla el perejil, deja que la papilla se enfríe por completo a temperatura ambiente y solo entonces pásala a los frascos, porque el frasco cerrado todavía caliente forma agua y hielo por dentro.","Reparte en 6 frasquitos pequeños de vidrio con tapa, deja 1 dedo de espacio arriba, escribe la fecha con cinta de papel y congela por 30 días o menos.","Para servir, pasa el frasquito al refrigerador la noche anterior y calienta a baño maría o en una olla a fuego bajo hasta que esté tibia por igual; pruébala en el dorso de la mano, sirve en cucharadas pequeñas y tira lo que sobre en el plato."],"alerta":"La carne tiene que quedar muy suave y sin hebras duras; cualquier trozo que no se aplaste entre los dedos debe salir del plato."},{"id":1706,"name":"Sopita Espesa de Verduras","icon":"🍲","time":"~35 min","kcal":"95 kcal por porción (estimado)","img":"https://images.pexels.com/photos/28286209/pexels-photo-28286209.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 8 meses","ingredients":["1 papa mediana pelada y en cubos","1 zanahoria mediana pelada y en rodajas","1 taza de calabaza (zapallo) kabocha en cubos","media taza de calabacita pelada y en cubos","2 tazas y media de agua filtrada","1 cucharadita de cebolla picadita","1 cucharadita de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"Calabacita → ejotes (judías verdes) bien cocidos, en la misma cantidad. Congela esta sopita en frasquitos de 150 ml: es la porción justa de una comida y se descongela rápido.","steps":["Sofríe la cebolla en el aceite de oliva 2 minutos a fuego bajo, hasta que esté transparente y suelte su olor.","Agrega la papa, la zanahoria, la calabaza y la calabacita, y revuelve 1 minuto para que todo se impregne del sofrito.","Añade las 2 tazas y media de agua filtrada, tapa y cocina a fuego medio unos 20 minutos, hasta que un tenedor atraviese la zanahoria sin ninguna resistencia.","Retira del fuego, aplasta las verduras con un tenedor dentro de la misma olla y deja algunos trocitos suaves enteros; la sopita tiene que quedar espesa, de las que se quedan en la cuchara sin escurrir, y no líquida.","Mezcla la pizca de orégano y deja que se enfríe por completo antes de guardarla, revolviendo de vez en cuando para que sea más rápido.","Reparte en 6 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio arriba, anota la fecha y congela por 30 días o menos.","Descongela en el refrigerador de un día para otro y recalienta en una olla a fuego bajo, revolviendo siempre, hasta que esté tibia por igual; pruébala en el dorso de la mano antes de servir y no la vuelvas a congelar."],"alerta":"La sopa de bebé es espesa y se da con cuchara; la sopa aguada en biberón no es adecuada en esta etapa."},{"id":1707,"name":"Salsa de Tomate Casera sin Sal","icon":"🍅","time":"~40 min","kcal":"45 kcal por porción (estimado)","img":"https://images.pexels.com/photos/39026052/pexels-photo-39026052.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 porciones","ageRec":"A partir de los 8 meses","ingredients":["6 tomates (jitomates) saladet maduros, sin piel y sin semillas, picados","media taza de agua filtrada","1 cucharada de cebolla bien picadita","1 diente de ajo machacado","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco","2 hojas de albahaca fresca"],"tip":"Tomate saladet → cualquier tomate bien maduro, en la misma cantidad. Esta es la salsa base de la semana: congélala en un molde de hielo y usa 2 o 3 cubitos por comida, en la pastita, en el arroz o en la carne deshebrada.","steps":["Haz una X en la base de los 6 tomates, sumérgelos 1 minuto en agua hirviendo y pásalos a un tazón con agua fría: la piel sale tirando con los dedos.","Corta los tomates por la mitad, quita las semillas con una cuchara y pica la pulpa en trozos pequeños.","Sofríe la cebolla y el ajo en el aceite de oliva 2 minutos a fuego bajo, sin dejar que se doren demasiado para que la salsa no quede amarga.","Agrega el tomate picado y la media taza de agua, cocina con la olla semitapada unos 25 minutos a fuego bajo, revolviendo a ratos, hasta que la salsa espese y no escurra cuando pasas la cuchara por el fondo.","Apaga, agrega el orégano y la albahaca, aplasta con el tenedor para deshacer los trozos más grandes y deja que se enfríe por completo.","Congela de dos formas: una parte en un molde de hielo de silicona (cuando esté firme, pasa los cubos a una bolsita para congelar) y otra parte en frasquitos pequeños de vidrio; anota la fecha y úsala en 60 días o menos.","Para usarla, toma solo la cantidad del día: calienta los cubitos directo en la olla a fuego bajo con 1 cucharada de agua, revolviendo hasta que esté tibia, y nunca devuelvas al congelador la salsa ya calentada."],"alerta":"La salsa del bebé va sin sal, sin caldo en cubo y sin azúcar; la acidez se equilibra con la cocción larga y con zanahoria rallada, si hace falta."},{"id":1708,"name":"Frijoles Aplastados para la Semana","icon":"🫘","time":"~50 min (sin el remojo)","kcal":"110 kcal por porción (estimado)","img":"https://images.pexels.com/photos/28902908/pexels-photo-28902908.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de frijoles (porotos) pintos crudos, dejados en remojo 12 horas con agua cambiada","3 tazas de agua filtrada para la cocción","1 cucharadita de cebolla picadita","1 diente pequeño de ajo machacado","1 cucharadita de aceite de oliva extra virgen","1 hoja pequeña de laurel"],"tip":"Frijoles pintos → frijoles negros o blancos, en la misma cantidad. Congela solo el caldo espeso con los granos aplastados: es el caldito de frijol que espesa cualquier papilla de la semana.","steps":["Deja los frijoles en remojo 12 horas, tira esa agua y enjuaga los granos: eso reduce las molestias por gases y ayuda a que se cocinen parejo.","Cocina los frijoles en la olla de presión con las 3 tazas de agua filtrada y la hoja de laurel unos 20 minutos después de que la olla empiece a silbar, hasta que el grano se aplaste entre los dedos sin esfuerzo.","Aparte, sofríe la cebolla y el ajo en el aceite de oliva 2 minutos y agrégalos a los frijoles cocidos, revolviendo bien para que tomen el sabor.","Quita la hoja de laurel, separa 1 cucharón y medio de granos con un poco de caldo y aplástalos con el tenedor hasta que queden como una crema espesa; en esta etapa los frijoles van aplastados, ni en grano entero ni con la cáscara suelta.","Deja que el caldito se enfríe por completo, lo que toma unos 40 minutos con la olla destapada a temperatura ambiente.","Reparte en 8 frasquitos pequeños de vidrio con tapa o en un molde de hielo de silicona, dejando 1 dedo de espacio, escribe la fecha y congela por 30 días o menos.","Para servir, descongela en el refrigerador de un día para otro y calienta en una olla pequeña a fuego bajo con 1 cucharada de agua, revolviendo hasta que esté tibio; pruébalo en el dorso de la mano y mézclalo con el arroz aplastado del bebé."],"alerta":"Nada de sal, caldo en cubo, tocino ni chorizo en los frijoles del bebé; la cáscara suelta se quita o se aplasta bien."},{"id":1709,"name":"Papilla de Pescado con Papa y Brócoli","icon":"🐟","time":"~35 min","kcal":"130 kcal por porción (estimado)","img":"https://images.pexels.com/photos/16134559/pexels-photo-16134559.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 frasquitos","ageRec":"A partir de los 10 meses","ingredients":["1 filete de tilapia o merluza (unos 150 g), sin espinas","2 papas medianas peladas y en cubos","1 taza de brócoli (solo los arbolitos) picado","1 taza y media de agua filtrada","1 cucharadita de aceite de oliva extra virgen","1 cucharadita de cebolla picadita","unas gotas de limón","1 pizca de perejil"],"tip":"Tilapia → merluza, pescadilla o lenguado, en la misma cantidad — siempre pescado blanco y sin espinas. Nunca uses atún en lata aquí: solo entra después de los 12 meses y como máximo 1 vez por semana.","steps":["Pasa el filete de pescado bajo el agua corriente, sécalo con papel de cocina y palpa toda la carne con la punta de los dedos, quitando cualquier espina que encuentres.","Sofríe la cebolla en el aceite de oliva 2 minutos, agrega las papas y 1 taza y media de agua filtrada y cocina tapado unos 12 minutos, hasta que un tenedor atraviese la papa sin resistencia.","Añade el brócoli y el filete de pescado encima, tapa y cocina 8 minutos más, hasta que el pescado se separe en lascas cuando lo tocas con el tenedor.","Desmenuza el pescado con el tenedor dentro de la olla, revisando otra vez que no quede ninguna espina, y agrega unas gotas de limón para quitarle el sabor fuerte.","Aplasta las verduras dejando trozos pequeños y suaves, del tamaño de una arveja, que es la textura de la etapa de los 10 meses, y mezcla el perejil.","Deja que se enfríe por completo y reparte en 5 frasquitos pequeños de vidrio con tapa, con 1 dedo de espacio arriba; escribe la fecha y congela por 30 días o menos (el pescado congelado dura menos que la carne, así que respeta el plazo).","Descongela siempre en el refrigerador de un día para otro, nunca fuera del refrigerador, y recalienta a baño maría hasta que esté tibia; pruébala en el dorso de la mano y tira cualquier sobra del plato."],"alerta":"El pescado solo puede ir al plato del bebé después de revisarlo lasca por lasca: una sola espina es riesgo de atragantamiento."},{"id":1710,"name":"Pollo Deshebradito para la Semana","icon":"🍗","time":"~35 min","kcal":"120 kcal por porción (estimado)","img":"https://images.pexels.com/photos/32287751/pexels-photo-32287751.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 filetes de pechuga de pollo (unos 300 g)","2 tazas de agua filtrada","1 diente de ajo machacado","1 cucharada de cebolla picadita","1 cucharadita de aceite de oliva extra virgen","1 pizca de pimentón dulce (paprika)","1 hoja pequeña de laurel"],"tip":"Pechuga de pollo → muslo y contramuslo deshuesados y sin piel, en la misma cantidad (quedan todavía más suaves). Congela el pollo deshebrado con un poco del caldo de la cocción: sin caldo se reseca y queda con hebras duras al descongelarlo.","steps":["Cocina los 2 filetes en la olla con las 2 tazas de agua filtrada, el ajo, la cebolla y la hoja de laurel, tapado, unos 20 minutos a fuego medio, hasta que el pollo se abra fácilmente al pincharlo con el tenedor.","Saca los filetes y deja que se entibien sobre una tabla 5 minutos, para poder manipularlos sin quemarte.","Deshebra el pollo con dos tenedores, tirando en el sentido de las fibras, hasta que las hebras queden bien finas y cortas; pasa el dedo por el montoncito para encontrar y deshacer cualquier hebra más dura.","Devuelve el pollo deshebrado a la olla con media taza del caldo de la cocción colado, agrega el aceite de oliva y la pizca de pimentón dulce y cocina 3 minutos más a fuego bajo, revolviendo, hasta que quede húmedo pero no aguado.","Espera a que se enfríe por completo y reparte en 6 porciones en frasquitos pequeños de vidrio con tapa, siempre con un poquito de caldo cubriendo el pollo.","Cierra, anota la fecha en la tapa y llévalo al congelador por 30 días o menos; si prefieres porciones más pequeñas, usa un molde de hielo y después pasa los cubitos a una bolsita para congelar.","Para servir, descongela en el refrigerador de un día para otro y calienta en una olla a fuego bajo con 1 cucharada de agua o de la salsa de tomate casera, hasta que esté tibio; pruébalo en el dorso de la mano y nunca vuelvas a congelar lo que ya se calentó."],"alerta":"El pollo siempre bien cocido, sin ninguna parte rosada en el centro, y deshebrado bien fino — el trozo entero de carne no va al plato en esta etapa."},{"id":1711,"name":"Sopita de Calabaza con Lentejas","icon":"🥣","time":"~40 min","kcal":"125 kcal por porción (estimado)","img":"https://images.pexels.com/photos/9027516/pexels-photo-9027516.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 10 meses","ingredients":["media taza de lentejas crudas, lavadas y dejadas en remojo 2 horas","2 tazas de calabaza (zapallo) kabocha en cubos","1 zanahoria pequeña en rodajas","3 tazas de agua filtrada","1 cucharada de cebolla picadita","1 diente pequeño de ajo machacado","1 cucharadita de aceite de oliva extra virgen","1 pizca muy pequeña de comino en polvo"],"tip":"Lentejas → arvejas (chícharos) partidas o garbanzos bien cocidos y sin piel, en la misma cantidad. Congelada en frasquito, esta sopita se vuelve el almuerzo listo de los días en que no te da el tiempo para cocinar nada.","steps":["Deja las lentejas en remojo 2 horas, tira el agua y enjuaga bien los granos antes de cocinarlos.","Sofríe la cebolla y el ajo en el aceite de oliva 2 minutos a fuego bajo, hasta que estén transparentes.","Agrega las lentejas escurridas, la calabaza, la zanahoria y las 3 tazas de agua filtrada, tapa y cocina a fuego medio-bajo unos 25 minutos, hasta que las lentejas se deshagan al apretarlas con la cuchara.","Aplasta con el tenedor hasta formar una sopita espesa, con trocitos pequeños y suaves todavía visibles, y mezcla la pizca de comino; la consistencia correcta es la que deja un camino en el fondo de la olla cuando pasas la cuchara.","Deja que se enfríe por completo con la olla destapada, lo que toma unos 40 minutos, antes de pensar en cerrar cualquier frasco.","Reparte en 6 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio arriba porque la sopita aumenta de volumen al congelarse, escribe la fecha y congela por 30 días o menos.","Descongela en el refrigerador de un día para otro y recalienta en una olla a fuego bajo, revolviendo y agregando 1 cucharada de agua si espesa demasiado, hasta que esté tibia; pruébala en el dorso de la mano antes de servir."],"alerta":"Las legumbres tienen que quedar bien cocidas y aplastadas; el grano entero y firme no se debe ofrecer en esta etapa."},{"id":1712,"name":"Carne Deshebrada Suave","icon":"🥩","time":"~60 min","kcal":"150 kcal por porción (estimado)","img":"https://images.pexels.com/photos/18354021/pexels-photo-18354021.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 12 meses","ingredients":["300 g de carne de res para deshebrar (músculo o falda) en trozos grandes","3 tazas de agua filtrada","1 cebolla pequeña picada","2 dientes de ajo machacados","1 hoja de laurel","1 cucharada de aceite de oliva extra virgen","media taza de salsa de tomate casera sin sal"],"tip":"Músculo → falda o paleta, en la misma cantidad — los cortes de fibra larga se deshebran mejor. Congela en frasquitos con un poco del caldo encima: es lo que mantiene la carne suave después de descongelarla.","steps":["Dora los trozos de carne en el aceite de oliva dentro de la olla de presión unos 5 minutos, volteándolos para que tomen color por todos lados.","Agrega la cebolla, el ajo, la hoja de laurel y las 3 tazas de agua filtrada, cierra la olla y cocina unos 35 minutos después de que empiece a silbar, hasta que la carne se abra sola al tirarla con el tenedor.","Abre la olla con cuidado, saca la carne y deshébrala con dos tenedores todavía tibia, separando bien las fibras y quitando cualquier nervio o grasa más firme.","Vuelve a poner la carne deshebrada en la olla con 1 taza del caldo colado y la media taza de salsa de tomate casera, y cocina a fuego bajo 8 minutos, hasta que la carne quede húmeda y brillante, sin caldo sobrante.","Corta con el costado del tenedor cualquier hebra demasiado larga: en esta etapa las hebras deben medir como máximo la mitad del dedo meñique, para que no se enreden en la boca.","Deja que se enfríe por completo y reparte en 6 frasquitos pequeños de vidrio con tapa, cubriendo la carne con un poco del caldo; escribe la fecha y congela por 60 días o menos.","Descongela en el refrigerador de un día para otro y calienta en una olla a fuego bajo con 1 cucharada de agua, revolviendo hasta que esté tibia por igual; pruébala en el dorso de la mano y nunca vuelvas a congelar la porción ya descongelada."],"alerta":"Aun a los 12 meses, toda hebra de carne tiene que aplastarse entre el pulgar y el índice, y el niño debe comer sentado, con un adulto cerca."},{"id":1713,"name":"Sopita de Arvejas con Pastita","icon":"🍜","time":"~35 min","kcal":"135 kcal por porción (estimado)","img":"https://images.pexels.com/photos/24186408/pexels-photo-24186408.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 frasquitos","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arvejas (chícharos) frescas o congeladas","1 papa mediana pelada y en cubos","media taza de pasta de estrellitas o letras, cruda","3 tazas de agua filtrada","1 cucharada de cebolla picadita","1 cucharadita de aceite de oliva extra virgen","1 pizca de hierbabuena fresca picadita"],"tip":"Arvejas frescas → arvejas congeladas (nunca en lata, por la sal). Congela la sopita con la pasta ya cocida, pero cocínala 2 minutos menos: termina de ablandarse al recalentar y no se vuelve engrudo.","steps":["Sofríe la cebolla en el aceite de oliva 2 minutos a fuego bajo, hasta que esté transparente y perfumada.","Agrega la papa, las arvejas y las 3 tazas de agua filtrada, tapa y cocina unos 15 minutos a fuego medio, hasta que un tenedor atraviese la papa sin resistencia y las arvejas se aplasten entre los dedos.","Añade la media taza de pastita y cocina 5 minutos más, 2 minutos menos de lo que indica el paquete, para que no se deshaga después de congelada.","Aplasta ligeramente con el tenedor, solo para deshacer la papa y espesar el caldo, dejando la pastita y parte de las arvejas enteras en trozos pequeños y suaves, como pide la comida de la familia adaptada.","Mezcla la hierbabuena picadita, apaga y deja que la sopita se enfríe por completo con la olla destapada.","Reparte en 5 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio arriba, escribe la fecha y congela por 30 días o menos.","Para servir, descongela en el refrigerador de un día para otro y recalienta en una olla a fuego bajo con 2 cucharadas de agua, revolviendo hasta que esté tibia por igual; pruébala en el dorso de la mano y ofrécela con el niño bien sentado a la mesa."],"alerta":"La arveja entera es redondita: aplasta o machaca cada una antes de servir, y nunca ofrezcas la sopita en biberón."},{"id":1714,"name":"Puré de Papa con Leche","icon":"🥔","time":"~30 min","kcal":"115 kcal por porción (estimado)","img":"https://images.pexels.com/photos/30635680/pexels-photo-30635680.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 frasquitos","ageRec":"A partir de los 12 meses","ingredients":["4 papas medianas peladas y en cubos","agua filtrada suficiente para cubrir las papas","media taza de leche entera","1 cucharada de aceite de oliva extra virgen","1 pizca de nuez moscada recién rallada","1 pizca de cebollín picadito"],"tip":"Leche entera → leche materna o la fórmula que el niño ya toma, en la misma cantidad, si quieres ofrecerlo antes de los 12 meses. El puré congelado puede quedar un poco arenoso al descongelarse: bátelo con el tenedor y 1 cucharada de leche tibia y vuelve a quedar cremoso.","steps":["Cocina las 4 papas en cubos en agua filtrada suficiente para cubrirlas, unos 15 minutos, hasta que un tenedor las atraviese sin ninguna resistencia.","Escurre bien el agua y devuelve las papas a la olla caliente 1 minuto, revolviendo, solo para secar el exceso de humedad.","Aplasta las papas todavía calientes con un pisapapas o con el tenedor, hasta que no queden trozos grandes.","Mezcla poco a poco la media taza de leche entera tibia, junto con el aceite de oliva, revolviendo hasta formar un puré cremoso y firme, que se queda en la cuchara inclinada sin escurrir.","Agrega la pizca de nuez moscada y el cebollín, prueba la textura y deja que se enfríe por completo a temperatura ambiente antes de envasar.","Reparte en 6 frasquitos pequeños de vidrio con tapa, dejando 1 dedo de espacio arriba, escribe la fecha y congela por 30 días o menos.","Descongela en el refrigerador de un día para otro y recalienta a baño maría o en una olla a fuego bajo con 1 cucharada de leche, revolviendo bien hasta que esté tibio y cremoso; pruébalo en el dorso de la mano y tira lo que sobre en el plato."],"alerta":"La leche de vaca en preparaciones solo a partir de los 12 meses; para bebés más pequeños, haz el mismo puré con leche materna o fórmula."},{"id":1715,"name":"Cubitos de Sazón Casera","icon":"🧄","time":"~20 min","kcal":"15 kcal por cubo (estimado)","img":"https://images.pexels.com/photos/33673964/pexels-photo-33673964.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"14 cubitos","ageRec":"A partir de los 6 meses","ingredients":["1 cebolla pequeña picada muy finita","2 dientes de ajo pelados y picados","1/2 taza de perejil lavado y picado","1/4 taza de cebollín lavado y picado","3 cucharadas de aceite de oliva","3 cucharadas de agua filtrada"],"tip":"Cebollín → cámbialo por 1/4 de taza de albahaca fresca picada, en la misma cantidad. Congela en un molde de hielo y usa 1 cubo para sazonar cada ollita de la semana, sin tener que picar nada en el día a día.","steps":["Lava el perejil y el cebollín hoja por hoja con agua corriente, sacúdelos bien para quitar el exceso de agua y pica todo muy finito sobre la tabla.","Pela la cebolla pequeña y los 2 dientes de ajo y pícalos también muy finito, en trocitos más pequeños que un grano de arroz.","Calienta 3 cucharadas de aceite de oliva en una olla pequeña a fuego bajo y sofríe la cebolla y el ajo unos 5 minutos, revolviendo siempre, hasta que la cebolla esté transparente y suave (nunca dejes que se dore o se queme, porque amarga).","Apaga el fuego, agrega el perejil y el cebollín picados y 3 cucharadas de agua filtrada, mezcla y deja que se enfríe por completo a temperatura ambiente, unos 20 minutos — no lleves nada tibio al congelador.","Reparte la sazón fría en un molde de hielo limpio, llenando cada espacio hasta la mitad con una cucharadita, y empareja con el dorso de la cuchara.","Cubre el molde con plástico o con su tapa y llévalo al congelador 4 horas; después desmolda los cubitos, guárdalos todos juntos en una bolsita para alimentos y vuelve a ponerlos en el congelador, donde duran 60 días o menos.","Para usarla, toma 1 cubito todavía congelado y échalo directo en la olla caliente al empezar el sofrito del bebé — esta sazón no necesita descongelarse antes y nunca se debe volver a congelar después de derretida."],"alerta":"Esta sazón no lleva sal ni sazonador comercial: la sal, solo después de los 2 años. El ajo, la cebolla, el perejil y el cebollín en pizca están permitidos desde los 6 meses."},{"id":1716,"name":"Caldito de Verduras para Congelar","icon":"🥣","time":"~45 min","kcal":"20 kcal por porción (estimado)","img":"https://images.pexels.com/photos/35966134/pexels-photo-35966134.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"10 porciones de 100 ml","ageRec":"A partir de los 6 meses","ingredients":["1 zanahoria mediana pelada en rodajas gruesas","1 papa mediana pelada en cubos","1/2 calabacita (zucchini) en rodajas gruesas","1 rama de apio o 1/2 puerro en trozos","1 diente de ajo pelado entero","1 ramito de perejil con tallo","1,5 litros de agua filtrada"],"tip":"Apio → cámbialo por 1/2 calabacita pelada en cubos, en la misma cantidad. Usa este caldito en lugar del agua para cocinar el arroz, el puré o la papilla de la semana — da sabor sin una pizca de sal.","steps":["Lava y pela las verduras y corta todo en trozos grandes: la zanahoria en rodajas gruesas, la papa en cubos, la calabacita en rodajas y el apio en trozos de dos dedos.","Pon todas las verduras, el diente de ajo entero y el ramito de perejil en una olla grande y cúbrelos con 1,5 litros de agua filtrada fría.","Lleva a fuego alto hasta que hierva, luego baja el fuego y deja cocinar destapado unos 35 minutos, hasta que las verduras estén tan suaves que un tenedor las atraviese sin ninguna resistencia y el agua tome un color dorado.","Apaga el fuego, saca y tira el ramito de perejil y cuela el caldo con una espumadera grande, guardando solo el líquido (las verduras cocidas pueden volverse un puré aplastado con tenedor para la comida del día).","Deja que el caldo se enfríe por completo a temperatura ambiente, unos 40 minutos, y después llévalo al refrigerador 1 hora antes de congelarlo — meter caldo tibio en el congelador echa a perder el resto de la comida.","Reparte el caldo frío en frasquitos pequeños de vidrio con tapa, dejando dos dedos de espacio vacío arriba (el líquido se expande al congelarse), escribe la fecha en la tapa con cinta de papel y congela: dura 60 días o menos.","Para usarlo, saca el frasquito la noche anterior y descongélalo en el refrigerador de un día para otro, o lleva el cubo congelado directo a la olla a fuego bajo; nunca vuelvas a congelar el caldo ya descongelado."],"alerta":"El caldo casero nunca lleva sal, caldo en cubo ni sazonador en sobre — están prohibidos hasta los 2 años porque sobrecargan los riñones del bebé."},{"id":1717,"name":"Lentejas Aplastaditas con Zanahoria","icon":"🫘","time":"~40 min","kcal":"110 kcal por porción (estimado)","img":"https://images.pexels.com/photos/6120506/pexels-photo-6120506.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 taza de lentejas dejadas en remojo 4 horas","1 zanahoria mediana pelada y rallada gruesa","1/2 cebolla pequeña picada muy finita","1 diente de ajo picado","1 cucharada de aceite de oliva","3 tazas de agua filtrada","1 pizca de perejil picado"],"tip":"Lentejas → cámbialas por 1 taza de frijoles (porotos) pintos ya cocidos y escurridos, en la misma cantidad. Congeladas en frasquitos pequeños, estas lentejas resuelven el almuerzo de seis días de la semana.","steps":["Deja 1 taza de lentejas en remojo en agua fría 4 horas, escúrrelas en un colador y enjuágalas con agua corriente hasta que el agua salga limpia.","Calienta 1 cucharada de aceite de oliva en una olla, agrega la cebolla y el ajo picados y sofríe a fuego bajo unos 4 minutos, hasta que la cebolla esté transparente y huela rico.","Añade las lentejas escurridas y la zanahoria rallada, revuelve 1 minuto para que se impregnen del aceite y cubre con 3 tazas de agua filtrada.","Cocina a fuego bajo con la olla semitapada unos 25 minutos, hasta que los granos de lenteja se deshagan cuando aprietas uno entre los dedos y el caldo esté bien espeso.","Apaga el fuego, agrega la pizca de perejil y aplasta todo con un tenedor directamente en la olla, hasta que quede un puré espeso que se queda en la cuchara sin escurrir — a esta edad nada de licuadora ni colador.","Espera a que se enfríe por completo (unos 30 minutos) y reparte en frasquitos pequeños de vidrio con tapa, un frasquito por comida, anotando la fecha en la tapa; en el congelador dura 30 días o menos.","La noche anterior, pasa el frasquito del congelador al refrigerador y deja que se descongele de un día para otro; recalienta a baño maría o en una ollita a fuego bajo, revolviendo, sirve tibio probándolo en el dorso de la mano y tira lo que sobre en el plato, sin volver a congelar."],"alerta":"Sin sal y sin sazonador comercial. Aplasta siempre con tenedor: hasta los 9 meses las guías de alimentación infantil recomiendan evitar la licuadora y el colador."},{"id":1718,"name":"Croquetitas de Arroz con Zanahoria al Horno","icon":"🍙","time":"~40 min","kcal":"95 kcal por croquetita (estimado)","img":"https://images.pexels.com/photos/39224448/pexels-photo-39224448.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"12 croquetitas","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de arroz blanco cocido sin sal, ya frío","1 zanahoria mediana pelada y rallada finita","1 huevo entero","3 cucharadas de avena en hojuelas finas","1 cucharada de perejil picado","1 cucharadita de aceite de oliva para engrasar"],"tip":"Avena en hojuelas finas → cámbiala por 3 cucharadas de harina de arroz, en la misma cantidad. Congeladas crudas, las croquetitas van directo del congelador al horno en los días apurados.","steps":["Pon 2 tazas de arroz cocido frío en un tazón grande y aplástalo con un tenedor hasta que los granos se suelten y queden ligeramente machacados.","Agrega la zanahoria rallada bien finita, 1 huevo entero, 3 cucharadas de avena y 1 cucharada de perejil, y mezcla con las manos limpias hasta que quede una masa que se cierra en la palma sin desmoronarse (si se desmorona, agrega 1 cucharada más de avena).","Engrasa una bandeja de horno con 1 cucharadita de aceite de oliva y forma 12 croquetitas aplanadas del tamaño de la palma de un niño, de más o menos 1 dedo de alto, dejando espacio entre ellas.","Hornea en horno precalentado a 200 °C unos 22 minutos, volteándolas a la mitad del tiempo, hasta que estén firmes y doradas por fuera pero todavía suaves al apretarlas — la croquetita tiene que aplastarse entre el pulgar y el índice.","Deja que se enfríen por completo sobre una rejilla o un plato, unos 30 minutos, para que no se forme hielo dentro de la bolsita.","Congela primero separadas: pon las croquetitas frías sin que se toquen en una bandeja y llévalas al congelador 2 horas; después pásalas todas a un frasco o bolsita con la fecha escrita, donde duran 30 días o menos sin pegarse unas con otras.","Para servir, lleva las croquetitas todavía congeladas al horno a 180 °C unos 12 minutos, o descongélalas en el refrigerador de un día para otro y caliéntalas 6 minutos; ofrécelas tibias, en tiras del tamaño de un dedo de adulto, con el bebé bien sentado, y no vuelvas a congelar lo que sobre."],"alerta":"Nada de sal ni queso rallado industrializado. Ofrécelas siempre en tiras suaves y con un adulto cerca durante toda la comida."},{"id":1719,"name":"Panquequitos de Banana y Avena","icon":"🥞","time":"~25 min","kcal":"80 kcal por panquequito (estimado)","img":"https://images.pexels.com/photos/7144964/pexels-photo-7144964.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"10 panquequitos","ageRec":"A partir de los 8 meses","ingredients":["2 bananas (plátanos) bien maduras","2 huevos enteros","1/2 taza de avena en hojuelas finas","1 pizca de canela en polvo","1 cucharadita de aceite de oliva o de coco para engrasar el sartén"],"tip":"Banana → cámbiala por 1 taza de manzana cocida y aplastada, en la misma cantidad. Congelados con papel encerado entre ellos, salen uno por uno sin romperse.","steps":["Pela 2 bananas bien maduras, ponlas en un tazón y aplástalas con un tenedor hasta que queden como un puré liso, sin trozos grandes.","Agrega 2 huevos enteros, 1/2 taza de avena en hojuelas finas y 1 pizca de canela, y mezcla con el tenedor más o menos 1 minuto, hasta formar una masa cremosa que cae lentamente de la cuchara.","Deja reposar la masa 5 minutos para que la avena se hidrate y espese un poco — eso ayuda a que el panquequito no se deshaga en el sartén.","Calienta un sartén antiadherente a fuego bajo, engrásalo con poquísimo aceite usando papel de cocina y vierte 1 cucharada llena de masa por panquequito, formando discos del tamaño de la boca de una taza.","Dóralos unos 2 minutos de cada lado, volteándolos cuando aparezcan burbujitas en la superficie y el borde se suelte solo; el panquequito listo queda suave y se aplasta entre el pulgar y el índice.","Deja que se enfríen por completo sobre un plato, apílalos con un cuadradito de papel encerado entre cada uno y guárdalos en un frasco con tapa o en una bolsita para alimentos; en el congelador duran 30 días o menos.","Para servir, saca los panquequitos que vas a usar y descongélalos en el refrigerador de un día para otro (o 10 minutos afuera), calienta 1 minuto de cada lado en el sartén a fuego bajo, sírvelos tibios cortados en tiras del tamaño de un dedo de adulto y nunca los vuelvas a congelar."],"alerta":"Sin azúcar, sin miel y sin leche de vaca. La miel cuenta como azúcar y, igual que el azúcar, solo entra después de los 2 años — antes, el dulzor viene de la banana madura."},{"id":1720,"name":"Albóndigas de Pollo al Horno","icon":"🍗","time":"~45 min","kcal":"60 kcal por albóndiga (estimado)","img":"https://images.pexels.com/photos/5836992/pexels-photo-5836992.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"18 albóndigas","ageRec":"A partir de los 8 meses","ingredients":["400 g de pechuga de pollo molida en el momento","1 zanahoria pequeña pelada y rallada muy finita","1/2 cebolla pequeña rallada","1 diente de ajo machacado","1 huevo entero","3 cucharadas de avena en hojuelas finas","1 cucharada de perejil picado","1 cucharadita de aceite de oliva para engrasar"],"tip":"Pollo molido → cámbialo por 400 g de carne molida de res magra, en la misma cantidad. Congélalas crudas y horneadas en frascos separados: crudas para el día con tiempo, horneadas para el día apurado.","steps":["Pon 400 g de pollo molido en un tazón grande y agrega la zanahoria rallada finita, la cebolla rallada, el ajo machacado, 1 huevo, 3 cucharadas de avena y 1 cucharada de perejil.","Mezcla con las manos limpias unos 2 minutos, apretando bien, hasta que la masa quede pareja y se despegue de los lados del tazón.","Forma 18 albóndigas pequeñas, del tamaño de una nuez grande, rodándolas entre las palmas, y ponlas en una bandeja engrasada con 1 cucharadita de aceite de oliva, dejando un dedo de espacio entre ellas.","Hornea en horno precalentado a 200 °C unos 25 minutos, volteándolas a la mitad del tiempo; corta una albóndiga por la mitad para comprobar que el centro está blanquito, sin ningún punto rosado, y que suelta líquido transparente.","Deja que se enfríen por completo sobre la bandeja fuera del horno, unos 30 minutos, antes de envasarlas.","Guarda las albóndigas frías en frasquitos pequeños de vidrio con tapa, 3 o 4 por frasquito (una comida en cada uno), escribe la fecha en la tapa y congela: duran 30 días o menos.","La noche anterior, pasa el frasquito al refrigerador y descongela de un día para otro; recalienta en una olla tapada con un dedo de agua a fuego bajo 5 minutos o a baño maría, sírvelas tibias y deshechas con el tenedor en trocitos que se aplasten entre los dedos, y no las vuelvas a congelar."],"alerta":"El pollo siempre bien cocido hasta que el centro pierda el color rosado. A esta edad la albóndiga va deshecha con el tenedor, nunca entera y redonda — la bolita redonda es riesgo de atragantamiento."},{"id":1721,"name":"Muffin de Calabaza con Huevo","icon":"🎃","time":"~50 min","kcal":"85 kcal por muffin (estimado)","img":"https://images.pexels.com/photos/34516543/pexels-photo-34516543.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"12 muffins","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de calabaza (zapallo) kabocha cocida y aplastada","2 huevos enteros","1 taza de harina de trigo","3 cucharadas de aceite de oliva","1 cucharadita de polvo para hornear","1 cucharada de cebollín picado","1 pizca de orégano"],"tip":"Calabaza kabocha → cámbiala por 2 tazas de camote (batata) cocido y aplastado, en la misma cantidad. Un muffin por bolsita facilita sacar solo lo que vas a usar.","steps":["Cocina la calabaza en cubos en agua unos 15 minutos, hasta que un tenedor la atraviese sin resistencia, escúrrela bien y aplástala con el tenedor hasta que quede un puré espeso; deja que se entibie.","En un tazón, bate 2 huevos con un tenedor 1 minuto y agrega 3 cucharadas de aceite de oliva y el puré de calabaza, mezclando hasta que quede parejo.","Añade poco a poco 1 taza de harina de trigo cernida, el cebollín picado y la pizca de orégano, y mezcla solo hasta que desaparezca la harina seca — revolver de más deja el muffin chicloso.","Agrega al final 1 cucharadita de polvo para hornear, da tres vueltas suaves con la cuchara y reparte la masa en 12 moldecitos de silicona o de papel, llenándolos hasta dos tercios.","Hornea en horno precalentado a 180 °C unos 25 minutos, hasta que un palillo clavado en el centro salga limpio y el muffin vuelva a su forma al apretarlo suavemente; la textura final es esponjosita y se aplasta entre el pulgar y el índice.","Deja que se enfríen por completo sobre una rejilla, unos 40 minutos, y envuelve cada muffin frío en una bolsita pequeña para alimentos, o todos juntos en un recipiente con tapa, con la fecha escrita: duran 30 días o menos en el congelador.","Para servir, descongela el muffin en el refrigerador de un día para otro y caliéntalo 5 minutos en el horno a 160 °C, o déjalo 20 minutos a temperatura ambiente; ofrécelo tibio y partido por la mitad, en tiras del tamaño de un dedo de adulto, y no lo vuelvas a congelar."],"alerta":"Muffin sin sal, sin azúcar y sin leche de vaca. Ofrécelo siempre partido, nunca el muffin entero en la mano del bebé, y con el niño bien sentado."},{"id":1722,"name":"Ñoquis de Papa Caseros","icon":"🥔","time":"~55 min","kcal":"150 kcal por porción (estimado)","img":"https://images.pexels.com/photos/37316435/pexels-photo-37316435.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 10 meses","ingredients":["4 papas medianas (unos 700 g)","1 taza de harina de trigo, y un poco más para espolvorear","1 yema de huevo","1 cucharada de aceite de oliva","1 pizca de nuez moscada recién rallada","1 pizca de perejil picado"],"tip":"Harina de trigo → cámbiala por 1 taza de harina de arroz más 1 cucharada de fécula de maíz. Congélalos crudos: los ñoquis se cocinan directo del congelador, sin descongelar.","steps":["Cocina 4 papas medianas con cáscara en agua unos 25 minutos, hasta que un tenedor las atraviese sin resistencia; escúrrelas, pélalas todavía calientes sujetándolas con un trapo y aplástalas con el tenedor o el pisapapas hasta que no quede ningún grumo.","Extiende la papa aplastada sobre la mesa de trabajo para que suelte el vapor 10 minutos — la papa muy húmeda pide más harina y deja el ñoqui duro.","Agrega 1 yema, 1 cucharada de aceite de oliva, la pizca de nuez moscada y el perejil, y ve añadiendo la harina poco a poco, amasando con las manos solo hasta formar una masa lisa que se despegue de los dedos (tal vez no uses la taza entera).","Espolvorea la mesa con harina, haz rollitos del grosor de un dedo y corta trocitos de más o menos 1,5 cm, del tamaño de la uña del pulgar — trozo pequeño y suave, adecuado para el movimiento de pinza de los 10 meses.","Cocina una porción de prueba en agua hirviendo sin sal unos 2 minutos, hasta que los ñoquis suban a la superficie; prueba uno: tiene que aplastarse con facilidad entre el pulgar y el índice.","Para congelar, extiende los ñoquis crudos y espolvoreados con harina en una bandeja forrada, sin que se toquen, llévalos al congelador 2 horas y después júntalos todos en una bolsita para alimentos con la fecha escrita: duran 60 días o menos.","El día de servir, echa los ñoquis todavía congelados directo en el agua hirviendo sin sal unos 3 minutos, hasta que suban, escúrrelos, agrégales un chorrito de aceite de oliva o salsa de tomate casera y sírvelos tibios; nunca vuelvas a congelar ñoquis ya cocidos."],"alerta":"El agua de cocción siempre sin sal. Corta los ñoquis bien pequeños y comprueba que se aplasten entre los dedos antes de llevarlos al plato."},{"id":1723,"name":"Hamburguesa de Pollo al Horno","icon":"🍔","time":"~40 min","kcal":"110 kcal por hamburguesa (estimado)","img":"https://images.pexels.com/photos/6676013/pexels-photo-6676013.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 hamburguesas","ageRec":"A partir de los 10 meses","ingredients":["500 g de pechuga de pollo molida en el momento","1/2 calabacita (zucchini) rallada y exprimida en un trapo","1/2 cebolla pequeña rallada","1 diente de ajo machacado","1 huevo entero","4 cucharadas de harina de avena","1 pizca de pimentón dulce (paprika)","1 cucharada de perejil picado"],"tip":"Calabacita → cámbiala por 1 zanahoria pequeña rallada y exprimida, en la misma cantidad. Separa cada hamburguesa con papel encerado antes de congelar para sacar una por vez.","steps":["Ralla 1/2 calabacita con el rallador grueso, júntala en un trapo limpio y retuércelo para exprimir el agua — si queda demasiado húmeda, la hamburguesa se deshace en la bandeja.","En un tazón, mezcla 500 g de pollo molido, la calabacita exprimida, la cebolla rallada, el ajo machacado, 1 huevo, 4 cucharadas de harina de avena, la pizca de pimentón dulce y el perejil.","Amasa con las manos limpias unos 2 minutos, hasta que la masa quede bien unida y ya no se pegue a los lados del tazón.","Divide en 8 porciones iguales y forma discos de más o menos 1 dedo de alto y del tamaño de la palma de un niño, acomodándolos en una bandeja engrasada con un chorrito de aceite de oliva.","Hornea en horno precalentado a 200 °C unos 20 minutos, volteándolas a la mitad; corta una por la mitad para comprobar que el centro está blanquito, sin punto rosado, y que la carne se deshace al apretarla con el tenedor.","Deja que se enfríen por completo unos 30 minutos, apílalas con un cuadrado de papel encerado entre cada hamburguesa y guárdalas en un recipiente con tapa o en una bolsita para alimentos, con la fecha escrita: duran 30 días o menos en el congelador.","La noche anterior, pásalas al refrigerador y descongela de un día para otro; recalienta en el horno a 180 °C 10 minutos o en un sartén tapado a fuego bajo, corta en trocitos pequeños que se aplasten entre los dedos, sirve tibio probando en el dorso de la mano y tira lo que sobre sin volver a congelar."],"alerta":"Sin sal y sin sazonador comercial. Ofrécela siempre cortada en trozos pequeños y suaves, con el niño bien sentado y un adulto cerca."},{"id":1724,"name":"Croquetitas de Pescado con Papa","icon":"🐟","time":"~50 min","kcal":"90 kcal por croquetita (estimado)","img":"https://images.pexels.com/photos/8732583/pexels-photo-8732583.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"12 croquetitas","ageRec":"A partir de los 10 meses","ingredients":["300 g de filete de pescado blanco sin espinas (tilapia o merluza)","3 papas medianas peladas en cubos","1/2 cebolla pequeña rallada","1 cucharada de perejil picado","1 huevo entero","2 cucharadas de harina de avena","1 cucharada de aceite de oliva","Jugo de 1/2 limón"],"tip":"Pescado blanco → cámbialo por 300 g de pechuga de pollo cocida y deshebrada, en la misma cantidad. Congeladas ya horneadas, quedan listas con 12 minutos de horno.","steps":["Rocía el filete de pescado con el jugo de 1/2 limón, déjalo 10 minutos y cocínalo al vapor o en agua unos 10 minutos, hasta que la carne quede opaca y se separe en lascas con el tenedor.","Revisa el pescado cocido con los dedos, palpando lasca por lasca con las yemas para asegurarte de que no quedó ninguna espina, y desmenúzalo bien finito.","Cocina las 3 papas en cubos unos 15 minutos, hasta que un tenedor las atraviese sin resistencia, escúrrelas muy bien y aplástalas con el tenedor todavía calientes hasta que quede un puré firme.","Mezcla en un tazón el puré de papa, el pescado desmenuzado, la cebolla rallada, el perejil, 1 huevo, 2 cucharadas de harina de avena y 1 cucharada de aceite de oliva, hasta formar una masa que se cierra en la palma sin pegarse.","Forma 12 croquetitas aplanadas del tamaño de la palma de un niño y hornéalas en horno precalentado a 200 °C unos 20 minutos, volteándolas a la mitad, hasta que estén doradas por fuera y sigan suaves al apretarlas entre el pulgar y el índice.","Deja que se enfríen por completo unos 30 minutos, congélalas separadas en una bandeja 2 horas y solo entonces júntalas en un frasquito con tapa o en una bolsita con la fecha escrita: duran 30 días o menos.","Para servir, lleva las croquetitas todavía congeladas al horno a 180 °C unos 12 minutos, o descongélalas en el refrigerador de un día para otro y caliéntalas 6 minutos; ofrécelas tibias, partidas en trozos pequeños, y no las vuelvas a congelar."],"alerta":"Revisa el pescado espina por espina con la yema de los dedos antes de mezclar — una espina es riesgo serio de atragantamiento. Nada de sal."},{"id":1725,"name":"Arroz Sazonado en Porciones","icon":"🍚","time":"~35 min","kcal":"140 kcal por porción (estimado)","img":"https://images.pexels.com/photos/31346219/pexels-photo-31346219.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 tazas de arroz blanco lavado y escurrido","1 zanahoria pequeña pelada en cubitos muy pequeños","1/2 taza de calabacita (zucchini) en cubitos muy pequeños","1/2 cebolla pequeña picada finita","1 diente de ajo picado","2 cucharadas de aceite de oliva","4 tazas de agua filtrada o caldito de verduras casero","1 pizca de cúrcuma"],"tip":"Calabacita → cámbiala por 1/2 taza de ejotes (judías verdes) picados muy finitos, en la misma cantidad. Un frasquito por comida se vuelve un almuerzo listo en 5 minutos.","steps":["Calienta 2 cucharadas de aceite de oliva en una olla, agrega la cebolla y el ajo picados y sofríe a fuego bajo unos 4 minutos, hasta que la cebolla esté transparente.","Añade la zanahoria y la calabacita en cubitos muy pequeños y la pizca de cúrcuma, y sofríe 3 minutos más, revolviendo.","Agrega 2 tazas de arroz lavado, revuelve 1 minuto para que se impregne del aceite y añade 4 tazas de agua filtrada o de caldito de verduras casero.","Cocina a fuego bajo con la olla semitapada unos 18 minutos, hasta que el agua se seque por completo y el arroz quede bien suave — más blandito que el arroz del adulto, porque tiene que aplastarse entre el pulgar y el índice.","Apaga, suelta los granos con un tenedor y extiende el arroz en una bandeja grande para que se enfríe rápido y por completo, en unos 25 minutos.","Reparte el arroz frío en frasquitos pequeños de vidrio con tapa, uno por comida, aprieta suavemente para que no quede aire, escribe la fecha en la tapa y congela: dura 30 días o menos.","La noche anterior, pasa el frasquito al refrigerador y descongela de un día para otro; recalienta a baño maría o en una ollita a fuego bajo con 1 cucharada de agua, revolviendo hasta que se suelten los granos, sirve tibio probándolo en el dorso de la mano y nunca lo vuelvas a congelar."],"alerta":"El arroz cocido es un alimento delicado: enfríalo rápido, congélalo el mismo día y nunca lo dejes descongelando fuera del refrigerador. Sin sal."},{"id":1726,"name":"Crepas de Huevo con Queso para Congelar","icon":"🫓","time":"~25 min","kcal":"120 kcal por crepa (estimado)","img":"https://images.pexels.com/photos/38441764/pexels-photo-38441764.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 crepas","ageRec":"A partir de los 12 meses","ingredients":["4 huevos enteros","8 cucharadas de fécula de maíz disuelta en un poco de agua","1/2 taza de queso fresco aplastado con el tenedor","1 cucharada de orégano seco","1 cucharadita de aceite de oliva para engrasar el sartén"],"tip":"Queso fresco → cámbialo por 1/2 taza de ricota fresca aplastada, en la misma cantidad. Apílalas con papel encerado entre ellas y saca una a la vez.","steps":["Bate 4 huevos con un tenedor en un tazón más o menos 1 minuto, hasta que la yema y la clara estén completamente mezcladas y un poco espumosas.","Agrega las 8 cucharadas de fécula de maíz disuelta, el queso fresco aplastado con el tenedor y 1 cucharada de orégano, y mezcla hasta formar una masa pareja que todavía cae de la cuchara.","Calienta un sartén antiadherente a fuego bajo, engrásalo con poquísimo aceite extendido con papel de cocina y vierte 1 cucharón pequeño de masa, girando el sartén para formar un disco delgado.","Cocina unos 2 minutos de cada lado, volteando cuando el borde se suelte solo y la superficie ya no esté líquida; la crepa lista es suave y se dobla sin romperse.","Repite hasta terminar la masa, apilando las crepas en un plato, y deja que se enfríen por completo unos 30 minutos antes de envasarlas.","Pon un cuadradito de papel encerado entre cada crepa, guarda la pila en una bolsita para alimentos o en un recipiente con tapa, escribe la fecha y congela: duran 30 días o menos.","Para servir, saca solo las crepas que vas a usar, descongélalas en el refrigerador de un día para otro y caliéntalas 1 minuto de cada lado en un sartén a fuego bajo; córtalas en tiras del tamaño de un dedo de adulto, sírvelas tibias y no las vuelvas a congelar."],"alerta":"Receta con queso, por eso a partir de los 12 meses y sin sal agregada. Sírvela siempre cortada en tiras, nunca la crepa entera enrollada."},{"id":1727,"name":"Pastita Casera de Espinaca","icon":"🍝","time":"~60 min","kcal":"160 kcal por porción (estimado)","img":"https://images.pexels.com/photos/17663528/pexels-photo-17663528.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 tazas de harina de trigo, y un poco más para espolvorear","1 taza de hojas de espinaca bien lavadas","2 huevos enteros","1 cucharada de aceite de oliva","1 pizca de nuez moscada recién rallada"],"tip":"Espinaca → cámbiala por 1 taza de hojas de acelga sin el tallo, en la misma cantidad. Congelada en nidos, se cocina directo del congelador en 4 minutos.","steps":["Lava bien 1 taza de hojas de espinaca, cocínalas al vapor unos 3 minutos hasta que se marchiten, escúrrelas apretando bien contra el colador y pícalas muy finito con el cuchillo.","En un tazón, mezcla 2 tazas de harina de trigo, la espinaca picada, 2 huevos, 1 cucharada de aceite de oliva y la pizca de nuez moscada.","Amasa sobre la mesa de trabajo enharinada unos 10 minutos, hasta que la masa quede lisa, verde clara y elástica, sin pegarse a las manos; envuélvela en plástico y déjala reposar 30 minutos a temperatura ambiente.","Estira la masa con el rodillo hasta que quede bien delgada (se ve la sombra de la mano a través de ella), espolvorea harina, enróllala como un brazo de reina y corta tiritas de más o menos medio dedo de ancho; suelta las tiras con las manos.","Cocina una porción de prueba en agua hirviendo sin sal unos 3 minutos; la pastita lista queda bien suave y se parte con la presión del tenedor, y se debe servir en trozos cortos, de unos dos dedos, para que no se enrede en la boca.","Para congelar, haz nidos con la masa cruda espolvoreada con harina, ponlos en una bandeja sin que se toquen, llévalos al congelador 2 horas y después guárdalos todos en una bolsita para alimentos con la fecha escrita: duran 60 días o menos.","Ese día, echa los nidos todavía congelados directo en el agua hirviendo sin sal unos 4 minutos, escúrrelos, mézclalos con salsa de tomate casera o un chorrito de aceite de oliva, corta con la tijera en trozos cortos y sirve tibio; nunca vuelvas a congelar pasta ya cocida."],"alerta":"Corta la pastita en trozos cortos antes de servir: una tira larga se puede enredar en la boca. El agua de cocción siempre sin sal."},{"id":1728,"name":"Albóndigas de Carne en Salsa de Tomate","icon":"🍅","time":"~55 min","kcal":"130 kcal por porción (estimado)","img":"https://images.pexels.com/photos/36958915/pexels-photo-36958915.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 porciones","ageRec":"A partir de los 12 meses","ingredients":["500 g de carne molida de res magra","1 huevo entero","4 cucharadas de harina de avena","1/2 cebolla pequeña rallada","1 diente de ajo machacado","1 cucharada de perejil picado","6 tomates (jitomates) maduros sin piel y sin semillas, picados","2 cucharadas de aceite de oliva","1 pizca de orégano"],"tip":"Carne molida de res → cámbiala por 500 g de pechuga de pollo molida, en la misma cantidad. Congélalas junto con la salsa: la salsa protege la carne para que no se reseque.","steps":["Mezcla en un tazón 500 g de carne molida, 1 huevo, 4 cucharadas de harina de avena, la cebolla rallada, el ajo machacado y el perejil, amasando con las manos 2 minutos hasta que la masa quede bien unida.","Forma 24 albóndigas pequeñas, del tamaño de una nuez, y guárdalas en el refrigerador 10 minutos para que se afirmen.","Haz la salsa: calienta 2 cucharadas de aceite de oliva en una olla ancha, sofríe los 6 tomates sin piel y sin semillas picados con la pizca de orégano unos 15 minutos, revolviendo, hasta que se deshagan y formen una salsa espesa.","Pon las albóndigas dentro de la salsa, tapa la olla y cocina a fuego bajo unos 20 minutos, volteándolas a la mitad; corta una por la mitad para comprobar que el centro está cocido por igual, sin punto rojo, y que se deshace con el tenedor.","Apaga y deja que se enfríen por completo en la olla destapada, unos 40 minutos — nunca lleves comida tibia al congelador.","Reparte en frasquitos pequeños de vidrio con tapa, 3 albóndigas con salsa por frasquito (una comida en cada uno), dejando un dedo de espacio arriba, escribe la fecha y congela: duran 30 días o menos.","La noche anterior, pasa el frasquito al refrigerador y descongela de un día para otro; recalienta a baño maría o en una ollita a fuego bajo 6 minutos, deshaz las albóndigas con el tenedor en trozos pequeños, sirve tibio probando en el dorso de la mano y tira lo que sobre en el plato sin volver a congelar."],"alerta":"Sin sal y sin salsa de tomate industrializada. Sirve la albóndiga siempre deshecha o cortada en cuatro, nunca entera y redonda."},{"id":1729,"name":"Muffin de Queso con Zanahoria","icon":"🧀","time":"~45 min","kcal":"100 kcal por muffin (estimado)","img":"https://images.pexels.com/photos/37431708/pexels-photo-37431708.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"12 muffins","ageRec":"A partir de los 12 meses","ingredients":["1 taza de zanahoria pelada y rallada muy finita","1/2 taza de queso fresco rallado grueso","2 huevos enteros","1 taza de harina de trigo","1/2 taza de leche entera","3 cucharadas de aceite de oliva","1 cucharadita de polvo para hornear","1 pizca de orégano"],"tip":"Queso fresco → cámbialo por 1/2 taza de ricota fresca desmoronada, en la misma cantidad. Congela uno por bolsita: se vuelve merienda en 20 minutos fuera del congelador.","steps":["Pela y ralla 1 taza de zanahoria con el rallador fino y ralla 1/2 taza de queso fresco con el rallador grueso, guardando los dos por separado.","En un tazón, bate 2 huevos con un tenedor 1 minuto y agrega 1/2 taza de leche entera y 3 cucharadas de aceite de oliva, mezclando bien.","Añade 1 taza de harina de trigo cernida, la zanahoria rallada, el queso y la pizca de orégano, y mezcla solo hasta que desaparezca la harina seca, sin batir de más.","Agrega al final 1 cucharadita de polvo para hornear, da tres vueltas con la cuchara y reparte la masa en 12 moldecitos, llenándolos hasta dos tercios de la altura.","Hornea en horno precalentado a 180 °C unos 25 minutos, hasta que se doren ligeramente y un palillo clavado en el centro salga limpio; el muffin listo es esponjosito y se aplasta entre el pulgar y el índice.","Deja que se enfríen por completo sobre una rejilla unos 40 minutos y envuelve cada muffin frío en una bolsita pequeña para alimentos, con la fecha escrita en el empaque: duran 30 días o menos en el congelador.","Para servir, descongela en el refrigerador de un día para otro o déjalo 20 minutos a temperatura ambiente y caliéntalo 5 minutos en el horno a 160 °C; ofrécelo tibio y partido en cuatro trozos, y no vuelvas a congelar lo que sobre."],"alerta":"Lleva queso y leche de vaca en preparación, por eso solo a partir de los 12 meses. Sin sal y sin azúcar, y siempre partido antes de servir."}],"9":[{"id":1730,"name":"Crema de Papaya con Banana Machacada","icon":"🥭","time":"~10 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/9590275/pexels-photo-9590275.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de papaya bien madura en cubos (sin semillas y sin cáscara)","1/2 banana (plátano) pequeña bien madura","1 pizca de canela en polvo (opcional)"],"tip":"La papaya y la banana son frutas suaves y dulces que forman parte de una alimentación variada y de colores. Esta receta no es un remedio: es un alimento rico más dentro de la rutina del bebé. Cambio: papaya grande → papaya pequeña, en la misma cantidad; una variedad de banana → otra variedad de banana bien madura, en la misma cantidad.","steps":["Elige una papaya bien madura, que ceda a una leve presión del dedo, córtala a la mitad y quita TODAS las semillas negras con una cuchara, raspando bien el hueco.","Corta 1/2 taza de la pulpa en cubos pequeños y ponla en un platito hondo, desechando cualquier parte verdosa o firme cerca de la cáscara.","Pela 1/2 banana bien madura (cáscara con puntitos oscuros) y ponla con la papaya en el mismo platito.","Machaca las dos frutas con el dorso de un tenedor, apretando contra el fondo del plato por 1 minuto más o menos, hasta que quede una crema espesa y pareja, sin ningún trozo más grande que un grano de arroz. No uses licuadora, batidora de mano ni colador en esta etapa.","Espolvorea 1 pizca de canela en polvo por encima y mezcla con el tenedor, si quieres darle sabor sin usar azúcar.","Revisa la textura: la crema debe quedarse quieta en la cuchara inclinada, sin escurrir. Si está muy aguada, agrega otro pedacito de banana y machaca de nuevo.","Sirve de inmediato, a temperatura ambiente, con CUCHARA: nunca en vaso, biberón ni popote. Antes de cumplir 1 año, la fruta es comida de cuchara, no bebida. Ofrece de 2 a 4 cucharaditas al ras con el bebé bien sentado y un adulto a su lado durante toda la comida."],"alerta":"Quita todas las semillas de la papaya: son pequeñas, redondas y resbalosas, una forma de alto riesgo de atragantamiento. No la licúes ni la cueles: antes de los 9 meses la textura tiene que ser machacada con tenedor."},{"id":1731,"name":"Crema de Mango con Aguacate","icon":"🥑","time":"~10 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/13222801/pexels-photo-13222801.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de mango bien maduro en cubos","2 cucharadas de pulpa de aguacate (palta) maduro","1 pizca de hierbabuena fresca picada muy fina (opcional)"],"tip":"El mango es dulce y cremoso, y el aguacate aporta grasa buena, que ayuda al cuerpo a aprovechar mejor lo que viene en la fruta. Es una combinación nutritiva dentro de una alimentación variada; no es un remedio. Cambio: mango → otra variedad de mango bien maduro, en la misma cantidad; aguacate → aguacate hass, en la misma cantidad.","steps":["Pela el mango con un cuchillo, corta la pulpa pegada al hueso y separa 1/2 taza de cubos pequeños, desechando las fibras más duras que quedan pegadas al hueso.","Corta el aguacate a la mitad, quita el hueso y saca 2 cucharadas de pulpa solo de la parte verde clara y suave, sin la cáscara oscura ni la parte amarga cerca de la cáscara.","Pon el mango en un platito hondo y machácalo solo con el tenedor por 1 minuto más o menos, apretando bien, hasta que no quede ninguna hebra gruesa.","Agrega el aguacate y machaca 1 minuto más, mezclando con el tenedor hasta que la crema quede lisa, verde anaranjada y pareja. Sin licuadora, sin batidora de mano y sin colador en esta etapa.","Agrega la pizca de hierbabuena picada muy fina, si quieres, y mezcla. No pongas azúcar, miel ni leche de vaca.","Prueba la consistencia: debe ser una crema espesa, que se queda en la cuchara inclinada sin gotear. Si queda muy blanda, agrega 1 cucharada más de aguacate.","Sirve al momento, a temperatura ambiente, con CUCHARA y nunca en vaso o biberón: antes de los 12 meses esta preparación es papilla de fruta, no un licuado para beber. Ofrece de 2 a 4 cucharaditas con el bebé bien sentado."],"alerta":"El aguacate se oscurece rápido: prepáralo y sírvelo al momento, no lo guardes para la siguiente comida. Nada de azúcar ni miel: la miel también es azúcar y solo entra después de los 2 años."},{"id":1732,"name":"Crema de Guayaba Rosada Raspada","icon":"🍈","time":"~12 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/1412550/pexels-photo-1412550.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 6 meses","ingredients":["1 guayaba rosada mediana bien madura","1/2 banana (plátano) pequeña bien madura","1 cucharada de agua filtrada tibia, si hace falta aflojar la crema"],"tip":"La guayaba rosada es una fruta muy aromática y la banana le da cremosidad y energía. Servir fruta fresca variada es parte de una alimentación equilibrada; esta receta no es un remedio. Cambio: guayaba rosada → guayaba blanca bien madura, en la misma cantidad; una variedad de banana → otra variedad de banana bien madura, en la misma cantidad.","steps":["Lava la guayaba con agua corriente frotando la cáscara con las manos, córtala a la mitad y observa el centro lleno de semillas duras.","Quita y desecha TODO el centro con semillas usando una cucharita, dejando solo la parte de afuera, firme y rosada, de la fruta: las semillas de la guayaba son durísimas y no pueden ir al plato del bebé.","Raspa la parte de afuera de la guayaba con la punta de una cucharita, siempre en el mismo sentido, hasta sacar unas 3 cucharadas de pulpa raspada muy finita en un platito hondo.","Pela 1/2 banana bien madura, ponla con la guayaba raspada y machaca todo con el dorso del tenedor por 1 minuto más o menos, hasta formar una crema espesa y pareja, sin hebras y sin trozos más grandes que un grano de arroz. No uses licuadora ni colador en esta etapa.","Si la crema queda muy firme, agrega 1 cucharada de agua filtrada tibia y machaca de nuevo: nunca uses leche de vaca ni azúcar para aflojarla.","Revisa la textura final: puré espeso que se queda quieto en la cuchara inclinada. Pasa la crema entre los dedos para confirmar que no quedó ningún pedacito de semilla.","Sirve tibio o a temperatura ambiente (prueba en el dorso de la mano), con CUCHARA, en porciones de 2 a 3 cucharaditas. A esta edad la fruta no va en vaso ni en biberón: es papilla de cuchara, con el bebé bien sentado y bajo supervisión."],"alerta":"Las semillas de la guayaba son duras y del tamaño de la vía respiratoria del bebé: desecha todo el centro y pasa la crema entre los dedos antes de servir para asegurarte de que no quedó ninguna."},{"id":1733,"name":"Crema de Zanahoria con Banana y Avena","icon":"🥕","time":"~20 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/7865794/pexels-photo-7865794.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 8 meses","ingredients":["1/2 zanahoria mediana pelada en rodajas gruesas","1 banana (plátano) pequeña bien madura","1 cucharada al ras de avena en hojuelas finas","1/2 taza de agua filtrada para cocinar","1 pizca de canela en polvo"],"tip":"La zanahoria, la avena y la banana son tres alimentos que forman parte de una alimentación variada y de colores. Ningún alimento solo es un remedio; esta receta es una buena opción de merienda. Cambio: zanahoria → calabaza (zapallo) cocida, en la misma cantidad; avena en hojuelas finas → avena en hojuelas gruesas molida en seco, en la misma cantidad.","steps":["Pela 1/2 zanahoria mediana, córtala en rodajas de más o menos 1 dedo de grosor y ponlas en una olla pequeña con 1/2 taza de agua filtrada, sin sal.","Cocina a fuego medio unos 15 minutos, con la olla medio tapada, hasta que un tenedor atraviese la rodaja sin ninguna resistencia; si todavía se resiste, cocina 3 minutos más.","Agrega 1 cucharada al ras de avena en hojuelas finas a la olla en los últimos 3 minutos de cocción y mezcla, hasta que la avena se hinche y el agua casi se seque por completo.","Escurre el exceso de agua, pasa todo a un platito hondo y machaca la zanahoria con el dorso del tenedor por 1 minuto más o menos, dejando algunos pedacitos suaves que se noten, del tamaño de medio grano de arroz: en esta etapa la textura ya puede ser un poco más gruesa, pero todavía sin licuadora ni colador.","Pela la banana bien madura, agrégala al plato y machaca todo junto hasta formar una crema espesa anaranjada con pedacitos suaves que se deshacen entre el pulgar y el índice.","Espolvorea 1 pizca de canela en polvo y mezcla con el tenedor. No agregues sal, azúcar, miel ni leche de vaca.","Deja entibiar, prueba la temperatura en el dorso de la mano y sirve con CUCHARA, en porciones de 3 a 5 cucharaditas. Antes de los 12 meses esta preparación no va en vaso ni con popote: es crema de cuchara, con el bebé bien sentado y un adulto cerca."],"alerta":"La zanahoria cruda o mal cocida es riesgo de atragantamiento: sírvela solo cuando el tenedor la atraviese sin resistencia y el pedacito se aplaste entre los dedos. Sin sal y sin azúcar."},{"id":1734,"name":"Crema de Remolacha con Manzana Cocida","icon":"🫐","time":"~25 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/20004821/pexels-photo-20004821.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 8 meses","ingredients":["1/3 de remolacha (betabel) pequeña pelada en cubos","1/2 manzana pequeña pelada y sin semillas, en cubos","1/2 taza de agua filtrada para cocinar","1 pizca de canela en polvo"],"tip":"La remolacha y la manzana forman una pareja de colores y sabor suave dentro de una alimentación variada; esta receta no es un remedio. Cambio: remolacha → calabaza (zapallo), en la misma cantidad; manzana → pera madura, en la misma cantidad.","steps":["Pela 1/3 de una remolacha pequeña y córtala en cubos de 1 cm más o menos; ponlos en una olla pequeña con 1/2 taza de agua filtrada, sin sal.","Cocina a fuego medio unos 18 minutos con la olla medio tapada: la remolacha es dura y necesita todo ese tiempo para estar en su punto.","Pela 1/2 manzana, quítale por completo el centro y las semillas, córtala en cubos y agrégala a la olla en los últimos 7 minutos de cocción.","Cocina hasta que un tenedor atraviese tanto la remolacha como la manzana sin ninguna resistencia y el agua esté casi seca; si todavía se resisten, cocina 4 minutos más con un poco más de agua.","Escurre, pasa a un platito hondo y machaca todo con el dorso del tenedor por unos 2 minutos, hasta que quede una crema espesa rosa oscuro con pedacitos suaves que se deshacen entre el pulgar y el índice. No uses licuadora ni colador.","Espolvorea 1 pizca de canela en polvo, mezcla y revisa que la crema se quede en la cuchara inclinada sin escurrir; si está muy seca, agrega 1 cucharada del agua de la cocción.","Deja entibiar, prueba en el dorso de la mano y sirve con CUCHARA, de 3 a 5 cucharaditas. A esta edad nada de servir en vaso o con popote: es papilla de cuchara, con el bebé bien sentado y supervisado."],"alerta":"La remolacha puede dejar la pipí y la popó rojizas por uno o dos días: es normal y se pasa. Quita todas las semillas de la manzana y cocínala bien: la manzana cruda y dura es riesgo de atragantamiento."},{"id":1735,"name":"Crema de Fresa con Yogur Natural","icon":"🍓","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/7508114/pexels-photo-7508114.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 10 meses","ingredients":["5 fresas (frutillas) medianas bien maduras, sin las hojas","3 cucharadas de yogur natural entero sin azúcar","1/2 banana (plátano) pequeña bien madura"],"tip":"La fresa, el yogur natural entero y la banana se combinan en una crema suave y cremosa, como parte de una alimentación variada; no es un remedio. Confirma con tu pediatra si ya puedes darle yogur a tu bebé. Cambio: fresa → guayaba rosada sin semillas, en la misma cantidad; yogur natural entero → yogur natural descremado solo si tu pediatra lo indica, en la misma cantidad.","steps":["Lava 5 fresas maduras con agua corriente una por una, frotando suave con los dedos, y déjalas en remojo 10 minutos en agua con 1 cucharada de vinagre; después enjuágalas bien.","Quita las hojitas verdes y la parte blanca y dura del tallito de cada fresa, cortando con un cuchillo: esa parte no se aplasta entre los dedos y no puede ir al plato.","Corta las fresas en cuatro a lo largo y ponlas en un platito hondo, junto con 1/2 banana bien madura pelada.","Machaca las frutas con el dorso del tenedor por unos 2 minutos, apretando bien contra el fondo, hasta que quede una pulpa roja espesa, sin ningún trozo más grande que medio grano de arroz.","Agrega 3 cucharadas de yogur natural entero SIN azúcar (revisa la etiqueta: los ingredientes deben ser solo leche y cultivos lácteos) y mezcla con el tenedor hasta que la crema quede rosada y pareja.","Revisa la textura: una crema espesa que se queda quieta en la cuchara inclinada. Si queda aguada, agrega otro pedazo de banana machacada; nunca la espeses con azúcar, miel ni leche de vaca.","Sirve de inmediato, fría o a temperatura ambiente, con CUCHARA, en porciones de 3 a 5 cucharaditas. Antes de los 12 meses esta preparación no es para beber en vaso ni con popote: es crema de cuchara, con el bebé bien sentado y un adulto a su lado."],"alerta":"La fresa es un alérgeno común: ofrécela por primera vez en la mañana, sola y en poca cantidad, y observa por 2 a 3 días. El yogur tiene que ser natural entero sin azúcar: nada de yogur de colores con pulpa ni de botellita."},{"id":1736,"name":"Crema de Papaya con Yogur y Avena","icon":"🥣","time":"~12 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/12042271/pexels-photo-12042271.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones para bebé","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de papaya madura en cubos, sin semillas","3 cucharadas de yogur natural entero sin azúcar","1 cucharada al ras de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"La papaya, la avena y el yogur natural entero forman una crema completa y suave dentro de una alimentación variada y de colores; esta receta no es un remedio. Cambio: papaya → mango bien maduro, en la misma cantidad; avena en hojuelas finas → avena en hojuelas gruesas machacada, en la misma cantidad.","steps":["Corta la papaya madura a la mitad y quita TODAS las semillas negras con una cuchara, raspando bien el hueco hasta que no quede ninguna.","Separa 1/2 taza de pulpa en cubos pequeños y ponla en un platito hondo, desechando las partes verdosas y más firmes cerca de la cáscara.","Machaca la papaya con el dorso del tenedor por 1 minuto más o menos, apretando contra el fondo del plato, hasta que quede una pulpa lisa sin trozos grandes.","Mezcla 1 cucharada al ras de avena en hojuelas finas con la papaya machacada y deja reposar 5 minutos: la avena absorbe el líquido de la fruta, se ablanda por completo y espesa la crema de forma natural, sin necesidad de azúcar.","Agrega 3 cucharadas de yogur natural entero sin azúcar (etiqueta con solo leche y cultivos lácteos) y mueve con el tenedor hasta que quede una crema clara y pareja.","Espolvorea 1 pizca de canela en polvo y revisa la textura: debe ser una crema espesa que se queda quieta en la cuchara inclinada, con la avena ya suave y ninguna hojuela seca o que raspe.","Sirve al momento, a temperatura ambiente o un poco fría, con CUCHARA, en porciones de 3 a 5 cucharaditas: nunca en vaso, biberón ni popote antes de los 12 meses. Bebé bien sentado, sin pantallas, con un adulto cerca durante toda la comida."],"alerta":"No la sirvas con la avena todavía seca: espera los 5 minutos de reposo hasta que la hojuela se ablande, para que no raspe la garganta. Yogur solo natural entero sin azúcar, con el visto bueno de tu pediatra."},{"id":1737,"name":"Licuado de Mango con Naranja Dulce","icon":"🍹","time":"~10 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/8211179/pexels-photo-8211179.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de mango bien maduro en cubos","2 gajos de naranja dulce (de poca acidez) sin semillas y sin la piel blanca","3 cucharadas de yogur natural entero sin azúcar","2 cucharadas de agua filtrada fría"],"tip":"La naranja, el mango y el yogur natural entero hacen un licuado suave que forma parte de una alimentación variada en esta etapa de guardería. El licuado acompaña el día, no reemplaza una comida y no es un remedio. Cambio: naranja dulce → mandarina sin semillas, en la misma cantidad; mango → papaya madura, en la misma cantidad.","steps":["Pela el mango, corta la pulpa pegada al hueso y separa 1/2 taza de cubos, desechando las fibras duras pegadas al hueso.","Pela 2 gajos de naranja dulce, abre cada gajo con los dedos y quita TODAS las semillas y lo más que puedas de la piel blanca, que deja sabor amargo.","Pon el mango, los gajos de naranja, 3 cucharadas de yogur natural entero sin azúcar y 2 cucharadas de agua filtrada fría en el vaso de la licuadora: a partir de los 12 meses la licuadora ya está permitida.","Licúa a velocidad media unos 40 segundos, parando una vez para raspar los lados del vaso, hasta que quede un licuado liso y cremoso, sin hebras de fruta que se noten.","Pruébalo con una cuchara limpia (nunca la misma que va a la boca del bebé) para confirmar que está dulce por la misma fruta: no agregues azúcar ni miel para endulzar.","Mide 100 ml como máximo y sirve en vaso entrenador o vaso abierto pequeño, frío o a temperatura ambiente, con el niño bien sentado a la mesa.","Ofrece el licuado como parte de una merienda, junto con una fruta en trozos o un pedazo de pan casero: es un acompañamiento y nunca reemplaza el almuerzo, la cena ni la toma de leche."],"alerta":"Máximo 100 ml por vez y una vez al día como máximo: tomar mucha bebida de fruta le quita espacio a la comida de verdad. Quita todas las semillas de la naranja y sirve en vaso, nunca en biberón ni con popote con el niño acostado."},{"id":1738,"name":"Licuado de Acerola con Banana y Agua de Coco","icon":"🍒","time":"~10 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/4051777/pexels-photo-4051777.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["6 acerolas maduras, sin hueso","1 banana (plátano) pequeña bien madura","1/3 taza de agua de coco natural fría"],"tip":"La acerola es una fruta ácida y muy aromática, la banana le da dulzor y el agua de coco natural la hace más ligera y refrescante. Es parte de una alimentación variada en esta etapa; la receta no es un remedio para resfriados ni para nada más. Cambio: acerola fresca → pulpa de acerola congelada sin azúcar, 2 cucharadas; agua de coco → agua filtrada fría, en la misma cantidad.","steps":["Lava 6 acerolas maduras con agua corriente, déjalas en remojo 10 minutos en agua con 1 cucharada de vinagre y enjuágalas bien: la acerola es delicada y se lastima fácil, así que manéjala con cuidado.","Abre cada acerola con los dedos y saca los 3 huesitos duros que tiene adentro, desechándolos todos: son duros, redondos y un riesgo real de atragantamiento.","Pon la pulpa de las acerolas, 1 banana bien madura pelada y 1/3 taza de agua de coco natural fría en el vaso de la licuadora.","Licúa a velocidad media unos 40 segundos, hasta que el licuado quede liso, rosado y cremoso, sin ningún pedacito de hueso o cáscara a la vista.","Pasa el licuado por un colador fino solo si viste algún pedazo de hueso: a partir de los 12 meses colar está permitido, pero lo ideal es aprovechar toda la fibra de la fruta.","Pruébalo con una cuchara limpia: la acerola es bien ácida, así que la banana bien madura es la que endulza. Si todavía está muy agrio, agrega 1/3 más de banana y licúa de nuevo; nunca uses azúcar ni miel.","Mide 100 ml como máximo y sirve frío en vaso entrenador o vaso abierto pequeño, con el niño bien sentado, como parte de una merienda y nunca en lugar de una comida."],"alerta":"Cada acerola tiene huesitos duros adentro: ábrelas una por una y quítalos todos antes de licuar. Sirve 100 ml como máximo por vez, en vaso, y nunca en lugar de una comida."},{"id":1739,"name":"Licuado Verde de Acelga con Mandarina","icon":"🥬","time":"~12 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/5366704/pexels-photo-5366704.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1 hoja pequeña de acelga, sin el tallo grueso","3 gajos de mandarina sin semillas y sin la piel blanca","1/2 banana (plátano) pequeña bien madura","1/3 taza de agua filtrada fría","1 pizca mínima de jengibre fresco rallado (lo que equivale a un grano de arroz)"],"tip":"La mandarina, la acelga y la banana hacen un licuado verde suave y cremoso dentro de una alimentación variada y de colores; no es un remedio para la gripa ni para nada más. Cambio: acelga → 3 hojas de espinaca bien lavadas; mandarina → naranja dulce sin semillas, en la misma cantidad.","steps":["Lava 1 hoja pequeña de acelga con agua corriente, déjala en remojo 10 minutos en agua con 1 cucharada de vinagre y enjuágala bien.","Dobla la hoja a la mitad y corta el tallo central grueso, usando solo la parte suave y verde: el tallo es fibroso y no se deshace en la bebida.","Pela 3 gajos de mandarina, ábrelos uno por uno y quita TODAS las semillas y la mayor parte de la piel blanca, que deja sabor amargo.","Pon en la licuadora la acelga en pedazos, los gajos de mandarina, 1/2 banana bien madura y 1/3 taza de agua filtrada fría, y ralla encima una pizca mínima de jengibre fresco, del tamaño de un grano de arroz: el jengibre solo a partir de los 12 meses y siempre en cantidad casi imperceptible.","Licúa a velocidad alta unos 60 segundos, hasta que la bebida quede verde clara y completamente lisa, sin ningún pedacito de hoja flotando.","Pásala por un colador fino si todavía queda alguna hebra de acelga, y pruébala con una cuchara limpia para confirmar que el jengibre no pica: si está fuerte, agrega 1/4 más de banana y licúa de nuevo. Sin azúcar y sin miel.","Mide 100 ml como máximo y sirve en vaso entrenador o vaso abierto, frío, con el niño bien sentado, como parte de una merienda y nunca en lugar del almuerzo, la cena ni la toma de leche."],"alerta":"El jengibre solo en pizca mínima y a partir de los 12 meses: en mayor cantidad pica e irrita la boca del niño. Quita todas las semillas de la mandarina y sirve 100 ml como máximo por vez."},{"id":1780,"name":"Crema de Banana con Avena","icon":"🍌","time":"~5 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/8805113/pexels-photo-8805113.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 6 meses","ingredients":["1 banana (plátano) bien madura","1 cucharada al ras de avena en hojuelas finas","1 pizca de canela en polvo (opcional)"],"tip":"La banana y la avena son dos alimentos sencillos que forman parte de una alimentación variada. Esta receta no es un remedio. Cambio: una variedad de banana → otra variedad de banana bien madura, en la misma cantidad.","steps":["Elige una banana bien madura, con puntitos oscuros en la cáscara, porque se machaca sola y no necesita cocción.","Machaca la banana entera con el dorso de un tenedor por 1 minuto más o menos, hasta que quede una crema sin ningún trozo más grande que un grano de arroz.","Mezcla 1 cucharada al ras de avena en hojuelas finas y deja reposar 5 minutos, para que la hojuela absorba el líquido de la fruta y se ablande por completo.","Mueve de nuevo y revisa que ninguna hojuela raspe entre los dedos: si todavía está seca, agrega 1 cucharada de agua y espera 2 minutos más.","Espolvorea la pizca de canela, si quieres, y confirma que la crema se queda quieta en la cuchara inclinada sin escurrir.","Sirve al momento, a temperatura ambiente, con CUCHARA: antes de los 12 meses la fruta es comida, no bebida en vaso o biberón."],"alerta":"No la sirvas con la avena todavía seca: los 5 minutos de reposo son lo que evita que la hojuela raspe la garganta del bebé."},{"id":1781,"name":"Licuado de Papaya con Naranja","icon":"🍊","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/8215110/pexels-photo-8215110.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de papaya madura en cubos, sin semillas","2 gajos de naranja dulce (de poca acidez) sin semillas y sin la piel blanca","3 cucharadas de yogur natural entero sin azúcar"],"tip":"La naranja y la papaya hacen un licuado suave dentro de una alimentación variada en esta etapa de guardería. El licuado acompaña la merienda, no reemplaza una comida y no es un remedio. Cambio: naranja dulce → mandarina sin semillas, en la misma cantidad.","steps":["Corta la papaya a la mitad y raspa el hueco con una cuchara hasta que no quede ninguna semillita negra pegada a la pulpa.","Pela los 2 gajos de naranja dulce, ábrelos uno por uno con los dedos y quita TODAS las semillas y lo más que puedas de la piel blanca, que amarga.","Pon la papaya, los gajos y las 3 cucharadas de yogur natural sin azúcar en la licuadora: a partir de los 12 meses ya está permitida.","Licúa a velocidad media unos 40 segundos, parando una vez para raspar los lados del vaso, hasta que quede liso y sin hebras.","Pruébalo con una cuchara limpia, que no vaya a la boca del niño, y confirma que está dulce por la misma fruta: nunca agregues azúcar ni miel.","Mide 100 ml como máximo y sirve en vaso entrenador o vaso abierto, con el niño bien sentado a la mesa."],"alerta":"Máximo 100 ml por vez y una vez al día: tomar mucha bebida de fruta le quita espacio a la comida de verdad. Nunca en biberón."},{"id":1782,"name":"Crema de Aguacate con Banana","icon":"🥑","time":"~5 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/5912010/pexels-photo-5912010.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 6 meses","ingredients":["1/4 de aguacate (palta) bien maduro","1/2 banana (plátano) bien madura","2 gotas de jugo de limón colado"],"tip":"El aguacate aporta grasa buena y la banana, dulzor y cremosidad: dos alimentos muy completos dentro de una alimentación variada. No es un remedio. Cambio: aguacate → aguacate hass bien maduro, en la misma cantidad.","steps":["Aprieta el aguacate suavemente con el pulgar: tiene que ceder al momento, porque el aguacate firme no se machaca por completo y no se debe ofrecer.","Saca con la cuchara solo la pulpa verde clara, desechando la cáscara y la parte oscura y amarga que queda pegada a ella.","Machaca el aguacate y la 1/2 banana juntos con el dorso del tenedor por 1 minuto más o menos, hasta que la crema quede lisa y de un solo color.","Pon las 2 gotas de jugo de limón colado y mezcla: así el aguacate tarda unos minutos más en oscurecerse.","Revisa la textura inclinando la cuchara: la crema debe quedarse quieta sin escurrir.","Sirve de inmediato, con CUCHARA, en cucharadas pequeñas: el aguacate machacado se oscurece rápido y no conviene guardarlo para después."]},{"id":1783,"name":"Licuado de Fresa con Banana","icon":"🍓","time":"~10 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/8743860/pexels-photo-8743860.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["5 fresas (frutillas) maduras, sin las hojas","1/2 banana (plátano) bien madura","1/3 taza de leche entera o bebida vegetal sin azúcar"],"tip":"La fresa y la banana hacen un licuado rosado y suave dentro de una alimentación variada y de colores; la bebida no es un remedio. Cambio: leche entera → bebida vegetal de avena sin azúcar, en la misma cantidad.","steps":["Lava las fresas una por una con agua corriente, déjalas en remojo 10 minutos en agua con 1 cucharada de vinagre y enjuágalas bien.","Corta las hojitas verdes y la parte blanca y dura del tallito de cada fresa, que no se aplasta entre los dedos.","Licúa las fresas, la 1/2 banana y el 1/3 de taza de leche unos 40 segundos, hasta que quede liso y rosado.","Pruébalo con una cuchara limpia: la banana madura es la que endulza. Si todavía está ácido, agrega 1/4 más de banana y licúa de nuevo, nunca azúcar.","Mide 100 ml como máximo y sirve en vaso entrenador, con el niño bien sentado, como parte de una merienda."],"alerta":"La fresa es un alérgeno común: la primera vez ofrécela en la mañana, en poca cantidad, y observa al niño en los días siguientes."},{"id":1784,"name":"Crema de Mango con Yogur","icon":"🥭","time":"~8 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/14930492/pexels-photo-14930492.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de mango bien maduro en cubos","3 cucharadas de yogur natural entero sin azúcar","1 pizca de canela en polvo (opcional)"],"tip":"El mango y el yogur natural hacen una crema suave dentro de una alimentación variada; no es un remedio. Confirma con tu pediatra si ya puedes darle yogur. Cambio: mango → papaya bien madura, en la misma cantidad.","steps":["Pela el mango y corta la pulpa pegada al hueso, desechando las fibras más duras que quedan pegadas a él.","Machaca los cubos de mango con el dorso del tenedor por 1 minuto más o menos, hasta que quede una pulpa lisa y sin ninguna hebra que se note.","Revisa la etiqueta del yogur: los ingredientes deben ser solo leche y cultivos lácteos, sin azúcar, colorante ni trozos de fruta.","Mezcla las 3 cucharadas de yogur con el mango machacado hasta que la crema quede de un solo color, sin rayas blancas.","Espolvorea la pizca de canela, si quieres, y confirma que la crema se queda quieta en la cuchara inclinada sin escurrir.","Sirve al momento, fría o a temperatura ambiente, con CUCHARA, en cucharadas pequeñas."],"alerta":"Yogur solo natural, entero y sin azúcar, y solo con el visto bueno de tu pediatra: nunca de botellita ni de colores."},{"id":1785,"name":"Crema de Pera con Avena","icon":"🍐","time":"~15 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/12119029/pexels-photo-12119029.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 6 meses","ingredients":["1 pera bien madura","1 cucharada al ras de avena en hojuelas finas","2 cucharadas de agua filtrada"],"tip":"La pera es una fruta suave y bien tolerada al comienzo de la alimentación complementaria, y la avena le da más cuerpo, dentro de una alimentación variada. No es un remedio. Cambio: pera → manzana bien madura, con 3 minutos más de cocción.","steps":["Pela la pera y quita todo el centro con las semillas usando una cucharita, cortando la pulpa en cubos pequeños.","Si la pera cede al tacto del pulgar, machácala cruda; si todavía está firme, cocina los cubos con las 2 cucharadas de agua por 8 minutos.","Escurre el exceso de líquido y machaca con el dorso del tenedor hasta que quede un puré espeso, sin licuadora y sin colador en esta etapa.","Mezcla 1 cucharada al ras de avena en hojuelas finas y deja reposar 5 minutos, hasta que la hojuela se ablande por completo.","Mueve de nuevo y revisa que la crema se quede quieta en la cuchara inclinada y que ninguna hojuela raspe entre los dedos.","Sirve tibia o a temperatura ambiente, con CUCHARA, probando antes en el dorso de la mano."],"alerta":"La pera cruda y firme no se machaca por completo y es riesgo de atragantamiento: sírvela sin cocinar solo cuando ceda al tacto del pulgar."},{"id":1786,"name":"Licuado de Sandía con Hierbabuena","icon":"🍉","time":"~10 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4113138/pexels-photo-4113138.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1 taza de sandía sin semillas, en cubos","1 hoja pequeña de hierbabuena fresca","2 cucharadas de agua filtrada fría"],"tip":"La sandía tiene mucha agua y entra como parte de la hidratación y de la variedad en la alimentación del niño. No es un remedio. Cambio: sandía → melón amarillo bien maduro, en la misma cantidad.","steps":["Corta la sandía y quita con la punta del cuchillo todas las semillas, una por una, incluso las blancas que se esconden en la pulpa.","Desecha la parte blanquecina cerca de la cáscara, que es firme y no se aplasta entre los dedos.","Licúa la pulpa con la hoja de hierbabuena y las 2 cucharadas de agua fría unos 30 segundos, hasta que quede parejo.","Pruébalo con una cuchara limpia: la sandía madura ya es dulce y no necesita nada de azúcar.","Mide 100 ml como máximo y sirve en vaso entrenador, frío, con el niño bien sentado, junto con una fruta en trozos."],"alerta":"Revisa semilla por semilla antes de licuar y ofrece 100 ml como máximo: la bebida de fruta no reemplaza una comida ni la toma de leche."},{"id":1787,"name":"Crema de Caqui con Banana","icon":"🟠","time":"~5 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/17612822/pexels-photo-17612822.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 6 meses","ingredients":["1/2 caqui (persimón) bien maduro y suave","1/2 banana (plátano) bien madura"],"tip":"El caqui es dulce y de color intenso, y la banana le da cremosidad: una crema rica dentro de una alimentación variada y de colores. No es un remedio. Cambio: caqui → durazno bien maduro, en la misma cantidad.","steps":["Elige un caqui bien maduro, con la pulpa suave al tacto: el caqui firme o verde tiene un sabor que amarra la boca y no se machaca bien.","Córtalo a la mitad, quita la cáscara y cualquier semilla que aparezca, usando solo la pulpa suave con la cuchara.","Machaca el caqui y la 1/2 banana juntos con el dorso del tenedor por 1 minuto más o menos, hasta que quede una crema anaranjada pareja.","Pasa la crema entre el pulgar y el índice para confirmar que no quedó ningún trozo firme ni fibra de la fruta.","Sirve al momento, a temperatura ambiente, con CUCHARA, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"Usa solo caqui bien maduro: el verde o firme amarra la boca y es difícil de machacar por completo."},{"id":1788,"name":"Licuado de Maracuyá con Banana","icon":"💛","time":"~10 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/14930534/pexels-photo-14930534.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["Pulpa de 1/2 maracuyá, colada y sin semillas","1 banana (plátano) bien madura","1/3 taza de leche entera o bebida vegetal sin azúcar"],"tip":"El maracuyá le da un sabor intenso y la banana equilibra la acidez: parte de una alimentación variada, sin ser un remedio. Cambio: maracuyá → unas gotas de jugo de naranja natural colado.","steps":["Corta el maracuyá a la mitad, saca la pulpa con una cuchara y pásala por un colador fino hasta quitar TODAS las semillas.","Licúa la pulpa colada, la banana bien madura y el 1/3 de taza de leche unos 40 segundos, hasta que quede cremoso y amarillento.","Pruébalo con una cuchara limpia: si todavía está ácido para el niño, agrega 1/2 banana más y licúa de nuevo; nunca azúcar ni miel.","Revisa mirando a contraluz que ninguna semilla se haya escapado del colador antes de servir.","Mide 100 ml como máximo y sirve en vaso entrenador, con el niño bien sentado a la mesa."],"alerta":"Cuela muy bien la pulpa: la semilla de maracuyá es dura, pequeña y resbalosa, una forma de riesgo de atragantamiento."},{"id":1789,"name":"Crema de Ciruela con Yogur","icon":"🟣","time":"~15 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/434295/pexels-photo-434295.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 10 meses","ingredients":["3 ciruelas frescas maduras, sin hueso","3 cucharadas de yogur natural entero sin azúcar","2 cucharadas de agua filtrada"],"tip":"La ciruela es conocida por su fibra y el yogur natural le da cremosidad, dentro de una alimentación variada; no es un remedio. Cambio: ciruela fresca → 3 ciruelas pasas bien hidratadas y sin hueso, en la misma cantidad.","steps":["Lava las ciruelas, córtalas a la mitad y quita todo el hueso, revisando con los dedos que ningún pedazo quedó pegado a la pulpa.","Cocina los trozos con las 2 cucharadas de agua a fuego bajo unos 8 minutos, hasta que se deshagan al presionarlos con la cuchara.","Machaca con el dorso del tenedor hasta que quede un puré espeso, sin ningún pedazo de cáscara dura.","Deja entibiar 5 minutos antes de agregar el yogur, porque el yogur mezclado con comida caliente se corta y pierde cremosidad.","Mezcla las 3 cucharadas de yogur natural sin azúcar y revisa que la crema se quede quieta en la cuchara inclinada.","Sirve con CUCHARA, a temperatura ambiente, en cucharadas pequeñas con el niño bien sentado."],"alerta":"Revisa que ningún pedazo de hueso haya quedado en la pulpa y ofrece yogur solo natural, entero y sin azúcar."},{"id":1790,"name":"Licuado de Coco con Banana","icon":"🥥","time":"~8 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/14994697/pexels-photo-14994697.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1 banana (plátano) bien madura","1/3 taza de leche de coco sin azúcar","1 pizca de canela en polvo"],"tip":"La leche de coco le da cremosidad y la banana, dulzor, dentro de una alimentación variada; la bebida no es un remedio. Cambio: leche de coco → leche entera, en la misma cantidad.","steps":["Pela la banana bien madura, con puntitos oscuros en la cáscara, y córtala en rodajas gruesas para que se licúe más fácil.","Licúa las rodajas con el 1/3 de taza de leche de coco sin azúcar unos 40 segundos, hasta que quede cremoso y parejo.","Revisa la etiqueta de la leche de coco antes de usarla: no puede tener azúcar ni conservadores agregados.","Espolvorea la pizca de canela, prueba con una cuchara limpia y confirma que está dulce solo por la banana.","Mide 100 ml como máximo y sirve en vaso entrenador, con el niño bien sentado, como parte de una merienda."],"alerta":"Máximo 100 ml por vez, siempre en vaso y nunca en biberón, y nunca en lugar del almuerzo, la cena ni la toma de leche."},{"id":1791,"name":"Crema de Banana con Cacao","icon":"🍫","time":"~5 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/7491906/pexels-photo-7491906.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 2 años","ingredients":["1 banana (plátano) bien madura","1 cucharadita de cacao 100% sin azúcar","2 cucharadas de yogur natural entero sin azúcar"],"tip":"El cacao 100% le da un sabor intenso sin nada de azúcar, y la banana endulza sola: es una opción de merienda dentro de una alimentación variada, sin ser un remedio. Cambio: cacao → 1 pizca de canela, para la versión permitida antes de los 2 años.","steps":["Machaca la banana bien madura con el dorso del tenedor hasta que quede una crema lisa, sin ningún trozo entero.","Cierne 1 cucharadita de cacao 100% sin azúcar por encima: así evitas los grumos secos que se quedan atrapados en la crema.","Mezcla el cacao y las 2 cucharadas de yogur natural por 1 minuto más o menos, hasta que el color quede parejo, sin partes claras.","Pruébala con una cuchara limpia: si queda amarga para el niño, agrega 1/2 banana más machacada, nunca azúcar ni miel.","Sirve al momento, con cuchara, a temperatura ambiente o un poco fría."],"alerta":"El cacao solo después de los 2 años. Antes, haz la misma receta solo con banana y yogur, cambiando el cacao por una pizca de canela."},{"id":1792,"name":"Licuado de Piña con Hierbabuena","icon":"🍍","time":"~12 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/17612823/pexels-photo-17612823.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["2 rebanadas de piña madura, sin el centro","1/2 banana (plátano) bien madura","1 hoja pequeña de hierbabuena fresca","1/3 taza de agua filtrada fría"],"tip":"La piña es refrescante y la banana suaviza su acidez: parte de una alimentación variada, sin ser un remedio. Cambio: piña → mango bien maduro, en la misma cantidad, para una versión menos ácida.","steps":["Corta las rebanadas de piña quitando la cáscara y todo el centro, que es fibroso y no se deshace ni licuado.","Corta la pulpa en cubos y licúala con la 1/2 banana, la hoja de hierbabuena y el 1/3 de taza de agua fría unos 50 segundos.","Pásalo por un colador fino si todavía queda alguna hebra de piña, que es la fruta más fibrosa de esta lista.","Pruébalo con una cuchara limpia: si está muy ácido, agrega 1/2 banana más y licúa de nuevo, nunca azúcar.","Mide 100 ml como máximo y sirve en vaso entrenador, frío, con el niño bien sentado a la mesa."],"alerta":"La piña es ácida y puede irritar la boca si la piel alrededor de los labios es sensible: ofrece poca la primera vez y observa."},{"id":1793,"name":"Crema de Durazno con Avena","icon":"🍑","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/4051766/pexels-photo-4051766.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 6 meses","ingredients":["1 durazno bien maduro, sin cáscara y sin hueso","1 cucharada al ras de avena en hojuelas finas","1 cucharada de agua filtrada"],"tip":"El durazno es dulce y aromático, y la avena le da más cuerpo, dentro de una alimentación variada y de colores. No es un remedio. Cambio: durazno → nectarina bien madura, en la misma cantidad.","steps":["Lava el durazno, córtalo a la mitad rodeando el hueso con el cuchillo y quita el hueso entero, guardándolo lejos del bebé.","Pela las mitades: la cáscara del durazno es fina, resbalosa y puede enrollarse dentro de la boca del bebé.","Machaca la pulpa con el dorso del tenedor por 1 minuto más o menos, hasta que quede un puré espeso y sin ninguna hebra.","Mezcla 1 cucharada al ras de avena en hojuelas finas y 1 cucharada de agua, y deja reposar 5 minutos para que la hojuela se ablande.","Mueve de nuevo y revisa que la crema se quede quieta en la cuchara inclinada y que ninguna hojuela raspe entre los dedos.","Sirve al momento, a temperatura ambiente, con CUCHARA, con el bebé bien sentado."],"alerta":"El hueso del durazno es liso y del tamaño de la vía respiratoria: quítalo entero y deséchalo antes de empezar a machacar."},{"id":1794,"name":"Licuado de Uva con Manzana","icon":"🍇","time":"~12 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/28053225/pexels-photo-28053225.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["10 uvas sin semillas, bien lavadas","1/2 manzana pelada y sin semillas","1/3 taza de agua filtrada fría"],"tip":"La uva y la manzana hacen un licuado dulce dentro de una alimentación variada; la bebida no es un remedio. Cambio: uva → 1/2 taza de fresa (frutilla) madura, en la misma cantidad.","steps":["Lava las uvas una por una con agua corriente y revisa que ninguna tenga semilla escondida, abriendo algunas con la punta del cuchillo.","Pela la 1/2 manzana y quita todo el centro con las semillas usando una cucharita.","Licúa las uvas, la manzana en cubos y el 1/3 de taza de agua fría unos 50 segundos, hasta que quede liso y sin trozos de cáscara.","Pásalo por un colador fino si queda algún pedazo de cáscara de uva, que es firme y no se deshace al licuar.","Mide 100 ml como máximo y sirve en vaso entrenador, con el niño bien sentado, junto con una merienda."],"alerta":"Nunca le ofrezcas uva entera al niño: aquí va licuada y colada, y en el plato siempre debe ir cortada en cuatro a lo largo."},{"id":1795,"name":"Crema de Zanahoria con Naranja","icon":"🥕","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/6412584/pexels-photo-6412584.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 8 meses","ingredients":["1 zanahoria mediana pelada en rodajas","2 gajos de naranja dulce (de poca acidez) sin semillas y sin la piel blanca","1/2 taza de agua filtrada"],"tip":"La zanahoria y la naranja hacen una crema de color vivo y sabor suave, parte de una alimentación variada; no es un remedio. Cambio: zanahoria → calabaza (zapallo) cocida, en la misma cantidad.","steps":["Cocina las rodajas de zanahoria en la 1/2 taza de agua, tapadas, unos 15 minutos, hasta que un tenedor las atraviese sin resistencia.","Pela los 2 gajos de naranja dulce y quita con paciencia todas las semillas y la piel blanca, que deja sabor amargo.","Escurre la zanahoria guardando un poco del agua y machaca las rodajas con el dorso del tenedor hasta que quede un puré liso.","Machaca los gajos de naranja encima y mezcla bien, ajustando lo espeso con el agua que guardaste si la crema queda muy firme.","Revisa la crema entre los dedos, asegurándote de que no quedó ninguna película de naranja ni trozo de zanahoria firme.","Sirve tibia, con CUCHARA, probando antes en el dorso de la mano, en cucharadas pequeñas."],"alerta":"Quita toda la película blanca de los gajos: es fibrosa, no se deshace y puede molestar la garganta del bebé."},{"id":1796,"name":"Licuado de Melón con Yogur","icon":"🍈","time":"~10 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/28053287/pexels-photo-28053287.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1 taza de melón amarillo maduro en cubos, sin semillas","3 cucharadas de yogur natural entero sin azúcar","2 cucharadas de agua filtrada fría"],"tip":"El melón tiene mucha agua y el yogur natural le da cremosidad, dentro de una alimentación variada en esta etapa; la bebida no es un remedio. Cambio: melón amarillo → melón cantalupo bien maduro, en la misma cantidad.","steps":["Corta el melón a la mitad y quita todas las semillas con una cuchara, raspando bien el hueco del centro de la fruta.","Pela y corta la pulpa en cubos, desechando la parte verdosa y firme que queda pegada a la cáscara.","Licúa los cubos con las 3 cucharadas de yogur natural sin azúcar y las 2 cucharadas de agua fría por 40 segundos.","Pruébalo con una cuchara limpia y confirma que está dulce por la misma fruta, sin necesidad de nada de azúcar.","Mide 100 ml como máximo y sirve en vaso entrenador, frío, con el niño bien sentado a la mesa."],"alerta":"Ofrece 100 ml como máximo y nunca en biberón: la bebida de fruta acompaña la merienda, no reemplaza una comida."},{"id":1797,"name":"Crema de Kiwi con Banana","icon":"🥝","time":"~6 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/12049998/pexels-photo-12049998.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 10 meses","ingredients":["1 kiwi bien maduro, sin cáscara","1/2 banana (plátano) bien madura","1 cucharada de yogur natural entero sin azúcar"],"tip":"El kiwi es ácido y refrescante, y la banana suaviza su acidez natural: parte de una alimentación variada, sin ser un remedio. Cambio: kiwi → mango bien maduro, en la misma cantidad.","steps":["Pela el kiwi por completo con el cuchillo, quitando toda la cáscara fina y peluda, que no se machaca y molesta en la boca.","Córtalo a la mitad a lo largo y quita la parte blanca del centro, más firme, que es la única que resiste al tenedor.","Machaca la pulpa del kiwi y la 1/2 banana juntas con el dorso del tenedor hasta que quede una crema verde clara pareja.","Mezcla 1 cucharada de yogur natural sin azúcar, que deja la crema más suave y menos ácida.","Sirve al momento, a temperatura ambiente, con CUCHARA, en cucharadas pequeñas con el niño bien sentado."],"alerta":"El kiwi firme es ácido y difícil de machacar: usa solo el bien maduro, que cede al tacto del pulgar, y ofrece poco la primera vez."},{"id":1798,"name":"Licuado de Manzana con Avena y Canela","icon":"🍎","time":"~12 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/30451538/pexels-photo-30451538.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción de 100 ml","ageRec":"A partir de los 12 meses","ingredients":["1 manzana pelada y sin semillas","1 cucharada de avena en hojuelas finas","1/3 taza de leche entera o bebida vegetal sin azúcar","1 pizca de canela en polvo"],"tip":"La manzana y la avena forman una merienda completa dentro de una alimentación variada; la bebida no es un remedio. Cambio: leche entera → bebida vegetal de avena sin azúcar, en la misma cantidad.","steps":["Pela la manzana y quita todo el centro con las semillas usando una cucharita, cortando la pulpa en cubos.","Deja la cucharada de avena en remojo en el 1/3 de taza de leche por 5 minutos, para que la hojuela se hidrate y se licúe sin dejar grumitos.","Licúa la manzana, la avena hidratada con la leche y la pizca de canela unos 50 segundos, hasta que quede cremoso y sin trozos.","Pruébalo con una cuchara limpia y confirma que la bebida quedó lisa, sin ninguna hojuela raspando en la lengua.","Mide 100 ml como máximo y sirve en vaso entrenador, con el niño bien sentado, como parte de una merienda."],"alerta":"Hidrata la avena antes de licuar: la hojuela seca deja la bebida grumosa y puede raspar la garganta del niño."},{"id":1799,"name":"Crema de Remolacha con Fresa","icon":"🩷","time":"~30 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/4051753/pexels-photo-4051753.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción para bebé","ageRec":"A partir de los 10 meses","ingredients":["1/3 de remolacha (betabel) pequeña, pelada en cubos","4 fresas (frutillas) maduras, sin las hojas","2 cucharadas de yogur natural entero sin azúcar","1/2 taza de agua filtrada"],"tip":"La remolacha y la fresa hacen una crema de color intenso y sabor suave, combinación nutritiva dentro de una alimentación variada; no es un remedio. Cambio: fresa → 1/2 taza de frambuesas maduras, en la misma cantidad.","steps":["Cocina los cubos de remolacha en la 1/2 taza de agua, tapados, unos 20 minutos, hasta que un tenedor los atraviese sin atorarse.","Lava las fresas, déjalas en remojo 10 minutos en agua con vinagre, enjuágalas y corta la parte blanca y dura del tallito.","Escurre la remolacha y machácala con el dorso del tenedor hasta que quede un puré liso, sin ningún trozo firme.","Machaca las fresas encima y mezcla bien, hasta que la crema quede rosa oscuro y de un solo color.","Deja entibiar 5 minutos antes de agregar las 2 cucharadas de yogur, para que no se corte con el calor.","Sirve con CUCHARA, a temperatura ambiente, en cucharadas pequeñas con el niño bien sentado."],"alerta":"La remolacha puede dejar la pipí y la popó rojizas por uno o dos días: es normal y no es sangre."}],"10":[{"id":1740,"name":"Camote Asado en Tiras","icon":"🍠","time":"~35 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/5507575/pexels-photo-5507575.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 camote (batata) mediano (unos 250 g), bien lavado y pelado","1 cucharada de aceite de oliva extra virgen","1 pizca de pimentón dulce (paprika)","1 cucharadita de perejil fresco bien picado"],"tip":"Camote → papa, en la misma cantidad.","steps":["Calienta el horno a 200 °C y cubre una bandeja con papel para hornear, para que el camote no se pegue ni se rompa al sacarlo.","Corta el camote pelado en tiras largas de más o menos 1 dedo de ancho y 8 cm de largo, todas del mismo tamaño para que se horneen parejo.","Mezcla las tiras en un bol con 1 cucharada de aceite de oliva y 1 pizca de pimentón dulce, sin nada de sal, hasta que todas queden brillantes.","Acomoda las tiras en la bandeja sin encimarlas y hornea unos 25 minutos, dándoles vuelta a la mitad del tiempo, hasta que un tenedor atraviese la tira sin ninguna resistencia.","Haz la prueba del dedo antes de servir: toma una tira ya tibia y apriétala entre el pulgar y el índice. Tiene que aplastarse con facilidad, casi como un puré. Si todavía está firme, devuélvela al horno 5 minutos más.","Deja entibiar sobre un plato, prueba la temperatura en el dorso de la mano, espolvorea el perejil y ofrece 2 o 3 tiras a la vez, acostadas en el plato.","Sirve en forma de tira o palito del tamaño de un dedo adulto (unos 8 cm de largo por 1,5 cm de ancho). De los 6 a los 9 meses el bebé todavía agarra con la mano cerrada: la tira tiene que sobresalir unos 3 cm de su puño para que pueda llevarse la punta a la boca solo. Esa punta larga y suave se deshace en la encía en vez de convertirse en un pedazo suelto y redondo dentro de la boca."],"alerta":"Nada de cubos en esta etapa: el cubo se va entero al fondo de la boca. Solo tiras suaves que se aplastan entre los dedos, con el bebé bien sentado, de frente a la comida, y un adulto cerca durante toda la comida."},{"id":1741,"name":"Palitos de Zanahoria al Vapor","icon":"🥕","time":"~20 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/34227779/pexels-photo-34227779.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 zanahorias medianas, peladas","1 chorrito de aceite de oliva extra virgen (más o menos 1 cucharadita)","1 pizca de orégano seco","Agua para el vapor"],"tip":"Zanahoria → calabaza (zapallo) tipo kabocha, en la misma cantidad (se cocina unos 5 minutos más rápido).","steps":["Corta cada zanahoria por la mitad a lo largo y luego en tiras de más o menos 1 dedo de ancho. Usa la parte más gruesa para que las tiras queden anchas y fáciles de agarrar.","Pon las tiras en la canasta de vapor sobre una olla con 2 dedos de agua hirviendo, tapa y cocina unos 15 minutos.","Pincha la tira más gruesa con un tenedor: tiene que atravesarla sin ninguna resistencia, como si entrara en mantequilla. Si se traba a la mitad, tapa y deja 3 minutos más.","Saca del vapor, reparte las tiras en un plato y aprieta una entre el pulgar y el índice. Si se deshace con la presión de los dedos, está en el punto seguro. La zanahoria firme no va al plato de ninguna manera: la verdura dura es la que más atraganta a esta edad.","Rocía con el chorrito de aceite de oliva, espolvorea el orégano y mezcla despacio para no romper las tiras.","Deja entibiar, prueba en el dorso de la mano y ofrece 2 o 3 tiras a la vez, en forma de palito del tamaño de un dedo adulto (unos 7 cm por 1,5 cm), con una punta que sobresalga de la manita cerrada. De los 6 a los 9 meses el bebé todavía no hace la pinza y solo puede comer lo que sobresale de su puño."],"alerta":"Nunca ofrezcas zanahoria cruda o a medio cocer, ni siquiera en rodajas. Solo palitos bien cocidos que se aplastan entre los dedos, con el niño sentado de frente a la comida y un adulto cerca todo el tiempo."},{"id":1742,"name":"Calabacita a la Plancha en el Sartén","icon":"🥒","time":"~15 min","kcal":"40 kcal (estimado)","img":"https://images.pexels.com/photos/13422450/pexels-photo-13422450.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana, bien lavada","1 cucharada de aceite de oliva extra virgen","1 pizca de ajo en polvo o 1/2 diente de ajo machacado","1 cucharadita de cebollín bien picado"],"tip":"Calabacita → calabaza (zapallo) pelada, en la misma cantidad (tarda unos minutos más).","steps":["Corta las dos puntas de la calabacita y luego córtala en tiras largas de más o menos 1 dedo de ancho. Deja la cáscara fina, que ayuda a que la tira no se deshaga en el sartén.","Calienta el sartén a fuego medio con el aceite de oliva y el ajo machacado por 1 minuto, solo hasta que huela rico, sin dejar que el ajo se dore.","Acomoda las tiras acostadas en el sartén, sin encimarlas, y ásalas unos 4 minutos por lado, hasta que se marquen un poco y queden transparentes en los bordes.","Baja el fuego, tapa y deja 3 minutos más para que el centro de la tira se cocine por dentro. La calabacita a la plancha engaña: se dora por fuera y sigue cruda en el centro.","Aprieta una tira tibia entre el pulgar y el índice: tiene que ceder y aplastarse sin esfuerzo. Si el centro sigue firme y gomoso, vuelve al sartén tapado 2 minutos más.","Espolvorea el cebollín, deja entibiar, prueba en el dorso de la mano y sirve 2 tiras a la vez.","La forma correcta aquí es la tira larga del tamaño de un dedo adulto (unos 8 cm por 1,5 cm), nunca en rodaja. De los 6 a los 9 meses el bebé agarra con la mano cerrada y necesita que la punta sobresalga de su puño. La rodaja, en cambio, es redonda, resbalosa y tiene justo el tamaño de su vía respiratoria."],"alerta":"Nunca sirvas calabacita en rodajas en esta etapa: la forma redonda es la más peligrosa para atragantarse. Bebé bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1743,"name":"Calabaza Asada en Rebanadas","icon":"🎃","time":"~35 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/5644955/pexels-photo-5644955.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 6 meses","ingredients":["1/2 calabaza (zapallo) tipo kabocha pequeña (unos 400 g), sin semillas","1 cucharada de aceite de oliva extra virgen","1 pizca de canela en polvo","1 pizca de cúrcuma"],"tip":"Calabaza kabocha → cualquier otra calabaza (zapallo) de pulpa naranja o camote (batata), en la misma cantidad.","steps":["Calienta el horno a 200 °C y cubre una bandeja con papel para hornear.","Pela la media calabaza y corta la pulpa en rebanadas largas de más o menos 1 dedo de grosor y 8 cm de largo. Quita toda la parte de las semillas y las hebras.","Rocía las rebanadas con el aceite de oliva, espolvorea la canela y la cúrcuma y mezcla con las manos hasta que cada rebanada quede un poco amarilla, sin usar sal.","Hornea unos 25 a 30 minutos, dándoles vuelta a la mitad del tiempo, hasta que la rebanada esté dorada en los bordes y un tenedor la atraviese sin ninguna resistencia.","Espera a que se entibie y haz la prueba obligatoria: aprieta una rebanada entre el pulgar y el índice. Tiene que volverse puré con la presión de los dedos. Si la calabaza está firme, vuelve al horno 5 minutos más.","Prueba la temperatura en el dorso de la mano y sirve 2 rebanadas a la vez, acostadas en el plato o en la mano del bebé.","El corte es en rebanada larga, con forma de palito del tamaño de un dedo adulto (unos 8 cm por 1,5 cm), con 3 cm que sobresalgan de la manita cerrada. En esta etapa el bebé todavía no hace el movimiento de pinza y solo come lo que sobresale del puño. La rebanada larga y suave se deshace en la encía, sin soltar un pedazo entero en la boca."],"alerta":"Quita toda la cáscara y las semillas: la cáscara de la calabaza queda dura y no se aplasta entre los dedos. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1744,"name":"Papa al Vapor con Aceite de Oliva","icon":"🥔","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/20701096/pexels-photo-20701096.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 papas medianas, peladas","1 cucharada de aceite de oliva extra virgen","1 cucharadita de perejil fresco bien picado","Agua para el vapor"],"tip":"Papa → ñame o camote (batata), en la misma cantidad.","steps":["Pela las papas y corta cada una a lo largo en tiras de más o menos 1 dedo de ancho, aprovechando la parte más gruesa.","Acomoda las tiras en la canasta de vapor sobre una olla con 2 dedos de agua hirviendo, tapa y cocina unos 15 minutos.","Pincha la tira más gruesa con un tenedor: tiene que entrar y salir sin resistencia. Si todavía se traba un poco, tapa y cocina 3 a 5 minutos más.","Saca del vapor con cuidado, porque la papa bien cocida es frágil, y reparte las tiras en un plato plano para que dejen de cocinarse con su propio vapor.","Aprieta una tira tibia entre el pulgar y el índice: tiene que aplastarse sin esfuerzo. La papa en su punto se vuelve casi puré entre los dedos. Si resiste, no va al plato.","Rocía con el aceite de oliva, espolvorea el perejil, prueba la temperatura en el dorso de la mano y sirve 2 o 3 tiras a la vez.","Sirve en tira o palito del tamaño de un dedo adulto (unos 7 cm por 1,5 cm), con la punta que sobresalga del puño cerrado. De los 6 a los 9 meses el bebé agarra la comida con toda la mano y come justo la punta que sobresale. Por eso la tira larga es la única forma que puede llevarse solo a la boca de manera segura."],"alerta":"La papa mal cocida queda firme por dentro y es riesgo de atragantamiento. Sirve solo la tira que se aplasta entre los dedos, con el bebé bien sentado, de frente a la comida, y un adulto cerca durante toda la comida."},{"id":1745,"name":"Calabacita al Vapor con Cebollín","icon":"🥬","time":"~20 min","kcal":"30 kcal (estimado)","img":"https://images.pexels.com/photos/4687720/pexels-photo-4687720.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana, pelada y sin la parte central de semillas","1 cucharadita de aceite de oliva extra virgen","1 cucharadita de cebollín bien picado","Agua para el vapor"],"tip":"Calabacita → calabaza (zapallo) pelada, en la misma cantidad (tarda unos 5 minutos más).","steps":["Pela la calabacita, córtala por la mitad a lo largo, quita con una cucharita la parte central con semillas y corta la pulpa en tiras largas de más o menos 1 dedo de ancho.","Pon las tiras en la canasta de vapor sobre una olla con 2 dedos de agua hirviendo y cocina tapado unos 12 minutos.","Revisa con un tenedor: tiene que atravesar la tira sin resistencia, y la calabacita debe verse transparente, ya no blanca ni opaca.","Saca las tiras y haz la prueba del dedo: aprieta una entre el pulgar y el índice. Tiene que deshacerse con la presión. Si la calabacita sigue crujiente, vuelve al vapor 3 minutos más.","Rocía con el aceite de oliva, espolvorea el cebollín y mezcla con cuidado para no romper las tiras.","Deja entibiar, prueba en el dorso de la mano y ofrece 2 tiras a la vez: una en la manita del bebé y la otra en el plato.","La forma es la tira larga del tamaño de un dedo adulto (unos 8 cm por 1,5 cm). La calabacita cocida es resbalosa, así que la tira larga es lo que asegura que un pedazo sobresalga del puño cerrado del bebé en esta etapa, cuando todavía no puede agarrar pedacitos con la punta de los dedos."],"alerta":"Quita siempre la parte central con semillas y cocina hasta que la tira se aplaste entre los dedos. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1746,"name":"Ejotes Suaves al Vapor","icon":"🫛","time":"~20 min","kcal":"35 kcal (estimado)","img":"https://images.pexels.com/photos/2942331/pexels-photo-2942331.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 taza de ejotes (judías verdes) anchos frescos (unos 120 g)","1 cucharadita de aceite de oliva extra virgen","1 pizca de ajo en polvo","Agua para el vapor"],"tip":"Ejotes anchos → ejotes finos, en la misma cantidad.","steps":["Lava los ejotes, corta las dos puntitas y quita la hebra del costado de cada uno, porque esa hebra nunca se ablanda y le estorba al bebé.","Corta los ejotes del tamaño de un dedo adulto, unos 7 cm, dejando cada pedazo recto y entero, sin picarlos en rueditas.","Cocina en la canasta de vapor, tapado, unos 12 a 14 minutos. El ejote tiene que pasarse del punto de restaurante y quedar bien blandito, sin nada crujiente.","Aprieta un ejote tibio entre el pulgar y el índice: tiene que aplastarse y abrirse con facilidad. Si truena entre los dedos, todavía está demasiado duro y vuelve al vapor 3 minutos más.","Escurre, rocía con el aceite de oliva, espolvorea la pizca de ajo en polvo y mezcla despacio.","Deja entibiar, prueba en el dorso de la mano y ofrece 3 o 4 ejotes acostados en el plato, al alcance de la manita.","El ejote ya tiene la forma ideal de palito del tamaño de un dedo adulto (unos 7 cm), y así debe servirse: entero y largo, con la punta que sobresalga de la mano cerrada del bebé. Picado en rueditas se vuelve un pedazo chico y redondo que de los 6 a los 9 meses el bebé todavía no puede agarrar y que rueda directo al fondo de la boca."],"alerta":"Quita la hebra del costado y cocina hasta que quede bien blando. Nunca sirvas ejotes al dente ni picados en rueditas. Bebé bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1747,"name":"Brócoli con Tallito al Vapor","icon":"🥦","time":"~20 min","kcal":"40 kcal (estimado)","img":"https://images.pexels.com/photos/8056670/pexels-photo-8056670.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de brócoli en ramitos con el tallito largo (unos 150 g)","1 cucharada de aceite de oliva extra virgen","1/2 diente de ajo machacado","Agua para el vapor"],"tip":"Brócoli → coliflor en ramitos, en la misma cantidad.","steps":["Separa los ramitos de brócoli dejando a propósito un tallito largo de unos 6 cm en cada uno: ese tallo es el mango por donde el niño lo va a agarrar.","Lava bien los ramitos con agua corriente, abriendo las flores con los dedos para quitar cualquier suciedad que quede entre ellas.","Cocina en la canasta de vapor, tapado, unos 12 minutos, hasta que el verde quede bien vivo y el tallito ceda al tenedor sin resistencia.","Haz la prueba del dedo en la florecita y en el tallo: aprieta cada parte entre el pulgar y el índice. Las dos tienen que aplastarse sin esfuerzo, porque el tallo tarda más que la flor y es el que suele quedar duro.","Calienta el aceite de oliva con el ajo machacado por 1 minuto a fuego bajo, rocíalo sobre los ramitos y mezcla con cuidado.","Deja entibiar, prueba en el dorso de la mano y entrega 1 ramito a la vez en la manita del niño.","Sirve el ramito entero con el tallito de unos 6 cm haciendo de palito del tamaño de un dedo adulto. De los 8 a los 9 meses el niño todavía cierra la mano alrededor de la comida, así que lo agarra por el tallo y come la florecita suave que sobresale del puño. Nunca piques las flores sueltas en esta etapa: la florecita suelta es un pedazo chico y redondo que todavía no puede agarrar con la pinza."],"alerta":"El tallito tiene que aplastarse entre los dedos igual que la flor: el tallo duro es riesgo de atragantamiento. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1748,"name":"Remolacha Asada en Palitos","icon":"🟣","time":"~45 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/37206686/pexels-photo-37206686.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 remolachas (betabel) medianas, peladas","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco","1 cucharadita de perejil fresco bien picado"],"tip":"Remolacha → zanahoria, en la misma cantidad (hornea unos 10 minutos menos).","steps":["Calienta el horno a 200 °C y cubre una bandeja con papel para hornear, que además evita que el morado de la remolacha manche el molde.","Pela las remolachas y córtalas en palitos de más o menos 1 dedo de ancho y 7 cm de largo, todos parecidos para que se horneen parejo.","Mezcla los palitos con el aceite de oliva y el orégano en un bol hasta que queden brillantes, sin nada de sal.","Repártelos en la bandeja, cubre con papel aluminio y hornea 30 minutos. Luego quita el aluminio y hornea 10 minutos más, hasta que un tenedor los atraviese sin resistencia.","Espera a que se entibien y aprieta un palito entre el pulgar y el índice: tiene que aplastarse con facilidad. La remolacha es de las raíces que más tardan en ablandarse, así que si resiste, vuelve al horno tapada 10 minutos más.","Espolvorea el perejil, prueba la temperatura en el dorso de la mano y ofrece 2 palitos a la vez.","El corte es en palito del tamaño de un dedo adulto (unos 7 cm por 1,5 cm), con la punta que sobresalga de la mano cerrada. A los 8 y 9 meses el bebé todavía agarra con toda la mano, y el palito largo es lo que puede llevarse solo a la boca sin que el pedazo desaparezca dentro del puño."],"alerta":"La remolacha puede dejar la pipí y la popó rosadas por uno o dos días: es normal y no es sangre. Sirve solo el palito que se aplasta entre los dedos, con el niño bien sentado y un adulto cerca durante toda la comida."},{"id":1749,"name":"Coliflor Asada Doradita","icon":"🤍","time":"~30 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/4963456/pexels-photo-4963456.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de coliflor en ramitos con el tallito (unos 200 g)","1 cucharada de aceite de oliva extra virgen","1 pizca de cúrcuma","1 pizca de ajo en polvo"],"tip":"Coliflor → brócoli en ramitos, en la misma cantidad.","steps":["Calienta el horno a 200 °C y separa la coliflor en ramitos, dejando un tallito de unos 5 a 6 cm en cada uno, que va a servir de mango para la manita.","Mezcla los ramitos en un bol con el aceite de oliva, la cúrcuma y el ajo en polvo hasta que queden un poco amarillos de forma pareja.","Repártelos en una bandeja con papel para hornear, cubre con papel aluminio y hornea 20 minutos. El aluminio hace vapor y es lo que asegura que el tallito se ablande de verdad.","Quita el aluminio y hornea 8 minutos más, solo hasta que se doren un poco los bordes, sin dejar que se tuesten y endurezcan.","Aprieta un ramito tibio entre el pulgar y el índice, probando la flor y el tallo por separado: los dos tienen que aplastarse sin esfuerzo. Si el tallo sigue firme, vuelve a tapar y hornea 5 minutos más.","Deja entibiar, prueba en el dorso de la mano y entrega 1 ramito a la vez en la mano del niño.","Sirve el ramito entero con el tallito de 5 a 6 cm haciendo de palito del tamaño de un dedo adulto. A los 8 y 9 meses el niño cierra la mano alrededor del tallo y come la flor suave que sobresale del puño. Es mucho más seguro que las florecitas sueltas, que son chicas, redondeadas y todavía no puede agarrar con la pinza."],"alerta":"La coliflor demasiado tostada queda dura y no se aplasta entre los dedos: si se pasa del punto, descártala. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1750,"name":"Berenjena Salteada en Tiras","icon":"🍆","time":"~25 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/5848473/pexels-photo-5848473.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 berenjena mediana, bien lavada","1 cucharada de aceite de oliva extra virgen","2 cucharadas de cebolla bien picada","1 pizca de orégano seco","3 cucharadas de agua"],"tip":"Berenjena → calabacita (zucchini), en la misma cantidad (se saltea 5 minutos más rápido).","steps":["Pela la berenjena completa, porque la cáscara queda gomosa y no se aplasta entre los dedos, y corta la pulpa en tiras de más o menos 1 dedo de ancho y 7 cm de largo.","Calienta el aceite de oliva en un sartén a fuego medio y sofríe la cebolla picada 2 minutos, solo hasta que se vea transparente.","Agrega las tiras de berenjena acostadas, sin encimarlas, y saltea 5 minutos, dándoles vuelta con cuidado para que se doren sin romperse.","Añade las 3 cucharadas de agua, espolvorea el orégano, tapa y cocina a fuego bajo unos 10 minutos, hasta que el agua se seque por completo y la berenjena quede bien suave.","Aprieta una tira tibia entre el pulgar y el índice: tiene que deshacerse con la presión de los dedos. La berenjena a medio cocer queda gomosa y no puede ir al plato.","Deja entibiar, prueba la temperatura en el dorso de la mano y sirve 2 tiras a la vez.","La forma es la tira del tamaño de un dedo adulto (unos 7 cm por 1,5 cm), con la punta que sobresalga de la mano cerrada. A los 8 y 9 meses el bebé todavía se lleva la comida a la boca con el puño cerrado, y la tira larga y suave es la única forma que puede morder solo sin que quede un pedazo suelto dando vueltas en la boca."],"alerta":"Quita toda la cáscara y cocina hasta que la tira se aplaste entre los dedos: la berenjena firme es riesgo de atragantamiento. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1751,"name":"Espárragos a la Plancha con Aceite de Oliva","icon":"🌿","time":"~15 min","kcal":"35 kcal (estimado)","img":"https://images.pexels.com/photos/42165/pexels-photo-42165.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["8 espárragos verdes frescos","1 cucharada de aceite de oliva extra virgen","1/2 diente de ajo machacado","1 cucharadita de perejil fresco bien picado"],"tip":"Espárragos → ejotes (judías verdes) anchos sin hebra, en la misma cantidad.","steps":["Toma cada espárrago por las dos puntas y dóblalo hasta que se rompa solo: la parte de abajo que se suelta es la fibrosa y se tira, porque nunca se ablanda.","Calienta el aceite de oliva con el ajo machacado en un sartén a fuego medio-bajo por 1 minuto, sin dejar que el ajo se dore.","Acomoda los espárragos acostados en el sartén, tapa y cocina unos 8 minutos, haciéndolos rodar de vez en cuando, hasta que queden verde vivo y blanditos, sin nada crujiente.","Aprieta un espárrago tibio entre el pulgar y el índice: tiene que aplastarse y abrirse en hebras suaves. Si todavía está firme o fibroso, tapa y cocina 3 minutos más o descarta esa parte del tallo.","Corta los espárragos ya suaves en pedazos chicos, del tamaño de una aceituna, unos 2 cm, y descarta cualquier parte del tallo que siga fibrosa.","Espolvorea el perejil, deja entibiar, prueba en el dorso de la mano y reparte 5 o 6 pedacitos directo en la bandeja de la silla de comer.","A partir de los 10 meses el niño ya hace el movimiento de pinza, agarrando con la punta del pulgar y del índice. Por eso el corte correcto pasa a ser el pedazo chico del tamaño de una aceituna (unos 2 cm): lo bastante chico para practicar la pinza y lo bastante suave para deshacerse en la encía, pero nunca redondo y entero."],"alerta":"Descarta siempre la base fibrosa del espárrago: la fibra no se aplasta entre los dedos y es riesgo de atragantamiento. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1752,"name":"Ñame Cocido en Pedacitos","icon":"🍠","time":"~30 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/7543152/pexels-photo-7543152.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 ñames medianos, pelados","1 cucharada de aceite de oliva extra virgen","1 pizca de pimentón dulce (paprika)","1 cucharadita de cebollín bien picado","Agua para cocinar"],"tip":"Ñame → papa, en la misma cantidad.","steps":["Pela los ñames bajo el chorro de agua, con la mano mojada, y córtalos en pedazos grandes para que se cocinen parejo.","Cocina en una olla con agua suficiente para cubrirlos, sin sal, unos 20 minutos contando desde que hierve.","Pincha el pedazo más grande con un tenedor: tiene que atravesarlo sin ninguna resistencia y el ñame debe estar cremoso por dentro. Si se traba, cocina 5 minutos más.","Escurre bien, deja secar 2 minutos con el calor de la misma olla apagada y corta en pedacitos chicos, del tamaño de una aceituna, unos 2 cm.","Aprieta un pedacito tibio entre el pulgar y el índice: tiene que volverse puré con la presión. Cualquier pedazo que resista a los dedos no va al plato.","Rocía con el aceite de oliva, espolvorea el pimentón dulce y el cebollín y mezcla con cuidado para que los pedacitos no se peguen entre sí.","Deja entibiar, prueba en el dorso de la mano y reparte 6 o 7 pedacitos en la bandeja. A partir de los 10 meses ya existe el movimiento de pinza, así que el pedazo chico del tamaño de una aceituna (unos 2 cm) es la forma correcta: entrena la punta de los dedos del niño y, como es tan suave que se aplasta solo en la encía, no corre el riesgo de bajar entero."],"alerta":"El ñame solo entra bien cocido, nunca crudo ni al dente. Sirve pedacitos que se aplasten entre los dedos, con el niño bien sentado, de frente a la comida, y un adulto cerca durante toda la comida."},{"id":1753,"name":"Yuca Cocida con Perejil y Cebollín","icon":"🥔","time":"~40 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/30893343/pexels-photo-30893343.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 tazas de yuca pelada, en pedazos (unos 300 g)","1 cucharada de aceite de oliva extra virgen","1 cucharada de perejil y cebollín bien picados","1 pizca de ajo en polvo","Agua para cocinar"],"tip":"Yuca → camote (batata), en la misma cantidad (se cocina unos 10 minutos más rápido).","steps":["Pela la yuca quitando la cáscara café y la piel rosada de abajo, y saca la hebra dura del centro de cada pedazo jalándola con la punta del cuchillo: ese tallo central nunca se ablanda.","Cocina los pedazos en agua hirviendo, sin sal, unos 25 a 30 minutos, hasta que la yuca se deshaga en los bordes.","Pincha con un tenedor: tiene que entrar sin resistencia y el pedazo debe empezar a abrirse solo. Si todavía está firme, cocina 10 minutos más, porque la yuca a medio cocer queda fibrosa y no sirve.","Escurre, revisa otra vez que no haya quedado ninguna hebra central y corta la yuca en pedacitos chicos, del tamaño de una aceituna, unos 2 cm.","Aprieta un pedacito tibio entre el pulgar y el índice: tiene que aplastarse y volverse puré entre los dedos. El pedazo que resista, o cualquier parte fibrosa, se tira.","Rocía con el aceite de oliva, espolvorea el ajo en polvo y el perejil con cebollín y mezcla con cuidado.","Deja entibiar, prueba en el dorso de la mano y reparte 6 pedacitos en la bandeja de la silla de comer. De los 10 meses en adelante el niño ya agarra con la pinza, así que el pedazo chico del tamaño de una aceituna (unos 2 cm) es el corte correcto: le sirve para practicar con los deditos y, así de suave, se deshace en la encía sin bajar entero."],"alerta":"Quita siempre la hebra dura del centro de la yuca y nunca sirvas yuca frita o seca, que queda dura y es riesgo de atragantamiento. Niño bien sentado, de frente a la comida, con un adulto cerca durante toda la comida."},{"id":1754,"name":"Tirita de Pollo Deshebrado Prensado","icon":"🍗","time":"~35 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/18773755/pexels-photo-18773755.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 filete de pechuga de pollo (unos 150 g)","1 hoja de laurel","1 diente de ajo machacado","1/2 cebolla pequeña en un pedazo grande","1 cucharada de aceite de oliva","1 cucharada del caldo de la misma cocción","Agua suficiente para cubrir la carne"],"tip":"Pechuga de pollo → muslo de pollo deshuesado y sin piel, en la misma cantidad.","steps":["Pon el filete de pollo en una olla pequeña con la hoja de laurel, el ajo machacado, la media cebolla y agua hasta cubrir dos dedos por encima de la carne.","Cocina a fuego medio unos 25 minutos, hasta que un tenedor atraviese la parte más gruesa del filete sin ninguna resistencia y la carne se abra sola cuando la tocas con el tenedor.","Saca el pollo, tira el laurel y la cebolla y deshebra la carne todavía tibia con dos tenedores, jalando en el sentido de las fibras hasta que queden hebras bien finas. En esta etapa no uses licuadora ni procesador.","Mezcla el pollo deshebrado con 1 cucharada del caldo de la cocción y 1 cucharada de aceite de oliva, hasta que la mezcla quede húmeda y se pegue cuando la aprietas en la palma de la mano.","Toma una porción del tamaño de un huevo, apriétala firme entre las dos manos y dale forma de barrita compacta. Ahora haz la prueba obligatoria: aprieta la barrita entre el pulgar y el índice y tiene que aplastarse con facilidad. Si queda dura o se desmorona, agrega 1 cucharada más de caldo y vuelve a prensar.","Sirve tibio, probando la temperatura en el dorso de la mano, en tiras prensadas de unos 8 cm de largo por 1,5 cm de ancho, o sea, del tamaño y grosor de un dedo adulto. De los 6 a los 9 meses el bebé todavía cierra toda la mano alrededor de la comida, así que la tira tiene que sobresalir del puño: esa punta que sobresale es la que se lleva a la boca y muerde, sin meterse el pedazo entero."],"alerta":"El pollo deshebrado suelto se vuelve hebra seca en la boca y aumenta el riesgo de atragantamiento: prénsalo bien y humedécelo con el caldo. Bebé siempre sentado, de frente a la comida, con un adulto al lado durante toda la comida."},{"id":1755,"name":"Tiritas de Pescado Blanco","icon":"🐟","time":"~20 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/5860604/pexels-photo-5860604.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 filete de tilapia o merluza sin espinas (unos 120 g)","1 cucharada de aceite de oliva","1 pizca de perejil bien picado","1 pizca de cúrcuma","1 cucharadita de jugo de limón, solo para untar el filete antes de cocinar"],"tip":"Tilapia → merluza o lenguado sin espinas, en la misma cantidad.","steps":["Pasa el filete bajo el chorro de agua, sécalo con papel de cocina y luego palpa todo el pescado con la punta de los dedos, centímetro por centímetro, buscando espinas. Quita con unas pinzas cualquier hebra dura que encuentres.","Unta la cucharadita de jugo de limón en el filete, espolvorea la pizca de cúrcuma y el perejil y deja reposar 5 minutos.","Calienta la cucharada de aceite de oliva en un sartén antiadherente a fuego bajo y pon el filete entero, sin cortarlo todavía, para que no se reseque.","Cocina unos 4 minutos por lado, hasta que la carne pierda por completo el aspecto transparente, quede blanquita hasta el centro y se separe en láminas cuando la tocas con el tenedor.","Deja entibiar y separa el filete en tiritas con el tenedor. Aprieta cada tirita entre el pulgar y el índice: tiene que deshacerse con una presión suave. Si no, vuelve 1 minuto más al sartén tapado con un chorrito de agua.","Sirve tibio, probando en el dorso de la mano, en tiritas de unos 7 cm de largo por 1,5 cm de ancho, en forma de palito del tamaño de un dedo adulto. En esta etapa el bebé agarra con la mano cerrada, y la tirita larga deja una punta fuera del puño, que es la parte que va a la boca. Un pedazo corto quedaría escondido dentro de la manita y el bebé terminaría metiéndose todo de una vez."],"alerta":"La espina de pescado es riesgo directo de atragantamiento: palpa todo el filete con los dedos antes y después de cocinarlo. Nunca ofrezcas pescado con el bebé acostado, caminando o distraído con una pantalla."},{"id":1756,"name":"Albóndiga Alargada de Carne","icon":"🥩","time":"~30 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/37941216/pexels-photo-37941216.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 8 meses","ingredients":["200 g de carne molida de res magra, molida dos veces","3 cucharadas de calabacita (zucchini) rallada bien fina y exprimida","2 cucharadas de avena en hojuelas finas","1 diente de ajo machacado","1 cucharada de cebolla bien picada","1 pizca de orégano","1 cucharada de aceite de oliva para engrasar la bandeja"],"tip":"Avena en hojuelas finas → harina de arroz, en la misma cantidad.","steps":["Pon en un bol la carne molida, la calabacita rallada y exprimida, la avena, el ajo, la cebolla y el orégano, y mezcla con la mano unos 2 minutos, hasta que la mezcla quede pareja y deje de pegarse a los dedos.","Toma porciones de 1 cucharada llena y haz rodar cada una sobre la mesa con la palma de la mano, estirándola hasta que quede una barrita larga y no una bolita. La forma redonda es justo la que no debe ir al plato a esta edad.","Reparte las barritas en una bandeja engrasada con el aceite de oliva, dejando dos dedos de espacio entre ellas para que se horneen parejo.","Hornea en horno precalentado a 180 °C unos 20 minutos, dándoles vuelta a la mitad del tiempo, hasta que la carne pierda por completo el color rosado en el centro cuando abres una albóndiga por la mitad.","Deja entibiar y aprieta una albóndiga entre el pulgar y el índice: tiene que aplastarse con facilidad y deshacerse en pedacitos suaves. Si está demasiado firme, devuélvela al horno tapada con papel aluminio y un chorrito de agua 5 minutos más.","Sirve tibia, probando en el dorso de la mano, en forma de barrita de unos 7 cm de largo por 2 cm de grosor, del tamaño de un dedo adulto. A los 8 meses el bebé todavía agarra con la mano cerrada, y la barrita larga deja una punta fuera del puño para que la muerda poco a poco. La albóndiga redonda tiene exactamente la forma y el diámetro de la vía respiratoria, y por eso no se ofrece así."],"alerta":"Nunca ofrezcas la albóndiga en bolita redonda: solo alargada en barrita. Revisa que cada pedazo se aplaste entre los dedos y quédate al lado del bebé durante toda la comida."},{"id":1757,"name":"Hamburguesa Casera en Tiras","icon":"🍔","time":"~25 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/8880744/pexels-photo-8880744.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["200 g de carne molida de res magra, molida dos veces","3 cucharadas de zanahoria cocida y aplastada con el tenedor","1 cucharada de avena en hojuelas finas","1 pizca de pimentón dulce (paprika)","1 pizca de cebollín picado","1 cucharada de aceite de oliva"],"tip":"Zanahoria cocida → calabaza (zapallo) cocida y aplastada, en la misma cantidad.","steps":["Cocina la zanahoria en agua unos 12 minutos, hasta que un tenedor la atraviese sin resistencia, y aplástala con el tenedor todavía caliente hasta que quede un puré grueso, sin usar licuadora.","Mezcla en un bol la carne molida, el puré de zanahoria, la avena, el pimentón dulce y el cebollín, apretando con la mano hasta que la mezcla quede húmeda y pareja.","Forma 4 discos planos de unos 1,5 cm de alto, apretando bien para que no se agrieten en los bordes, y deja reposar 5 minutos en el refrigerador para que se afirmen.","Cocina en un sartén antiadherente con el aceite de oliva a fuego bajo, unos 5 minutos por lado, hasta que al cortar una hamburguesa por la mitad no quede ningún punto rosado en el centro.","Deja entibiar y corta cada hamburguesa en tiras. Aprieta una tira entre el pulgar y el índice: tiene que ceder y aplastarse con facilidad. Si resiste, vuelve al sartén tapado con 1 cucharada de agua 3 minutos más para que se ablande con el vapor.","Sirve tibio, probando en el dorso de la mano, en tiras de unos 7 cm de largo por 1,5 cm de ancho, en forma de palito del tamaño de un dedo adulto. Cortar el disco en tiras, en vez de dar la hamburguesa entera o en cubos, es lo que permite que el bebé de 8 meses la agarre con la mano cerrada y muerda solo la puntita que sobresale del puño, controlando él mismo el tamaño del bocado."],"alerta":"Nada de carne término medio: el centro tiene que quedar sin ningún punto rosado. Corta siempre en tiras, nunca en cubos, y mantén a un adulto vigilando durante toda la comida."},{"id":1758,"name":"Omelette en Tiritas","icon":"🍳","time":"~12 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/7532859/pexels-photo-7532859.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 huevos enteros","1 cucharada de agua","1 pizca de perejil bien picado","1 cucharadita de aceite de oliva"],"tip":"Perejil → cebollín bien picado, en la misma cantidad.","steps":["Rompe los 2 huevos en un bol, agrega la cucharada de agua y bate con el tenedor más o menos 1 minuto, hasta que la yema y la clara queden completamente mezcladas, sin ningún hilo transparente.","Agrega la pizca de perejil y vuelve a mezclar con el tenedor.","Calienta la cucharadita de aceite de oliva en un sartén antiadherente pequeño a fuego bajo y espárcela con papel de cocina para dejar solo una capa fina.","Vierte los huevos batidos y cocina a fuego bajo unos 3 minutos de un lado, dale vuelta con la espátula y deja 2 minutos más, hasta que el omelette quede firme y sin ninguna parte blanda o brillante. El huevo para el bebé va siempre bien cocido, yema y clara.","Pasa el omelette a una tabla, deja entibiar y aprieta un pedacito entre el pulgar y el índice: tiene que aplastarse sin esfuerzo. Si está gomoso, se quedó demasiado tiempo en el fuego y conviene hacerlo de nuevo a fuego más bajo.","Corta con un cuchillo en tiras de unos 8 cm de largo por 2 cm de ancho, en forma de palito del tamaño de un dedo adulto, y sirve tibio, probando en el dorso de la mano. A los 6 meses el bebé cierra toda la manita alrededor de la comida, así que la tira larga es la forma segura: sobresale una punta del puño para que la muerda, mientras que los cuadritos chicos desaparecerían dentro de la mano y se irían enteros a la boca."],"alerta":"El huevo crudo o blando no va a ninguna edad: yema y clara siempre bien cocidas. Ofrécelo en tiras, nunca en un pedazo cuadrado grueso, y siempre con el bebé bien sentado y acompañado."},{"id":1759,"name":"Mini Frittata de Verduras","icon":"🥚","time":"~30 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/5639249/pexels-photo-5639249.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 huevos enteros","3 cucharadas de calabacita (zucchini) rallada fina","2 cucharadas de zanahoria rallada bien fina","1 cucharada de cebolla bien picada","1 pizca de orégano","1 cucharadita de aceite de oliva para engrasar los moldecitos"],"tip":"Calabacita → calabaza (zapallo) rallada fina, en la misma cantidad.","steps":["Sofríe la cebolla picada y la zanahoria rallada en la cucharadita de aceite de oliva a fuego bajo unos 5 minutos, agrega la calabacita y deja 3 minutos más, hasta que las verduras estén tan suaves que se deshagan al apretarlas con la cuchara.","Bate los 2 huevos con el tenedor en un bol hasta que la yema y la clara se mezclen por completo, agrega las verduras sofritas y el orégano y revuelve.","Reparte la mezcla en moldes para muffins engrasados, llenando hasta dos tercios de la altura para que la frittata crezca sin desbordarse.","Hornea en horno precalentado a 180 °C unos 18 minutos, hasta que la superficie esté firme al tacto y un palillo clavado en el centro salga limpio, sin huevo crudo pegado.","Desmolda todavía tibia, corta cada mini frittata por la mitad y aprieta un pedazo entre el pulgar y el índice: tiene que aplastarse con facilidad y no volver a su forma. Si está demasiado firme, el horno se pasó y la próxima tanda necesita 3 minutos menos.","Sirve tibia, probando en el dorso de la mano, en tiras de unos 7 cm de largo por 2 cm de ancho cortadas de punta a punta de la frittata, en forma de palito del tamaño de un dedo adulto. A los 8 meses el bebé todavía agarra con la mano cerrada, y la tira que sobresale del puño le permite morder solo la punta. La frittata entera en la mano sería un bocado demasiado grande para su boca."],"alerta":"La frittata sale muy caliente del horno: deja que se entibie y prueba en el dorso de la mano antes de servir. Córtala en tiras, revisa que se aplasten entre los dedos y no dejes que el bebé coma caminando."},{"id":1760,"name":"Panqueque de Huevo","icon":"🥞","time":"~15 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/13376623/pexels-photo-13376623.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 huevos enteros","1/2 banana (plátano) bien madura","2 cucharadas de avena en hojuelas finas","1 pizca de canela en polvo","1 cucharadita de aceite de oliva o de aceite de coco"],"tip":"Banana → 1/2 taza de calabaza (zapallo) cocida y aplastada, en la misma cantidad.","steps":["Aplasta la media banana con el tenedor en un plato hondo hasta que quede un puré liso, sin ningún pedazo entero. En esta etapa nada de licuadora ni colador.","Rompe los 2 huevos encima, agrega la avena y la canela y bate todo con el tenedor más o menos 1 minuto, hasta que quede una mezcla lisa que cae despacio de la cuchara.","Calienta la cucharadita de aceite en un sartén antiadherente a fuego muy bajo y espárcela con papel de cocina, dejando solo una capa fina.","Vierte la mezcla formando panqueques de unos 10 cm y cocina 3 minutos, hasta que salgan burbujitas en la superficie y los bordes se suelten solos. Dales vuelta y deja 2 minutos más, hasta que el centro esté firme y sin mezcla cruda.","Deja entibiar sobre una tabla y aprieta un pedacito entre el pulgar y el índice: el panqueque tiene que aplastarse con facilidad y quedar húmedo. Si se desmorona seco, agrega 1 cucharada más de puré de banana a la próxima mezcla.","Corta cada panqueque en tiras de unos 8 cm de largo por 2 cm de ancho, en forma de palito del tamaño de un dedo adulto, y sirve tibio probando en el dorso de la mano. El disco entero en la mano del bebé de 6 meses sería demasiado blando y se enrollaría dentro de la boca. La tira firme, en cambio, deja una punta fuera de la mano cerrada, y él muerde solo esa punta."],"alerta":"Sin azúcar, sin miel y sin leche de vaca: el dulce viene solo de la banana. Sirve en tiras, revisa que se aplasten entre los dedos y mantén al bebé sentado y vigilado."},{"id":1761,"name":"Croquetita de Frijoles","icon":"🫘","time":"~35 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/36170562/pexels-photo-36170562.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de frijoles (porotos) pintos bien cocidos y escurridos","3 cucharadas de harina de avena","1 huevo entero","1 cucharada de cebolla bien picada","1 diente de ajo machacado","1 pizca de perejil picado","1 cucharada de aceite de oliva para engrasar"],"tip":"Frijoles pintos → frijoles negros bien cocidos y escurridos, en la misma cantidad.","steps":["Escurre bien los frijoles cocidos y aplástalos con el tenedor en un bol hasta que queden una pasta gruesa, con algunos granos todavía enteros, que se queda en la cuchara sin escurrir.","Sofríe la cebolla y el ajo en el aceite de oliva a fuego bajo unos 4 minutos, hasta que estén transparentes y suaves, y mézclalos con los frijoles aplastados junto con el perejil.","Agrega el huevo y la harina de avena y revuelve hasta que la mezcla se despegue de los lados del bol y se pueda moldear con la mano.","Forma croquetitas planas de 1 cucharada cada una, acomódalas en una bandeja engrasada y hornea en horno precalentado a 180 °C unos 22 minutos, dándoles vuelta a la mitad, hasta que la superficie quede sequita y dorada de forma pareja.","Deja entibiar y aprieta una croquetita entre el pulgar y el índice: tiene que aplastarse con facilidad, sin costra dura por fuera. Si la costra resiste, cubre las croquetitas con un paño 5 minutos y el vapor las ablanda.","Sirve tibio, probando en el dorso de la mano, en pedazos chicos del tamaño de una aceituna, de unos 1,5 cm por lado. A partir de los 10 meses ya existe el movimiento de pinza, con el pulgar y el índice, así que el bebé puede agarrar solo pedazos chicos. Pero tienen que ser planos y suaves, nunca bolitas redondas enteras, que tienen la forma más peligrosa para la vía respiratoria."],"alerta":"Nada de croquetita redonda entera en la mano del bebé: aplánala y córtala en pedazos del tamaño de una aceituna. Cada pedazo tiene que aplastarse entre los dedos, y la comida es siempre sentado y acompañado."},{"id":1762,"name":"Croqueta de Lentejas al Horno","icon":"🥔","time":"~45 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/35017886/pexels-photo-35017886.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de lentejas crudas, remojadas por 2 horas","1 papa mediana cocida","2 cucharadas de queso fresco rallado","1 cucharada de cebolla bien picada","1 pizca de orégano","2 cucharadas de harina de avena","1 cucharada de aceite de oliva para engrasar"],"tip":"Lentejas → garbanzos bien cocidos y aplastados, en la misma cantidad.","steps":["Escurre las lentejas del remojo, cocínalas en agua unos 20 minutos, hasta que los granos se deshagan al apretarlos con la cuchara contra el costado de la olla, y escúrrelas muy bien.","Cocina la papa en agua unos 15 minutos, hasta que un tenedor la atraviese sin resistencia, y aplástala todavía caliente hasta que quede un puré grueso.","Mezcla en un bol las lentejas, el puré de papa, el queso fresco rallado, la cebolla, el orégano y la harina de avena, apretando con la cuchara hasta que la mezcla quede lo bastante firme para moldearla sin que se pegue a la mano.","Forma croquetas alargadas de 1 cucharada cada una, en forma de barrita y no de bolita, y acomódalas en una bandeja engrasada con el aceite de oliva.","Hornea en horno precalentado a 190 °C unos 25 minutos, dándoles vuelta a la mitad del tiempo, hasta que estén doradas por fuera y suaves por dentro. Deja entibiar y aprieta una croqueta entre el pulgar y el índice para revisar que se aplaste con facilidad. Si la costra queda dura, cúbrelas con un paño unos minutos hasta que se ablanden con su propio vapor.","Sirve tibio, probando en el dorso de la mano, en pedazos chicos del tamaño de una aceituna, de unos 1,5 cm por lado. Al año la pinza ya está bien firme y el bebé agarra esos pedacitos con el pulgar y el índice. El corte chico y suave es lo que evita que se lleve la croqueta entera a la boca de una vez."],"alerta":"El queso de esta receta es la razón por la que empieza recién al año. Corta en pedazos del tamaño de una aceituna, revisa que se aplasten entre los dedos y vigila durante toda la comida."},{"id":1763,"name":"Kibbe de Calabaza al Horno","icon":"🎃","time":"~50 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/5847944/pexels-photo-5847944.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de trigo bulgur","1 taza de calabaza (zapallo) cocida y aplastada","200 g de carne molida de res magra, molida dos veces","1 cucharada de cebolla bien picada","1 pizca de hierbabuena (menta) bien picada","1 cucharada de aceite de oliva"],"tip":"Trigo bulgur → avena en hojuelas finas hidratada, en la misma cantidad.","steps":["Cubre el trigo bulgur con agua tibia y deja que se hidrate 30 minutos, hasta que los granos se inflen y queden suaves al apretarlos. Escúrrelo apretando con las manos para sacarle toda el agua.","Cocina la calabaza en agua unos 15 minutos, hasta que un tenedor la atraviese sin resistencia, y aplástala con el tenedor hasta que quede un puré grueso que se queda en la cuchara sin escurrir.","Mezcla en un bol el trigo escurrido, el puré de calabaza, la carne molida, la cebolla y la hierbabuena, apretando con la mano hasta que la mezcla quede bien pareja y sin bolitas de carne separadas.","Extiende la mezcla en una bandeja engrasada con el aceite de oliva formando una capa de unos 2 cm de alto, alisa la superficie con el dorso de la cuchara y rocía con un chorrito de aceite de oliva.","Hornea en horno precalentado a 190 °C unos 30 minutos, hasta que la superficie quede dorada y la carne pierda por completo el color rosado cuando abres el kibbe por la mitad. Deja entibiar y aprieta un pedazo entre el pulgar y el índice para confirmar que se aplasta con facilidad, sin costra dura.","Sirve tibio, probando en el dorso de la mano, en pedazos chicos del tamaño de una aceituna, de unos 1,5 cm por lado, descartando los bordes más secos de la bandeja. Al año el bebé ya usa la pinza y agarra bien esos pedacitos. El tamaño chico y la textura que cede entre los dedos son lo que hace seguro el corte en esta etapa."],"alerta":"Descarta los bordes duros de la bandeja: solo va al plato el pedazo que se aplasta entre los dedos. Corta en pedazos del tamaño de una aceituna y quédate cerca del bebé durante toda la comida."},{"id":1764,"name":"Tofu a la Plancha en Palitos","icon":"🍢","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/5182130/pexels-photo-5182130.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["150 g de tofu firme","1 cucharada de aceite de oliva","1 pizca de cúrcuma","1 pizca de orégano","1 diente de ajo machacado"],"tip":"Tofu firme → tofu suave bien escurrido, en la misma cantidad, a la plancha por menos tiempo.","steps":["Escurre el tofu, envuélvelo en un paño limpio y déjalo 10 minutos con un plato encima para quitarle el exceso de agua. Eso ayuda a que el palito no se deshaga en la mano del bebé.","Corta el bloque en palitos de unos 7 cm de largo por 1,5 cm de grosor, siempre a lo largo, nunca en cubitos.","Mezcla en un bol el aceite de oliva, el ajo machacado, la cúrcuma y el orégano y pasa esa mezcla por todos los lados de los palitos con la punta de los dedos.","Cocina en un sartén antiadherente a fuego medio-bajo unos 3 minutos por lado, girándolos con la espátula, hasta que se forme una costrita dorada ligera, sin dejar que se resequen o endurezcan.","Deja entibiar y aprieta un palito entre el pulgar y el índice: tiene que aplastarse con facilidad, cediendo a una presión suave. Si está gomoso, el fuego estaba demasiado alto y conviene cocinar los siguientes por menos tiempo.","Sirve tibio, probando en el dorso de la mano, en palitos de unos 7 cm por 1,5 cm, o sea, del tamaño de un dedo adulto. De los 6 a los 9 meses el bebé agarra con la mano cerrada y no puede soltar lo que está dentro del puño, así que el palito largo es la forma correcta: la punta que sobresale de la mano es justo la parte que se lleva a la boca y muerde."],"alerta":"El tofu muy firme o demasiado cocido queda gomoso y no se aplasta entre los dedos: en ese caso no va al plato. Córtalo siempre en palito, nunca en cubo, y ofrécelo con el bebé bien sentado y acompañado."},{"id":1765,"name":"Carne Deshebrada con Verduras","icon":"🍖","time":"~60 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/19805189/pexels-photo-19805189.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 8 meses","ingredients":["200 g de carne de res magra en pieza (también sirve músculo o paleta)","1 zanahoria mediana","1 pedazo de 5 cm de calabacita (zucchini)","1 diente de ajo machacado","1 hoja de laurel","1 cucharada de aceite de oliva","Agua suficiente para cubrir la carne"],"tip":"Carne magra en pieza → músculo de res, en la misma cantidad, cocinando 10 minutos más.","steps":["Pon la carne en una olla de presión con el ajo, la hoja de laurel y agua hasta cubrir, y cocina unos 35 minutos desde que la olla empieza a silbar, hasta que la pieza se abra en hebras con solo tocarla con el tenedor.","Mientras tanto, corta la zanahoria y la calabacita en palitos de unos 7 cm por 1,5 cm y cocínalos al vapor unos 15 minutos, hasta que un tenedor los atraviese sin ninguna resistencia.","Saca la carne, tira el laurel y deshebra con dos tenedores en el sentido de las fibras, hasta que queden hebras bien finas. Guarda 3 cucharadas del caldo de la cocción.","Vuelve a poner la carne deshebrada en la olla con el caldo guardado y el aceite de oliva y cocina a fuego bajo unos 5 minutos, hasta que la carne quede húmeda y brillante, nunca seca.","Aprieta un palito de zanahoria y una porción de carne entre el pulgar y el índice: los dos tienen que aplastarse con facilidad. Si la zanahoria todavía resiste, devuélvela al vapor 5 minutos más, porque la verdura que no se aplasta entre los dedos no va al plato.","Sirve tibio, probando en el dorso de la mano, con la carne deshebrada apretada con la mano en tiritas de unos 7 cm, al lado de los palitos de verdura del mismo tamaño, todos del grosor de un dedo adulto. A los 8 meses el bebé agarra con la mano cerrada, y tanto la tira de carne prensada como el palito de verdura dejan una punta fuera del puño, que es la parte que puede morder solo."],"alerta":"La carne deshebrada suelta puede formar una hebra seca en la garganta: siempre humedecida con el caldo y prensada en tirita. Revisa que la zanahoria se aplaste entre los dedos y vigila durante toda la comida."},{"id":1766,"name":"Mini Nuggets de Pollo al Horno","icon":"🐤","time":"~40 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/7428285/pexels-photo-7428285.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 10 meses","ingredients":["200 g de pechuga de pollo molida o bien picada","3 cucharadas de camote (batata) cocido y aplastado","2 cucharadas de harina de avena","1 cucharada de cebolla bien picada","1 pizca de pimentón dulce (paprika)","2 cucharadas de harina de avena para empanizar","1 cucharada de aceite de oliva para engrasar"],"tip":"Camote → papa cocida y aplastada, en la misma cantidad.","steps":["Cocina el camote en agua unos 15 minutos, hasta que un tenedor lo atraviese sin resistencia, y aplástalo con el tenedor hasta que quede un puré grueso.","Mezcla en un bol el pollo molido, el puré de camote, las 2 cucharadas de harina de avena, la cebolla y el pimentón dulce, apretando con la mano hasta que la mezcla quede firme y se despegue de los dedos.","Forma nuggets planos de 1 cucharada cada uno, de unos 1 cm de alto, y pasa cada uno por la harina de avena que separaste para empanizar.","Acomódalos en una bandeja engrasada con el aceite de oliva y hornea en horno precalentado a 190 °C unos 22 minutos, dándoles vuelta a la mitad del tiempo, hasta que al abrir un nugget por la mitad la carne esté blanquita por completo, sin ningún punto rosado.","Deja entibiar y aprieta un nugget entre el pulgar y el índice: tiene que aplastarse con facilidad y quedar húmedo por dentro. Si la costra queda dura, cubre la bandeja con un paño 5 minutos para que el vapor los ablande.","Sirve tibio, probando en el dorso de la mano, en pedazos chicos del tamaño de una aceituna, de unos 1,5 cm por lado. A partir de los 10 meses el bebé ya hace el movimiento de pinza con el pulgar y el índice y puede agarrar pedazos chicos solo. El corte plano y suave es seguro porque cede en la boca, al contrario del nugget entero, que sería un bocado demasiado grande para que lo controle."],"alerta":"El pollo tiene que estar blanquito en el centro, sin ningún punto rosado. Corta en pedazos del tamaño de una aceituna que se aplasten entre los dedos y mantén a un adulto al lado del bebé todo el tiempo."},{"id":1767,"name":"Tiras de Mango Maduro","icon":"🥭","time":"~10 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/4023132/pexels-photo-4023132.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 mango bien maduro (mediano)","1 cucharada de avena en hojuelas finas"],"tip":"Mango → papaya bien madura, en la misma cantidad.","steps":["Elige un mango bien maduro, que ceda cuando lo aprietas suavemente con el pulgar: el mango duro no se aplasta entre los dedos y todavía no sirve para el bebé.","Lava la cáscara con agua corriente, sécala con un paño limpio y pela la fruta apoyada en una tabla, con el pelador o con el cuchillo.","Corta la pulpa pegada al hueso, soltando las dos caras del mango en pedazos grandes, y guarda el hueso lejos del alcance del niño.","Aprieta un pedazo entre el pulgar y el índice: tiene que aplastarse con facilidad y sin esfuerzo. Si resiste, cocina las tiras al vapor 3 minutos y deja que se entibien antes de servir.","Pasa cada tira ligeramente por la avena en hojuelas finas, solo para quitarle lo resbaloso y que el bebé pueda agarrarla sin que la fruta se le escape de la mano.","Corta en tiras del tamaño de un dedo adulto, unos 8 cm de largo por 2 cm de ancho, y sirve 2 o 3 a la vez a temperatura ambiente. De los 6 a los 9 meses el bebé todavía agarra con la mano cerrada: la tira larga sobresale unos tres dedos del puño y puede morder solo la punta, mientras que un cubito chico desaparece dentro de la mano cerrada y no lo alcanza con la boca."],"alerta":"Nada de mango duro o muy fibroso: solo el bien maduro, que se aplasta entre los dedos. Bebé siempre bien sentado, de frente a la comida, con un adulto al lado durante toda la comida."},{"id":1768,"name":"Banana con Cáscara para Agarrar","icon":"🍌","time":"~5 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/4114147/pexels-photo-4114147.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 banana (plátano) bien madura","1 cucharada de avena en hojuelas finas"],"tip":"Banana → cualquier otra variedad de banana dulce bien madura, en la misma cantidad.","steps":["Lava la cáscara de la banana con agua corriente y sécala, porque la mano del bebé va a estar tocándola toda la comida.","Corta la banana por la mitad a lo largo sin quitarle la cáscara y luego corta cada mitad otra vez a lo largo, formando cuatro tiras largas con cáscara de un lado.","Jala la cáscara de cada tira solo hasta la mitad, dejando una parte con cáscara para que el bebé la agarre y una parte de fruta descubierta para que la muerda.","Aprieta la parte descubierta entre el pulgar y el índice: la banana madura se aplasta enseguida, casi como puré. La banana todavía verdosa no se aplasta y no debe ofrecerse.","Espolvorea la parte descubierta con la avena en hojuelas finas para que resbale menos y la manita la agarre mejor.","Sirve 1 tira a la vez a temperatura ambiente, con la fruta sobresaliendo unos 3 o 4 dedos del puño cerrado. De los 6 a los 9 meses esta tira larga con cáscara de apoyo es la forma más segura que existe: el bebé la agarra por la cáscara, muerde solo la punta y no puede meterse el pedazo entero en la boca."],"alerta":"Nunca ofrezcas banana en rodajas: la forma redonda es la que más se atora en la garganta. Retira la cáscara del plato en cuanto el bebé termine y quédate a su lado durante toda la comida."},{"id":1769,"name":"Pera Cocida en Tiras","icon":"🍐","time":"~15 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/8190280/pexels-photo-8190280.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 pera madura (mediana)","1/2 taza de agua filtrada","1 pizca de canela en polvo"],"tip":"Pera → manzana roja, cocida al vapor por el mismo tiempo, en la misma cantidad.","steps":["Lava la pera con agua corriente, pélala y córtala por la mitad, quitando el centro y todas las semillas con una cucharita.","Corta cada mitad en tiras de más o menos 8 cm de largo por 2 cm de ancho, del tamaño de un dedo adulto.","Cocina las tiras al vapor sobre 1/2 taza de agua unos 8 minutos, o hasta que un tenedor atraviese la tira sin ninguna resistencia.","Espolvorea una pizca de canela en polvo todavía caliente, apaga el fuego y deja entibiar 10 minutos sobre una tabla.","Prueba un pedazo entre el pulgar y el índice: tiene que aplastarse con facilidad, casi como un puré. Si todavía está firme, devuelve las tiras al vapor 3 minutos más.","Sirve tibio, probando antes en el dorso de la mano, 2 o 3 tiras a la vez, siempre en forma de palito del tamaño de un dedo adulto, con una punta que sobresalga de la mano cerrada. En esta etapa el bebé todavía no hace el movimiento de pinza, y la tira larga es la única forma que puede llevarse solo a la boca de manera segura."],"alerta":"La pera cruda es dura y no se aplasta entre los dedos, así que en esta etapa solo va cocida. Sin cáscara y sin ninguna semilla, y siempre con un adulto cerca durante toda la comida."},{"id":1770,"name":"Tiritas de Papaya y Sandía","icon":"🍉","time":"~10 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/39325514/pexels-photo-39325514.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 rebanada gruesa de papaya bien madura","1 rebanada gruesa de sandía sin semillas","1 cucharada de avena en hojuelas finas"],"tip":"Sandía → melón bien maduro y sin semillas, en la misma cantidad.","steps":["Lava la cáscara de la papaya y de la sandía con agua corriente antes de cortarlas, para que el cuchillo no lleve la suciedad de la cáscara a la pulpa.","Pela la papaya y quita todas las semillitas negras con una cuchara, raspando bien el hueco de la fruta.","Corta la sandía y quita con la punta del cuchillo cada semilla negra o blanca que aparezca, una por una, porque la semilla entera es riesgo de atragantamiento.","Aprieta un pedazo de cada fruta entre el pulgar y el índice: las dos tienen que aplastarse sin esfuerzo. La parte blanca de la sandía, cerca de la cáscara, queda dura y se descarta.","Pasa las tiras por la avena en hojuelas finas para que no se resbalen de la manita del bebé cuando se las lleve a la boca.","Corta todo en tiras del tamaño de un dedo adulto, unos 8 cm de largo por 2 cm de ancho, sirve fresquito o a temperatura ambiente y ofrece 2 tiras a la vez. De los 6 a los 9 meses el corte tiene que ser largo justamente porque la mano del bebé se cierra alrededor de la comida y solo la punta que sobresale del puño llega a la boca."],"alerta":"Sandía solo sin ninguna semilla y papaya sin las semillitas negras. Nada de pedazos redondos: siempre tira larga, con el bebé bien sentado y acompañado por un adulto."},{"id":1771,"name":"Tiras de Aguacate con Avena","icon":"🥑","time":"~8 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/17453964/pexels-photo-17453964.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1/2 aguacate (palta) pequeño bien maduro","2 cucharadas de avena en hojuelas finas","1 pizca de perejil fresco bien picado"],"tip":"Avena en hojuelas finas → harina de maíz fina tostada ligeramente en el sartén, en la misma cantidad.","steps":["Elige un aguacate que ceda al tocarlo suavemente con el pulgar: el aguacate duro no se aplasta entre los dedos y todavía no debe ofrecerse.","Corta el aguacate por la mitad a lo largo, quita el hueso con cuidado usando una cuchara y guárdalo lejos del alcance del bebé.","Saca la pulpa de la mitad con una cuchara grande, manteniendo el pedazo entero para poder cortar tiras firmes después.","Corta la pulpa en tiras del tamaño de un dedo adulto, unos 8 cm de largo por 2 cm de ancho, apoyando el cuchillo en una tabla seca.","Aprieta una tira entre el pulgar y el índice para confirmar que se aplasta con facilidad y pasa todas las tiras por la avena en hojuelas finas con el perejil, porque el aguacate es muy resbaloso y sin esa capita se escapa de la mano.","Sirve 2 tiras a la vez a temperatura ambiente, sobre un plato antideslizante, con la punta de la tira sobresaliendo del puño cerrado. Ese largo es lo que permite que el bebé de 6 a 9 meses muerda solo la punta sin meterse el pedazo entero en la boca."],"alerta":"Guarda el hueso del aguacate fuera del alcance del niño: es liso, redondo y del tamaño de la vía respiratoria. Comida siempre con el niño sentado y un adulto al lado."},{"id":1772,"name":"Durazno Cocido en Tiras","icon":"🍑","time":"~15 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/10817520/pexels-photo-10817520.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 duraznos maduros","1/2 taza de agua filtrada","1 pizca de canela en polvo"],"tip":"Durazno → nectarina madura, cocida de la misma forma, en la misma cantidad.","steps":["Lava los duraznos con agua corriente, córtalos por la mitad rodeando el hueso con el cuchillo y quita el hueso entero, guardándolo lejos del bebé.","Pela las mitades, porque la cáscara del durazno es fina, resbala y se puede enrollar dentro de la boca del bebé.","Corta cada mitad en tiras de unos 8 cm de largo por 2 cm de ancho, del tamaño de un dedo adulto.","Cocina las tiras al vapor sobre 1/2 taza de agua unos 6 minutos, hasta que un tenedor las atraviese sin resistencia, y espolvorea la pizca de canela.","Deja entibiar 10 minutos y prueba un pedazo entre el pulgar y el índice: si se aplasta sin esfuerzo, está en su punto. Si todavía está firme, vuelve al vapor 2 minutos más.","Sirve tibio, probando en el dorso de la mano, 2 o 3 tiras a la vez, en forma de palito del tamaño de un dedo adulto. A los 8 meses el bebé todavía agarra con la mano cerrada, así que la tira larga con la punta que sobresale es la forma segura. El pedazo chico, solo después de los 10 meses, cuando aparece el movimiento de pinza."],"alerta":"El hueso del durazno es un riesgo grave de atragantamiento: quítalo entero y descártalo antes de servir. El durazno crudo solo si se aplasta entre los dedos; si no, va cocido, y siempre con un adulto acompañando."},{"id":1773,"name":"Panqueque de Banana en Tiras","icon":"🥞","time":"~20 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/36854694/pexels-photo-36854694.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) bien madura","1 huevo de campo","2 cucharadas de avena en hojuelas finas","1 pizca de canela en polvo","1 chorrito de aceite de oliva para engrasar"],"tip":"Huevo → 2 cucharadas de puré de manzana, en la misma proporción, si todavía no le has dado huevo.","steps":["Aplasta la banana con un tenedor en un plato hondo hasta que quede un puré sin pedazos grandes, sin usar licuadora ni procesador.","Agrega el huevo entero, la avena en hojuelas finas y la pizca de canela y mezcla con el tenedor por 1 minuto, hasta que la mezcla quede pareja y un poco espesa.","Deja reposar la mezcla 5 minutos para que la avena se hidrate; si no, el panqueque se desmorona en la mano del bebé.","Calienta un sartén antiadherente a fuego bajo con un chorrito de aceite de oliva, extiende la mitad de la mezcla formando un disco de unos 12 cm y dora 3 minutos por lado, hasta que el panqueque se suelte solo del fondo.","Deja entibiar sobre una tabla y aprieta un pedazo entre el pulgar y el índice: tiene que ceder y aplastarse, sin quedar gomoso. Si está demasiado seco, agrega 1 cucharada de agua a la siguiente tanda.","Corta el panqueque en tiras de unos 8 cm de largo por 2 cm de ancho, del tamaño de un dedo adulto, y sirve tibio, 2 tiras a la vez. La tira larga es la forma correcta hasta los 9 meses porque sobresale de la mano cerrada del bebé y él muerde solo la punta. El disco entero o el pedazo redondeado, no."],"alerta":"El huevo siempre bien cocido, sin ninguna parte blanda en el centro. Corta el panqueque en tiras, nunca en bolitas ni pedazos redondos, y quédate al lado del bebé durante toda la comida."},{"id":1774,"name":"Pancito sin Sal en Tiras","icon":"🍞","time":"~1h50","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/34376712/pexels-photo-34376712.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"8 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de harina de trigo","1 cucharadita de levadura seca","3/4 de taza de agua tibia","2 cucharadas de aceite de oliva","1 pizca de orégano seco"],"tip":"Harina de trigo → mitad harina de trigo y mitad harina de avena, manteniendo la misma cantidad total.","steps":["Disuelve la levadura seca en 3/4 de taza de agua tibia, probada en el dorso de la mano para que esté tibia y nunca caliente, y deja reposar 10 minutos hasta que se forme espumita en la superficie.","Agrega la harina de trigo, el aceite de oliva y la pizca de orégano y amasa con las manos unos 8 minutos, hasta que quede una masa lisa que se despega del bol.","Cubre con un paño limpio y deja crecer en un lugar tibio y sin corrientes de aire por 1 hora, o hasta que la masa duplique su tamaño.","Forma un pan rectangular, ponlo en un molde engrasado con aceite de oliva y hornea en horno precalentado a 180 °C unos 30 minutos, hasta que se dore y suene hueco cuando le das golpecitos con el dedo.","Espera a que se enfríe por completo, quita toda la corteza de los bordes y aprieta un pedazo de la miga entre el pulgar y el índice: tiene que aplastarse con facilidad, porque la corteza dura o el pan tostado no se pueden ofrecer a esta edad.","Corta solo la miga suave en tiras de unos 8 cm de largo por 2 cm de ancho, del tamaño de un dedo adulto, y sirve 1 tira a la vez con el bebé sentado. Hasta los 9 meses la tira larga es la forma segura porque sobresale de la mano cerrada, y el pan tiene que estar suave: el pan seco se vuelve una bola pegajosa en la boca y es riesgo de atragantamiento."],"alerta":"Nada de sal en la masa y nada de corteza dura o tostada, solo miga suave en tira. Ofrece una tira a la vez, con un adulto al lado, y nunca dejes que el bebé camine con el pan en la mano."},{"id":1775,"name":"Crepa de Huevo en Palitos","icon":"🍳","time":"~10 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/24738514/pexels-photo-24738514.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 huevo de campo","2 cucharadas de fécula de maíz disuelta en 1 cucharada de agua","1 pizca de orégano seco","1 chorrito de aceite de oliva para engrasar"],"tip":"Fécula de maíz → 2 cucharadas de harina de avena, en la misma cantidad.","steps":["Bate el huevo con un tenedor en un bol por 30 segundos, hasta que la yema y la clara queden completamente mezcladas, sin hilos de clara a la vista.","Agrega la fécula de maíz disuelta y la pizca de orégano y revuelve hasta que no quede ningún grumo de fécula en el bol.","Calienta un sartén antiadherente pequeño a fuego bajo con un chorrito de aceite de oliva, vierte toda la mezcla y extiéndela con el dorso de la cuchara, formando un disco bien delgado.","Cocina unos 3 minutos, hasta que el borde se suelte solo, dale vuelta con la espátula y deja 2 minutos más, asegurándote de que el huevo quede bien cocido, sin ninguna parte blanda.","Pásala a una tabla, espera a que se entibie y aprieta un pedacito entre el pulgar y el índice: tiene que aplastarse con facilidad. Si queda gomosa, es señal de que la crepa quedó demasiado gruesa y conviene hacerla de nuevo más delgada.","Corta en palitos de unos 6 cm de largo por 1,5 cm de ancho o, si el bebé ya agarra con el movimiento de pinza, en pedacitos del tamaño de una aceituna, unos 1,5 cm. A los 10 meses la pinza ya permite el pedazo chico, pero siempre tiene que ser plano y suave, nunca redondo y entero, porque solo la forma plana no tapa la vía respiratoria."],"alerta":"Huevo bien cocido por los dos lados, sin centro blando. El pedazo nunca más grande que una aceituna y siempre plano, con el niño sentado y un adulto acompañando durante toda la comida."},{"id":1776,"name":"Uvas y Kiwi en Pedacitos","icon":"🍇","time":"~10 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/8963440/pexels-photo-8963440.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["6 uvas sin semilla","1 kiwi bien maduro","1 cucharada de yogur natural entero, si el pediatra ya lo autorizó"],"tip":"Kiwi → mango bien maduro en pedacitos, en la misma cantidad.","steps":["Lava las uvas una por una con agua corriente, frotando la cáscara con los dedos, y descarta las que estén arrugadas o con la cáscara muy gruesa.","Corta cada uva en cuatro a lo largo, del rabito a la punta, y nunca en rodajas: la rodaja mantiene la forma redonda, que es justo la que se atora en la garganta.","Pasa la punta del cuchillo por dentro de cada cuarto de uva y quita cualquier semillita que haya quedado.","Pela el kiwi bien maduro, córtalo por la mitad a lo largo, quita la parte blanca del centro, que es más dura, y pícalo en pedacitos del tamaño de una aceituna, unos 1,5 cm.","Aprieta un pedazo de uva y uno de kiwi entre el pulgar y el índice: los dos tienen que aplastarse sin esfuerzo. Si el kiwi todavía está firme, déjalo unos días más en el frutero antes de ofrecerlo.","Sirve frío, solo o con la cucharada de yogur natural encima, en porciones de 4 o 5 pedacitos a la vez. A los 10 meses el bebé ya hace el movimiento de pinza y puede agarrar pedazos chicos, pero el tamaño máximo es el de una aceituna y nada puede ir redondo y entero al plato: por eso la uva va siempre cortada en cuatro, a lo largo."],"alerta":"La uva entera o en rodajas es uno de los mayores riesgos de atragantamiento en la infancia: solo en cuatro, a lo largo. Niño sentado, sin pantallas, con un adulto al lado."},{"id":1777,"name":"Pasta para Comer con la Mano con Tomate Cherry","icon":"🍝","time":"~25 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/34132123/pexels-photo-34132123.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de pasta tipo tornillo (fusilli) cruda","6 tomates cherry maduros","1 diente de ajo pequeño machacado","1 cucharada de aceite de oliva","1 pizca de orégano seco","1 pizca de albahaca fresca picada"],"tip":"Pasta tipo tornillo → pasta tipo moñito (farfalle), cocida por el mismo tiempo, en la misma cantidad.","steps":["Cocina la pasta en agua hirviendo sin sal unos 12 minutos, unos 3 minutos más de lo que pide el paquete, porque para el bebé la pasta tiene que quedar bien blandita y nunca al dente.","Escurre la pasta y prueba un tornillo entre el pulgar y el índice: tiene que aplastarse con facilidad, sin resistencia en el centro. Si resiste, vuelve a la olla 2 minutos más.","Corta cada tomate cherry en cuatro a lo largo, nunca en rodajas, y quita las semillas con la punta de la cuchara.","Sofríe el ajo machacado en el aceite de oliva a fuego bajo por 1 minuto, agrega los cuartos de tomate cherry y cocina unos 6 minutos, hasta que la cáscara se suelte y la salsa espese.","Mezcla la pasta con la salsa, agrega el orégano y la albahaca y deja entibiar hasta la temperatura de servir, probando en el dorso de la mano.","Sirve en porciones chicas, con 5 o 6 tornillos a la vez, para que el bebé los agarre con el movimiento de pinza. El tornillo bien cocido mide unos 2 cm, el tamaño de una aceituna, y sus ranuras ayudan a agarrarlo. El tomate cortado en cuatro pierde la forma redonda, que es justo lo que hace que un tomate cherry entero tape la vía respiratoria."],"alerta":"El tomate cherry entero es riesgo de atragantamiento: siempre en cuatro, a lo largo. Pasta bien cocida, nunca al dente, y un adulto cerca durante toda la comida."},{"id":1778,"name":"Mini Quesadilla Doblada","icon":"🫓","time":"~10 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/11094180/pexels-photo-11094180.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 tortilla de maíz o de harina pequeña y suave","2 cucharadas de queso fresco rallado","1 cucharadita de mantequilla sin sal","1 pizca de orégano seco"],"tip":"Queso fresco → queso cottage sin sal agregada, en la misma cantidad.","steps":["Revisa que la tortilla esté suave y flexible, sin partes secas ni tostadas en el borde. Si el borde está duro, recórtalo con un cuchillo.","Calienta la tortilla en un sartén antiadherente pequeño a fuego bajo unos 30 segundos por lado, solo hasta que esté tibia y se pueda doblar sin romperse.","Reparte el queso fresco rallado sobre la mitad de la tortilla, unta la mantequilla sin sal y espolvorea la pizca de orégano.","Dobla la tortilla por la mitad con la espátula, aprieta un poco para cerrarla y deja 1 minuto más a fuego bajo, solo hasta que el queso se derrita.","Pásala a una tabla, espera 5 minutos a que se entibie y aprieta un pedazo entre el pulgar y el índice: tiene que aplastarse. La tortilla que se secó en el fuego queda dura y en ese caso hay que hacerla de nuevo, por menos tiempo.","Corta la media luna en pedazos del tamaño de una aceituna, unos 2 cm, o en tiras cortas de 5 cm, y sirve tibio, pocos pedazos a la vez. A partir de los 12 meses el niño ya agarra con la pinza y mastica mejor, pero el pedazo sigue siendo chico, plano y suave, porque la tortilla en pedazo grande y elástico se pega al paladar."],"alerta":"Nada de tortilla dura, tostada o muy elástica: solo suave, en pedazo chico y plano. Niño bien sentado, sin pantallas, con un adulto al lado durante toda la comida."},{"id":1779,"name":"Polenta Firme en Palitos","icon":"🌽","time":"~40 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/33173599/pexels-photo-33173599.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de harina de maíz para polenta","2 tazas de agua filtrada","1/4 de taza de leche entera","1 cucharada de queso fresco rallado","1 cucharadita de aceite de oliva","1 pizca de cúrcuma"],"tip":"Leche entera → leche materna o la fórmula que el bebé ya toma, en la misma cantidad.","steps":["Hierve las 2 tazas de agua en una olla, agrega la pizca de cúrcuma y baja el fuego.","Echa la harina de maíz en forma de lluvia, revolviendo sin parar con una cuchara de madera, para que no se formen grumos.","Cocina a fuego bajo unos 25 minutos, revolviendo cada 2 minutos, hasta que la polenta se despegue del fondo de la olla y quede bien espesa.","Agrega la leche entera, el queso fresco rallado y el aceite de oliva y revuelve 2 minutos más, hasta que quede cremosa y pareja.","Extiende la polenta en un molde engrasado formando una capa de 2 cm de alto, deja que se enfríe por completo y llévala al refrigerador por 1 hora, hasta que esté lo bastante firme para cortarla sin que se deshaga.","Corta en palitos de unos 6 cm de largo por 2 cm de ancho y aprieta uno entre el pulgar y el índice: tiene que aplastarse con facilidad. Si está demasiado firme, la polenta se secó y debe volver a la olla con un poco de agua.","Sirve tibia o fría, 2 palitos a la vez, probando la temperatura en el dorso de la mano. A partir de los 12 meses el niño ya agarra pedazos chicos con la pinza, pero aquí el palito sigue siendo la mejor forma porque se deshace en la boca y no forma una bola. Nunca frías los palitos: la costrita crujiente se rompe en astillas duras y se vuelve riesgo de atragantamiento."],"alerta":"La polenta siempre suave y nunca frita: el palito crujiente se rompe en astillas duras y puede atragantar. Sirve tibia, con el niño sentado y acompañado por un adulto."}],"11":[{"id":1800,"name":"Banana Aplastada con Avena en 3 Minutos","icon":"🍌","time":"~3 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/7655878/pexels-photo-7655878.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 banana (plátano) bien madura","1 cucharada de avena en hojuelas finas","1 cucharada de agua filtrada tibia"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad, para una crema todavía más lisa.","steps":["Elige una banana bien madura, con pintitas oscuras en la cáscara: se aplasta sola con el tenedor y no necesita ninguna cocción.","Aplasta la 1/2 banana con el dorso de un tenedor dentro del mismo platito, unos 40 segundos, hasta que quede un puré sin ningún trozo entero.","Mezcla 1 cucharada de avena en hojuelas finas y 1 cucharada de agua filtrada tibia, revolviendo hasta que se incorpore por completo.","Deja reposar 2 minutos: la avena absorbe el agua, se ablanda y espesa la papilla sola, sin necesitar nada de azúcar.","Revisa la textura inclinando la cuchara de lado — la crema tiene que quedarse quieta sin escurrir, y ninguna hojuela debe raspar entre los dedos.","Sirve en el momento, a temperatura ambiente, en cucharadas pequeñas, con el bebé bien sentado y un adulto al lado durante toda la comida."],"alerta":"No la sirvas con la avena todavía seca: los 2 minutos de reposo son lo que evita que la hojuela raspe la garganta del bebé."},{"id":1801,"name":"Crema de Aguacate con Gotas de Limón","icon":"🥑","time":"~4 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/7936673/pexels-photo-7936673.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/4 de aguacate (palta) bien maduro","3 gotas de jugo de limón colado","1 cucharada de agua filtrada, si hace falta aflojar"],"tip":"Aguacate → 1/4 de aguacate hass bien maduro, en la misma cantidad y con la misma preparación.","steps":["Aprieta el aguacate suavemente con el pulgar: tiene que ceder enseguida. El aguacate firme no se aplasta por completo y no se debe ofrecer en esta etapa.","Saca con la cuchara solo la pulpa verde clara de la parte central, desechando la cáscara y la parte oscura y amarga que queda pegada a ella.","Aplasta la pulpa con el dorso del tenedor más o menos 1 minuto, presionando contra el fondo del plato, hasta que quede una crema lisa y sin ninguna hebra.","Agrega las 3 gotas de jugo de limón colado y mezcla: además del sabor, el limón retrasa por unos minutos el oscurecimiento natural de la fruta.","Si la crema queda demasiado firme, agrega 1 cucharada de agua filtrada y vuelve a aplastar, hasta que se quede quieta en la cuchara inclinada sin escurrir.","Sirve de inmediato, a temperatura ambiente, en cucharadas pequeñas — el aguacate aplastado se oscurece rápido y no vale la pena guardarlo para después."]},{"id":1802,"name":"Papaya Aplastada al Momento","icon":"🧡","time":"~3 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/10869540/pexels-photo-10869540.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 rebanada gruesa de papaya bien madura (unos 100 g)"],"tip":"Papaya → mango bien maduro, en la misma cantidad y con la misma preparación.","steps":["Corta la rebanada de papaya por la mitad y raspa el hueco con una cucharadita hasta que no quede ninguna semillita negra pegada a la pulpa.","Pela la rebanada con el cuchillo apoyada en la tabla, desechando también la parte verdosa y más firme que queda junto a la cáscara.","Aplasta la pulpa con el dorso del tenedor unos 40 segundos, hasta que quede un puré espeso y parejo, sin ningún trozo más grande que un grano de arroz.","Pasa el puré entre el pulgar y el índice para confirmar que no se escapó ninguna semilla y que la textura quedó lisa por completo.","Sirve en el momento, a temperatura ambiente, en cucharadas pequeñas, con el bebé bien sentado y vigilado."],"alerta":"Las semillas de la papaya son pequeñas, negras y resbalosas — una forma de alto riesgo de atragantamiento. Raspa todo el hueco antes de aplastar."},{"id":1803,"name":"Puré Exprés de Papa con Aceite de Oliva","icon":"🥔","time":"~5 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/19374934/pexels-photo-19374934.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 papa mediana ya cocida, del refrigerador","2 cucharadas de agua filtrada tibia","1 cucharadita de aceite de oliva extra virgen"],"tip":"Papa → camote (batata) o ñame ya cocidos, en la misma cantidad.","steps":["Saca la papa ya cocida del refrigerador, pélala si todavía tiene cáscara y córtala en trozos grandes dentro de un platito hondo.","Rocíala con 2 cucharadas de agua filtrada tibia y llévala al microondas 1 minuto, solo para que la papa vuelva a quedar caliente y suave por dentro.","Aplasta con el dorso del tenedor más o menos 1 minuto, hasta que quede un puré cremoso y sin ningún grumo firme que resista la presión.","Mezcla 1 cucharadita de aceite de oliva todavía tibio, que deja el puré más suave y ayuda al cuerpo del bebé a aprovechar las vitaminas de la comida.","Espera 2 minutos y pruébalo en el dorso de tu mano: el microondas calienta parejo por fuera pero guarda calor en el centro, así que revuelve antes de probar.","Sirve tibio, en cucharadas pequeñas, con el bebé bien sentado a la mesa."],"alerta":"El microondas calienta de forma desigual: revuelve bien todo el puré y pruébalo en el dorso de la mano antes de llevarlo a la boca del bebé."},{"id":1804,"name":"Arroz con Frijoles Aplastados del Refrigerador","icon":"🍚","time":"~5 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/19781599/pexels-photo-19781599.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 cucharadas de arroz blanco ya cocido","2 cucharadas de frijoles (porotos) ya cocidos, con un poco del caldo","1 cucharadita de aceite de oliva extra virgen"],"tip":"Frijoles → lentejas ya cocidas, en la misma cantidad.","steps":["Pon el arroz y los frijoles con el caldo en un platito hondo y llévalos al microondas 1 minuto y medio, revolviendo a la mitad del tiempo.","Aplasta los frijoles con el dorso del tenedor hasta que queden como una crema espesa, sacando y desechando cualquier cascarita suelta que flote.","Aplasta el arroz ligeramente por encima, solo lo suficiente para que los granos queden machacados y suaves, dejando trocitos que se noten para que el bebé mastique.","Mezcla todo con 1 cucharadita de aceite de oliva hasta formar una papilla espesa que se queda en la cuchara inclinada sin escurrir.","Revuelve bien, espera 2 minutos y pruébalo en el dorso de la mano antes de servir, porque los frijoles guardan calor en el fondo del plato.","Sirve tibio, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"Quita las cascaritas sueltas de los frijoles antes de servir y nunca recalientes dos veces el mismo plato de arroz con frijoles."},{"id":1805,"name":"Huevo Revuelto Bien Suave","icon":"🍳","time":"~4 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/7696938/pexels-photo-7696938.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 huevo entero","1 cucharada de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Aceite de oliva → 1 cucharadita de mantequilla sin sal, en la misma cantidad.","steps":["Rompe el huevo en un tazón, agrega 1 cucharada de agua y bate con el tenedor 30 segundos, hasta que no quede ningún hilo transparente de clara.","Calienta 1 cucharadita de aceite de oliva en un sartén antiadherente pequeño a fuego muy bajo y extiéndelo con papel de cocina, dejando solo una capa delgada.","Vierte el huevo y revuelve sin parar con la espátula unos 2 minutos, raspando el fondo, hasta que se formen grumos suaves y completamente firmes.","Revisa que no haya quedado ninguna parte brillante o líquida: para el bebé, la yema y la clara van siempre bien cocidas, sin excepción.","Apaga el fuego, aplasta los grumos con el tenedor y deja que se entibie 1 minuto, probándolo en el dorso de la mano antes de servir.","Sirve tibio, en cucharadas pequeñas, con el bebé bien sentado y un adulto al lado."],"alerta":"El huevo crudo o tierno no se puede dar a ninguna edad: cocínalo hasta que no quede ninguna parte brillante o líquida en el sartén."},{"id":1806,"name":"Omelette de Queso en Tiras","icon":"🧀","time":"~5 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/39022508/pexels-photo-39022508.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 huevo entero","1 cucharada de queso fresco rallado","1 cucharadita de aceite de oliva extra virgen"],"tip":"Queso fresco → ricota fresca aplastada, en la misma cantidad.","steps":["Bate el huevo con el tenedor 30 segundos, hasta que la yema y la clara queden completamente mezcladas, y agrega la cucharada de queso fresco rallado.","Calienta 1 cucharadita de aceite de oliva en un sartén antiadherente pequeño a fuego bajo y vierte la mezcla, girando el sartén para extenderla.","Tapa y cocina unos 2 minutos, hasta que la superficie se afirme por completo y no quede ninguna parte líquida en el centro del omelette.","Voltéalo con la espátula y déjalo 1 minuto más del otro lado, solo para que se dore un poco sin resecarse ni quedar chicloso.","Pásalo a una tabla, espera 2 minutos a que se entibie y córtalo en tiras largas de unos 6 cm por 1,5 cm, del tamaño de un dedo de adulto.","Sírvelo tibio, probándolo en el dorso de la mano, ofreciendo 2 tiras a la vez con el niño bien sentado."],"alerta":"Córtalo siempre en tiras largas, nunca en cuadritos: el trozo redondo de huevo es de las formas que más se atoran en la garganta."},{"id":1807,"name":"Crema de Ricota con Banana","icon":"🥣","time":"~4 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/11281296/pexels-photo-11281296.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["2 cucharadas de ricota fresca","1/2 banana (plátano) bien madura","1 cucharada de agua filtrada, si hace falta aflojar"],"tip":"Ricota fresca → queso cottage sin sal agregada, en la misma cantidad.","steps":["Aplasta las 2 cucharadas de ricota con el dorso del tenedor hasta que se deshagan por completo, sin que quede ningún grumo firme en la crema.","Aplasta la 1/2 banana bien madura por separado, también con el tenedor, hasta que quede un puré liso y sin trozos enteros.","Mezcla las dos partes unos 30 segundos, hasta que la crema quede pareja y de un solo color, sin franjas blancas de ricota a la vista.","Si queda demasiado seca, agrega 1 cucharada de agua filtrada y revuelve hasta que la crema se quede quieta en la cuchara inclinada sin escurrir.","Sirve en el momento, a temperatura ambiente, en cucharadas pequeñas, sin agregar azúcar — la banana madura ya endulza sola."],"alerta":"Usa ricota fresca sin sal agregada; los quesos amarillos y los rallados de paquete tienen demasiado sodio para esta etapa."},{"id":1808,"name":"Yogur Natural con Fruta Aplastada","icon":"🍓","time":"~3 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/6823334/pexels-photo-6823334.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["3 cucharadas de yogur natural entero sin azúcar","1/2 banana (plátano) madura o 4 fresas (frutillas) maduras","1 pizca de canela en polvo (opcional)"],"tip":"Banana → 1/2 taza de mango bien maduro, en la misma cantidad.","steps":["Revisa la etiqueta del yogur antes de abrirlo: los ingredientes deben ser solo leche y cultivos lácteos, sin azúcar, colorantes ni trozos de fruta industrializados.","Aplasta la fruta elegida con el dorso del tenedor hasta que quede un puré sin ningún trozo entero; si usas fresas, corta la parte blanca y dura del cabito.","Mezcla las 3 cucharadas de yogur natural con el puré, revolviendo 30 segundos hasta que el color quede parejo.","Espolvorea la pizca de canela, si quieres, y revisa que la crema se quede quieta en la cuchara inclinada sin escurrir.","Sirve en el momento, frío o a temperatura ambiente, en cucharadas pequeñas, y tira lo que sobre en el platito."],"alerta":"El yogur solo a partir de los 10 meses y con el visto bueno de tu pediatra — siempre natural, entero y sin azúcar, nunca bebible ni de colores."},{"id":1809,"name":"Pasta del Día Anterior con Aceite de Oliva y Queso","icon":"🍝","time":"~4 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/5472025/pexels-photo-5472025.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de pasta corta ya cocida, del refrigerador","1 cucharadita de aceite de oliva extra virgen","1 cucharada de queso fresco rallado"],"tip":"Queso fresco → ricota fresca desmoronada, en la misma cantidad.","steps":["Pon la pasta del refrigerador en un platito, rocíala con 1 cucharada de agua y llévala al microondas 1 minuto para que vuelva a quedar suave.","Corta cada trozo de pasta por la mitad con la tijera de cocina o con el costado del tenedor, dejando trozos de 2 cm como máximo.","Aprieta un trozo entre el pulgar y el índice: tiene que aplastarse sin resistencia. Si está firme, vuelve al microondas 20 segundos más.","Mezcla 1 cucharadita de aceite de oliva y la cucharada de queso rallado, revolviendo hasta que el queso se derrita y cubra todos los trozos.","Revuelve bien, espera 1 minuto y pruébala en el dorso de la mano antes de servir, en porciones pequeñas con el niño bien sentado."],"alerta":"Usa siempre pasta corta y cortada: una tira larga de pasta se enreda en la boca del niño y es riesgo real de atragantamiento."},{"id":1810,"name":"Pan Suave con Crema de Aguacate","icon":"🍞","time":"~4 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/7656035/pexels-photo-7656035.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 rebanada de pan de molde integral bien suave","2 cucharadas de aguacate (palta) bien maduro","2 gotas de jugo de limón colado"],"tip":"Pan de molde integral → pan casero sin sal, en la misma cantidad.","steps":["Corta con el cuchillo toda la corteza de la rebanada de pan, usando solo la miga suave — la corteza dura lastima la encía y es riesgo de atragantamiento.","Aplasta las 2 cucharadas de aguacate maduro con el dorso del tenedor hasta que quede una crema lisa, y agrega las 2 gotas de limón colado.","Unta la crema sobre la miga del pan en una capa delgada, hasta los bordes, sin dejar montoncitos gruesos que resbalen al morder.","Corta el pan en tiras largas de unos 8 cm por 2 cm, del tamaño de un dedo de adulto, nunca en cuadritos.","Aprieta una tira entre los dedos para confirmar que la miga se aplasta con facilidad y sirve 1 tira a la vez, con el bebé bien sentado."],"alerta":"La miga de pan en trozo cuadrado se pega al paladar del bebé: ofrécela siempre en tira larga, con un adulto al lado."},{"id":1811,"name":"Puré de Calabaza en el Microondas","icon":"🎃","time":"~5 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/5718103/pexels-photo-5718103.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 taza de calabaza (zapallo) kabocha en cubos pequeños","2 cucharadas de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Calabaza kabocha → camote (batata) en cubos pequeños, con 1 minuto más de microondas.","steps":["Corta la calabaza en cubos muy pequeños, del tamaño de una aceituna, para que se cocinen parejo y rápido en el microondas.","Ponla en un recipiente apto para microondas con 2 cucharadas de agua, cúbrela con un plato y llévala al microondas 4 minutos a potencia alta.","Pincha el cubo más grande con un tenedor: tiene que atravesarlo sin ninguna resistencia. Si se atora en el centro, vuelve a meterlo tapado 1 minuto más.","Escurre el exceso de agua y aplasta con el dorso del tenedor hasta que quede un puré espeso que se queda quieto en la cuchara inclinada sin escurrir.","Mezcla 1 cucharadita de aceite de oliva, revuelve todo el puré y espera 2 minutos para que el calor se reparta por igual.","Pruébalo en el dorso de la mano y sírvelo tibio, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"En el microondas el centro del puré queda mucho más caliente que la superficie: revuelve todo y pruébalo en el dorso de la mano antes de servir."},{"id":1812,"name":"Zanahoria Cocida Aplastada con Yogur","icon":"🥕","time":"~5 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/6546431/pexels-photo-6546431.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 zanahoria mediana ya cocida, del refrigerador","2 cucharadas de yogur natural entero sin azúcar","1 pizca de perejil picado muy fino"],"tip":"Yogur natural → ricota fresca aplastada, en la misma cantidad.","steps":["Saca la zanahoria ya cocida del refrigerador y llévala al microondas 40 segundos, solo para quitarle lo frío y que vuelva a quedar suave.","Aplasta la zanahoria con el dorso del tenedor hasta que quede un puré anaranjado, sin ningún trozo que resista la presión de los dedos.","Deja que se entibie 2 minutos antes de agregar el yogur, porque el yogur mezclado con comida caliente se corta y pierde lo cremoso.","Mezcla las 2 cucharadas de yogur natural y la pizca de perejil, revolviendo hasta que la crema quede de un solo color.","Sirve a temperatura ambiente, en cucharadas pequeñas, con el niño bien sentado."],"alerta":"El yogur solo a partir de los 10 meses y con el visto bueno de tu pediatra, siempre natural, entero y sin azúcar."},{"id":1813,"name":"Pollo Deshebrado del Refrigerador con Puré Rápido","icon":"🍗","time":"~5 min","kcal":"145 kcal (estimado)","img":"https://images.pexels.com/photos/10883402/pexels-photo-10883402.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de pollo ya cocido y deshebrado, del refrigerador","1 papa mediana ya cocida, del refrigerador","3 cucharadas de agua filtrada"],"tip":"Pollo → carne molida magra ya cocida, en la misma cantidad.","steps":["Junta el pollo deshebrado y la papa cocida en un platito hondo, rocía con 3 cucharadas de agua y cubre con un plato.","Lleva al microondas 1 minuto y medio, revolviendo a la mitad del tiempo, hasta que todo vuelva a quedar caliente y húmedo por completo.","Aplasta la papa con el dorso del tenedor hasta que quede un puré y deshebra el pollo todavía más, tirando con dos tenedores hasta que queden hebras bien finas y cortas.","Pasa los dedos por el pollo deshebrado buscando cualquier hebra más gruesa o dura y deshazla antes de mezclarla con el puré.","Mezcla todo hasta formar una papilla espesa y húmeda, nunca seca, y espera 2 minutos para que el calor se reparta.","Pruébala en el dorso de la mano y sírvela tibia, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"El pollo deshebrado seco se vuelve una hebra dura en la boca: siempre húmedo con el agua del recalentado y deshebrado bien fino antes de servir."},{"id":1814,"name":"Crepa Sencilla de Huevo en Tiras","icon":"🫓","time":"~5 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/37050196/pexels-photo-37050196.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 huevo entero","2 cucharadas de fécula de maíz disuelta en 1 cucharada de agua","1 cucharadita de aceite de oliva extra virgen"],"tip":"Fécula de maíz → 2 cucharadas de harina de avena, en la misma cantidad.","steps":["Bate el huevo con el tenedor 30 segundos y mezcla las 2 cucharadas de fécula de maíz disuelta hasta que no quede ningún grumo en el tazón.","Calienta 1 cucharadita de aceite de oliva en un sartén antiadherente pequeño a fuego bajo y extiéndelo con papel de cocina, dejando solo una capa delgada.","Vierte toda la masa y extiéndela con el dorso de la cuchara, formando un disco bien delgado — la crepa gruesa queda chiclosa y difícil de masticar.","Cocina unos 2 minutos, hasta que el borde se suelte solo, voltéala con la espátula y déjala 1 minuto más para que el huevo se cocine por completo.","Pásala a una tabla, espera a que se entibie y córtala en tiras de unos 6 cm por 1,5 cm, del tamaño de un dedo de adulto.","Sírvela tibia, probándola en el dorso de la mano, con el niño bien sentado y un adulto cerca."],"alerta":"La crepa gruesa queda elástica y se pega al paladar: extiéndela bien delgada y sírvela siempre cortada en tiras, nunca enrollada."},{"id":1815,"name":"Papilla Rápida de Avena","icon":"🥣","time":"~4 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/4488079/pexels-photo-4488079.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 cucharadas de avena en hojuelas finas","1/2 taza de leche materna, fórmula o leche entera según la edad","1 pizca de canela en polvo"],"tip":"Leche entera → leche materna o la fórmula que el bebé ya toma, en la misma cantidad, para bebés menores de 12 meses.","steps":["Mezcla las 2 cucharadas de avena con la 1/2 taza de leche en una ollita, todavía fuera del fuego, hasta que se disuelva por completo.","Lleva a fuego bajo revolviendo sin parar unos 3 minutos, hasta que la papilla espese y deje un camino en el fondo cuando pasas la cuchara.","Apaga, agrega la pizca de canela y revuelve: nada de azúcar, miel ni chocolate en polvo, que no entran en la alimentación antes de los 2 años.","Extiende la papilla en un platito plano para que se enfríe más rápido y revuelve dos o tres veces mientras se entibia.","Pruébala en el dorso de la mano y sírvela tibia, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"La papilla guarda mucho calor en el fondo del plato: revuelve bien y pruébala en el dorso de la mano, nunca la sirvas directo de la olla."},{"id":1816,"name":"Banana a la Plancha en el Sartén","icon":"🍌","time":"~5 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/1576120/pexels-photo-1576120.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) firme, cortada por la mitad a lo largo","1/2 cucharadita de mantequilla sin sal","1 pizca de canela en polvo"],"tip":"Mantequilla sin sal → 1/2 cucharadita de aceite de coco, en la misma cantidad.","steps":["Corta la banana por la mitad a lo largo, nunca en rodajas — la rodaja es la forma redonda que más se atora en la garganta.","Derrite la 1/2 cucharadita de mantequilla sin sal en un sartén antiadherente a fuego bajo, extendiéndola con papel de cocina.","Cocina cada mitad unos 2 minutos de cada lado, hasta que se dore un poco y ceda cuando la tocas con el tenedor.","Espolvorea la pizca de canela todavía en el sartén y apaga el fuego, sin agregar nada de azúcar.","Deja que se entibie 2 minutos y corta cada mitad en tiras de unos 7 cm, del tamaño de un dedo de adulto.","Aprieta una tira entre el pulgar y el índice para confirmar que se aplasta con facilidad y sírvela tibia, probándola en el dorso de la mano."],"alerta":"Nunca cortes la banana en rodajas: siempre a lo largo y después en tiras, con un adulto al lado durante toda la comida."},{"id":1817,"name":"Sopita Rápida con las Verduras del Refrigerador","icon":"🍲","time":"~5 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/12309415/pexels-photo-12309415.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de verduras ya cocidas del refrigerador (zanahoria, papa, calabacita)","1/4 de taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Usa las verduras que sobraron del almuerzo de la familia, siempre que se hayan cocinado sin sal.","steps":["Junta las verduras ya cocidas y el 1/4 de taza de agua en una ollita y llévalas a fuego bajo unos 3 minutos, revolviendo.","Aplasta las verduras con el dorso del tenedor dentro de la misma olla, dejando trocitos suaves que se noten, sin usar licuadora.","Revisa apretando un trocito entre el pulgar y el índice: tiene que deshacerse sin esfuerzo; si no, cocina 2 minutos más.","Mezcla 1 cucharadita de aceite de oliva y ajusta el espesor — la sopita del bebé es espesa y se da con cuchara, nunca aguada en vaso.","Sírvela en un platito hondo, espera 2 minutos y pruébala en el dorso de la mano antes de servir, en cucharadas pequeñas."],"alerta":"Solo aprovecha verduras que se cocinaron sin sal y que estuvieron en el refrigerador 2 días o menos."},{"id":1818,"name":"Arroz en Papilla con Verdura Aplastada","icon":"🍚","time":"~5 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/38551579/pexels-photo-38551579.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de arroz blanco ya cocido","2 cucharadas de zanahoria ya cocida","3 cucharadas de agua filtrada"],"tip":"Zanahoria → calabaza (zapallo) ya cocida, en la misma cantidad.","steps":["Junta el arroz, la zanahoria y las 3 cucharadas de agua en un platito hondo, cubre con un plato y lleva al microondas 1 minuto.","Aplasta la zanahoria con el dorso del tenedor hasta que quede un puré y mézclala con el arroz, apretando los granos para dejarlos bien suaves.","El agua del recalentado es lo que convierte el arroz seco del refrigerador en papilla: agrega 1 cucharada más si todavía se desmorona.","Revisa la textura inclinando la cuchara — la papilla tiene que quedarse quieta sin escurrir, con trocitos suaves a la vista.","Revuelve todo el plato, espera 2 minutos y pruébala en el dorso de la mano antes de ofrecerla en cucharadas pequeñas."]},{"id":1819,"name":"Crepita Suave de Fécula de Maíz con Queso","icon":"🫓","time":"~5 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/5860731/pexels-photo-5860731.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["3 cucharadas de fécula de maíz disuelta en 3 cucharadas de agua","2 cucharadas de queso fresco rallado","1/2 cucharadita de mantequilla sin sal"],"tip":"Queso fresco → ricota fresca aplastada, en la misma cantidad.","steps":["Revuelve bien la fécula de maíz con el agua en un tazón hasta que no quede ningún grumo seco y viértela en el sartén antiadherente frío.","Extiende la mezcla formando un disco delgado y llévala a fuego bajo unos 2 minutos, hasta que la masa se una y se suelte sola del fondo.","Reparte el queso rallado y la mantequilla sobre la mitad del disco, dobla por la mitad con la espátula y deja 1 minuto más, solo para que el queso se derrita.","Pásala a una tabla y espera 3 minutos a que se entibie: la crepita sale muy caliente y, si se reseca, se endurece y cuesta masticarla.","Córtala en tiras cortas de unos 5 cm y aprieta una entre los dedos — tiene que ceder, nunca estirarse como goma.","Sírvela tibia, probándola en el dorso de la mano, con el niño bien sentado."],"alerta":"La crepita reseca queda dura y la elástica se pega al paladar: sírvela suave, en tiras cortas, y nunca enrollada entera."},{"id":1820,"name":"Camote en el Microondas en Tiras","icon":"🍠","time":"~5 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/9219092/pexels-photo-9219092.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 camote (batata) pequeño, pelado","2 cucharadas de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Camote → papa pelada, con 1 minuto más de microondas.","steps":["Pela el camote y córtalo en tiras largas de unos 8 cm por 1,5 cm, del tamaño y el grosor de un dedo de adulto.","Pon las tiras en un recipiente apto para microondas con 2 cucharadas de agua, cubre con un plato y lleva al microondas 4 minutos a potencia alta.","Pincha la tira más gruesa con el tenedor: tiene que atravesarla sin resistencia. Si se atora, vuelve a meterla tapada 1 minuto más y prueba otra vez.","Escurre el agua, rocía con 1 cucharadita de aceite de oliva y extiende las tiras en un plato para que se enfríen más rápido.","Aprieta una tira tibia entre el pulgar y el índice — tiene que aplastarse casi como puré. La tira firme no va al plato.","Pruébala en el dorso de la mano y sirve 2 tiras a la vez, con el bebé bien sentado y un adulto al lado durante toda la comida."],"alerta":"Córtalo siempre en tira larga: de los 6 a los 9 meses el bebé agarra con la mano cerrada y solo alcanza la punta que sobresale del puño."},{"id":1821,"name":"Calabacita Salteada en 4 Minutos","icon":"🥒","time":"~4 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/13422458/pexels-photo-13422458.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 calabacita (zucchini) pequeña","1 cucharadita de aceite de oliva extra virgen","2 cucharadas de agua filtrada"],"tip":"Calabacita → ejotes (judías verdes), con 2 minutos más en el sartén.","steps":["Corta la calabacita en tiras largas de unos 7 cm por 1,5 cm, dejando la cáscara delgadita, que ayuda a que la tira no se deshaga.","Calienta 1 cucharadita de aceite de oliva en un sartén a fuego medio y pon las tiras acostadas, sin encimarlas, 1 minuto de cada lado.","Agrega las 2 cucharadas de agua, tapa y deja 2 minutos: el vapor es lo que cocina el centro, porque la calabacita a la plancha se dora por fuera y queda cruda por dentro.","Aprieta una tira tibia entre el pulgar y el índice — tiene que ceder sin esfuerzo. Si el centro resiste, tapa 1 minuto más.","Deja que se entibie, pruébala en el dorso de la mano y sirve 2 tiras a la vez, con el bebé bien sentado."],"alerta":"Nunca sirvas la calabacita en rodaja: la forma redonda es la más peligrosa para el atragantamiento. Siempre en tira larga."},{"id":1822,"name":"Huevo Cocido Aplastado con Aceite de Oliva","icon":"🥚","time":"~5 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/9344968/pexels-photo-9344968.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 huevo cocido ya listo, del refrigerador","1 cucharadita de aceite de oliva extra virgen","1 cucharada de agua filtrada tibia"],"tip":"Aceite de oliva → 1 cucharada de aguacate (palta) maduro aplastado, en la misma cantidad.","steps":["Pela el huevo cocido y córtalo por la mitad para revisar: la yema tiene que estar firme y amarilla por completo, sin ningún punto tierno o anaranjado que escurra.","Aplasta el huevo con el dorso del tenedor en un platito más o menos 1 minuto, hasta que quede como una arenita fina, sin trozos de clara enteros.","Mezcla 1 cucharadita de aceite de oliva y 1 cucharada de agua tibia, revolviendo hasta que la mezcla quede cremosa en lugar de seca y desmoronada.","Revisa la textura inclinando la cuchara: la crema tiene que quedarse quieta, porque el huevo aplastado seco atraganta con facilidad.","Sirve a temperatura ambiente, en cucharadas pequeñas, con el bebé bien sentado y un adulto al lado."],"alerta":"La yema tierna no se puede dar a ninguna edad, y el huevo aplastado seco es riesgo de atragantamiento: humedécelo siempre con aceite de oliva y un poco de agua."},{"id":1823,"name":"Pera Aplastada con Canela","icon":"🍐","time":"~4 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4488082/pexels-photo-4488082.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 pera williams bien madura","1 pizca de canela en polvo","2 cucharadas de agua filtrada"],"tip":"Pera → manzana bien madura, con 2 minutos más de microondas.","steps":["Pela la pera y quita todo el centro con las semillas usando una cucharadita, cortando la pulpa en cubos pequeños.","Si la pera está bien madura y cede al tocarla, sáltate la cocción y aplástala directamente; si todavía está firme, sigue con el paso siguiente.","Pon los cubos en un recipiente apto para microondas con 2 cucharadas de agua, cubre y lleva al microondas 2 minutos, hasta que un tenedor los atraviese sin resistencia.","Escurre y aplasta con el dorso del tenedor hasta que quede un puré espeso que se queda quieto en la cuchara inclinada sin escurrir.","Espolvorea la pizca de canela, revuelve y deja que se entibie, probándolo en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"La pera cruda y firme no se aplasta por completo y es riesgo de atragantamiento: sírvela sin cocinar solo cuando la fruta ceda al tocarla con el pulgar."},{"id":1824,"name":"Puré Rápido de Arvejas","icon":"🟢","time":"~5 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/32188886/pexels-photo-32188886.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de arvejas (chícharos) congeladas","3 cucharadas de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Arvejas congeladas → 1/2 taza de ejotes (judías verdes) picados, con 2 minutos más de cocción.","steps":["Pon la 1/2 taza de arvejas congeladas en un recipiente apto para microondas con 3 cucharadas de agua, cubre con un plato y lleva al microondas 3 minutos.","Escurre el agua y aplasta las arvejas con el dorso del tenedor más o menos 1 minuto, apretando bien hasta deshacer la cascarita de cada grano.","Pasa los dedos por el puré buscando cualquier grano que se haya escapado entero y aplástalos uno por uno antes de seguir.","Mezcla 1 cucharadita de aceite de oliva hasta que el puré quede brillante y se quede quieto en la cuchara inclinada sin escurrir.","Espera 2 minutos, pruébalo en el dorso de la mano y sírvelo tibio, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"La arveja entera es redonda y del tamaño de la vía respiratoria: aplasta grano por grano y revisa el puré con los dedos antes de servir."},{"id":1825,"name":"Tostadita Suave con Ricota y Tomate","icon":"🍅","time":"~5 min","kcal":"145 kcal (estimado)","img":"https://images.pexels.com/photos/9226737/pexels-photo-9226737.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 rebanada de pan de molde integral bien suave","2 cucharadas de ricota fresca","1/2 tomate (jitomate) maduro sin piel y sin semillas"],"tip":"Ricota fresca → queso cottage sin sal agregada, en la misma cantidad.","steps":["Corta la corteza del pan y calienta la miga 30 segundos en un sartén antiadherente seco, solo para que se afirme sin tostarse ni endurecerse.","Aplasta las 2 cucharadas de ricota con el tenedor hasta que quede una crema lisa y úntala sobre la miga en una capa delgada.","Quita la piel y todas las semillas del 1/2 tomate y pica la pulpa muy finita, en trozos más pequeños que un grano de arroz.","Reparte el tomate picado sobre la ricota, presionando suavemente para que no se suelte al morder.","Corta en tiras largas de unos 8 cm por 2 cm y sirve a temperatura ambiente, 1 tira a la vez, con el niño bien sentado."],"alerta":"Nunca tuestes el pan hasta que quede crujiente: una astilla dura lastima la encía y atraganta. Solo debe quedar firme y todavía suave."},{"id":1826,"name":"Pasta de Letras con Salsa de Tomate","icon":"🔤","time":"~5 min","kcal":"155 kcal (estimado)","img":"https://images.pexels.com/photos/26207779/pexels-photo-26207779.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de pasta de letras ya cocida, del refrigerador","3 cucharadas de salsa de tomate casera sin sal","1 cucharadita de aceite de oliva extra virgen"],"tip":"Pasta de letras → pasta de tornillitos ya cocida y cortada por la mitad, en la misma cantidad.","steps":["Junta la pasta de letras y las 3 cucharadas de salsa de tomate casera sin sal en una ollita a fuego bajo.","Revuelve unos 3 minutos, hasta que la salsa cubra todas las letras y la pasta vuelva a quedar bien suave y húmeda.","Aprieta una letra entre el pulgar y el índice: tiene que aplastarse sin resistencia; si no, agrega 1 cucharada de agua y cocina 1 minuto más.","Mezcla 1 cucharadita de aceite de oliva fuera del fuego, que deja el plato más suave y ayuda a absorber las vitaminas del tomate.","Sírvela en un platito, espera 2 minutos y pruébala en el dorso de la mano antes de servir en porciones pequeñas."],"alerta":"Usa solo salsa de tomate casera sin sal: la salsa lista del supermercado tiene demasiado sodio y azúcar para esta etapa."},{"id":1827,"name":"Crema Rápida de Maíz","icon":"🌽","time":"~5 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/12987565/pexels-photo-12987565.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de granos de maíz (elote/choclo) cocidos, del refrigerador","3 cucharadas de agua filtrada o leche según la edad","1 cucharadita de aceite de oliva extra virgen"],"tip":"Granos de maíz → arvejas (chícharos) ya cocidas, en la misma cantidad y con la misma preparación.","steps":["Pon los granos de maíz y las 3 cucharadas de líquido en un recipiente apto para microondas, cubre con un plato y lleva al microondas 1 minuto y medio.","Aplasta los granos con el dorso del tenedor o con un pisapapas unos 2 minutos, apretando con fuerza hasta deshacer la cascarita de cada grano.","Pasa la crema entre los dedos y revisa que no haya quedado ningún grano entero — la cascarita del maíz no se ablanda ni cocida.","Mezcla 1 cucharadita de aceite de oliva hasta que la crema quede espesa y quieta en la cuchara inclinada sin escurrir.","Revuelve todo el plato, espera 2 minutos y pruébala en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"El grano de maíz entero es redondo, tiene cáscara dura y es riesgo real de atragantamiento: aplasta hasta que no quede ninguno y revisa con los dedos."},{"id":1828,"name":"Ensalada Tibia de Papa con Atún","icon":"🐟","time":"~5 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/9219084/pexels-photo-9219084.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 12 meses","ingredients":["1 papa mediana ya cocida, del refrigerador","2 cucharadas de atún en agua, bien escurrido","1 cucharadita de aceite de oliva extra virgen"],"tip":"Atún en agua → 2 cucharadas de pollo cocido y deshebrado, en la misma cantidad.","steps":["Escurre muy bien el atún, apretándolo contra el costado de la lata con el tenedor, y desmenúzalo hasta que queden lascas muy pequeñas y sueltas.","Pasa los dedos por todo el atún desmenuzado buscando cualquier lasca más firme o trozo de piel, y tira lo que encuentres.","Aplasta la papa ya cocida con el tenedor hasta que quede un puré espeso y llévala al microondas 1 minuto, solo para entibiarla.","Mezcla el atún con el puré y agrega 1 cucharadita de aceite de oliva, revolviendo hasta formar una pasta húmeda que no se desmorona en la cuchara.","Espera 2 minutos, pruébala en el dorso de la mano y sírvela tibia, en porciones pequeñas, con el niño bien sentado."],"alerta":"El atún en lata solo a partir de los 12 meses y como máximo una vez por semana, por el mercurio. Usa siempre el que viene en agua, nunca en aceite."},{"id":1829,"name":"Papilla Rápida de Harina de Maíz","icon":"🌾","time":"~5 min","kcal":"145 kcal (estimado)","img":"https://images.pexels.com/photos/19745775/pexels-photo-19745775.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 cucharadas de harina de maíz fina","1/2 taza de leche materna, fórmula o leche entera según la edad","1 pizca de canela en polvo"],"tip":"Harina de maíz fina → 2 cucharadas de harina de arroz, en la misma cantidad.","steps":["Disuelve las 2 cucharadas de harina de maíz en la leche todavía fría, dentro de la ollita, revolviendo bien hasta que no quede ningún punto seco — eso es lo que evita los grumos.","Lleva a fuego bajo revolviendo sin parar unos 4 minutos, hasta que la papilla espese y deje un camino en el fondo cuando pasa la cuchara.","Agrega la pizca de canela y apaga, sin añadir azúcar, miel ni chocolate en polvo, que no entran antes de los 2 años.","Extiéndela en un platito plano y revuelve dos o tres veces mientras se enfría, para que el calor no se quede concentrado en el centro.","Pruébala en el dorso de la mano y sírvela tibia, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"La papilla de harina de maíz se endurece rápido al enfriarse: si queda demasiado firme, agrega 1 cucharada de leche tibia y revuelve antes de ofrecerla."}],"12":[{"id":1830,"name":"Zanahoria en Bastones al Horno","icon":"🥕","time":"~30 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/6546425/pexels-photo-6546425.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 zanahorias medianas peladas","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"Esta es la zanahoria en FORMA DE BASTÓN, para que el bebé la tome con la mano. Es la primera de las cuatro formas de ofrecer la misma verdura: si dice que no a esta, prueba el puré, la croquetita o la sopa de las recetas siguientes, sin esconder nunca la zanahoria de otra manera.","steps":["Calienta el horno a 200 °C y cubre una bandeja para hornear con papel para hornear, para que el bastón no se pegue ni se rompa al sacarlo.","Corta las zanahorias en bastones de unos 7 cm por 1,5 cm, usando la parte más gruesa de la raíz para que todos queden parecidos y se horneen parejo.","Mezcla los bastones con 1 cucharada de aceite de oliva y la pizca de orégano hasta que brillen, y repártelos en la bandeja sin amontonarlos.","Hornea unos 22 minutos, dándoles la vuelta a la mitad del tiempo, hasta que un tenedor atraviese el bastón sin ninguna resistencia.","Aprieta un bastón tibio entre el pulgar y el índice: tiene que aplastarse con facilidad. Si resiste, regrésalo al horno 5 minutos más.","Deja entibiar, prueba la temperatura en el dorso de la mano y ofrece 2 bastones a la vez, con el bebé bien sentado y un adulto a su lado durante toda la comida."],"alerta":"La zanahoria dura es la que más atraganta a esta edad: solo va al plato el bastón que se aplasta entre los dedos."},{"id":1831,"name":"Zanahoria en Puré Suave","icon":"🥕","time":"~25 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/34531190/pexels-photo-34531190.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 zanahorias medianas peladas en rodajas gruesas","1/2 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma zanahoria, ahora en TEXTURA LISA. Muchos bebés dicen no al bastón porque les extraña morder, y al día siguiente la aceptan con cuchara. Ofrécela sin insistir y sin mezclarla con otro alimento.","steps":["Corta las zanahorias en rodajas gruesas y cocínalas en una olla con 1/2 taza de agua, tapada, unos 18 minutos a fuego medio.","Pincha la rodaja más gruesa con un tenedor: tiene que atravesarla sin trabarse. Si encuentras resistencia, cocina 4 minutos más.","Escurre guardando el agua de cocción en una taza, porque es la que va a ajustar el espesor del puré después.","Aplasta las rodajas con el dorso del tenedor unos 2 minutos, hasta que quede un puré liso, sin usar licuadora ni colador.","Agrega 1 cucharada del agua guardada a la vez hasta que el puré se quede quieto en la cuchara inclinada sin escurrir, y mezcla el aceite de oliva.","Prueba la temperatura en el dorso de la mano y sirve tibio, en cucharadas pequeñas, con el bebé bien sentado."]},{"id":1832,"name":"Croquetitas de Zanahoria al Horno","icon":"🥕","time":"~35 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/24870667/pexels-photo-24870667.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de zanahoria cocida y aplastada","1 huevo entero","3 cucharadas de avena en hojuelas finas","1 cucharadita de aceite de oliva para engrasar"],"tip":"La misma zanahoria, ahora en FORMA DE CROQUETITA, que toma con los deditos en pinza. La zanahoria sigue a la vista en la masa naranja: la idea no es esconderla, es darle una cara nueva que el niño se anime a probar.","steps":["Cocina la zanahoria hasta que un tenedor la atraviese sin resistencia y aplástala con el tenedor hasta que no quede ningún pedazo duro en la masa.","Mezcla 1 taza de la zanahoria aplastada con el huevo y las 3 cucharadas de avena, apretando con las manos hasta que la masa se despegue del tazón.","Forma croquetitas pequeñas y bien aplanadas, en forma de disco, y nunca en bolita redonda, que es la forma más peligrosa para atragantarse.","Acomódalas en una bandeja engrasada con 1 cucharadita de aceite de oliva y hornea a 190 °C unos 18 minutos, dándoles la vuelta a la mitad del tiempo.","Aprieta una croquetita tibia entre el pulgar y el índice: tiene que ceder con facilidad y quedar húmeda por dentro, nunca con costra dura.","Deja entibiar, prueba la temperatura en el dorso de la mano y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado."],"alerta":"Aplana siempre en disco: la bolita redonda de masa es justo la forma y el tamaño que tapan la vía respiratoria del niño."},{"id":1833,"name":"Sopita de Zanahoria con Pasta","icon":"🥕","time":"~30 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/32795462/pexels-photo-32795462.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 zanahorias medianas en cubos pequeños","2 cucharadas de pasta de letritas cruda","2 tazas de agua filtrada o caldo casero sin sal","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma zanahoria, ahora CALIENTE Y EN CALDO. La temperatura y el líquido cambian por completo cómo se siente el sabor de la verdura, y es común que el niño acepte en la sopa lo que rechazó en el plato seco.","steps":["Cocina los cubos de zanahoria en las 2 tazas de agua o caldo casero sin sal, con la olla tapada, unos 15 minutos a fuego medio.","Aprieta un cubo entre los dedos: tiene que aplastarse sin esfuerzo antes de que agregues la pasta.","Agrega las 2 cucharadas de pasta de letritas y cocina 6 minutos más, hasta que esté bien suave, más cocida de lo que la comería un adulto.","Aplasta la mitad de los cubos de zanahoria con el tenedor dentro de la olla, para espesar el caldo, y deja la otra mitad entera y suave.","Mezcla 1 cucharadita de aceite de oliva fuera del fuego y extiende la sopa en un platito hondo para que se enfríe más rápido.","Revuelve, prueba la temperatura en el dorso de la mano y sirve tibia, nunca caliente, con el niño bien sentado a la mesa."],"alerta":"La sopa muy caliente puede quemar la boca de verdad: extiéndela en el plato, revuelve y prueba en el dorso de la mano antes de cada cucharada."},{"id":1834,"name":"Calabacita en Tiras a la Plancha","icon":"🥒","time":"~15 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/36040965/pexels-photo-36040965.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana","1 cucharada de aceite de oliva extra virgen","3 cucharadas de agua filtrada"],"tip":"Esta es la calabacita en TIRA, con la cáscara verde a la vista. Mostrar la verdura entera es parte del método: el niño necesita reconocer lo que está comiendo para, más adelante, aceptarlo de verdad.","steps":["Corta la calabacita en tiras largas de unos 8 cm por 1,5 cm, dejando la cáscara delgadita, que sostiene la tira y evita que se deshaga.","Calienta 1 cucharada de aceite de oliva en un sartén a fuego medio y dora las tiras acostadas, sin amontonarlas, 4 minutos de cada lado.","Agrega las 3 cucharadas de agua, tapa y cocina 3 minutos más: el vapor es lo que cocina el centro, porque a la plancha se dora por fuera y queda cruda por dentro.","Aprieta una tira tibia entre el pulgar y el índice: tiene que ceder sin esfuerzo. Si el centro está como de goma, tapa 2 minutos más.","Deja entibiar, prueba la temperatura en el dorso de la mano y ofrece 2 tiras a la vez, con el bebé bien sentado y un adulto a su lado."],"alerta":"Nunca ofrezcas calabacita en rodajas: la forma redonda es la más peligrosa de la mesa. Siempre en tira larga."},{"id":1835,"name":"Crema de Calabacita","icon":"🥒","time":"~25 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/32912064/pexels-photo-32912064.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana en cubos","1 papa pequeña pelada en cubos","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma calabacita, ahora CREMOSA Y SIN PEDAZOS. La papa entra solo para dar cuerpo, no para disimular: la crema sigue verde clarito y con sabor a calabacita, y así es como hay que presentarla.","steps":["Cocina la calabacita y la papa en cubos en 1 taza de agua, con la olla tapada, unos 15 minutos a fuego medio.","Pincha un cubo de papa con el tenedor: tiene que atravesarlo sin resistencia antes de apagar el fuego.","Escurre guardando media taza del agua de cocción y aplasta todo con el tenedor hasta que quede una crema lisa, sin licuadora ni colador.","Agrega el agua guardada de 1 cucharada a la vez hasta que la crema se quede quieta en la cuchara inclinada sin escurrir.","Mezcla 1 cucharadita de aceite de oliva, extiende en un platito y revuelve mientras se entibia, probando en el dorso de la mano antes de servir."]},{"id":1836,"name":"Panqueques de Calabacita","icon":"🥒","time":"~20 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/8714356/pexels-photo-8714356.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1/2 calabacita (zucchini) rallada gruesa y exprimida","1 huevo entero","3 cucharadas de avena en hojuelas finas","1 cucharadita de aceite de oliva para engrasar"],"tip":"La misma calabacita, ahora en FORMA DE PANQUEQUE, con los hilitos verdes a la vista en la masa. Cuéntale al niño que adentro hay calabacita: el objetivo es que la pruebe sabiendo, no engañarlo.","steps":["Ralla la 1/2 calabacita por el lado grueso, ponla en un paño limpio y exprime con fuerza para sacar el agua; si no, la masa no se arma en el sartén.","Bate el huevo con un tenedor, mezcla la calabacita exprimida y las 3 cucharadas de avena hasta tener una masa que cae despacio de la cuchara.","Deja reposar 5 minutos para que la avena se hidrate: sin esto, el panqueque se desmorona en la mano del bebé.","Calienta el sartén antiadherente engrasado con 1 cucharadita de aceite de oliva a fuego bajo y haz discos pequeños, dorando 2 minutos de cada lado.","Revisa que el centro ya no esté húmedo y corta cada panqueque en tiras de unos 7 cm por 1,5 cm, nunca en pedazo redondo.","Sirve tibio, probando en el dorso de la mano, con el bebé bien sentado y un adulto cerca."],"alerta":"Corta siempre en tiras: el disco entero o un pedazo redondo de panqueque es riesgo de atragantamiento a esta edad."},{"id":1837,"name":"Espagueti de Calabacita","icon":"🥒","time":"~20 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/11929430/pexels-photo-11929430.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 calabacita (zucchini) mediana cortada en tiras finas tipo espagueti","1/2 taza de salsa de tomate casera sin sal","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma calabacita, ahora con CARA DE PASTA. Para muchos niños que dicen no a las verduras, la forma conocida del espagueti es la que abre la puerta, y siguen viendo que es calabacita.","steps":["Corta la calabacita a lo largo en tiras muy finas, con un pelador de verduras o un cuchillo afilado sobre la tabla.","Cocina las tiras al vapor unos 8 minutos, hasta que estén transparentes y sin nada crujiente: al dente no sirve para bebé.","Aprieta una tira entre el pulgar y el índice: tiene que deshacerse sin esfuerzo; si no, regrésala al vapor 3 minutos más.","Corta las tiras en pedazos cortos de 3 cm o menos con tijeras de cocina, para que ninguna se enrolle en la boca del niño.","Mézclalas con la salsa de tomate casera sin sal ya tibia y termina con 1 cucharadita de aceite de oliva fuera del fuego.","Sirve tibio, probando en el dorso de la mano, en porciones pequeñas con el niño bien sentado."],"alerta":"La tira larga de verdura se enrolla en la garganta: córtala siempre en pedazos de 3 cm o menos antes de servir."},{"id":1838,"name":"Calabaza en Cubos al Horno","icon":"🎃","time":"~35 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/6129281/pexels-photo-6129281.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 tazas de calabaza (zapallo) kabocha pelada en cubos","1 cucharada de aceite de oliva extra virgen","1 pizca de canela en polvo"],"tip":"Esta es la calabaza en CUBO, para que el niño la tome con los deditos en pinza. La canela realza el dulce natural de la verdura sin una pizca de azúcar, y la forma pequeña le da autonomía a quien ya quiere comer solo.","steps":["Calienta el horno a 200 °C y corta la calabaza en cubos del tamaño de una aceituna, todos parecidos, para que se horneen parejo.","Mezcla los cubos con 1 cucharada de aceite de oliva y la pizca de canela hasta que brillen un poco y repártelos en una bandeja forrada.","Hornea unos 25 minutos, dándoles la vuelta a la mitad, hasta que los bordes se doren y un tenedor los atraviese sin ninguna resistencia.","Aprieta un cubo tibio entre el pulgar y el índice: tiene que volverse casi puré con la presión. Si resiste, regrésalo al horno 5 minutos.","Deja entibiar, prueba la temperatura en el dorso de la mano y pon 6 cubos a la vez en la bandeja de la silla, con el niño bien sentado y acompañado."],"alerta":"Descarta cualquier cubo que siga firme en la prueba del dedo: la calabaza mal horneada es riesgo de atragantamiento."},{"id":1839,"name":"Calabaza en Puré Suave","icon":"🎃","time":"~25 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/5605543/pexels-photo-5605543.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 tazas de calabaza (zapallo) kabocha en cubos","1/2 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen","1 pizca muy pequeña de cúrcuma"],"tip":"La misma calabaza, ahora LISA Y DE CUCHARA. Si dijo no al cubo, ofrécele el puré dos o tres días después, sin presionar y sin comentar el no anterior.","steps":["Cocina los cubos de calabaza en la 1/2 taza de agua, con la olla tapada, unos 15 minutos, hasta que un tenedor los atraviese sin trabarse.","Escurre guardando el agua de cocción en una taza, que es la que va a ajustar el espesor del puré al final.","Aplasta la calabaza todavía caliente con el dorso del tenedor, dentro de la misma olla, hasta que quede un puré espeso y parejo.","Agrega la pizca de cúrcuma y 1 cucharadita de aceite de oliva, y ajusta con el agua guardada hasta que el puré se quede quieto en la cuchara inclinada.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."]},{"id":1840,"name":"Muffin Salado de Calabaza","icon":"🎃","time":"~40 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/11176257/pexels-photo-11176257.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de calabaza (zapallo) cocida y aplastada","2 huevos enteros","1 taza de harina de avena","1 cucharadita de polvo para hornear"],"tip":"La misma calabaza, ahora en FORMA DE MUFFIN, que es la forma de los antojitos que el niño ve comer a los adultos. El muffin queda naranja justamente porque la calabaza está ahí: muéstraselo.","steps":["Calienta el horno a 180 °C y aplasta la calabaza ya cocida hasta que no quede ningún pedazo firme en la masa.","Bate los 2 huevos con el tenedor, agrega la calabaza aplastada y mezcla la harina de avena poco a poco, solo hasta que desaparezca la parte seca.","Agrega 1 cucharadita de polvo para hornear al final, da tres vueltas con la cuchara y reparte en moldecitos engrasados hasta dos tercios de su altura.","Hornea unos 25 minutos, hasta que un palillo clavado en el centro salga limpio y el muffin regrese al apretarlo suavemente.","Deja enfriar por completo sobre una rejilla, unos 30 minutos, porque el centro guarda calor mucho después de que la superficie se enfría.","Parte el muffin en cuatro pedazos antes de servir y ofrece un pedazo a la vez, con el niño bien sentado."],"alerta":"Nunca le des el muffin entero en la mano al niño: pártelo en pedazos pequeños y espera a que el centro se enfríe por completo."},{"id":1841,"name":"Sopa Cremosa de Calabaza","icon":"🎃","time":"~30 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/13788765/pexels-photo-13788765.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de calabaza (zapallo) kabocha en cubos","1 taza de agua filtrada o caldo casero sin sal","1 cucharada de cebolla picadita","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma calabaza, ahora CALIENTE Y EN CALDO. Ofrécela en el tazón mientras la familia también come sopa: comer lo mismo que los adultos es parte de lo que hace que el niño quiera probar.","steps":["Sofríe la cucharada de cebolla picadita en el aceite de oliva a fuego bajo 2 minutos, hasta que esté transparente y suelte aroma.","Agrega la calabaza en cubos y la taza de agua o caldo casero sin sal, tapa y cocina unos 15 minutos.","Aplasta la calabaza con el tenedor dentro de la misma olla, dejando algunos pedacitos suaves enteros para que el niño note la textura.","Revisa que la sopa quedó espesa, de las que dejan un camino en el fondo de la olla cuando pasa la cuchara: la sopa de bebé no es aguada.","Extiende en un platito hondo, revuelve mientras se enfría y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"Sírvela siempre tibia y nunca en biberón: la sopa es comida de cuchara, no bebida."},{"id":1842,"name":"Arbolitos de Brócoli al Vapor","icon":"🥦","time":"~20 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/4162155/pexels-photo-4162155.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de brócoli en ramitos con el tallito largo","1 cucharada de aceite de oliva extra virgen","1/2 diente de ajo machacado"],"tip":"Este es el brócoli en RAMITO, con el tallito como mango para la manita. La florecita parece un arbolito, y esa forma suele despertar curiosidad en el niño que dice no a la verdura picada.","steps":["Separa los ramitos dejando a propósito un tallito de unos 6 cm en cada uno, que es por donde el niño lo va a agarrar.","Lávalos abriendo las flores con los dedos bajo el chorro de agua, para soltar cualquier suciedad atrapada entre ellas.","Cocina al vapor, tapado, unos 12 minutos, hasta que el verde esté vivo y el tallito ceda al tenedor sin resistencia.","Aprieta la flor y el tallo por separado entre los dedos: los dos tienen que aplastarse, porque el tallo tarda más y es el que suele quedar duro.","Calienta el aceite de oliva con el ajo machacado 1 minuto a fuego bajo, viértelo sobre los ramitos y mezcla con cuidado.","Deja entibiar, prueba en el dorso de la mano y dale 1 ramito a la vez en la mano al niño, siempre acompañado."],"alerta":"El tallito tiene que aplastarse entre los dedos igual que la flor: el tallo duro es riesgo de atragantamiento."},{"id":1843,"name":"Crema Verde de Brócoli","icon":"🥦","time":"~25 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/6646157/pexels-photo-6646157.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 taza de brócoli en ramitos pequeños","1 papa pequeña pelada en cubos","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"El mismo brócoli, ahora en CREMA VERDE de cuchara. El color fuerte a veces asusta la primera vez: preséntala sin presión, y repite otro día si dice que no.","steps":["Cocina el brócoli y la papa en 1 taza de agua, con la olla tapada, unos 15 minutos, hasta que el tenedor atraviese la papa sin trabarse.","Escurre guardando media taza del agua de cocción, que es la que va a dejar la crema en el espesor justo.","Aplasta todo con el dorso del tenedor hasta que quede una crema verde pareja, sin licuadora y sin colador en esta etapa.","Agrega el agua guardada de 1 cucharada a la vez, hasta que la crema se quede quieta en la cuchara inclinada sin escurrir.","Mezcla 1 cucharadita de aceite de oliva, extiende en un platito y revuelve mientras se entibia, probando en el dorso de la mano antes de servir."]},{"id":1844,"name":"Croquetitas de Brócoli al Horno","icon":"🥦","time":"~35 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/34557890/pexels-photo-34557890.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de brócoli cocido y picado muy finito","1 huevo entero","3 cucharadas de harina de avena","1 cucharadita de aceite de oliva para engrasar"],"tip":"El mismo brócoli, ahora en CROQUETITA con puntitos verdes a la vista. No lo piques tan fino que desaparezca: el niño necesita ver el brócoli ahí y aun así elegir comerlo.","steps":["Cocina el brócoli hasta que esté muy suave, escúrrelo muy bien y pícalo finito, sin convertirlo en pasta.","Mezcla el brócoli picado con el huevo y las 3 cucharadas de harina de avena, apretando con las manos hasta que la masa se despegue del tazón.","Forma croquetitas pequeñas y bien aplanadas, en forma de disco, y nunca en bolita redonda.","Acomódalas en una bandeja engrasada y hornea a 190 °C unos 18 minutos, dándoles la vuelta a la mitad del tiempo, hasta que estén firmes y apenas doradas.","Aprieta una croquetita tibia entre los dedos: tiene que ceder y seguir húmeda por dentro, sin costra dura en los bordes.","Deja entibiar y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado y acompañado."],"alerta":"Aplana siempre en disco y sirve en pedazos pequeños: la bolita redonda de masa tapa la vía respiratoria del niño."},{"id":1845,"name":"Arroz Verde con Brócoli","icon":"🥦","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/17746601/pexels-photo-17746601.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arroz blanco ya cocido","1 taza de brócoli cocido y picado","1 cucharada de aceite de oliva extra virgen","1 cucharada de cebolla picadita"],"tip":"El mismo brócoli, ahora MEZCLADO CON UN ALIMENTO QUE YA ACEPTA. Este es el último escalón: el arroz es terreno conocido y se lleva el brócoli consigo, sin que deje de verse en el plato.","steps":["Sofríe la cucharada de cebolla picadita en el aceite de oliva a fuego bajo 2 minutos, hasta que esté transparente.","Agrega el brócoli ya cocido y picado y sofríe 2 minutos más, revolviendo, solo para que tome el sabor de la cebolla.","Mezcla el arroz ya cocido y revuelve 3 minutos a fuego bajo, hasta que todo esté bien caliente y cubierto de aceite.","Aprieta un pedacito de brócoli entre los dedos para confirmar que sigue suave después del sofrito.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en porciones pequeñas."]},{"id":1846,"name":"Camote en Bastones al Horno","icon":"🍠","time":"~35 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/30705576/pexels-photo-30705576.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 camote (batata) mediano pelado","1 cucharada de aceite de oliva extra virgen","1 pizca de pimentón dulce (paprika)"],"tip":"Este es el camote en BASTÓN, la forma que el niño ya relaciona con comida rica. Se hornea sin una gota de fritura y sigue siendo la misma verdura de las otras tres recetas de esta serie.","steps":["Calienta el horno a 200 °C y cubre una bandeja con papel para hornear para que los bastones no se peguen ni se rompan.","Corta el camote en bastones de unos 8 cm por 1,5 cm, del tamaño y el grosor de un dedo de adulto.","Mezcla con 1 cucharada de aceite de oliva y la pizca de pimentón dulce y repártelos en la bandeja sin amontonarlos, para que se horneen parejo.","Hornea unos 25 minutos, dándoles la vuelta a la mitad, hasta que un tenedor atraviese el bastón sin ninguna resistencia.","Aprieta un bastón tibio entre el pulgar y el índice: tiene que aplastarse casi como puré. Si resiste, regrésalo al horno 5 minutos.","Deja entibiar, prueba en el dorso de la mano y ofrece 2 bastones a la vez, con el bebé bien sentado y un adulto a su lado."],"alerta":"De los 6 a los 9 meses el bebé agarra con la mano cerrada: el bastón largo es la única forma que puede llevarse solo a la boca con seguridad."},{"id":1847,"name":"Puré Cremoso de Camote","icon":"🍠","time":"~30 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/11316282/pexels-photo-11316282.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 camote (batata) mediano pelado en cubos","1/2 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen","1 pizca de canela en polvo"],"tip":"El mismo camote, ahora en TEXTURA CREMOSA. El niño que extraña morder el bastón suele aceptar bien el puré, y al revés: por eso existen las cuatro formas.","steps":["Cocina los cubos de camote en la 1/2 taza de agua, con la olla tapada, unos 18 minutos a fuego medio.","Pincha el cubo más grande con un tenedor: tiene que atravesarlo sin trabarse. Si encuentras resistencia, cocina 4 minutos más.","Escurre guardando el agua de cocción y aplasta los cubos todavía calientes con el dorso del tenedor hasta que quede un puré liso.","Agrega la pizca de canela y 1 cucharadita de aceite de oliva y ajusta con el agua guardada hasta que el puré se quede quieto en la cuchara inclinada.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."]},{"id":1848,"name":"Croquetitas de Camote al Horno","icon":"🍠","time":"~40 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/8601177/pexels-photo-8601177.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de camote (batata) cocido y aplastado","2 cucharadas de avena en hojuelas finas","1 huevo entero","1 cucharadita de aceite de oliva para engrasar"],"tip":"El mismo camote, ahora en CROQUETITA que sostiene solito. Dale forma de bastón aplanado y no de bolita: la forma alargada es más segura y además ayuda al bebé que come con la mano cerrada.","steps":["Cocina el camote hasta que un tenedor lo atraviese sin resistencia y aplástalo bien, sin dejar ningún pedazo firme en la masa.","Mezcla 1 taza del camote aplastado con el huevo y las 2 cucharadas de avena hasta formar una masa que se cierra en la palma sin desmoronarse.","Forma bastones aplanados de unos 7 cm, de 1 dedo de alto, y acomódalos en una bandeja engrasada con 1 cucharadita de aceite de oliva.","Hornea a 190 °C unos 18 minutos, dándoles la vuelta a la mitad del tiempo, hasta que se doren un poco por fuera y sigan suaves por dentro.","Aprieta un bastón tibio entre los dedos: tiene que aplastarse con facilidad; si no, deshazlo y regrésalo al horno con un poco más de camote.","Deja entibiar, prueba en el dorso de la mano y sirve 1 bastón a la vez, con el bebé bien sentado y acompañado."],"alerta":"Dales siempre forma de bastón aplanado, nunca de bolita redonda, que es la forma que más atraganta a esta edad."},{"id":1849,"name":"Rodajas Suaves de Camote al Horno","icon":"🍠","time":"~45 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/4617524/pexels-photo-4617524.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) mediano pelado en rodajas de 1 cm","1 cucharada de aceite de oliva extra virgen","1 pizca de canela en polvo"],"tip":"El mismo camote, ahora en RODAJA REDONDA Y DELGADA, que parece una galleta. Tiene que salir del horno suave y flexible, nunca crujiente: la gracia está en la forma nueva, no en que cruja.","steps":["Calienta el horno a 180 °C y corta el camote en rodajas de unos 1 cm, todas del mismo grosor para que se horneen parejo.","Mezcla con 1 cucharada de aceite de oliva y la pizca de canela y repártelas en una bandeja forrada, sin encimar las rodajas.","Hornea unos 30 minutos, dándoles la vuelta a la mitad del tiempo, hasta que estén doradas en los bordes y suaves en el centro.","Aprieta una rodaja tibia entre el pulgar y el índice: tiene que doblarse y aplastarse. Si está quebradiza, se pasó y no debe servirse.","Corta cada rodaja a la mitad antes de ofrecerla, para que ningún pedazo tenga la forma redonda entera.","Deja entibiar, prueba en el dorso de la mano y sirve con el niño bien sentado y acompañado."],"alerta":"La rodaja crujiente se rompe en astillas duras y se vuelve riesgo de atragantamiento: tiene que salir del horno suave y doblable, y cortarse a la mitad antes de servir."},{"id":1850,"name":"Puré Rosa de Remolacha","icon":"🩷","time":"~35 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4768992/pexels-photo-4768992.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 remolacha (betabel) pequeña pelada en cubos","1 papa pequeña pelada en cubos","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Esta es la remolacha por el COLOR. La papa aclara el puré y lo deja rosa en lugar de morado oscuro, lo que suele asustar menos la primera vez, y la remolacha sigue siendo el sabor principal del plato.","steps":["Cocina la remolacha y la papa en cubos en 1 taza de agua, con la olla tapada, unos 25 minutos a fuego medio.","Pincha el cubo de remolacha con el tenedor: es la más dura de las dos y tiene que atravesarse sin trabarse antes de apagar el fuego.","Escurre guardando media taza del agua de cocción, que es la que va a dejar el puré en el espesor justo.","Aplasta todo con el dorso del tenedor hasta que quede un puré rosa parejo, sin licuadora y sin colador en esta etapa.","Ajusta con el agua guardada hasta que el puré se quede quieto en la cuchara inclinada sin escurrir y mezcla 1 cucharadita de aceite de oliva.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"La remolacha puede dejar la pipí y la popó rojizas por uno o dos días: es normal y no es sangre."},{"id":1851,"name":"Cubitos de Remolacha al Horno","icon":"🩷","time":"~50 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/6607312/pexels-photo-6607312.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 remolachas (betabel) medianas peladas en cubos pequeños","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"La misma remolacha, ahora en CUBO Y CON EL DULCE CONCENTRADO por el horno. Horneada pierde ese sabor a tierra que muchos niños rechazan en el puré, y se vuelve casi un dulcecito de verdura.","steps":["Calienta el horno a 200 °C y corta las remolachas en cubos del tamaño de una aceituna, todos parecidos, para que se horneen parejo.","Mezcla los cubos con 1 cucharada de aceite de oliva y la pizca de orégano y repártelos en una bandeja forrada con papel para hornear.","Cubre la bandeja con papel aluminio y hornea 30 minutos: el vapor atrapado es lo que ablanda la remolacha, que es la raíz más dura de la lista.","Quita el aluminio y hornea 10 minutos más, solo para que los bordes se doren y aparezca el dulce natural.","Aprieta un cubo tibio entre el pulgar y el índice: tiene que aplastarse sin esfuerzo; si no, vuelve a cubrir y hornea 10 minutos más.","Deja entibiar, prueba en el dorso de la mano y pon 6 cubos a la vez en la bandeja de la silla, con el niño bien sentado."],"alerta":"La remolacha es la raíz que más tarda en ablandarse: ningún cubo firme puede ir al plato, aunque ya esté dorado por fuera."},{"id":1852,"name":"Pastita Rosa de Remolacha","icon":"🩷","time":"~40 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/6608543/pexels-photo-6608543.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1/2 taza de remolacha (betabel) cocida y aplastada","1 taza de harina de trigo","1 huevo entero","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma remolacha, ahora CONVERTIDA EN PASTA DE COLOR. El niño ve la pasta rosa antes de saber por qué, y es muy lindo contarle que el color viene de la remolacha después de que ya la probó y le gustó.","steps":["Aplasta la remolacha ya cocida con el tenedor hasta que quede un puré liso, sin ningún pedazo firme que estorbe en la masa.","Mezcla el puré con el huevo y ve agregando la harina poco a poco, amasando hasta formar una masa rosa lisa que se despega de las manos.","Extiende la masa bien delgada sobre la mesa enharinada, enróllala como un tubo y corta tiritas de medio dedo de ancho.","Corta las tiritas en pedazos cortos de 3 cm o menos con tijeras, para que ninguna se enrolle en la boca del niño.","Cocina en agua hirviendo sin sal unos 4 minutos, hasta que la pastita esté bien suave y se parta al apretarla con el tenedor.","Escurre, rocía con 1 cucharadita de aceite de oliva, deja entibiar y sirve probando en el dorso de la mano."],"alerta":"La pasta larga se enrolla en la boca: córtala siempre en pedazos de 3 cm o menos antes de cocinar. Agua de cocción sin sal."},{"id":1853,"name":"Croquetitas de Remolacha al Horno","icon":"🩷","time":"~40 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/11161423/pexels-photo-11161423.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de remolacha (betabel) cocida y rallada","1 huevo entero","4 cucharadas de harina de avena","1 cucharadita de aceite de oliva para engrasar"],"tip":"La misma remolacha, ahora en CROQUETITA QUE EL NIÑO SOSTIENE. Rallada en lugar de aplastada, la remolacha cambia de textura en la boca y el sabor a tierra se siente mucho más suave.","steps":["Ralla la remolacha ya cocida por el lado grueso y exprímela en un paño limpio para sacar el exceso de agua; si no, la masa no se arma.","Mezcla la remolacha rallada con el huevo y las 4 cucharadas de harina de avena, apretando con las manos hasta que la masa se despegue del tazón.","Forma croquetitas pequeñas y bien aplanadas, en forma de disco, y nunca en bolita redonda.","Acomódalas en una bandeja engrasada y hornea a 190 °C unos 20 minutos, dándoles la vuelta a la mitad, hasta que estén firmes por dentro.","Aprieta una croquetita tibia entre los dedos: tiene que ceder con facilidad y seguir húmeda, sin costra dura en los bordes.","Deja entibiar y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado y acompañado."],"alerta":"Aplana siempre en disco y sirve en pedazos pequeños, nunca la croquetita entera en la mano del niño."},{"id":1854,"name":"Arbolitos de Coliflor al Horno","icon":"🤍","time":"~35 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/4960143/pexels-photo-4960143.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de coliflor en ramitos con el tallito","1 cucharada de aceite de oliva extra virgen","1 pizca de cúrcuma"],"tip":"Esta es la coliflor en RAMITO CON MANGO, que el niño sostiene como un heladito. La cúrcuma deja la flor un poco dorada y le cambia la cara a la verdura sin cambiar lo que es.","steps":["Calienta el horno a 200 °C y separa la coliflor en ramitos dejando un tallito de unos 6 cm en cada uno, que sirve de mango.","Mezcla los ramitos con 1 cucharada de aceite de oliva y la pizca de cúrcuma hasta que queden amarillitos parejo.","Repártelos en una bandeja forrada, cubre con papel aluminio y hornea 20 minutos: el vapor atrapado es lo que ablanda el tallo.","Quita el aluminio y hornea 8 minutos más, solo hasta que se doren un poco en las orillas, sin dejar que se tuesten y endurezcan.","Aprieta la flor y el tallo por separado entre los dedos: los dos tienen que aplastarse sin esfuerzo antes de ir al plato.","Deja entibiar, prueba en el dorso de la mano y dale 1 ramito a la vez en la mano al niño, siempre acompañado."],"alerta":"La coliflor demasiado tostada queda dura y no se aplasta entre los dedos: si se pasó, descártala en lugar de servirla."},{"id":1855,"name":"Crema Blanca de Coliflor","icon":"🤍","time":"~25 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/6896516/pexels-photo-6896516.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 tazas de coliflor en ramitos pequeños","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen","1 pizca de nuez moscada recién rallada"],"tip":"La misma coliflor, ahora en CREMA BLANCA Y SUAVE. Para el niño que dice no a la verdura por el color, la crema clarita es la más fácil de aceptar, y sigue siendo coliflor pura, sin esconder nada.","steps":["Cocina los ramitos en 1 taza de agua, con la olla tapada, unos 15 minutos, hasta que un tenedor los atraviese sin ninguna resistencia.","Escurre guardando media taza del agua de cocción, que es la que va a ajustar el espesor de la crema al final.","Aplasta los ramitos con el dorso del tenedor hasta que quede una crema blanca pareja, sin licuadora y sin colador.","Agrega la pizca de nuez moscada y 1 cucharadita de aceite de oliva y ajusta con el agua guardada hasta que la crema se quede quieta en la cuchara inclinada.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."]},{"id":1856,"name":"Arroz Blanquito de Coliflor","icon":"🤍","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/35041653/pexels-photo-35041653.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 tazas de coliflor cruda rallada por el lado grueso","1 cucharada de aceite de oliva extra virgen","1 cucharada de cebolla picadita","3 cucharadas de agua filtrada"],"tip":"La misma coliflor, ahora CON CARA DE ARROZ. Esta es la forma que suele destrabar al niño que come arroz y dice no a la verdura, y vale la pena contarle que es coliflor después de que ya la probó.","steps":["Ralla la coliflor cruda por el lado grueso hasta formar granitos sueltos parecidos al arroz, descartando los tallos más gruesos.","Sofríe la cucharada de cebolla picadita en el aceite de oliva a fuego bajo 2 minutos, hasta que esté transparente y suelte aroma.","Agrega la coliflor rallada y las 3 cucharadas de agua, tapa y cocina unos 8 minutos, revolviendo de vez en cuando.","Prueba un granito entre los dedos: tiene que aplastarse sin resistencia, porque la coliflor cruda o al dente no sirve para un niño pequeño.","Destapa y deja 2 minutos más para que se seque el exceso de agua, sin dejar que se reseque y endurezca.","Extiende en un platito, deja entibiar y sirve probando en el dorso de la mano, en porciones pequeñas."],"alerta":"La coliflor cruda es dura y no se aplasta entre los dedos: sírvela solo cuando esté bien cocida, aunque esté rallada muy fina."},{"id":1857,"name":"Croquetitas Doradas de Coliflor","icon":"🤍","time":"~35 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/13741662/pexels-photo-13741662.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de coliflor cocida y aplastada","1 huevo entero","3 cucharadas de harina de avena","1 cucharadita de aceite de oliva para engrasar"],"tip":"La misma coliflor, ahora en CROQUETITA DORADA. El dorado del horno cambia por completo el aspecto de la verdura blanca y cocida, que es justo la forma a la que más dicen no los niños que rechazan la comida.","steps":["Cocina la coliflor hasta que esté muy suave, escúrrela muy bien y aplástala con el tenedor, sin dejar exceso de agua en la masa.","Mezcla con el huevo y las 3 cucharadas de harina de avena, apretando con las manos hasta que la masa se cierre en la palma sin pegarse.","Forma croquetitas pequeñas y bien aplanadas, en forma de disco, nunca en bolita redonda.","Acomódalas en una bandeja engrasada y hornea a 190 °C unos 18 minutos, dándoles la vuelta a la mitad, hasta que se doren por fuera.","Aprieta una croquetita tibia entre los dedos para confirmar que cede con facilidad y sigue suave por dentro.","Deja entibiar, prueba en el dorso de la mano y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado."],"alerta":"Sirve siempre en pedazos pequeños y aplanados: la croquetita entera y redonda es riesgo de atragantamiento."},{"id":1858,"name":"Panqueques Verdes de Espinaca","icon":"🥬","time":"~20 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/13887556/pexels-photo-13887556.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de hojas de espinaca bien lavadas","1 huevo entero","3 cucharadas de avena en hojuelas finas","1 cucharadita de aceite de oliva para engrasar"],"tip":"Esta es la espinaca POR EL VERDE VIVO del panqueque. No es para esconder la hoja: es para que aparezca en una forma divertida, que el niño toma con la mano en lugar de comer con tenedor.","steps":["Lava las hojas de espinaca una por una, cocínalas al vapor 3 minutos hasta que se marchiten y exprímelas bien contra el colador para sacar el agua.","Pica la espinaca muy finita y mézclala con el huevo batido y las 3 cucharadas de avena hasta formar una masa verde pareja.","Deja reposar 5 minutos para que la avena se hidrate: sin esto, el panqueque se desmorona en la mano del bebé.","Calienta el sartén antiadherente engrasado con 1 cucharadita de aceite de oliva a fuego bajo y haz discos pequeños, dorando 2 minutos de cada lado.","Revisa que el centro ya no esté húmedo y corta cada panqueque en tiras de unos 7 cm por 1,5 cm.","Sirve tibio, probando en el dorso de la mano, con el bebé bien sentado y un adulto cerca."],"alerta":"Corta siempre en tira larga: el disco entero de panqueque en la mano del bebé es un bocado demasiado grande para su boca."},{"id":1859,"name":"Crema de Espinaca","icon":"🥬","time":"~25 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/8954279/pexels-photo-8954279.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de hojas de espinaca bien lavadas","1 papa pequeña pelada en cubos","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma espinaca, ahora en CREMA DE CUCHARA. La papa da cuerpo y suaviza el sabor fuerte de la hoja, sin quitarle el verde al plato: el niño sigue viendo que está comiendo espinaca.","steps":["Cocina la papa en cubos en 1 taza de agua, con la olla tapada, unos 12 minutos, hasta que un tenedor la atraviese sin trabarse.","Agrega las hojas de espinaca en los últimos 3 minutos, solo hasta que se marchiten por completo y bajen de volumen en la olla.","Escurre guardando media taza del agua de cocción y aplasta todo con el dorso del tenedor hasta que quede una crema verde pareja.","Ajusta con el agua guardada hasta que la crema se quede quieta en la cuchara inclinada sin escurrir, y mezcla 1 cucharadita de aceite de oliva.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"Pica bien la espinaca antes de aplastar: la hoja entera y resbalosa se puede pegar en el paladar del bebé."},{"id":1860,"name":"Omelette de Espinaca","icon":"🥬","time":"~15 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/11654228/pexels-photo-11654228.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de espinaca salteada y bien picada","2 huevos enteros","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma espinaca, ahora DENTRO DEL HUEVO, que casi todos los niños ya aceptan. Las hojitas siguen a la vista en las tiras: el huevo es el compañero conocido, no el escondite.","steps":["Saltea la espinaca ya lavada en un sartén sin aceite 2 minutos, hasta que se marchite, exprime el exceso de agua y pícala muy finita.","Bate los 2 huevos con el tenedor hasta que la yema y la clara estén completamente mezcladas y agrega la espinaca picada.","Calienta 1 cucharadita de aceite de oliva en un sartén antiadherente a fuego bajo, vierte la mezcla y tapa.","Cocina unos 4 minutos, hasta que la superficie esté firme por completo, dale la vuelta con la espátula y deja 1 minuto más del otro lado.","Pásalo a una tabla, espera que se entibie y córtalo en tiras largas de unos 7 cm por 1,5 cm, nunca en cuadritos.","Sirve tibio, probando en el dorso de la mano, ofreciendo 2 tiras a la vez con el bebé bien sentado."],"alerta":"El huevo siempre bien cocido, sin partes blandas. Y córtalo en tiras: el pedazo redondo de omelette es de las formas más peligrosas."},{"id":1861,"name":"Pastita Verde de Espinaca","icon":"🥬","time":"~45 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/18890240/pexels-photo-18890240.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de hojas de espinaca cocidas y exprimidas","1 y 1/2 tazas de harina de trigo","1 huevo entero","1 cucharadita de aceite de oliva extra virgen"],"tip":"La misma espinaca, ahora CONVERTIDA EN PASTA VERDE. Es el escalón más avanzado de la serie: la hoja ya no se ve, pero sigue en el plato, y el niño que ya aceptó las tres formas anteriores suele comer esta sin dudar.","steps":["Cocina las hojas de espinaca al vapor 3 minutos, exprímelas muy bien contra el colador y pícalas muy finito con el cuchillo.","Mezcla la espinaca picada con el huevo y ve agregando la harina poco a poco, amasando unos 8 minutos hasta que la masa quede lisa y verde clarito.","Envuélvela en plástico para cocina y déjala reposar 30 minutos a temperatura ambiente, para que sea más fácil de extender.","Extiéndela bien delgada con el rodillo sobre la mesa enharinada, enróllala como un tubo y corta tiritas de medio dedo de ancho.","Corta las tiritas en pedazos cortos de 3 cm o menos con tijeras y cocina en agua hirviendo sin sal unos 4 minutos.","Escurre, rocía con 1 cucharadita de aceite de oliva, deja entibiar y sirve probando en el dorso de la mano."],"alerta":"Corta la pastita en pedazos de 3 cm o menos: el hilo largo se enrolla en la boca del niño. Agua de cocción siempre sin sal."},{"id":1862,"name":"Puré Verdecito de Arvejas","icon":"🟢","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/38103239/pexels-photo-38103239.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 taza de arvejas (chícharos) frescas o congeladas","1/2 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Estas son las arvejas APLASTADAS, que es como hay que ofrecerlas las primeras veces. El grano entero entra mucho después, y aun así machacado: el puré es el comienzo seguro de esta serie.","steps":["Cocina la taza de arvejas en la 1/2 taza de agua, con la olla tapada, unos 10 minutos, hasta que los granos estén bien suaves.","Escurre guardando un poco del agua de cocción y aplasta las arvejas con el dorso del tenedor unos 2 minutos, apretando con fuerza.","Pasa los dedos por el puré buscando cualquier grano que se haya escapado entero y aplástalos uno por uno antes de seguir.","Ajusta con el agua guardada hasta que el puré se quede quieto en la cuchara inclinada sin escurrir y mezcla 1 cucharadita de aceite de oliva.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"La arveja entera es redonda y del tamaño de la vía respiratoria del bebé: aplasta grano por grano y revisa el puré con los dedos antes de servir."},{"id":1863,"name":"Croquetitas de Arvejas al Horno","icon":"🟢","time":"~35 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/18976846/pexels-photo-18976846.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arvejas (chícharos) cocidas y aplastadas","1 huevo entero","3 cucharadas de harina de avena","1 cucharadita de aceite de oliva para engrasar"],"tip":"Las mismas arvejas, ahora en CROQUETITA VERDE que el niño toma con los deditos en pinza. Aplastada dentro de la masa, la arveja deja de ser esa bolita que rueda por el plato y tiene una textura que el niño puede morder.","steps":["Cocina las arvejas hasta que estén bien suaves y aplástalas con el tenedor hasta que no quede ningún grano entero en la masa.","Mezcla con el huevo y las 3 cucharadas de harina de avena, apretando con las manos hasta que la masa se despegue del tazón.","Forma croquetitas pequeñas y bien aplanadas, en forma de disco, y nunca en bolita redonda.","Acomódalas en una bandeja engrasada y hornea a 190 °C unos 18 minutos, dándoles la vuelta a la mitad del tiempo.","Aprieta una croquetita tibia entre los dedos: tiene que ceder con facilidad y seguir húmeda por dentro.","Deja entibiar, prueba en el dorso de la mano y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado."],"alerta":"Revisa que no haya quedado ninguna arveja entera en la masa antes de formar, y aplana siempre las croquetitas en disco."},{"id":1864,"name":"Crema de Arvejas con Papa","icon":"🟢","time":"~25 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/3559899/pexels-photo-3559899.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de arvejas (chícharos) frescas o congeladas","1 papa pequeña pelada en cubos","1 taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Las mismas arvejas, ahora en una CREMA MÁS SUAVE. La papa le quita un poco del sabor marcado a la arveja y es el puente para el niño que dijo no al puré solo de la primera receta.","steps":["Cocina la papa en cubos en 1 taza de agua, con la olla tapada, 10 minutos, y agrega las arvejas en los últimos 8 minutos.","Pincha un cubo de papa con el tenedor: tiene que atravesarlo sin trabarse antes de apagar el fuego.","Escurre guardando media taza del agua de cocción y aplasta todo con el tenedor, apretando bien para deshacer la cascarita de cada arveja.","Pasa los dedos por la crema revisando que no quedó ningún grano entero, y ajusta el espesor con el agua guardada.","Mezcla 1 cucharadita de aceite de oliva, extiende en un platito y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"Aplasta cada arveja y revisa la crema con los dedos: el grano entero es riesgo de atragantamiento aunque esté dentro del caldo."},{"id":1865,"name":"Arroz de Colores con Arvejas","icon":"🟢","time":"~25 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/7660458/pexels-photo-7660458.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arroz blanco ya cocido","1/2 taza de arvejas (chícharos) cocidas","1 cucharada de aceite de oliva extra virgen","1 cucharada de cebolla picadita"],"tip":"Las mismas arvejas, ahora REPARTIDAS EN EL ARROZ que el niño ya come. Es el paso final: la arveja aparece en puntitos verdes en un plato conocido, sin volverse la protagonista de la comida.","steps":["Sofríe la cucharada de cebolla picadita en el aceite de oliva a fuego bajo 2 minutos, hasta que esté transparente.","Agrega las arvejas ya cocidas y aplasta un poco cada grano con el dorso de la cuchara, directo en el sartén, para quitarle la forma redonda.","Mezcla el arroz ya cocido y revuelve 3 minutos a fuego bajo, hasta que todo esté bien caliente y cubierto de aceite.","Revisa con los dedos que ninguna arveja quedó entera y redonda antes de retirar del fuego.","Extiende en un platito, deja entibiar y prueba en el dorso de la mano antes de servir en porciones pequeñas."],"alerta":"Aun a los 12 meses, aplasta un poco cada arveja antes de servir: entera y cocida sigue siendo riesgo de atragantamiento."},{"id":1866,"name":"Caldito de Frijoles","icon":"🫘","time":"~20 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/1703272/pexels-photo-1703272.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de frijoles (porotos) pintos bien cocidos, con caldo","1/4 de taza de agua filtrada","1 cucharadita de aceite de oliva extra virgen"],"tip":"Estos son los frijoles en CALDO ESPESO, sin ningún grano entero. Es la forma más fácil de presentarle los frijoles al niño que dice no, y la base de las otras tres recetas de esta serie.","steps":["Pon los frijoles con el caldo y el 1/4 de taza de agua en una ollita y calienta a fuego bajo unos 5 minutos.","Aplasta los granos con el dorso del tenedor dentro de la olla unos 2 minutos, hasta formar una crema espesa y pareja.","Quita y descarta todas las cascaritas sueltas que floten, porque no se ablandan y le molestan al bebé.","Revisa que no quedó ningún grano entero y que el caldito se queda quieto en la cuchara inclinada sin escurrir.","Mezcla 1 cucharadita de aceite de oliva, extiende en un platito y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"El grano entero de frijol y la cascarita suelta son riesgo de atragantamiento: aplasta todo y quita las cáscaras antes de servir."},{"id":1867,"name":"Croquetitas de Frijoles al Horno","icon":"🫘","time":"~40 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/17132215/pexels-photo-17132215.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de frijoles (porotos) cocidos y escurridos","1 huevo entero","4 cucharadas de harina de avena","1 cucharadita de aceite de oliva para engrasar"],"tip":"Los mismos frijoles, ahora en CROQUETITA SECA que el niño toma con la mano. El que dice no al caldo por la textura mojada suele aceptar bien los frijoles en forma de croquetita.","steps":["Escurre muy bien los frijoles cocidos y aplástalos con el tenedor hasta formar una pasta espesa, sin exceso de caldo en el tazón.","Quita las cascaritas sueltas que aparezcan mientras aplastas y descártalas todas antes de seguir.","Mezcla con el huevo y las 4 cucharadas de harina de avena, apretando hasta que la masa se cierre en la palma sin pegarse en los dedos.","Forma croquetitas pequeñas y bien aplanadas, en disco, y hornea a 190 °C unos 20 minutos, dándoles la vuelta a la mitad.","Aprieta una croquetita tibia entre los dedos para confirmar que cede con facilidad, sin costra dura por fuera.","Deja entibiar y sirve en pedazos del tamaño de una aceituna, con el niño bien sentado y acompañado."],"alerta":"Quita todas las cascaritas de los frijoles y aplana las croquetitas en disco: la cáscara suelta y la bolita redonda son riesgo de atragantamiento."},{"id":1868,"name":"Frijoles Aplastados con Arroz","icon":"🫘","time":"~15 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/32845315/pexels-photo-32845315.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de frijoles (porotos) cocidos con un poco de caldo","3 cucharadas de arroz blanco ya cocido","1 cucharadita de aceite de oliva extra virgen"],"tip":"Los mismos frijoles, ahora JUNTO AL ARROZ. Es la pareja que come toda la familia, y sentarse a la mesa comiendo lo mismo que los adultos es de lo que más ayuda al niño que dice no a animarse a probar.","steps":["Calienta los frijoles con el caldo en una ollita a fuego bajo 3 minutos y aplasta los granos con el tenedor hasta que quede una crema.","Quita y descarta las cascaritas sueltas que floten antes de agregar el arroz.","Mezcla el arroz ya cocido y aplasta un poco los granos, dejando pedacitos suaves que se noten para que el niño mastique.","Agrega 1 cucharadita de aceite de oliva y revuelve hasta que la papilla quede espesa y quieta en la cuchara inclinada sin escurrir.","Extiende en un platito, revuelve mientras se entibia y prueba en el dorso de la mano antes de servir en cucharadas pequeñas."],"alerta":"Aplasta todos los granos y quita las cascaritas: los frijoles enteros no se deben ofrecer en esta etapa."},{"id":1869,"name":"Puré de Frijoles con Calabaza","icon":"🫘","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/5605563/pexels-photo-5605563.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de frijoles (porotos) cocidos y escurridos","1 taza de calabaza (zapallo) kabocha cocida","1 cucharadita de aceite de oliva extra virgen","1 pizca de perejil picado"],"tip":"Los mismos frijoles, ahora CON EL COLOR Y EL DULZOR DE LA CALABAZA. Para el niño que extraña el sabor fuerte de los frijoles solos, la calabaza lo suaviza sin sacar los frijoles del plato, y el puré queda naranja en lugar de café.","steps":["Cocina la calabaza hasta que un tenedor la atraviese sin resistencia y aplástala con el tenedor hasta que quede un puré liso.","Aplasta los frijoles ya cocidos aparte, quitando y descartando todas las cascaritas sueltas que aparezcan.","Mezcla los frijoles aplastados con el puré de calabaza durante 1 minuto, hasta que el color quede parejo y sin vetas oscuras.","Revisa con los dedos que no quedó ningún grano entero y ajusta con 1 cucharada de agua si quedó demasiado seco.","Agrega 1 cucharadita de aceite de oliva y la pizca de perejil, extiende en un platito y revuelve mientras se entibia.","Prueba en el dorso de la mano y sirve tibio, en cucharadas pequeñas, con el bebé bien sentado."],"alerta":"Revisa el puré con los dedos antes de servir: ningún grano de frijol puede ir entero al plato del bebé."}],"13":[{"id":1870,"name":"Bastones de Camote en Freidora de Aire","icon":"🍠","time":"~20 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/5612346/pexels-photo-5612346.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 camote (batata) mediano pelado","1 cucharada de aceite de oliva extra virgen","1 pizca de pimentón dulce (paprika)"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 180 °C por 18 minutos, para que el bastón quede bien suave; a partir de los 10 meses, 190 °C por 15 minutos, cuando el niño ya mastica mejor. Cambio: camote → papa, con 3 minutos más.","steps":["Precalienta la freidora de aire a 180 °C por 3 minutos, con la canasta vacía, para que los bastones empiecen a cocinarse ya a la temperatura correcta.","Corta el camote en bastones de unos 8 cm por 1,5 cm, del largo y el grosor de un dedo adulto, todos parecidos entre sí.","Mezcla con 1 cucharada de aceite de oliva y la pizca de pimentón y repártelos en la canasta en una sola capa, sin amontonar; si no, se cocinan al vapor y quedan aguados.","Cocina a 180 °C por 18 minutos, sacudiendo la canasta a la mitad del tiempo, hasta que un tenedor atraviese el bastón sin ninguna resistencia.","Aprieta un bastón tibio entre el pulgar y el índice: tiene que aplastarse casi hasta volverse puré. Si resiste, regrésalo 4 minutos más.","Espera 5 minutos fuera de la canasta, prueba en el dorso de la mano y ofrece 2 bastones a la vez, con el bebé bien sentado y un adulto al lado."],"alerta":"Lo que sale de la freidora de aire está mucho más caliente que lo que sale del horno: espera siempre 5 minutos y prueba en el dorso de la mano antes de dárselo al bebé."},{"id":1871,"name":"Bastones de Zanahoria en Freidora de Aire","icon":"🥕","time":"~20 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/32659125/pexels-photo-32659125.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 zanahorias medianas peladas","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 180 °C por 18 minutos, porque la zanahoria tiene que quedar bien blanda; a partir de los 12 meses, 190 °C por 14 minutos. Cambio: zanahoria → calabaza (zapallo) tipo kabocha en bastones, con 4 minutos menos.","steps":["Precalienta la freidora de aire a 180 °C por 3 minutos y corta las zanahorias en bastones de unos 7 cm por 1,5 cm, usando la parte más gruesa de la raíz.","Mezcla los bastones con 1 cucharada de aceite de oliva y la pizca de orégano hasta que brillen parejo.","Repártelos en la canasta en una sola capa, sin encimarlos, y cocina a 180 °C por 18 minutos, sacudiendo dos veces durante la cocción.","Pincha el bastón más grueso con un tenedor: tiene que atravesarlo sin trabarse. La zanahoria es de las verduras que más tardan en ablandarse.","Aprieta un bastón tibio entre los dedos y sirve solo los que se aplasten fácil; los firmes regresan a la canasta 4 minutos más.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 2 bastones a la vez, con el bebé bien sentado."],"alerta":"La zanahoria firme es la que más atragantamientos causa a esta edad: ningún bastón que resista a los dedos puede ir al plato."},{"id":1872,"name":"Tiras de Calabacita en Freidora de Aire","icon":"🥒","time":"~15 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/36367576/pexels-photo-36367576.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana","1 cucharada de aceite de oliva extra virgen","1 pizca de ajo en polvo"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 170 °C por 14 minutos, para que la tira quede bien blanda; a partir de los 10 meses, 180 °C por 11 minutos. Cambio: calabacita → berenjena pelada, con 3 minutos más.","steps":["Precalienta la freidora de aire a 170 °C por 3 minutos y corta la calabacita en tiras largas de unos 8 cm por 1,5 cm, dejando la cáscara fina.","Mezcla las tiras con 1 cucharada de aceite de oliva y la pizca de ajo en polvo, sin nada de sal.","Repártelas en la canasta en una sola capa y cocina a 170 °C por 14 minutos, volteando las tiras con las pinzas de cocina a la mitad del tiempo.","Aprieta una tira tibia entre el pulgar y el índice: tiene que ceder sin esfuerzo. La calabacita medio cruda queda como de hule y no se debe servir.","Espera 5 minutos fuera de la canasta, prueba en el dorso de la mano y ofrece 2 tiras a la vez, con el bebé bien sentado."],"alerta":"Nunca cortes la calabacita en rodajas: la forma redonda es la más peligrosa de la mesa. Siempre en tira larga."},{"id":1873,"name":"Rebanadas de Calabaza en Freidora de Aire","icon":"🎃","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/4768952/pexels-photo-4768952.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 tazas de calabaza (zapallo) tipo kabocha pelada, en rebanadas","1 cucharada de aceite de oliva extra virgen","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 180 °C por 16 minutos, en rebanada larga; a partir de los 10 meses, 190 °C por 13 minutos, en cubos del tamaño de una aceituna. Cambio: calabaza kabocha → cualquier otra calabaza de pulpa naranja, con el mismo tiempo.","steps":["Precalienta la freidora de aire a 180 °C por 3 minutos y corta la calabaza en rebanadas largas de unos 8 cm por 1,5 cm, desechando la cáscara y las semillas.","Mezcla con 1 cucharada de aceite de oliva y la pizca de canela, que resalta el dulce natural de la calabaza sin nada de azúcar.","Repártelas en la canasta en una sola capa y cocina a 180 °C por 16 minutos, sacudiendo a la mitad del tiempo.","Aprieta una rebanada tibia entre los dedos: tiene que volverse casi puré al presionarla; si no, regrésala 4 minutos más.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 2 rebanadas a la vez, con el bebé bien sentado y vigilado."],"alerta":"De los 6 a los 9 meses el bebé agarra con la mano cerrada: sirve en rebanada larga, que sobresalga del puño, y nunca en cubo pequeño."},{"id":1874,"name":"Arbolitos de Brócoli en Freidora de Aire","icon":"🥦","time":"~15 min","kcal":"45 kcal (estimado)","img":"https://images.pexels.com/photos/4162156/pexels-photo-4162156.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de brócoli en arbolitos con el tallito largo","1 cucharada de aceite de oliva extra virgen","1/2 diente de ajo machacado"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 170 °C por 13 minutos, para que el tallo se ablande junto con la flor; a partir de los 12 meses, 180 °C por 10 minutos. Cambio: brócoli → coliflor en arbolitos, con 2 minutos más.","steps":["Precalienta la freidora de aire a 170 °C por 3 minutos y separa los arbolitos dejando un tallito de unos 6 cm en cada uno, que sirve de mango para la manita.","Mezcla los arbolitos con 1 cucharada de aceite de oliva y el ajo machacado y repártelos en la canasta en una sola capa.","Cocina a 170 °C por 13 minutos, sacudiendo a la mitad del tiempo, hasta que el verde quede vivo y las puntas de las flores se doren un poco.","Aprieta la flor y el tallo por separado entre los dedos: los dos tienen que aplastarse, porque el tallo tarda más y es el que suele quedar duro.","Espera 5 minutos, prueba en el dorso de la mano y dale 1 arbolito a la vez en la mano al niño, siempre con supervisión."],"alerta":"Si las puntitas de las flores se tuestan y quedan quebradizas, desecha esos arbolitos: un pedacito duro es riesgo de atragantamiento."},{"id":1875,"name":"Arbolitos de Coliflor en Freidora de Aire","icon":"🤍","time":"~18 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/4162147/pexels-photo-4162147.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 tazas de coliflor en arbolitos con el tallito","1 cucharada de aceite de oliva extra virgen","1 pizca de cúrcuma"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 170 °C por 16 minutos, para que el tallo ceda junto con la flor; a partir de los 12 meses, 180 °C por 12 minutos. Cambio: coliflor → brócoli en arbolitos, con 2 minutos menos.","steps":["Precalienta la freidora de aire a 170 °C por 3 minutos y separa la coliflor en arbolitos con un tallito de unos 6 cm en cada uno.","Mezcla con 1 cucharada de aceite de oliva y la pizca de cúrcuma hasta que queden un poco amarillos y parejos.","Repártelos en la canasta en una sola capa y cocina a 170 °C por 16 minutos, sacudiendo dos veces durante la cocción.","Aprieta la flor y el tallo por separado entre los dedos, porque la coliflor tiene el tallo grueso y es él el que dice si la receta está en su punto.","Espera 5 minutos fuera de la canasta, prueba en el dorso de la mano y dale 1 arbolito a la vez en la mano al niño."],"alerta":"La coliflor demasiado tostada queda dura y quebradiza: si los bordes se oscurecen mucho, deséchala en lugar de servirla."},{"id":1876,"name":"Bastones de Papa en Freidora de Aire","icon":"🥔","time":"~22 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/7936634/pexels-photo-7936634.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 6 meses","ingredients":["3 papas medianas peladas","1 cucharada de aceite de oliva extra virgen","1 cucharadita de perejil fresco picadito"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 180 °C por 20 minutos, en bastón largo; a partir de los 10 meses, 190 °C por 16 minutos, cortado después en trozos del tamaño de una aceituna. Cambio: papa → ñame pelado, con el mismo tiempo.","steps":["Precalienta la freidora de aire a 180 °C por 3 minutos y corta las papas a lo largo, en bastones de unos 7 cm por 1,5 cm.","Mezcla con 1 cucharada de aceite de oliva y repártelos en la canasta en una sola capa, sin amontonar, para que se doren parejo.","Cocina a 180 °C por 20 minutos, sacudiendo a la mitad del tiempo; la papa bien cocida se deshace fácil, así que mueve con cuidado.","Pincha el bastón más grueso con el tenedor: tiene que atravesarlo sin resistencia y empezar a abrirse en los bordes.","Aprieta un bastón tibio entre los dedos: la papa en su punto se vuelve casi puré. Si resiste, regrésala 4 minutos más.","Espolvorea el perejil, espera 5 minutos, prueba en el dorso de la mano y ofrece 2 bastones a la vez."],"alerta":"La papa mal cocida queda firme por dentro aunque esté dorada por fuera: haz siempre la prueba del dedo antes de servir."},{"id":1877,"name":"Bastones de Remolacha en Freidora de Aire","icon":"🩷","time":"~28 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/19748951/pexels-photo-19748951.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 remolachas (betabeles) medianas peladas","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 25 minutos, porque la remolacha es la raíz más dura de la lista; a partir de los 18 meses, 190 °C por 20 minutos. Cambio: remolacha → zanahoria en bastones, con 7 minutos menos.","steps":["Precalienta la freidora de aire a 180 °C por 3 minutos y corta las remolachas en bastones de unos 7 cm por 1,5 cm, todos parecidos.","Mezcla con 1 cucharada de aceite de oliva y la pizca de orégano y repártelos en la canasta en una sola capa.","Cocina a 180 °C por 25 minutos, sacudiendo cada 8 minutos, porque la remolacha necesita todo ese tiempo para ablandarse por dentro.","Aprieta un bastón tibio entre el pulgar y el índice: tiene que aplastarse sin esfuerzo; si no, regrésalo 5 minutos más y prueba otra vez.","Espera 5 minutos fuera de la canasta, prueba en el dorso de la mano y ofrece 2 bastones a la vez, con el niño bien sentado."],"alerta":"La remolacha puede dejar la orina y la popó rojizas por uno o dos días: es normal y no es sangre."},{"id":1878,"name":"Tiras de Berenjena en Freidora de Aire","icon":"🍆","time":"~18 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/11601078/pexels-photo-11601078.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 berenjena mediana pelada","1 cucharada de aceite de oliva extra virgen","1 pizca de orégano seco"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 170 °C por 16 minutos, para que la tira quede bien suave; a partir de los 12 meses, 180 °C por 13 minutos. Cambio: berenjena → calabacita (zucchini), con 3 minutos menos.","steps":["Pela la berenjena por completo: la cáscara queda como de hule aunque esté cocida y no se aplasta entre los dedos del bebé.","Precalienta la freidora de aire a 170 °C por 3 minutos y corta la pulpa en tiras largas de unos 7 cm por 1,5 cm.","Mezcla con 1 cucharada de aceite de oliva y el orégano, repártelas en la canasta en una sola capa y cocina a 170 °C por 16 minutos.","Voltea las tiras con las pinzas de cocina a la mitad del tiempo, con cuidado, porque la berenjena se deshace fácil cuando llega a su punto.","Aprieta una tira tibia entre los dedos: tiene que deshacerse al presionarla. La berenjena que queda como de hule regresa 3 minutos más.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 2 tiras a la vez, con el bebé bien sentado."],"alerta":"Quita toda la cáscara antes de cocinar: es la parte que no se ablanda y se vuelve riesgo de atragantamiento."},{"id":1879,"name":"Bastones de Ñame en Freidora de Aire","icon":"🍠","time":"~25 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/11650403/pexels-photo-11650403.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 ñames medianos pelados","1 cucharada de aceite de oliva extra virgen","1 cucharadita de cebollín picadito"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 180 °C por 22 minutos; a partir de los 12 meses, 190 °C por 18 minutos, cortando después en trozos del tamaño de una aceituna. Cambio: ñame → papa pelada, con el mismo tiempo.","steps":["Pela los ñames con la mano mojada bajo el chorro de agua, porque la cáscara suelta una baba que hace resbalar el cuchillo.","Precalienta la freidora de aire a 180 °C por 3 minutos y corta en bastones de unos 7 cm por 1,5 cm, todos del mismo grosor.","Mezcla con 1 cucharada de aceite de oliva, repártelos en la canasta en una sola capa, sin amontonar, y cocina a 180 °C por 22 minutos.","Sacude la canasta cada 8 minutos y, al final, pincha el bastón más grueso: el tenedor tiene que atravesarlo sin ninguna resistencia.","Aprieta un bastón tibio entre los dedos: tiene que volverse puré al presionarlo; si no, regrésalo 5 minutos más.","Espolvorea el cebollín, espera 5 minutos, prueba en el dorso de la mano y ofrece 2 bastones a la vez."],"alerta":"El ñame nunca se puede ofrecer crudo ni al dente: solo va al plato el bastón que se aplasta entre los dedos."},{"id":1880,"name":"Tiras de Calabacita Pelada en Freidora de Aire","icon":"🥬","time":"~18 min","kcal":"35 kcal (estimado)","img":"https://images.pexels.com/photos/20323424/pexels-photo-20323424.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 calabacita (zucchini) mediana pelada y sin el centro de semillas","1 cucharada de aceite de oliva extra virgen","1 cucharadita de cebollín picadito"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 170 °C por 16 minutos, en tira larga; a partir de los 10 meses, 180 °C por 13 minutos. Cambio: calabacita pelada → calabacita con su cáscara fina, con 3 minutos menos.","steps":["Pela la calabacita bajo el chorro de agua, córtala a la mitad a lo largo y quita con una cuchara todo el centro de semillas, que queda aguado y se deshace en hebras.","Precalienta la freidora de aire a 170 °C por 3 minutos y corta la pulpa en tiras largas de unos 8 cm por 1,5 cm.","Mezcla con 1 cucharada de aceite de oliva, repártelas en la canasta en una sola capa y cocina a 170 °C por 16 minutos, volteando a la mitad.","La calabacita está en su punto cuando se ve translúcida en lugar de blanquecina y un tenedor la atraviesa sin resistencia.","Aprieta una tira tibia entre los dedos para confirmar que se deshace al presionarla; si no, regrésala 3 minutos más.","Espolvorea el cebollín, espera 5 minutos, prueba en el dorso de la mano y ofrece 2 tiras a la vez."],"alerta":"Quita siempre el centro de semillas de la calabacita: se separa en hebras y trozos sueltos que el bebé no logra controlar en la boca."},{"id":1881,"name":"Ejotes Suaves en Freidora de Aire","icon":"🫛","time":"~15 min","kcal":"40 kcal (estimado)","img":"https://images.pexels.com/photos/185473/pexels-photo-185473.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 taza de ejotes (judías verdes) anchos frescos","1 cucharada de aceite de oliva extra virgen","1 pizca de ajo en polvo"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 170 °C por 14 minutos, porque el ejote tiene que pasar del punto de restaurante y quedar bien blando; a partir de los 10 meses, 180 °C por 11 minutos. Cambio: ejotes anchos → ejotes finos, con 3 minutos menos.","steps":["Corta las dos puntitas de cada ejote y jala la hebra del costado: esa hebra nunca se ablanda y le estorba al bebé al morder.","Precalienta la freidora de aire a 170 °C por 3 minutos y corta los ejotes del tamaño de un dedo adulto, unos 7 cm, siempre enteros a lo largo.","Mezcla con 1 cucharada de aceite de oliva y la pizca de ajo en polvo y repártelos en la canasta en una sola capa.","Cocina a 170 °C por 14 minutos, sacudiendo a la mitad del tiempo, hasta que los ejotes se marchiten y pierdan todo lo crujiente.","Aprieta un ejote tibio entre los dedos: tiene que aplastarse y abrirse fácil. El ejote que truena todavía está demasiado duro.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 3 ejotes a la vez, con el bebé bien sentado."],"alerta":"Nunca piques el ejote en rueditas: de los 6 a los 9 meses va entero y largo, para que sobresalga una punta de la mano cerrada del bebé."},{"id":1882,"name":"Nuggets de Pollo Caseros en Freidora de Aire","icon":"🐤","time":"~25 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/37738387/pexels-photo-37738387.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["250 g de pechuga de pollo molida al momento","3 cucharadas de camote (batata) cocido y machacado","3 cucharadas de harina de avena","1 pizca de pimentón dulce (paprika)"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos, para que el nugget quede jugoso por dentro; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: camote → papa cocida y machacada, en la misma cantidad.","steps":["Mezcla el pollo molido, el camote machacado, 2 cucharadas de harina de avena y el pimentón, apretando hasta que la masa se despegue del tazón.","Forma nuggets aplanados de 1 cucharada cada uno, de 1 cm de alto más o menos, y pasa cada uno por la harina de avena que sobró.","Precalienta la freidora de aire a 180 °C por 3 minutos y acomoda los nuggets en la canasta en una sola capa, sin que se toquen.","Cocina a 180 °C por 16 minutos, volteando a la mitad del tiempo, y abre un nugget a la mitad: la carne tiene que estar blanca por completo, sin ningún punto rosado.","Aprieta un nugget tibio entre los dedos: tiene que ceder y seguir jugoso; si la costra queda dura, tápalos con un trapo por 5 minutos.","Espera 5 minutos, prueba en el dorso de la mano y sirve cortado en trozos del tamaño de una aceituna."],"alerta":"Abre siempre un nugget a la mitad antes de servirlos todos: el pollo con cualquier punto rosado no puede ir al plato."},{"id":1883,"name":"Albóndigas de Pollo en Freidora de Aire","icon":"🍗","time":"~22 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/36711035/pexels-photo-36711035.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["250 g de pechuga de pollo molida al momento","1 zanahoria pequeña rallada muy finita","1 huevo entero","3 cucharadas de avena en hojuelas finas"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 180 °C por 15 minutos, en forma de bastón largo; a partir de los 12 meses, 190 °C por 12 minutos, deshecha con el tenedor antes de servir. Cambio: pollo → carne de res magra molida, con el mismo tiempo.","steps":["Mezcla el pollo molido, la zanahoria rallada, el huevo y las 3 cucharadas de avena, apretando con las manos hasta que la masa quede bien unida.","Forma bastones alargados de unos 7 cm rodando la masa en la palma de la mano, y nunca bolitas redondas, que son la peor forma para atragantarse.","Precalienta la freidora de aire a 180 °C por 3 minutos y acomoda los bastones en la canasta en una sola capa, con espacio entre ellos.","Cocina a 180 °C por 15 minutos, volteando a la mitad del tiempo, y corta uno a la mitad para revisar que el centro esté blanco, sin punto rosado.","Aprieta un bastón tibio entre los dedos: tiene que aplastarse fácil y deshacerse en pedacitos suaves.","Espera 5 minutos, prueba en el dorso de la mano y sirve 1 bastón a la vez, con el bebé bien sentado."],"alerta":"Nunca les des forma de bolita redonda: siempre en bastón alargado, y deshecho con el tenedor si el niño todavía no mastica bien."},{"id":1884,"name":"Hamburguesa de Pollo en Freidora de Aire","icon":"🍔","time":"~20 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/29653148/pexels-photo-29653148.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["300 g de pechuga de pollo molida al momento","1/2 calabacita (zucchini) rallada y bien exprimida","1 huevo entero","4 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 15 minutos, servida cortada en tiras; a partir de los 18 meses, 190 °C por 12 minutos, cortada en trozos pequeños. Cambio: calabacita → zanahoria rallada y exprimida, en la misma cantidad.","steps":["Ralla la 1/2 calabacita, júntala en un trapo limpio y exprímela con fuerza para sacarle toda el agua; si no, la hamburguesa se deshace en la canasta.","Mezcla el pollo molido, la calabacita exprimida, el huevo y las 4 cucharadas de harina de avena, amasando hasta que la masa se despegue del tazón.","Forma discos aplanados de 1,5 cm de alto más o menos y del tamaño de la palma de la mano de un niño.","Precalienta la freidora de aire a 180 °C por 3 minutos y cocina los discos a 180 °C por 15 minutos, volteando a la mitad del tiempo.","Corta una hamburguesa a la mitad: el centro tiene que estar blanco por completo, sin ningún punto rosado, antes de servir las demás.","Espera 5 minutos, prueba en el dorso de la mano y sírvela siempre cortada en tiras, nunca el disco entero en la mano del niño."],"alerta":"El disco entero de hamburguesa tiene justo la forma y el tamaño que tapan la vía respiratoria: córtalo siempre en tiras antes de servir."},{"id":1885,"name":"Deditos de Pescado Empanados en Freidora de Aire","icon":"🐟","time":"~18 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/32916221/pexels-photo-32916221.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["200 g de filete de pescado blanco sin espinas, en tiras","1 huevo batido","4 cucharadas de harina de avena","1 cucharadita de jugo de limón"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 12 minutos, para que el dedito quede suave y se deshaga en hebras; a partir de los 18 meses, 190 °C por 10 minutos. Cambio: pescado blanco → tiras de pechuga de pollo, con 4 minutos más.","steps":["Palpa todo el filete con la punta de los dedos, centímetro por centímetro, y quita con unas pinzas cualquier espina que encuentres antes de cortar.","Corta en tiras de unos 7 cm por 1,5 cm, báñalas con 1 cucharadita de jugo de limón y deja reposar 5 minutos.","Pasa cada tira por el huevo batido y después por la harina de avena, cubriendo bien todos los lados para formar una costrita pareja.","Precalienta la freidora de aire a 180 °C por 3 minutos y acomoda los deditos en la canasta en una sola capa, sin encimarlos; si no, se pegan.","Cocina a 180 °C por 12 minutos, volteando a la mitad, hasta que el pescado se deshaga en lajas al tocarlo con el tenedor.","Revisa las lajas con los dedos una vez más, espera 5 minutos, prueba en el dorso de la mano y sirve."],"alerta":"La espina de pescado es riesgo directo de atragantamiento: palpa el filete antes de cortar y revisa las lajas después de cocinar, siempre las dos veces."},{"id":1886,"name":"Croquetitas de Pescado con Papa en Freidora de Aire","icon":"🐠","time":"~25 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/32651691/pexels-photo-32651691.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["200 g de filete de pescado blanco cocido y deshebrado, sin espinas","2 papas medianas cocidas y machacadas","1 huevo entero","2 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 15 minutos, servidas en trozos del tamaño de una aceituna; a partir de los 18 meses, 190 °C por 12 minutos. Cambio: pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Deshebra el pescado ya cocido y pasa los dedos por toda la carne, laja por laja, quitando cualquier espina que haya quedado.","Mezcla el pescado deshebrado, las papas machacadas, el huevo y las 2 cucharadas de harina de avena hasta que la masa se forme en la palma sin pegarse.","Forma croquetitas aplanadas en forma de disco, nunca en bolita redonda, y precalienta la freidora de aire a 180 °C por 3 minutos.","Cocina a 180 °C por 15 minutos, volteando a la mitad del tiempo, hasta que se doren por fuera y estén firmes por dentro.","Aprieta una croquetita tibia entre los dedos: tiene que ceder fácil y seguir jugosa, sin costra dura en los bordes.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Revisa el pescado deshebrado con los dedos antes de mezclar la masa: una sola espina olvidada es un riesgo serio de atragantamiento."},{"id":1887,"name":"Albóndigas de Carne en Freidora de Aire","icon":"🥩","time":"~22 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/28371787/pexels-photo-28371787.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["250 g de carne de res magra molida dos veces","3 cucharadas de calabacita (zucchini) rallada y exprimida","2 cucharadas de avena en hojuelas finas","1 diente de ajo machacado"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 180 °C por 15 minutos, en bastón largo y deshecho con el tenedor; a partir de los 12 meses, 190 °C por 12 minutos, cortado en cuatro. Cambio: carne de res → pechuga de pollo molida, con el mismo tiempo.","steps":["Mezcla la carne molida, la calabacita rallada y exprimida, las 2 cucharadas de avena y el ajo machacado, apretando hasta que la masa quede pareja.","Forma bastones alargados de unos 7 cm rodando la masa sobre la mesa, nunca bolitas redondas.","Precalienta la freidora de aire a 180 °C por 3 minutos y acomoda los bastones en la canasta en una sola capa, con dos dedos de espacio entre ellos.","Cocina a 180 °C por 15 minutos, volteando a la mitad, y abre uno a la mitad para revisar que no quedó ningún punto rosado en el centro.","Aprieta un bastón tibio entre los dedos: tiene que aplastarse fácil y deshacerse en pedacitos suaves.","Espera 5 minutos, prueba en el dorso de la mano y sirve deshecho con el tenedor, con el bebé bien sentado."],"alerta":"La carne con cualquier punto rosado en el centro no se puede servir, y la albóndiga nunca va redonda y entera al plato."},{"id":1888,"name":"Hamburguesa de Carne en Freidora de Aire","icon":"🍔","time":"~20 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/20323448/pexels-photo-20323448.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["300 g de carne de res magra molida dos veces","3 cucharadas de zanahoria cocida y machacada","1 huevo entero","3 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos, servida en tiras; a partir de los 18 meses, 190 °C por 13 minutos, en trozos pequeños. Cambio: carne de res magra → otro corte de res molido dos veces, con el mismo tiempo.","steps":["Cocina la zanahoria hasta que un tenedor la atraviese sin resistencia y machácala con el tenedor hasta que quede un puré sin trozos firmes.","Mezcla la carne molida, el puré de zanahoria, el huevo y las 3 cucharadas de harina de avena, amasando hasta que la masa deje de pegarse a las manos.","Forma discos aplanados de 1,5 cm de alto más o menos y llévalos al refrigerador por 5 minutos, para que se afirmen y no se rajen en la canasta.","Precalienta la freidora de aire a 180 °C por 3 minutos y cocina los discos a 180 °C por 16 minutos, volteando a la mitad del tiempo.","Corta una hamburguesa a la mitad: el centro tiene que estar cocido parejo, sin ningún punto rosado, antes de servir las demás.","Espera 5 minutos, prueba en el dorso de la mano y sirve cortada en tiras, nunca el disco entero en la mano del niño."],"alerta":"La carne molida poco cocida no se puede dar a ninguna edad: confirma que el centro esté cocido y corta siempre en tiras antes de servir."},{"id":1889,"name":"Kibbe al Horno en Freidora de Aire","icon":"🧆","time":"~28 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/34146354/pexels-photo-34146354.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["250 g de carne de res magra molida dos veces","1/2 taza de trigo bulgur hidratado y exprimido","1 cucharada de cebolla picadita","1 pizca de hierbabuena (menta) picada muy finita"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 180 °C por 22 minutos, cortado en trozos del tamaño de una aceituna; a partir de los 18 meses, 190 °C por 18 minutos. Cambio: trigo bulgur → avena en hojuelas finas hidratada, en la misma cantidad.","steps":["Hidrata el trigo bulgur en agua tibia por 30 minutos y exprímelo con las manos hasta sacarle toda el agua; si no, la masa no se afirma.","Mezcla el trigo exprimido, la carne molida, la cebolla picadita y la hierbabuena, amasando con las manos por 2 minutos hasta que quede parejo.","Forma bastones aplanados de unos 7 cm y precalienta la freidora de aire a 180 °C por 3 minutos.","Cocina a 180 °C por 22 minutos, volteando a la mitad del tiempo, y abre un bastón a la mitad para revisar que el centro esté cocido parejo.","Aprieta un trozo tibio entre los dedos: tiene que ceder sin esfuerzo, y los bordes resecos se desechan.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Desecha los bordes resecos del kibbe: solo va al plato el trozo que se aplasta entre los dedos."},{"id":1890,"name":"Tiras de Pollo Sazonadas en Freidora de Aire","icon":"🍗","time":"~20 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/9219086/pexels-photo-9219086.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 filete de pechuga de pollo (unos 150 g)","1 cucharada de aceite de oliva extra virgen","1 diente de ajo machacado","1 pizca de pimentón dulce (paprika)"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 180 °C por 16 minutos, en tira larga del tamaño de un dedo; a partir de los 12 meses, 190 °C por 13 minutos, deshebrado. Cambio: pechuga de pollo → muslo deshuesado y sin piel, con 3 minutos más.","steps":["Corta el filete en el sentido de las fibras, en tiras de unos 8 cm por 1,5 cm, para que el pollo se deshebre en la boca en vez de quedar como un trozo firme.","Sazona las tiras con 1 cucharada de aceite de oliva, el ajo machacado y la pizca de pimentón, y deja reposar 5 minutos.","Precalienta la freidora de aire a 180 °C por 3 minutos y acomoda las tiras en la canasta en una sola capa, sin encimarlas.","Cocina a 180 °C por 16 minutos, volteando a la mitad, y abre la tira más gruesa: tiene que estar blanca hasta el centro, sin ningún punto rosado.","Aprieta una tira tibia entre los dedos: si resiste, deshébrala con dos tenedores antes de servir, para que el bebé no muerda un trozo firme.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 1 tira a la vez, con el bebé bien sentado."],"alerta":"El pollo en la freidora de aire se reseca fácil y queda en trozo duro: si la tira no se aplasta entre los dedos, deshébrala antes de ofrecerla."},{"id":1891,"name":"Croquetitas de Carne en Freidora de Aire","icon":"🥔","time":"~25 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/31398314/pexels-photo-31398314.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["200 g de carne de res magra molida y bien cocida","2 papas medianas cocidas y machacadas","1 huevo entero","3 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos, servidas en trozos del tamaño de una aceituna; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: carne de res → pollo cocido y deshebrado muy fino, en la misma cantidad.","steps":["Sofríe la carne molida en un sartén sin sal hasta que pierda todo el color rosado, deshaciendo los grumos con la cuchara, y deja enfriar.","Mezcla la carne cocida, las papas machacadas, el huevo y 2 cucharadas de harina de avena hasta que la masa se forme en la palma sin pegarse.","Forma croquetitas alargadas del tamaño de un dedo y pasa cada una por la harina de avena que sobró, para formar una costrita ligera.","Precalienta la freidora de aire a 180 °C por 3 minutos y cocina a 180 °C por 16 minutos, volteando a la mitad del tiempo.","Aprieta una croquetita tibia entre los dedos: tiene que ceder y seguir jugosa por dentro. Si la costra queda dura, tápalas con un trapo por 5 minutos.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"El centro de la croquetita guarda calor mucho después de que la costra se enfría: espera los 5 minutos y prueba siempre antes de dársela al niño."},{"id":1892,"name":"Albóndigas de Pescado en Freidora de Aire","icon":"🐟","time":"~22 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/37107128/pexels-photo-37107128.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["250 g de filete de pescado blanco cocido y deshebrado, sin espinas","1 huevo entero","3 cucharadas de harina de avena","1 cucharada de perejil picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 14 minutos, servida deshecha con el tenedor; a partir de los 18 meses, 190 °C por 11 minutos, cortada en cuatro. Cambio: pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina el pescado al vapor hasta que se separe en lajas y pasa los dedos por toda la carne deshebrada, quitando cualquier espina que encuentres.","Mezcla el pescado deshebrado, el huevo, las 3 cucharadas de harina de avena y el perejil hasta que la masa se pueda formar con facilidad.","Forma bastones alargados de unos 6 cm, nunca bolitas redondas, y precalienta la freidora de aire a 180 °C por 3 minutos.","Cocina a 180 °C por 14 minutos, volteando a la mitad del tiempo, hasta que estén firmes y un poco dorados por fuera.","Aprieta un bastón tibio entre los dedos para confirmar que se aplasta fácil y sigue jugoso por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve deshecho o en trozos del tamaño de una aceituna."],"alerta":"Revisa el pescado espina por espina antes de mezclar, aunque el filete se venda como sin espinas: las finas pasan sin que las veas."},{"id":1893,"name":"Filete de Pescado en Lajas en Freidora de Aire","icon":"🐠","time":"~18 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/30635699/pexels-photo-30635699.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 filete de pescado blanco sin espinas (unos 120 g)","1 cucharada de aceite de oliva extra virgen","1 cucharadita de jugo de limón","1 pizca de perejil picadito"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 170 °C por 12 minutos, deshebrado y mezclado con un puré; a partir de los 10 meses, 180 °C por 10 minutos, en lajas sueltas en el plato. Cambio: pescado blanco → merluza u otro pescado blanco sin espinas, con el mismo tiempo.","steps":["Palpa todo el filete con la punta de los dedos antes de sazonarlo y quita con unas pinzas cualquier espina que encuentres.","Báñalo con 1 cucharadita de jugo de limón y 1 cucharada de aceite de oliva y deja reposar 5 minutos.","Precalienta la freidora de aire a 170 °C por 3 minutos y pon el filete entero en la canasta, sin cortarlo, para que no se reseque.","Cocina a 170 °C por 12 minutos, sin voltear, hasta que la carne deje de verse transparente y se separe en lajas al tocarla con el tenedor.","Deshebra el pescado y revisa laja por laja con los dedos, buscando cualquier espina que haya quedado después de cocinarlo.","Espolvorea el perejil, espera 5 minutos, prueba en el dorso de la mano y sirve tibio, mezclado con un puré si el bebé todavía es pequeño."],"alerta":"Revisa el pescado dos veces, antes y después de cocinarlo: la espina fina es el mayor riesgo de esta receta."},{"id":1894,"name":"Croquetitas de Arroz en Freidora de Aire","icon":"🍙","time":"~22 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/34203235/pexels-photo-34203235.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arroz blanco cocido y frío","1 huevo entero","2 cucharadas de avena en hojuelas finas","1 cucharada de perejil picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 15 minutos, servidas en trozos del tamaño de una aceituna; a partir de los 18 meses, 190 °C por 12 minutos. Cambio: avena en hojuelas finas → harina de arroz, en la misma cantidad.","steps":["Machaca el arroz frío con el tenedor por 1 minuto, más o menos, hasta que los granos se suelten y queden un poco aplastados; eso ayuda a que la masa se una.","Mezcla el huevo, las 2 cucharadas de avena y el perejil, apretando con las manos hasta que la masa se forme en la palma sin desmoronarse.","Forma croquetitas bien aplanadas, en forma de disco, y nunca en bolita redonda, que es la forma más peligrosa para atragantarse.","Precalienta la freidora de aire a 180 °C por 3 minutos y cocina a 180 °C por 15 minutos, volteando a la mitad del tiempo.","Aprieta una croquetita tibia entre los dedos: tiene que ceder fácil y seguir jugosa por dentro, sin costra dura.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna, con el niño bien sentado."],"alerta":"El arroz cocido es un alimento delicado: usa solo el que estuvo en el refrigerador 1 día o menos y nunca lo recalientes dos veces."},{"id":1895,"name":"Croquetitas de Papa en Freidora de Aire","icon":"🥔","time":"~25 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/35813494/pexels-photo-35813494.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["3 papas medianas cocidas y machacadas","1 huevo entero","3 cucharadas de harina de avena","1 cucharada de cebollín picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos; a partir de los 18 meses, 190 °C por 13 minutos, con la costrita un poco más firme. Cambio: papa → camote (batata) cocido y machacado, en la misma cantidad.","steps":["Cocina las papas hasta que un tenedor las atraviese sin resistencia, escúrrelas muy bien y machácalas todavía calientes, sin dejar ningún grumo.","Extiende el puré en un plato por 5 minutos para que suelte el vapor: el puré demasiado húmedo pide harina de más y deja la croquetita dura.","Mezcla el huevo, las 3 cucharadas de harina de avena y el cebollín hasta que la masa se despegue de las manos.","Forma croquetitas alargadas del tamaño de un dedo, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 16 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos para confirmar que cede fácil y sigue suave por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"El centro de la croquetita guarda calor mucho después de que la costra se enfría: espera los 5 minutos y prueba antes de dársela al niño."},{"id":1896,"name":"Bastones de Polenta en Freidora de Aire","icon":"🌽","time":"~25 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/38081858/pexels-photo-38081858.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de harina de maíz fina para polenta","2 tazas de agua filtrada","1 cucharada de aceite de oliva extra virgen","1 pizca de cúrcuma"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 18 minutos, dejando el bastón suave por dentro; a partir de los 18 meses, 190 °C por 15 minutos. Cambio: harina de maíz fina → polenta instantánea, en la misma cantidad.","steps":["Hierve las 2 tazas de agua, baja el fuego y agrega la harina de maíz en forma de lluvia, revolviendo sin parar para que no se hagan grumos.","Cocina a fuego bajo unos 20 minutos, revolviendo cada 2 minutos, hasta que la polenta se despegue del fondo de la olla.","Extiéndela en un molde engrasado en una capa de 2 cm, deja enfriar y llévala al refrigerador por 1 hora, hasta que esté lo bastante firme para cortar.","Corta en bastones de unos 6 cm por 2 cm, mézclalos con 1 cucharada de aceite de oliva y la cúrcuma y precalienta la freidora de aire a 180 °C por 3 minutos.","Cocina a 180 °C por 18 minutos, volteando a la mitad, sin dejar que se forme costra crujiente: se rompe en pedacitos duros y es riesgo de atragantamiento.","Aprieta un bastón tibio entre los dedos, confirma que se aplasta fácil, espera 5 minutos y sirve probando en el dorso de la mano."],"alerta":"La polenta con costra crujiente se rompe en pedacitos duros: si el bastón truena entre los dedos, deséchalo en lugar de servirlo."},{"id":1897,"name":"Croquetitas de Yuca en Freidora de Aire","icon":"🥔","time":"~25 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/3324431/pexels-photo-3324431.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 tazas de yuca cocida, sin la hebra del centro","1 huevo entero","2 cucharadas de harina de avena","1 cucharada de perejil picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: yuca → camote (batata) cocido y machacado, con 3 minutos menos.","steps":["Pela la yuca quitando la cáscara café y la piel rosada de abajo, y saca con el cuchillo la hebra dura del centro de cada trozo.","Cocina hasta que la yuca empiece a abrirse en los bordes, unos 25 minutos, y machácala todavía caliente, revisando que no haya quedado ninguna hebra.","Mezcla el huevo, las 2 cucharadas de harina de avena y el perejil hasta formar una masa que se forme en la palma sin pegarse.","Forma croquetitas bien aplanadas en forma de disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 16 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos: tiene que ceder sin esfuerzo y seguir suave por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Quita por completo la hebra fibrosa del centro de la yuca: no se ablanda ni cocida y es riesgo directo de atragantamiento."},{"id":1898,"name":"Muffin Salado de Verduras en Freidora de Aire","icon":"🧁","time":"~25 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/17741884/pexels-photo-17741884.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 huevos enteros","1/2 taza de zanahoria rallada finita","1/2 taza de calabacita (zucchini) rallada y exprimida","1 taza de harina de avena","1 cucharadita de polvo para hornear"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 170 °C por 18 minutos, para que el muffin quede bien esponjoso; a partir de los 18 meses, 180 °C por 15 minutos. Cambio: harina de avena → harina de arroz, en la misma cantidad.","steps":["Ralla la calabacita, exprímela en un trapo limpio para sacarle el agua y mézclala con la zanahoria rallada y los 2 huevos batidos.","Agrega la harina de avena poco a poco, revolviendo solo hasta que desaparezca la parte seca, y suma el polvo para hornear al final con tres vueltas de cuchara.","Reparte la masa en moldecitos de silicona para freidora de aire, llenándolos hasta dos tercios de su altura.","Precalienta la freidora de aire a 170 °C por 3 minutos y cocina a 170 °C por 18 minutos, hasta que un palillo clavado en el centro salga limpio.","Deja enfriar por completo sobre una rejilla, unos 20 minutos, porque el centro del muffin guarda calor mucho después de que la superficie se enfría.","Parte el muffin en cuatro trozos y sirve uno a la vez, con el niño bien sentado y vigilado."],"alerta":"Nunca le des el muffin entero en la mano al niño: pártelo siempre en trozos pequeños y espera a que el centro se enfríe."},{"id":1899,"name":"Croquetitas de Camote con Pollo en Freidora de Aire","icon":"🍠","time":"~25 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/31254448/pexels-photo-31254448.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) mediano cocido y machacado","4 cucharadas de pollo cocido y deshebrado muy fino","1 huevo entero","2 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: pollo → carne de res magra molida bien cocida, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese sin resistencia y machácalo hasta que no quede ningún trozo firme en la masa.","Deshebra el pollo muy fino con dos tenedores y pasa los dedos por el montoncito, deshaciendo cualquier hebra más gruesa.","Mezcla el camote, el pollo deshebrado, el huevo y las 2 cucharadas de harina de avena hasta que la masa se despegue del tazón.","Forma croquetitas bien aplanadas en disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 16 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos para confirmar que cede fácil y sigue jugosa por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Deshebra el pollo muy fino antes de mezclar: una hebra gruesa dentro de la croquetita es difícil de masticar y puede atragantar."},{"id":1900,"name":"Mini Panecitos de Queso Caseros en Freidora de Aire","icon":"🧀","time":"~25 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/5847191/pexels-photo-5847191.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"5 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de fécula de maíz","1/2 taza de queso fresco rallado","1 huevo entero","3 cucharadas de leche entera","1 cucharada de aceite de oliva extra virgen"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 170 °C por 18 minutos, para que quede suave por dentro; a partir de los 18 meses, 180 °C por 15 minutos. Cambio: queso fresco → ricota machacada, en la misma cantidad.","steps":["Calienta la leche con el aceite de oliva hasta que casi hierva y viértela sobre la fécula de maíz, revolviendo con la cuchara hasta formar una masa con grumos.","Espera 5 minutos a que se entibie y agrega el huevo y el queso rallado, amasando con las manos hasta que la masa quede lisa y se despegue de los dedos.","Forma bolitas pequeñas y aplasta cada una con la palma de la mano para hacer discos: el panecito redondo y entero no va a la mano del niño.","Precalienta la freidora de aire a 170 °C por 3 minutos y cocina los discos a 170 °C por 18 minutos, hasta que crezcan y se doren un poco.","Espera 10 minutos a que se enfríen: el panecito de queso caliente queda elástico y se pega al paladar, y justo ahí aumenta el riesgo.","Corta cada disco en cuatro trozos y sirve uno a la vez, con el niño bien sentado y un adulto al lado."],"alerta":"El panecito de queso es elástico y se pega al paladar: aplánalo, espera a que se enfríe y córtalo siempre en cuatro antes de servir. Nunca entero."},{"id":1901,"name":"Croquetitas de Maíz en Freidora de Aire","icon":"🌽","time":"~22 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/8998041/pexels-photo-8998041.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de granos de maíz tierno (elote/choclo) cocidos","1 huevo entero","3 cucharadas de harina de avena","1 cucharada de cebollín picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 15 minutos; a partir de los 18 meses, 190 °C por 12 minutos. Cambio: maíz tierno → arvejas (chícharos) cocidas y machacadas, en la misma cantidad.","steps":["Machaca el maíz cocido con un machacador de papas por 2 minutos, más o menos, apretando con fuerza hasta deshacer la cascarita de cada grano.","Pasa los dedos por la masa y revisa que no haya quedado ningún grano entero, porque la cáscara del maíz no se ablanda ni cocida.","Mezcla el huevo, las 3 cucharadas de harina de avena y el cebollín hasta que la masa se forme en la palma sin pegarse.","Forma croquetitas bien aplanadas en disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 15 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos para confirmar que cede y sigue suave por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"El grano de maíz entero es redondo y de cáscara dura: machácalo hasta que no quede ninguno y revisa la masa con los dedos antes de formar las croquetitas."},{"id":1902,"name":"Ñoquis Dorados en Freidora de Aire","icon":"🥔","time":"~30 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/6659556/pexels-photo-6659556.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 papas medianas cocidas y machacadas","3/4 de taza de harina de trigo","1 yema de huevo","1 cucharada de aceite de oliva extra virgen"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 180 °C por 12 minutos después de cocerlos en agua; a partir de los 18 meses, 190 °C por 10 minutos. Cambio: harina de trigo → harina de arroz con 1 cucharada de fécula de maíz.","steps":["Machaca las papas todavía calientes y extiéndelas en un plato por 5 minutos para que suelten el vapor, porque el puré húmedo pide demasiada harina.","Agrega la yema y la harina poco a poco, amasando solo hasta formar una masa lisa que se despegue de los dedos.","Haz rollitos delgados sobre la mesa enharinada y corta pedacitos muy pequeños, del tamaño de la uña del pulgar.","Cocina en agua hirviendo sin sal unos 3 minutos, hasta que suban a la superficie, y escurre bien.","Mezcla con 1 cucharada de aceite de oliva, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 12 minutos, sacudiendo a la mitad.","Aprieta un ñoqui tibio entre los dedos: tiene que aplastarse fácil. Espera 5 minutos y sirve probando en el dorso de la mano."],"alerta":"Corta los ñoquis muy pequeños antes de cocerlos: un trozo grande y blandito se puede tragar entero sin masticar."},{"id":1903,"name":"Pastel Salado de Verduras en Freidora de Aire","icon":"🥧","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/26161037/pexels-photo-26161037.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["3 huevos enteros","1/2 taza de zanahoria rallada finita","1/2 taza de calabacita (zucchini) rallada y exprimida","3 cucharadas de queso fresco rallado","3 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 170 °C por 22 minutos, para que el pastel se afirme sin resecarse; a partir de los 18 meses, 180 °C por 18 minutos. Cambio: queso fresco → ricota machacada, en la misma cantidad.","steps":["Bate los 3 huevos con el tenedor y mezcla la zanahoria rallada, la calabacita exprimida, el queso y las 3 cucharadas de harina de avena.","Vierte en un molde pequeño para freidora de aire, engrasado, formando una capa de unos 3 cm de alto.","Precalienta la freidora de aire a 170 °C por 3 minutos y cocina a 170 °C por 22 minutos, sin abrir la canasta en los primeros 15 minutos.","Clava un palillo en el centro: tiene que salir limpio, sin huevo crudo pegado, antes de que saques el molde.","Deja enfriar 10 minutos fuera de la canasta, porque el relleno de huevo guarda mucho calor por dentro.","Corta en trozos del tamaño de un dedo, prueba en el dorso de la mano y sirve con el niño bien sentado."],"alerta":"Confirma con el palillo que el centro esté cocido: el pastel de huevo mal cocido no se puede dar a ninguna edad."},{"id":1904,"name":"Omelet en Tiras en Freidora de Aire","icon":"🍳","time":"~15 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/35071827/pexels-photo-35071827.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["2 huevos enteros","1 cucharada de agua filtrada","1 cucharada de cebollín picadito","1 cucharadita de aceite de oliva para engrasar"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 160 °C por 12 minutos, para que el omelet quede bien suave; a partir de los 10 meses, 170 °C por 10 minutos. Cambio: cebollín → perejil picadito, en la misma cantidad.","steps":["Bate los 2 huevos con 1 cucharada de agua por 30 segundos, hasta que no quede ningún hilo transparente de clara, y agrega el cebollín.","Engrasa un molde pequeño para freidora de aire con 1 cucharadita de aceite de oliva y vierte la mezcla, formando una capa delgada.","Precalienta la freidora de aire a 160 °C por 3 minutos y cocina a 160 °C por 12 minutos, sin abrir en los primeros 8 minutos.","Revisa que la superficie se haya afirmado por completo, sin ninguna parte brillante o líquida: el huevo para bebé va siempre bien cocido.","Espera 5 minutos, corta en tiras largas de unos 7 cm por 1,5 cm y prueba en el dorso de la mano.","Sirve 2 tiras a la vez, con el bebé bien sentado y un adulto al lado durante toda la comida."],"alerta":"Córtalo siempre en tira larga, nunca en cuadritos: el trozo redondo de huevo es de las formas que más se atoran."},{"id":1905,"name":"Mini Frittata de Verduras en Freidora de Aire","icon":"🥚","time":"~20 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/15481458/pexels-photo-15481458.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 huevos enteros","3 cucharadas de calabacita (zucchini) rallada y exprimida","2 cucharadas de zanahoria rallada finita","1 cucharadita de aceite de oliva para engrasar"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 160 °C por 15 minutos; a partir de los 12 meses, 170 °C por 12 minutos. Cambio: calabacita → berenjena pelada, rallada y exprimida, en la misma cantidad.","steps":["Sofríe la zanahoria y la calabacita ralladas en un sartén por 4 minutos, hasta que estén tan suaves que se deshagan con la cuchara.","Bate los 2 huevos con el tenedor y mezcla las verduras sofritas y ya tibias.","Reparte en moldecitos de silicona engrasados, llenándolos hasta dos tercios de su altura para que la frittata crezca sin desbordarse.","Precalienta la freidora de aire a 160 °C por 3 minutos y cocina a 160 °C por 15 minutos, hasta que la superficie se afirme y un palillo salga limpio del centro.","Espera 5 minutos fuera de la canasta y corta cada frittata en tiras de unos 6 cm, sin servir nunca la pieza entera.","Prueba en el dorso de la mano y sirve 1 tira a la vez, con el bebé bien sentado."],"alerta":"La frittata sale muy caliente de la freidora de aire y guarda calor en el centro: espera los 5 minutos y prueba antes de ofrecerla."},{"id":1906,"name":"Muffin de Huevo con Calabacita en Freidora de Aire","icon":"🧁","time":"~20 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/34516541/pexels-photo-34516541.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["3 huevos enteros","1/2 taza de calabacita (zucchini) rallada y bien exprimida","1 cucharada de perejil picadito","1 cucharadita de aceite de oliva para engrasar"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 160 °C por 16 minutos; a partir de los 12 meses, 170 °C por 13 minutos. Cambio: calabacita → zanahoria rallada finita, en la misma cantidad.","steps":["Ralla la calabacita y exprímela muy bien en un trapo limpio, porque su agua no deja que el muffin se afirme y lo deja aguado.","Bate los 3 huevos con el tenedor, mezcla la calabacita exprimida y el perejil y reparte en moldecitos de silicona engrasados.","Llena cada moldecito hasta dos tercios de su altura, para que el muffin crezca sin desbordarse dentro de la canasta.","Precalienta la freidora de aire a 160 °C por 3 minutos y cocina a 160 °C por 16 minutos, hasta que se afirmen por completo y no tiemblen en el centro.","Espera 5 minutos, desmolda con cuidado y corta cada muffin en cuatro trozos antes de servir.","Prueba en el dorso de la mano y ofrece un trozo a la vez, con el bebé bien sentado."],"alerta":"Nunca le des el muffin de huevo entero en la mano al bebé: córtalo siempre en cuatro y revisa que el centro esté bien cocido."},{"id":1907,"name":"Huevo en Moldecito con Queso en Freidora de Aire","icon":"🧀","time":"~18 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/23884204/pexels-photo-23884204.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 huevos enteros","2 cucharadas de queso fresco rallado","1 cucharada de tomate (jitomate) sin piel y sin semillas, picadito","1 cucharadita de aceite de oliva para engrasar"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 160 °C por 14 minutos, para que la yema se cocine por completo; a partir de los 18 meses, 170 °C por 12 minutos. Cambio: queso fresco → ricota machacada, en la misma cantidad.","steps":["Engrasa dos moldecitos de silicona con aceite de oliva y bate los huevos con el tenedor hasta que la yema y la clara queden completamente mezcladas.","Mezcla el queso rallado y el tomate picadito, ya sin piel y sin semillas, y reparte en los moldecitos.","Precalienta la freidora de aire a 160 °C por 3 minutos y cocina a 160 °C por 14 minutos, sin abrir en los primeros 10 minutos.","Revisa que el huevo se haya afirmado entero, sin ninguna parte blanda o brillante en el centro, antes de sacarlo de la canasta.","Espera 5 minutos, desmolda y corta en tiras de unos 6 cm, sin servir nunca la pieza entera.","Prueba en el dorso de la mano y sirve 1 tira a la vez, con el niño bien sentado."],"alerta":"La yema blanda no se puede dar a ninguna edad: el huevo tiene que estar firme por completo antes de salir del moldecito."},{"id":1908,"name":"Croquetitas de Garbanzo en Freidora de Aire","icon":"🫘","time":"~25 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/6911885/pexels-photo-6911885.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de garbanzos bien cocidos y sin piel","1 huevo entero","3 cucharadas de harina de avena","1 cucharada de perejil picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: garbanzos → lentejas bien cocidas y machacadas, en la misma cantidad.","steps":["Cocina los garbanzos hasta que se desmoronen entre los dedos y quita una por una las pieles sueltas, que no se ablandan y se pegan en la garganta.","Machácalos con el tenedor hasta formar una pasta espesa, sin que quede ningún garbanzo entero en la masa.","Mezcla el huevo, las 3 cucharadas de harina de avena y el perejil hasta que la masa se forme en la palma sin pegarse a los dedos.","Forma croquetitas bien aplanadas en disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 16 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos: tiene que ceder y seguir jugosa por dentro, sin costra dura.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Quita todas las pieles sueltas de los garbanzos: quedan enteras aunque estén cocidas y se pueden pegar en la garganta del niño."},{"id":1909,"name":"Croquetitas de Lentejas en Freidora de Aire","icon":"🫘","time":"~25 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/9465702/pexels-photo-9465702.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de lentejas bien cocidas y escurridas","1 papa pequeña cocida y machacada","1 huevo entero","3 cucharadas de harina de avena"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 16 minutos; a partir de los 18 meses, 190 °C por 13 minutos. Cambio: lentejas → garbanzos bien cocidos y sin piel, en la misma cantidad.","steps":["Cocina las lentejas hasta que los granos se deshagan al apretarlos contra la pared de la olla y escúrrelas muy bien.","Machaca las lentejas con la papa cocida usando el tenedor, hasta formar una pasta espesa y pareja.","Mezcla el huevo y las 3 cucharadas de harina de avena, apretando hasta que la masa se despegue del tazón.","Forma croquetitas bien aplanadas en disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 16 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos para confirmar que cede fácil y sigue suave por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Aplánalas siempre en disco y sírvelas en trozos pequeños: la bolita redonda de masa es la forma que más atraganta."},{"id":1910,"name":"Croquetitas de Frijoles en Freidora de Aire","icon":"🫘","time":"~25 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/22711483/pexels-photo-22711483.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de frijoles (porotos) cocidos y bien escurridos","1 huevo entero","4 cucharadas de harina de avena","1 cucharada de cebollín picadito"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 180 °C por 17 minutos; a partir de los 18 meses, 190 °C por 14 minutos. Cambio: frijoles pintos → frijoles negros bien cocidos, en la misma cantidad.","steps":["Escurre muy bien los frijoles y machácalos con el tenedor hasta formar una pasta espesa, sin exceso de caldo en el tazón.","Quita y desecha todas las cascaritas sueltas que aparezcan mientras machacas, porque no se ablandan.","Mezcla el huevo, las 4 cucharadas de harina de avena y el cebollín hasta que la masa se forme en la palma sin pegarse.","Forma croquetitas bien aplanadas en disco, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 17 minutos, volteando a la mitad.","Aprieta una croquetita tibia entre los dedos, confirma que cede fácil y desecha las que queden con costra dura.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Quita todas las cascaritas de los frijoles antes de formar las croquetitas: la cáscara suelta es riesgo de atragantamiento aunque esté dentro de la masa."},{"id":1911,"name":"Croquetitas Árabes de Garbanzo en Freidora de Aire","icon":"🧆","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/34492423/pexels-photo-34492423.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de garbanzos bien cocidos y sin piel","1 cucharada de cebolla picadita","1 cucharada de perejil picadito","3 cucharadas de harina de avena","1 cucharada de aceite de oliva extra virgen"],"tip":"Tiempo y temperatura según la edad: a partir de los 12 meses, 180 °C por 18 minutos, sin dejar que se forme costra dura; a partir de los 18 meses, 190 °C por 15 minutos. Cambio: harina de avena → harina de arroz, en la misma cantidad.","steps":["Cocina los garbanzos hasta que se desmoronen entre los dedos y quita una por una todas las pieles sueltas antes de machacarlos.","Machácalos con el tenedor hasta formar una pasta y mezcla la cebolla, el perejil, el aceite de oliva y las 3 cucharadas de harina de avena.","Deja reposar la masa 10 minutos en el refrigerador para que se afirme; eso ayuda a que la croquetita no se raje dentro de la canasta.","Forma discos bien aplanados, precalienta la freidora de aire a 180 °C por 3 minutos y cocina por 18 minutos, volteando a la mitad del tiempo.","Aprieta una croquetita tibia entre los dedos: tiene que ceder sin esfuerzo. Si la costra queda dura, tápalas con un trapo por 5 minutos.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos del tamaño de una aceituna."],"alerta":"Esta croquetita se reseca rápido en la freidora de aire: si la costra truena entre los dedos, no se la ofrezcas al niño."},{"id":1912,"name":"Banana Horneada con Canela en Freidora de Aire","icon":"🍌","time":"~15 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/6489475/pexels-photo-6489475.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 banana (plátano) firme, cortada a la mitad a lo largo","1/2 cucharadita de aceite de coco","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 170 °C por 10 minutos, servida en tira larga; a partir de los 10 meses, 180 °C por 8 minutos, cortada en trozos del tamaño de una aceituna. Cambio: aceite de coco → mantequilla sin sal, en la misma cantidad.","steps":["Corta la banana a la mitad a lo largo, nunca en rodajas, porque la rodaja es la forma redonda que más se atora en la garganta.","Barnízala con el aceite de coco derretido, espolvorea la pizca de canela y no le pongas nada de azúcar: la banana horneada se endulza sola.","Precalienta la freidora de aire a 170 °C por 3 minutos y acomoda las mitades en la canasta con el lado cortado hacia arriba.","Cocina a 170 °C por 10 minutos, sin voltear, hasta que la banana esté suave y un poco dorada en los bordes.","Espera 5 minutos fuera de la canasta y corta cada mitad en tiras de unos 7 cm, del tamaño de un dedo adulto.","Aprieta una tira entre los dedos para confirmar que se aplasta fácil y sirve probando en el dorso de la mano."],"alerta":"La banana horneada se enfría por fuera pero guarda calor en el centro: espera los 5 minutos y prueba siempre antes de dársela al bebé."},{"id":1913,"name":"Rebanadas Suaves de Manzana en Freidora de Aire","icon":"🍎","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/1437605/pexels-photo-1437605.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 manzana gala pelada y sin semillas","1 pizca de canela en polvo","1 cucharadita de agua filtrada"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 160 °C por 16 minutos, para que la rebanada quede bien blanda; a partir de los 12 meses, 170 °C por 13 minutos. Cambio: manzana gala → pera williams madura, con 3 minutos menos.","steps":["Pela la manzana y quita todo el centro con las semillas, cortando la pulpa en rebanadas de 1 cm de grosor, más o menos.","Barnízalas con la cucharadita de agua y espolvorea la canela, sin nada de azúcar, y precalienta la freidora de aire a 160 °C por 3 minutos.","Reparte las rebanadas en la canasta en una sola capa, sin encimarlas, y cocina a 160 °C por 16 minutos, volteando a la mitad del tiempo.","Las rebanadas tienen que salir suaves y doblables, nunca crujientes: un chip quebradizo se rompe en pedacitos duros y es riesgo de atragantamiento.","Aprieta una rebanada tibia entre el pulgar y el índice para confirmar que cede y se dobla sin romperse.","Corta cada rebanada a la mitad, espera 5 minutos, prueba en el dorso de la mano y sirve con el bebé bien sentado."],"alerta":"Si la rebanada sale crujiente y quebradiza, deséchala: tiene que estar suave y doblable para poder ofrecerla."},{"id":1914,"name":"Pera Horneada en Freidora de Aire","icon":"🍐","time":"~18 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/28885911/pexels-photo-28885911.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 6 meses","ingredients":["1 pera williams madura, pelada y sin semillas","1 pizca de canela en polvo","1 cucharadita de agua filtrada"],"tip":"Tiempo y temperatura según la edad: de los 6 a los 9 meses, 160 °C por 14 minutos, servida machacada con el tenedor; a partir de los 10 meses, 170 °C por 11 minutos, en trozos pequeños. Cambio: pera → manzana gala, con 3 minutos más.","steps":["Pela la pera y quita todo el centro con las semillas usando una cucharita, cortándola en rebanadas gruesas.","Barnízalas con la cucharadita de agua, espolvorea la canela y precalienta la freidora de aire a 160 °C por 3 minutos.","Reparte las rebanadas en la canasta en una sola capa y cocina a 160 °C por 14 minutos, volteando a la mitad del tiempo.","La pera está en su punto cuando un tenedor la atraviesa sin ninguna resistencia y la rebanada empieza a deshacerse en los bordes.","Espera 5 minutos y machácala con el tenedor si el bebé tiene menos de 10 meses, o córtala en trozos pequeños si ya agarra con la pinza de los dedos.","Prueba en el dorso de la mano y sirve tibia, con el bebé bien sentado y un adulto al lado."],"alerta":"Quita todas las semillas antes de cocinar y revisa la temperatura en el dorso de la mano: la fruta horneada guarda calor por dentro."},{"id":1915,"name":"Bolitas de Banana con Avena en Freidora de Aire","icon":"🍌","time":"~22 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/5419341/pexels-photo-5419341.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 bananas (plátanos) muy maduras","1 huevo entero","1 taza de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 170 °C por 15 minutos, para que la bolita quede bien suave; a partir de los 12 meses, 180 °C por 12 minutos. Cambio: avena en hojuelas finas → harina de arroz, en la misma cantidad.","steps":["Machaca las 2 bananas muy maduras con el tenedor hasta que queden en un puré liso, sin ningún trozo entero.","Mezcla el huevo, la taza de avena y la pizca de canela hasta formar una masa que se pueda moldear con las manos, sin nada de azúcar.","Deja reposar 5 minutos para que la avena se hidrate; así la bolita no se desmorona en la mano del bebé.","Forma bolitas bien aplanadas en disco, precalienta la freidora de aire a 170 °C por 3 minutos y cocina por 15 minutos, volteando a la mitad.","Aprieta una bolita tibia entre los dedos: tiene que ceder fácil y seguir jugosa por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos pequeños, con el bebé bien sentado."],"alerta":"Sin azúcar y sin miel: la banana madura ya endulza. La miel cuenta como azúcar y, como ella, solo después de los 2 años."},{"id":1916,"name":"Muffin de Manzana en Freidora de Aire","icon":"🍎","time":"~25 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/6625845/pexels-photo-6625845.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 manzana rallada en el rallador grueso","2 huevos enteros","1 taza de harina de avena","1 cucharadita de polvo para hornear","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 170 °C por 18 minutos; a partir de los 18 meses, 180 °C por 15 minutos. Cambio: harina de avena → harina de arroz, en la misma cantidad.","steps":["Pela la manzana, quítale todas las semillas y rállala en el rallador grueso, para que las hebras se vean en la masa.","Bate los 2 huevos con el tenedor, mezcla la manzana rallada y la canela y agrega la harina de avena poco a poco, solo hasta que desaparezca la parte seca.","Agrega el polvo para hornear al final con tres vueltas de cuchara y reparte en moldecitos de silicona hasta dos tercios de su altura.","Precalienta la freidora de aire a 170 °C por 3 minutos y cocina a 170 °C por 18 minutos, hasta que un palillo clavado en el centro salga limpio.","Deja enfriar por completo sobre una rejilla, unos 20 minutos, porque el centro guarda calor mucho después de que la superficie se enfría.","Parte cada muffin en cuatro trozos y sirve uno a la vez, con el niño bien sentado y vigilado."],"alerta":"Nunca le des el muffin entero en la mano al niño: pártelo en cuatro y espera a que el centro se enfríe por completo."},{"id":1917,"name":"Bananitas en Tiras con Canela en Freidora de Aire","icon":"🍌","time":"~18 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/4114126/pexels-photo-4114126.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["2 bananas (plátanos) firmes, cortadas en tiras largas","1 pizca de canela en polvo","1/2 cucharadita de aceite de coco"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 160 °C por 14 minutos, dejando la tira suave y doblable; a partir de los 12 meses, 170 °C por 11 minutos. Cambio: aceite de coco → mantequilla sin sal, en la misma cantidad.","steps":["Corta cada banana a la mitad a lo largo y después cada mitad otra vez, para que queden cuatro tiras largas por fruta.","Barnízalas con el aceite de coco derretido, espolvorea la canela y precalienta la freidora de aire a 160 °C por 3 minutos.","Reparte las tiras en la canasta en una sola capa, sin que se toquen, y cocina a 160 °C por 14 minutos.","Voltea las tiras con las pinzas de cocina a la mitad del tiempo, con cuidado, porque la banana horneada queda frágil y se deshace fácil.","Las tiras tienen que salir suaves y doblables, nunca resecas y quebradizas, porque se rompen en pedacitos duros en la boca.","Espera 5 minutos, prueba en el dorso de la mano y ofrece 1 tira a la vez, con el bebé bien sentado."],"alerta":"Nunca cortes la banana en rodajas: siempre a lo largo, en tiras, y con un adulto al lado durante toda la comida."},{"id":1918,"name":"Manzana Rellena de Avena en Freidora de Aire","icon":"🍏","time":"~25 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/6210952/pexels-photo-6210952.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 manzana gala pelada, sin el centro","2 cucharadas de avena en hojuelas finas","1 cucharada de agua filtrada","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: a partir de los 10 meses, 170 °C por 20 minutos, para que la manzana quede bien blanda; a partir de los 18 meses, 180 °C por 16 minutos. Cambio: manzana gala → pera williams madura, con 4 minutos menos.","steps":["Pela la manzana y quita todo el centro con las semillas usando un descorazonador o una cucharita, dejando un hueco en el medio.","Mezcla las 2 cucharadas de avena con la cucharada de agua y la canela, y rellena el hueco de la manzana con esa pasta.","Precalienta la freidora de aire a 170 °C por 3 minutos y pon la manzana parada en un moldecito para freidora de aire.","Cocina a 170 °C por 20 minutos, hasta que la manzana ceda al tocarla con el tenedor y empiece a abrirse por los costados.","Espera 5 minutos, corta la manzana en trozos pequeños y machácala un poco con el tenedor, revisando que la avena haya quedado suave.","Prueba en el dorso de la mano y sirve tibia, en trozos del tamaño de una aceituna, con el niño bien sentado."],"alerta":"Revisa que no haya quedado ninguna semilla en el centro y que la avena se haya hidratado por completo antes de servir."},{"id":1919,"name":"Bolitas de Calabaza Dulce en Freidora de Aire","icon":"🎃","time":"~25 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/5490828/pexels-photo-5490828.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de calabaza (zapallo) tipo kabocha cocida y machacada","1 huevo entero","3/4 de taza de avena en hojuelas finas","1 pizca de canela en polvo"],"tip":"Tiempo y temperatura según la edad: de los 8 a los 11 meses, 170 °C por 16 minutos, para que la bolita quede bien suave; a partir de los 12 meses, 180 °C por 13 minutos. Cambio: calabaza kabocha → camote (batata) cocido y machacado, en la misma cantidad.","steps":["Cocina la calabaza hasta que un tenedor la atraviese sin resistencia y machácala con el tenedor hasta que quede un puré sin trozos firmes.","Mezcla el huevo, la avena y la pizca de canela, y deja reposar la masa 5 minutos para que las hojuelas se hidraten por completo.","Forma bolitas bien aplanadas en forma de disco, nunca en bolita redonda.","Precalienta la freidora de aire a 170 °C por 3 minutos y cocina a 170 °C por 16 minutos, volteando a la mitad del tiempo.","Aprieta una bolita tibia entre los dedos: tiene que ceder fácil y seguir jugosa por dentro.","Espera 5 minutos, prueba en el dorso de la mano y sirve en trozos pequeños, con el bebé bien sentado."],"alerta":"Sin nada de azúcar: la calabaza horneada ya es dulce por naturaleza. El azúcar, solo después de los 2 años."}]};
/* GUIDES: uma entrada por bônus com hasRecipes:false — conteúdo preventivo e geral, sempre
   reforçando a orientação do pediatra e de cursos certificados para temas de segurança. */
const GUIDES = {"4":{"gradient":"linear-gradient(135deg, var(--bg-guide1), #7A3A2E)","tips":[{"title":"La prevención es la mejor protección","text":"Corta los alimentos en tamaños y formas seguros para la edad de tu bebé. No le des enteros los alimentos redondos y duros del tamaño de la vía respiratoria, como uvas, tomates cherry o salchicha en rodajas."},{"title":"Vigila siempre las comidas","text":"Nunca dejes al bebé comiendo solo. Que esté bien sentado, sin pantallas cerca, y nunca acostado o caminando mientras come."},{"title":"Aprende a distinguir entre atorarse y asfixiarse","text":"Toser fuerte suele ser el propio cuerpo respondiendo bien cuando se atora. En cambio, si le cuesta llorar, toser o respirar, es una emergencia y hay que actuar de inmediato."},{"title":"Toma un curso certificado de primeros auxilios infantiles","text":"Las técnicas para desatorar a un bebé se actualizan cada cierto tiempo. Por eso te recomendamos mucho un curso presencial o en línea certificado, siempre al día, en vez de aprender solo con la teoría."},{"title":"Ten siempre a mano los contactos de emergencia","text":"Guarda el número de emergencias de tu país y el del pediatra de tu bebé en un lugar visible de la cocina, y no dudes en llamar ante cualquier duda real."}]},"5":{"gradient":"linear-gradient(135deg, var(--bg-guide2), #2E5B5A)","tips":[{"title":"Dale un alimento nuevo a la vez","text":"Espera de 2 a 3 días entre un alimento nuevo y otro. Así es más fácil saber qué causó una reacción, si aparece alguna."},{"title":"Pon atención a las señales","text":"Piel roja, hinchazón, vómito, diarrea o irritación después de comer merecen atención y hay que comentarlas con el pediatra de tu bebé."},{"title":"Los alimentos que más causan alergia suelen darse temprano","text":"El huevo, el cacahuate o maní (siempre en pasta, nunca entero), el pescado y el gluten suelen darse desde el inicio de la alimentación complementaria, siempre con la guía del pediatra."},{"title":"Anota cada novedad","text":"Usa una libretita o el Diario de Primeras Veces (otro bono de este paquete) para anotar la fecha, el alimento y la reacción de cada alimento nuevo."},{"title":"Una reacción grave es una emergencia médica","text":"Hinchazón en la cara o en los labios, dificultad para respirar o atragantamiento que no pasa necesitan atención médica de inmediato. No esperes a ver si se le pasa solo."}]},"6":{"gradient":"linear-gradient(135deg, var(--bg-guide3), #4E4270)","tips":[{"title":"Anota la primera vez de cada alimento","text":"Escribe la fecha, la reacción del bebé y si después repitió o no. Eso ayuda a descubrir sus gustos y posibles sensibilidades con el tiempo."},{"title":"Sigue cómo cambia la textura","text":"Del puré liso a los pedacitos suaves, cada etapa es un logro que vale la pena anotar, y te ayuda a ver si el ritmo va bien."},{"title":"Marca las reacciones que ya revisaste","text":"Junta tus notas con la Guía de Alimentos Nuevos y Reacciones (otro bono) para tener toda la historia de la alimentación del bebé en un solo lugar."},{"title":"Celebra los logros del cuerpo relacionados con la comida","text":"Sentarse sin apoyo, llevarse la comida a la boca solo, agarrar la cucharita: pequeños logros que vale la pena guardar."},{"title":"Lleva el diario a las consultas","text":"Un resumen ordenado ayuda al pediatra a entender rápido qué alimentos ya comió y cómo ha reaccionado el bebé."}]}};
/* ==================== ESTADO ==================== */
let state = {
  route:'home', search:'', filter:'todas',
  /* As favoritas ficam salvas no aparelho: a mãe marca hoje e encontra amanhã. */
  favorites:new Set((function(){ try{ return JSON.parse(localStorage.getItem('app_favs')) || []; }catch(e){ return []; } })()),
  detailId:null,
  listSelected:new Set(), listModalSearch:'', listModalFilter:'todas', generatedList:null, checkedItems:new Set(),
  bonusN:null, bonusSearch:'', bonusDetailId:null, cardapioId:null,
  /* rating: única exceção ao "nunca usar localStorage" desta skill — aqui é seguro porque
     o resultado é um arquivo .html standalone entregue como produto final ao comprador. */
  rating: (function(){ try{ return parseInt(localStorage.getItem('app_rating')) || 0; }catch(e){ return 0; } })(),
};
function setRating(n){
  state.rating = n;
  try{ localStorage.setItem('app_rating', n); }catch(e){}
  if(state.route==='home') render();
  const modalEl = document.getElementById('ratingModal');
  if(modalEl && modalEl.classList.contains('open')) renderRatingModal();
}
function openRatingModal(){
  document.getElementById('ratingModal').classList.add('open');
  try{ localStorage.setItem('app_popup_seen','1'); }catch(e){}
  renderRatingModal();
}
function closeRatingModal(markDismissed){
  document.getElementById('ratingModal').classList.remove('open');
  if(markDismissed){ try{ localStorage.setItem('app_popup_seen','1'); }catch(e){} }
}
function renderRatingModal(){
  const r = state.rating;
  let thanksHtml = '';
  if(r >= 4){
    thanksHtml = `<div class="rc-thanks">¡Qué alegría saberlo! 💛 Si puedes, <b>comenta en el anuncio</b> lo que te pareció. Eso nos ayuda muchísimo a llegar a más familias como la tuya.</div>`;
  } else if(r > 0){
    thanksHtml = `<div class="rc-thanks">¡Gracias por calificar! Tu opinión nos ayuda a mejorar la app en cada actualización. 💛</div>`;
  }
  document.getElementById('ratingModalContent').innerHTML = `
    <button class="rm-close" onclick="closeRatingModal(true)">✕</button>
    <div class="rc-icon">⭐</div>
    <h3 style="font-family:'Fraunces',serif;font-size:20px;color:var(--forest);margin-bottom:8px;">¿Qué te pareció la app?</h3>
    <p style="font-size:13.5px;color:var(--ink-soft);line-height:1.55;margin-bottom:16px;">Tu calificación nos ayuda muchísimo a seguir mejorando para tu familia.</p>
    <div class="rc-stars">
      ${[1,2,3,4,5].map(n=>`<button class="${n<=r?'filled':''} rc-star" onclick="setRating(${n})">${n<=r?'★':'☆'}</button>`).join('')}
    </div>
    ${thanksHtml}
    ${r>0 ? `<button class="btn-terracotta" style="margin-top:18px;" onclick="closeRatingModal(true)">Cerrar</button>` : ''}
  `;
}
function setRoute(r){
  state.route = r;
  state.search=''; state.filter='todas';
  document.querySelectorAll('.nav-links button, .bottom-nav button').forEach(b=>b.classList.toggle('active', b.dataset.route===r || (r==='detail'&&b.dataset.route==='recipes') || (r==='cardapioDetail'&&b.dataset.route==='cardapios')));
  render();
  window.scrollTo({top:0,behavior:'smooth'});
}
document.querySelectorAll('.nav-links button, .bottom-nav button').forEach(b=>b.addEventListener('click',()=>setRoute(b.dataset.route)));
function openDetail(id){ state.detailId=id; state.route='detail'; render(); window.scrollTo({top:0,behavior:'smooth'}); }
function toggleFav(id, ev){
  ev && ev.stopPropagation();
  state.favorites.has(id) ? state.favorites.delete(id) : state.favorites.add(id);
  try{ localStorage.setItem('app_favs', JSON.stringify(Array.from(state.favorites))); }catch(e){}
  render();
}
/* Gera um PDF da receita a partir da área "imprimível" do cartão (banner, foto, ingredientes,
   modo de preparo, dica e aviso de segurança) usando html2canvas + jsPDF, ambos carregados via CDN.
   Antes de fotografar, espera as fontes (Fraunces/Caveat/etc.) e a foto da receita carregarem —
   sem isso o html2canvas às vezes captura com a fonte padrão do navegador ou sem a imagem, o que
   deixa o PDF com uma cara bem diferente do cartão bonito que aparece na tela. */
function waitForCardAssets(area, timeout){
  const fontsReady = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
  const imgs = Array.from(area.querySelectorAll('img'));
  const imagesReady = imgs.length
    ? Promise.all(imgs.map(img=> img.complete ? Promise.resolve() : new Promise(res=>{ img.onload = img.onerror = res; })))
    : Promise.resolve();
  return Promise.race([
    Promise.all([fontsReady, imagesReady]),
    new Promise(res=>setTimeout(res, timeout || 4000))
  ]);
}
async function downloadRecipePDF(printId, btnId, recipeName){
  const area = document.getElementById(printId);
  const btn = document.getElementById(btnId);
  if(!area) return;
  const originalLabel = btn ? btn.innerHTML : '';
  if(typeof html2canvas === 'undefined' || !window.jspdf){
    window.print();
    return;
  }
  if(btn){ btn.disabled = true; btn.innerHTML = '⏳ Preparando...'; }
  try{
    await waitForCardAssets(area, 4000);
    if(btn){ btn.innerHTML = '⏳ Generando PDF...'; }
    const canvas = await html2canvas(area, {scale:3, useCORS:true, allowTaint:true, backgroundColor:'#FFF8F0'});
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF('p','mm','a4');
    const pageWidth = 210, pageHeight = 297, margin = 10;
    const imgWidth = pageWidth - margin*2;
    const imgHeight = canvas.height * imgWidth / canvas.width;
    let heightLeft = imgHeight;
    let position = margin;
    const imgData = canvas.toDataURL('image/jpeg', 0.97);
    pdf.addImage(imgData, 'JPEG', margin, position, imgWidth, imgHeight);
    heightLeft -= (pageHeight - margin*2);
    while(heightLeft > 0){
      position = heightLeft - imgHeight + margin;
      pdf.addPage();
      pdf.addImage(imgData, 'JPEG', margin, position, imgWidth, imgHeight);
      heightLeft -= (pageHeight - margin*2);
    }
    const safeName = (recipeName||'receta').normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-zA-Z0-9]+/g,'_').replace(/^_+|_+$/g,'');
    pdf.save((safeName || 'receta') + '.pdf');
  }catch(err){
    alert('No se pudo generar el PDF ahora. Puedes intentarlo de nuevo o usar la opción de imprimir del navegador.');
  }finally{
    if(btn){ btn.disabled = false; btn.innerHTML = originalLabel; }
  }
}
function openBonusList(n){
  state.bonusN=n; state.bonusSearch=''; state.route='bonusList';
  document.querySelectorAll('.nav-links button, .bottom-nav button').forEach(b=>b.classList.remove('active'));
  render(); window.scrollTo({top:0,behavior:'smooth'});
}
function openBonusDetail(n,id){
  state.bonusN=n; state.bonusDetailId=id; state.route='bonusDetail';
  render(); window.scrollTo({top:0,behavior:'smooth'});
}
function openGuide(n){
  state.bonusN=n; state.route='guide';
  document.querySelectorAll('.nav-links button, .bottom-nav button').forEach(b=>b.classList.remove('active'));
  render(); window.scrollTo({top:0,behavior:'smooth'});
}
/* Ao digitar na busca, o app redesenha a lista inteira — e isso apagaria o campo de texto,
   fechando o teclado do celular a cada letra. Por isso devolvemos o foco e o cursor ao fim
   do texto logo depois de redesenhar. */
/* Blindagem da foto: quase toda foto do Pexels e .jpeg, mas algumas sao .png.
   Se a primeira URL falhar, tentamos a variante .png antes de cair no emoji. */
function imgFallback(el, icon, size){
  if(el.dataset.tried !== '1' && el.src.indexOf('.jpeg') > -1){
    el.dataset.tried = '1';
    el.src = el.src.replace('.jpeg', '.png');
    return;
  }
  const d = document.createElement('div');
  d.style.cssText = 'font-size:' + (size||46) + 'px;display:flex;align-items:center;justify-content:center;width:100%;height:100%';
  d.textContent = icon;
  el.replaceWith(d);
}
function keepFocus(id){
  const el = document.getElementById(id);
  if(!el) return;
  el.focus({preventScroll:true});
  try{ const v = el.value; el.setSelectionRange(v.length, v.length); }catch(e){}
}
function setBonusSearch(v){ state.bonusSearch=v; render(); keepFocus('bonusSearchInput'); }
function openCardapio(id){
  state.cardapioId=id; state.route='cardapioDetail';
  document.querySelectorAll('.nav-links button, .bottom-nav button').forEach(b=>b.classList.toggle('active', b.dataset.route==='cardapios'));
  render(); window.scrollTo({top:0,behavior:'smooth'});
}
/* ==================== HELPERS ==================== */
function artStyle(cat){ const c = CATS[cat]; return `background:${c.bg}`; }
/* Contagens sempre calculadas a partir dos dados reais no array — nunca escreva um
   número fixo no hero, porque ele fica desatualizado assim que o cliente manda mais receitas. */
function mainRecipeCount(){ return RECIPES.length; }
function bonusRecipeCount(n){ return (BONUS_RECIPES[n]||[]).length; }
function totalRecipeCount(){
  return RECIPES.length + Object.values(BONUS_RECIPES).reduce((sum,arr)=>sum+arr.length,0);
}
function roundedLabel(n){
  const floor = Math.floor(n/10)*10;
  return (floor>0 ? floor : n) + '+';
}
function heroSection(){
  return `
  <section class="hero">
    <div>
      <div class="hero-eyebrow"><span class="dot"></span><span class="eyebrow" style="margin:0">Menú Pequeño Paladar · Acceso de por vida</span></div>
      <h1>Alimentación complementaria <em>sin sustos</em><br>de los 6 meses a los 2 añitos</h1>
      <p class="lead">${roundedLabel(mainRecipeCount())} recetas organizadas por etapa del desarrollo, listas en 15 minutos o menos, con menús completos y lista de compras automática, para que nunca más te quedes en blanco a la hora de decidir qué servir.</p>
      <div class="stat-row">
        <div class="stat"><b>${roundedLabel(totalRecipeCount())}</b><span>RECETAS EN TOTAL</span></div>
        <div class="stat"><b>${BONUSES.length}</b><span>BONOS</span></div>
        <div class="stat"><b>15min</b><span>EN PROMEDIO</span></div>
      </div>
    </div>
  </section>
  <div class="main-feature" onclick="setRoute('recipes')">
    <img class="main-feature-photo" src="${MAIN_COVER_IMG}" alt="Menú Pequeño Paladar" loading="eager" decoding="async" onerror="this.style.display='none'">
    <div class="main-feature-content">
      <span class="main-feature-badge">★ PRODUCTO PRINCIPAL</span>
      <h2 class="main-feature-title">Menú Pequeño Paladar</h2>
      <p class="main-feature-sub">${roundedLabel(mainRecipeCount())} recetas organizadas por etapa del desarrollo: la base de todo lo que recibiste.</p>
      <div class="main-feature-stats">
        <div><b>${roundedLabel(mainRecipeCount())}</b><span>RECETAS</span></div>
        <div><b>5</b><span>ETAPAS</span></div>
        <div><b>${CARDAPIOS.length}</b><span>MENÚS LISTOS</span></div>
      </div>
      <div class="main-feature-actions">
        <button class="btn-terracotta" onclick="event.stopPropagation(); setRoute('recipes')">Ver todas las recetas →</button>
      </div>
    </div>
  </div>
  <div class="quick-actions-row">
    <div class="quick-action-card" onclick="setRoute('cardapios')">
      <div class="qa-icon">📋</div>
      <div class="qa-text"><b>Menús listos</b><span>${CARDAPIOS.length} días completos, ya armados por etapa</span></div>
      <span class="qa-arrow">→</span>
    </div>
    <div class="quick-action-card" onclick="setRoute('lista')">
      <div class="qa-icon">🛒</div>
      <div class="qa-text"><b>Lista de compras</b><span>Elige las recetas y genera la tuya en segundos</span></div>
      <span class="qa-arrow">→</span>
    </div>
  </div>
  <div class="section-label bonus-section-label"><span class="eyebrow">Bonos incluidos en tu acceso</span></div>
  <div class="collections">
    ${BONUSES.filter(b=>!b.extra).map(b=>collectionCard(
      b.badge || ('BONO '+b.n), b.title, b.hasRecipes ? bonusRecipeCount(b.n)+' recetas exclusivas' : 'guía práctica',
      b.cover,
      b.hasRecipes ? `openBonusList(${b.n})` : `openGuide(${b.n})`, b.icon, b.color
    )).join('')}
  </div>
  <div class="section-label bonus-section-label"><span class="eyebrow">Extras que agregaste en la compra</span></div>
  <div class="collections">
    ${BONUSES.filter(b=>b.extra).map(b=>collectionCard(
      b.badge, b.title, bonusRecipeCount(b.n)+' recetas exclusivas',
      b.cover, `openBonusList(${b.n})`, b.icon, b.color
    )).join('')}
  </div>
  <div class="guide-note" style="max-width:720px;margin:32px auto 0;text-align:center;">⚕️ Esta app es educativa y las recetas e información que presenta <b>no sustituyen la orientación de un pediatra o nutricionista</b>. Cada bebé tiene su propio ritmo: consulta siempre al profesional que acompaña al tuyo antes de empezar o cambiar la alimentación complementaria.</div>
  ${ratingSection()}`;
}
function ratingSection(){
  const r = state.rating;
  let thanksHtml = '';
  if(r >= 4){
    thanksHtml = `<div class="rc-thanks">¡Qué alegría saberlo! 💛 Si puedes, <b>comenta en el anuncio</b> lo que te pareció. Eso nos ayuda muchísimo a llegar a más familias como la tuya.</div>`;
  } else if(r > 0){
    thanksHtml = `<div class="rc-thanks">¡Gracias por calificar! Tu opinión nos ayuda a mejorar la app en cada actualización. 💛</div>`;
  }
  return `
  <div class="rating-card">
    <div class="rc-icon">⭐</div>
    <h3>¿Qué te pareció la app?</h3>
    <p>Tu calificación nos ayuda muchísimo a seguir mejorando para tu familia.</p>
    <div class="rc-stars">
      ${[1,2,3,4,5].map(n=>`<button class="${n<=r?'filled':''} rc-star" onclick="setRating(${n})">${n<=r?'★':'☆'}</button>`).join('')}
    </div>
    ${thanksHtml}
  </div>`;
}
/* Card de coleção com a CAPA OFICIAL do bônus (mockup). A arte aparece inteira
   (object-fit:contain) e o texto vive num bloco branco embaixo — nunca por cima da capa. */
/* Se a capa oficial nao carregar, o card mostra o emblema do bonus
   em vez de ficar com o espaco vazio. */
function collCoverFallback(el, icon, accent){
  const d = document.createElement('div');
  d.className = 'coll-emblem';
  d.style.color = accent;
  d.textContent = icon;
  el.replaceWith(d);
}
function collectionCard(badge,title,sub,coverImg,action,icon,accent){
  const imgTag = coverImg
    ? `<img class="coll-photo" src="${coverImg}" alt="${title}" loading="lazy" decoding="async" onerror="collCoverFallback(this,'${icon||'🍽️'}','${accent||'var(--forest)'}')">`
    : `<div class="coll-emblem" style="color:${accent||'var(--forest)'}">${icon||'🍽️'}</div>`;
  return `<div class="coll-card" onclick="${action}">
    <div class="coll-media">
      ${imgTag}
      <span class="coll-badge">${badge}</span>
    </div>
    <div class="coll-body">
      <div class="coll-title">${title}</div>
      <div class="coll-sub">${sub}</div>
    </div>
  </div>`;
}
function recipesSection(){
  const list = RECIPES.filter(r=>{
    const matchCat = state.filter==='todas' ? true : state.filter==='favoritas' ? state.favorites.has(r.id) : r.cat===state.filter;
    const matchSearch = (r.name.toLowerCase()+r.ingredients.join(' ').toLowerCase()).includes(state.search.toLowerCase());
    return matchCat && matchSearch;
  });
  const counts = {};
  RECIPES.forEach(r=>counts[r.cat]=(counts[r.cat]||0)+1);
  return `
    <div class="recipes-head">
      <a class="back-link" onclick="setRoute('home')">← Volver</a>
      <div class="eyebrow">RECETARIO POR ETAPA</div>
      <h1 style="font-size:34px;margin-top:6px;color:var(--forest)">Todas las recetas</h1>
      <div class="search-box">
        <span>🔍</span>
        <input id="searchInput" placeholder="Buscar por nombre o ingrediente..." value="${state.search}" oninput="setSearch(this.value)">
      </div>
      <div class="filter-row">
        <button class="${state.filter==='todas'?'active':''} pill" onclick="setFilter('todas')">Todas (${RECIPES.length})</button>
        <button class="pill ${state.filter==='favoritas'?'active':''}" onclick="setFilter('favoritas')">♡ Favoritas (${state.favorites.size})</button>
        ${Object.keys(CATS).map(k=>`<button class="${state.filter===k?'active':''} pill" onclick="setFilter('${k}')">${CATS[k].label} (${counts[k]||0})</button>`).join('')}
      </div>
    </div>
    ${list.length ? `<div class="result-count">${list.length} ${list.length===1?'receta encontrada':'recetas encontradas'}</div><div class="recipe-grid">${list.map(recipeCard).join('')}</div>` : emptyState()}
  `;
}
function emptyState(){
  return `<div class="empty-state"><div class="big">🍽️</div><p>Todavía no hay recetas por aquí.<br>Prueba otra palabra u otra etapa.</p></div>`;
}
function recipeCard(r){
  const c = CATS[r.cat];
  const fav = state.favorites.has(r.id);
  const art = r.img
    ? `<img class="r-img" src="${r.img}" alt="${r.name}" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;" onerror="imgFallback(this,'${r.icon}',46)">`
    : r.icon;
  return `<div class="r-card" onclick="openDetail(${r.id})">
    <div class="r-art" style="${artStyle(r.cat)}">
      ${art}
      ${r.img ? `<div class="r-shade"></div><div class="r-cat-chip" style="color:${c.color}">${c.label}</div>` : ''}
      <div class="fav" onclick="toggleFav(${r.id}, event)">${fav?'❤️':'🤍'}</div>
    </div>
    <div class="r-body">
      <div class="r-name">${r.name}</div>
      <div class="r-time">🕐 ${r.time}</div>
      <div class="r-age">👶 ${r.ageRec.replace(/^A partir de (los )?/,'')}</div>
    </div>
  </div>`;
}
/* Conteúdo interno do cartão de receita, sem o link de voltar nem o botão de baixar. */
function printCardHTML(r, opts){
  opts = opts || {};
  const showFav = opts.showFav !== false;
  const interactive = opts.interactive !== false;
  const fav = showFav && state.favorites.has(r.id);
  const heartHTML = (showFav && interactive)
    ? `<div class="card-banner-heart" onclick="toggleFav(${r.id}, event)" style="cursor:pointer;">${fav?'❤️':'♡'}</div>`
    : `<div class="card-banner-heart">${fav?'❤️':'♡'}</div>`;
  const photo = r.img
    ? `<img src="${r.img}" alt="${r.name}" crossorigin="anonymous" onerror="this.parentElement.innerHTML='<div class=\\'cp-fallback\\'>${r.icon}</div>'">`
    : `<div class="cp-fallback">${r.icon}</div>`;
  const metaRows = [
    {icon:'🕐', label:'Tiempo de preparación:', value:r.time},
    r.ageRec ? {icon:'👶', label:'Edad recomendada:', value:r.ageRec} : null,
    r.portions ? {icon:'🍽️', label:'Rinde:', value:r.portions} : null,
    r.kcal ? {icon:'🔥', label:'Calorías:', value:r.kcal} : null,
  ].filter(Boolean);
  return `
    <div class="card-banner">
      ${heartHTML}
      <h1>${r.name}</h1>
      <div class="cb-rule"></div>
    </div>
    <div class="card-meta-photo">
      <div class="card-meta-list">
        ${metaRows.map(m=>`
        <div class="card-meta-row">
          <div class="card-meta-badge">${m.icon}</div>
          <div class="card-meta-text">
            <div class="cm-label">${m.label}</div>
            <div class="cm-value">${m.value}</div>
          </div>
        </div>`).join('')}
      </div>
      <div class="card-photo-wrap">${photo}</div>
    </div>
    <div class="card-box-label">INGREDIENTES:</div>
    <ul class="card-ing-list">
      ${r.ingredients.map(i=>`<li><span class="leaf">🌿</span>${i}</li>`).join('')}
    </ul>
    <div class="card-divider"><span class="line"></span><span class="heart">♡</span><span class="line"></span></div>
    <div class="card-box-label">PREPARACIÓN:</div>
    <ul class="card-steps">
      ${r.steps.map((s,i)=>`<li><span class="step-n">${i+1}</span>${s}</li>`).join('')}
    </ul>
    ${(r.tip || r.substitutions) ? `
    <div class="card-tip-banner">
      <div class="ct-icon">💡</div>
      <div class="ct-text"><b>CONSEJO:</b> ${(r.tip || r.substitutions).replace(/(→)/g,'<b>$1</b>')}</div>
      <div class="ct-heart">♡</div>
    </div>` : ''}
    <div class="card-safety-banner">
      <div class="cs-icon">👶</div>
      <div class="cs-text">${r.alerta ? `<span class="cs-alerta">⚠️ ${r.alerta}</span>` : ''}<b>Recordatorio de seguridad:</b> sirve siempre con el bebé bien sentado y bajo supervisión constante, ajustando el corte y la textura según su desarrollo. Esta receta es educativa y <b>no sustituye la orientación de un pediatra o nutricionista</b>: consulta siempre al profesional que acompaña a tu bebé.</div>
    </div>`;
}
function cardStyleDetailSection(r, opts){
  opts = opts || {};
  const backAction = opts.backAction || "setRoute('recipes')";
  const backLabel = opts.backLabel || "← Todas las recetas";
  const showFav = opts.showFav !== false;
  const printId = `print-${r.id}`;
  const btnId = `dl-${r.id}`;
  const safeTitle = String(r.name).replace(/'/g,"’");
  return `
  <div class="card-recipe">
    <a class="back-link" onclick="${backAction}">${backLabel}</a>
    <div class="card-download-row">
      <button class="btn-download" id="${btnId}" onclick="downloadRecipePDF('${printId}','${btnId}','${safeTitle}')">📥 Descargar receta en PDF</button>
    </div>
    <div class="card-print-area" id="${printId}">
    ${printCardHTML(r, {showFav})}
    </div>
  </div>`;
}
function detailSection(){
  const r = RECIPES.find(x=>x.id===state.detailId);
  if(!r) return recipesSection();
  return cardStyleDetailSection(r, {backAction:"setRoute('recipes')", backLabel:"← Todas las recetas", showFav:true});
}
function bonusListSection(){
  const b = BONUSES.find(x=>x.n===state.bonusN);
  const pool = BONUS_RECIPES[state.bonusN] || [];
  const list = pool.filter(r=>(r.name.toLowerCase()+r.ingredients.join(' ').toLowerCase()).includes(state.bonusSearch.toLowerCase()));
  return `
    <div class="recipes-head">
      <a class="back-link" onclick="setRoute('home')">← Volver al inicio</a>
      <div class="eyebrow">${b.badge || ("BONO "+b.n)}</div>
      <h1 style="font-size:30px;margin-top:6px;color:var(--forest)">${b.title}</h1>
      <p class="lead" style="margin-top:8px;font-size:14.5px;">${b.text}</p>
      <div class="search-box">
        <span>🔍</span>
        <input id="bonusSearchInput" placeholder="Buscar por nombre o ingrediente..." value="${state.bonusSearch}" oninput="setBonusSearch(this.value)">
      </div>
    </div>
    ${list.length ? `<div class="result-count">${list.length} ${list.length===1?'receta encontrada':'recetas encontradas'}</div><div class="recipe-grid">${list.map(r=>bonusRecipeCard(r,b)).join('')}</div>` : emptyState()}
  `;
}
function bonusRecipeCard(r,b){
  const art = r.img
    ? `<img class="r-img" src="${r.img}" alt="${r.name}" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;" onerror="imgFallback(this,'${r.icon}',46)">`
    : r.icon;
  return `<div class="r-card" onclick="openBonusDetail(${b.n},${r.id})">
    <div class="r-art" style="background:${b.bg}">
      ${art}
      ${r.img ? `<div class="r-shade"></div><div class="r-cat-chip" style="color:${b.color}">${b.badge || ("BONO "+b.n)}</div>` : ''}
    </div>
    <div class="r-body">
      <div class="r-name">${r.name}</div>
      <div class="r-time">🕐 ${r.time}</div>
      <div class="r-age">👶 ${r.ageRec.replace(/^A partir de (los )?/,'')}</div>
    </div>
  </div>`;
}
function bonusDetailSection(){
  const b = BONUSES.find(x=>x.n===state.bonusN);
  const r = (BONUS_RECIPES[state.bonusN]||[]).find(x=>x.id===state.bonusDetailId);
  if(!r) return bonusListSection();
  return cardStyleDetailSection(r, {backAction:`openBonusList(${b.n})`, backLabel:`← Volver al bono ${b.n}`, showFav:false});
}
function guideSection(){
  const b = BONUSES.find(x=>x.n===state.bonusN);
  const g = GUIDES[state.bonusN];
  return `
  <div class="guide-wrap">
    <a class="back-link" onclick="setRoute('home')">← Volver al inicio</a>
    <div class="guide-hero" style="background:${g.gradient}">
      <div class="icon">${b.icon}</div>
      <h1>${b.title}</h1>
      <p>${b.text}</p>
    </div>
    <div class="guide-tips">
      ${g.tips.map((t,i)=>`<div class="guide-tip"><div class="n">${i+1}</div><div><h3>${t.title}</h3><p>${t.text}</p></div></div>`).join('')}
    </div>
    <div class="guide-note">Esta guía es educativa y no sustituye la evaluación del <b>pediatra de tu bebé</b>. Ante cualquier emergencia, busca atención médica de inmediato.</div>
  </div>`;
}
/* ---------------- CARDÁPIOS ---------------- */
function cardapioStripItem(recipeId){
  const r = RECIPES.find(x=>x.id===recipeId);
  if(!r) return `<div class="cs-item" style="background:var(--paper)">🍽️</div>`;
  return r.img
    ? `<div class="cs-item" style="background-image:url('${r.img}')"></div>`
    : `<div class="cs-item" style="background:${CATS[r.cat].bg}">${r.icon}</div>`;
}
function cardapiosSection(){
  return `
    <div class="recipes-head">
      <a class="back-link" onclick="setRoute('home')">← Volver</a>
      <div class="eyebrow">MENÚS LISTOS</div>
      <h1 style="font-size:34px;margin-top:6px;color:var(--forest)">Menús por etapa</h1>
      <p class="lead" style="margin-top:8px;font-size:14.5px;">Días completos, listos para usar: desayuno, media mañana, almuerzo, merienda y cena, pensados para la etapa de tu bebé.</p>
    </div>
    <div class="cardapio-grid" style="margin-top:26px;">
      ${CARDAPIOS.map(c=>`
        <div class="cardapio-card" onclick="openCardapio(${c.id})">
          <div class="cardapio-strip">
            ${MEAL_ORDER.map(m=>cardapioStripItem(c.meals[m])).join('')}
          </div>
          <div class="cardapio-body">
            <div class="cardapio-eyebrow">MENÚ ${c.id}</div>
            <div class="cardapio-title">${c.title}</div>
            <div class="cardapio-sub">${c.sub}</div>
          </div>
        </div>
      `).join('')}
    </div>`;
}
function mealSlotRow(mealKey, recipeId){
  const r = RECIPES.find(x=>x.id===recipeId);
  if(!r) return '';
  const art = r.img
    ? `style="background-image:url('${r.img}')"`
    : `style="background:${CATS[r.cat].bg}"`;
  return `<div class="meal-slot" onclick="openDetail(${r.id})">
    <div class="ms-art" ${art}>${r.img ? '' : r.icon}</div>
    <div class="ms-info">
      <div class="ms-label">${MEAL_LABELS[mealKey]}</div>
      <div class="ms-name">${r.name}</div>
      <div class="ms-time">🕐 ${r.time}</div>
    </div>
  </div>`;
}
function cardapioDetailSection(){
  const c = CARDAPIOS.find(x=>x.id===state.cardapioId);
  if(!c) return cardapiosSection();
  return `
  <div class="detail" style="max-width:640px;margin:0 auto;padding-top:34px;">
    <a class="back-link" onclick="setRoute('cardapios')">← Todos los menús</a>
    <div class="eyebrow">MENÚ ${c.id}</div>
    <h1 style="font-size:30px;">${c.title}</h1>
    <p class="lead" style="margin-top:8px;font-size:14.5px;max-width:none;">${c.sub}</p>
    <div style="margin-top:24px;">
      ${MEAL_ORDER.map(m=>mealSlotRow(m, c.meals[m])).join('')}
    </div>
  </div>`;
}
/* ---------------- LISTA DE COMPRAS ---------------- */
function openListModal(){
  document.getElementById('listModal').classList.add('open');
  renderModal();
}
function closeListModal(){
  document.getElementById('listModal').classList.remove('open');
  render();
}
function clearListSelection(){ state.listSelected.clear(); renderModal(); }
function setModalSearch(v){ state.listModalSearch=v; renderModal(); }
function setModalFilter(f){ state.listModalFilter=f; renderModal(); }
function toggleListSelect(id){
  state.listSelected.has(id) ? state.listSelected.delete(id) : state.listSelected.add(id);
  renderModal();
}
function renderModal(){
  const filters = ['todas', ...Object.keys(CATS)];
  document.getElementById('modalFilters').innerHTML = filters.map(f=>{
    const count = f==='todas' ? RECIPES.length : RECIPES.filter(r=>r.cat===f).length;
    const label = f==='todas' ? 'Todas' : CATS[f].label;
    return `<button class="${state.listModalFilter===f?'active':''} pill" onclick="setModalFilter('${f}')">${label} (${count})</button>`;
  }).join('');
  const list = RECIPES.filter(r=>{
    const matchCat = state.listModalFilter==='todas' ? true : r.cat===state.listModalFilter;
    const matchSearch = (r.name.toLowerCase()+r.ingredients.join(' ').toLowerCase()).includes(state.listModalSearch.toLowerCase());
    return matchCat && matchSearch;
  });
  document.getElementById('modalGrid').innerHTML = `<div class="modal-grid">${list.map(r=>{
    const sel = state.listSelected.has(r.id);
    const art = r.img
      ? `<img src="${r.img}" alt="${r.name}" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;" onerror="imgFallback(this,'${r.icon}',34)">`
      : r.icon;
    return `<div class="modal-card ${sel?'selected':''}" onclick="toggleListSelect(${r.id})">
      <div class="modal-art" style="${artStyle(r.cat)}">${art}<div class="modal-check">✓</div></div>
      <div class="modal-info">
        <div class="modal-cat" style="color:${CATS[r.cat].color}">${CATS[r.cat].label}</div>
        <div class="modal-name">${r.name}</div>
      </div>
    </div>`;
  }).join('') || '<div class="empty-state" style="grid-column:1/-1"><div class="big">🍽️</div><p>No se encontró ninguna receta.</p></div>'}</div>`;
  document.getElementById('modalCount').textContent = `${state.listSelected.size} receta${state.listSelected.size===1?'':'s'} seleccionada${state.listSelected.size===1?'':'s'}`;
}
function normalizeIng(str){ return str.trim().toLowerCase().replace(/\s+/g,' '); }
function generateShoppingList(){
  const chosen = RECIPES.filter(r=>state.listSelected.has(r.id));
  const seen = new Map();
  chosen.forEach(r=>{
    r.ingredients.forEach(ing=>{
      const key = normalizeIng(ing);
      if(!seen.has(key)) seen.set(key, {text:ing, from:new Set()});
      seen.get(key).from.add(r.name);
    });
  });
  state.generatedList = Array.from(seen.values()).sort((a,b)=>a.text.localeCompare(b.text,'es'));
  state.checkedItems = new Set();
  render();
}
function toggleChecked(idx){
  state.checkedItems.has(idx) ? state.checkedItems.delete(idx) : state.checkedItems.add(idx);
  render();
}
function resetList(){ state.generatedList=null; render(); }
function listaSection(){
  if(!state.generatedList){
    const n = state.listSelected.size;
    return `
      <div class="list-summary">
        <div class="list-cart-icon">🛒</div>
        <h2>${n>0?`${n} receta${n===1?'':'s'} seleccionada${n===1?'':'s'}`:'Ninguna receta seleccionada'}</h2>
        <p>${n>0?'Lista para generar tu lista de compras.':'Elige las recetas de la semana para generar tu lista automáticamente.'}</p>
        <div class="list-summary-actions">
          <button class="btn-outline" onclick="openListModal()">+ Ajustar recetas</button>
          <button class="btn-terracotta" ${n===0?'disabled':''} onclick="${n>0?'generateShoppingList()':''}">Generar lista</button>
        </div>
      </div>`;
  }
  const total = state.generatedList.length;
  const done = state.checkedItems.size;
  return `
    <div class="list-header">
      <div>
        <a class="back-link" onclick="resetList()">← Nueva lista</a>
        <h1>Tu lista de compras</h1>
        <div class="list-progress">${done} DE ${total} ARTÍCULOS MARCADOS · ${state.listSelected.size} RECETAS</div>
      </div>
      <div class="list-actions">
        <button class="btn-outline" onclick="openListModal()">+ Ajustar recetas</button>
      </div>
    </div>
    <div class="list-groups">
      <div class="list-items">
        ${state.generatedList.map((item,idx)=>{
          const checked = state.checkedItems.has(idx);
          const fromLabel = item.from.size>1 ? `${item.from.size} recetas` : Array.from(item.from)[0];
          return `<div class="list-item ${checked?'checked':''}" onclick="toggleChecked(${idx})">
            <div class="box">${checked?'✓':''}</div>
            <span class="txt">${item.text}</span>
            <span class="from">${fromLabel}</span>
          </div>`;
        }).join('')}
      </div>
    </div>`;
}
function setFilter(f){ state.filter=f; render(); }
function setSearch(v){ state.search=v; render(); keepFocus('searchInput'); }
function render(){
  const app = document.getElementById('app');
  if(state.route==='home') app.innerHTML = heroSection();
  else if(state.route==='recipes') app.innerHTML = recipesSection();
  else if(state.route==='detail') app.innerHTML = detailSection();
  else if(state.route==='lista') app.innerHTML = listaSection();
  else if(state.route==='bonusList') app.innerHTML = bonusListSection();
  else if(state.route==='bonusDetail') app.innerHTML = bonusDetailSection();
  else if(state.route==='guide') app.innerHTML = guideSection();
  else if(state.route==='cardapios') app.innerHTML = cardapiosSection();
  else if(state.route==='cardapioDetail') app.innerHTML = cardapioDetailSection();
}
setRoute('home');
/* Botão de voltar ao topo: aparece só depois que a rolagem passa da primeira tela. */
(function(){
  const b = document.getElementById('toTop');
  if(!b) return;
  const upd = () => b.classList.toggle('show', window.scrollY > 600);
  window.addEventListener('scroll', upd, {passive:true});
  upd();
})();
/* Popup de avaliação: aparece uma única vez, depois de um tempinho navegando,
   só se a pessoa ainda não avaliou nem fechou o popup antes. */
(function(){
  let jaVisto = false;
  try{ jaVisto = localStorage.getItem('app_popup_seen') === '1'; }catch(e){}
  if(!jaVisto && state.rating === 0){
    setTimeout(()=>{
      if(state.rating === 0) openRatingModal();
    }, 12000);
  }
})();
