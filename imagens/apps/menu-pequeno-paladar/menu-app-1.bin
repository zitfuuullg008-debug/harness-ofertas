(function(){
document.title="Menú Pequeño Paladar";
var hd=document.head;
hd.insertAdjacentHTML("beforeend","<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">");
hd.insertAdjacentHTML("beforeend","<link rel=\"preconnect\" href=\"https://media.atomicatmedia.net\">");
hd.insertAdjacentHTML("beforeend","<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap\" rel=\"stylesheet\">");
var st=document.createElement("style");st.textContent=":root{--forest:#D97B4F;--forest-light:#EFA47C;--forest-deep:#8B4A2B;--cream:#FFF8F0;--paper:#FDEEE0;--paper-dark:#F7DFC8;--terracotta:#6E9E6F;--terracotta-light:#A9C9A0;--ink:#2B2115;--ink-soft:#6E5D47;--sage:#9BB98C;--line:rgba(43,33,21,0.1);--c-m6:#E0A06B;--c-m6-bg:#FBEADC;--c-m8:#C79433;--c-m8-bg:#F6ECD3;--c-m10:#5F8C60;--c-m10-bg:#E2EEE0;--c-m12:#4F7C9C;--c-m12-bg:#E0EAF1;--c-m18:#B96C80;--c-m18-bg:#F5E1E7;--b1:#C97088;--b1-bg:#F8E4EA;--b2:#DB8557;--b2-bg:#FBEBDF;--b3:#BF9330;--b3-bg:#F6ECD4;--b8:#4C86B8;--b8-bg:#E0EBF4;--b9:#C9821C;--b9-bg:#F8EBD3;--b10:#8E5A97;--b10-bg:#EEE2F1;--b11:#C0603F;--b11-bg:#F7E2DA;--b12:#3F8E86;--b12-bg:#DDEEEC;--b13:#A8544E;--b13-bg:#F5E0DE;--b7:#5D7F4C;--b7-bg:#E3EEDD;--bg-guide1:#B15748;--bg-guide1-bg:#F5DEDA;--bg-guide2:#47807F;--bg-guide2-bg:#DCEBEB;--bg-guide3:#7C6BA3;--bg-guide3-bg:#E9E3F2;--radius:18px;--radius-sm:10px;--shadow:0 10px 30px -12px rgba(140,74,38,0.22);--shadow-sm:0 4px 14px -6px rgba(140,74,38,0.16)}*{box-sizing:border-box}body,html{margin:0;padding:0}body{background:var(--cream);color:var(--ink);font-family:Manrope,sans-serif;-webkit-font-smoothing:antialiased;min-height:100vh}.serif,h1,h2,h3{font-family:Fraunces,serif;font-weight:600;letter-spacing:-.01em;margin:0}.eyebrow{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}a{text-decoration:none;color:inherit}button{font-family:inherit;cursor:pointer;border:none;background:0 0}::selection{background:var(--terracotta-light);color:var(--forest-deep)}.nav{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:16px 32px;background:rgba(255,248,240,.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}.logo{font-family:Fraunces,serif;font-weight:700;font-size:19px;color:var(--forest)}.logo span{color:var(--terracotta)}.nav-links{display:flex;gap:4px;align-items:center}.nav-links button{padding:9px 16px;border-radius:999px;font-size:14px;font-weight:600;color:var(--ink-soft);transition:all .18s ease}.nav-links button:hover{background:var(--paper);color:var(--ink)}.nav-links button.active{background:var(--forest);color:#fff}@media(max-width:820px){.nav{padding:14px 18px}.nav-links{display:none}}.bottom-nav{display:none}@media(max-width:820px){.bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:60;background:rgba(255,248,240,.97);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:8px 6px calc(8px + env(safe-area-inset-bottom));box-shadow:0 -6px 18px -10px rgba(0,0,0,.15)}.bottom-nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 2px;border-radius:12px;color:var(--ink-soft);transition:color .15s ease,background .15s ease}.bottom-nav .bn-icon{font-size:20px;line-height:1}.bottom-nav .bn-label{font-size:10.5px;font-weight:700}.bottom-nav button.active{color:var(--forest);background:var(--paper)}}.page{max-width:1180px;margin:0 auto;padding:0 32px 100px}@media(max-width:820px){.page{padding:0 18px 96px}}.hero{display:grid;grid-template-columns:1fr;gap:24px;align-items:center;padding:64px 0 40px}@media(max-width:900px){.hero{padding:36px 0 20px;gap:20px}}.hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--paper);padding:6px 14px;border-radius:999px;margin-bottom:22px}.hero-eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--terracotta)}.hero h1{font-size:clamp(38px,5.2vw,60px);line-height:1.05;color:var(--forest)}.hero h1 em{font-style:italic;color:var(--terracotta);font-weight:500}.hero p.lead{font-size:17px;color:var(--ink-soft);max-width:460px;margin-top:18px;line-height:1.6}.stat-row{display:flex;gap:36px;margin-top:34px;flex-wrap:wrap}.stat b{font-family:Fraunces,serif;font-size:30px;color:var(--forest);display:block;font-weight:600}.stat span{font-size:12.5px;color:var(--ink-soft);font-family:'Space Mono',monospace;letter-spacing:.04em}.section-label{text-align:center;margin:8px 0 26px}.section-label .eyebrow{display:block}.collections{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}@media(max-width:980px){.collections{grid-template-columns:repeat(3,1fr)}}@media(max-width:700px){.collections{grid-template-columns:repeat(2,1fr)}}@media(max-width:440px){.collections{grid-template-columns:1fr}}.coll-card{border-radius:var(--radius);overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:var(--shadow-sm);display:flex;flex-direction:column;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease}.coll-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.coll-card:hover .coll-photo{transform:scale(1.05)}.coll-media{position:relative;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;padding:16px;background:radial-gradient(circle at 50% 38%,#fff 0,var(--paper) 82%)}.coll-photo{max-width:100%;max-height:100%;object-fit:contain;display:block;filter:drop-shadow(0 12px 20px rgba(140,74,38,.3));transition:transform .3s ease}.coll-emblem{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:clamp(52px,13vw,86px);line-height:1;filter:drop-shadow(0 12px 20px rgba(140,74,38,.22))}.coll-badge{position:absolute;top:10px;left:10px;background:var(--forest);color:#fff;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.06em;padding:5px 10px;border-radius:999px;font-weight:700;box-shadow:0 3px 10px -4px rgba(0,0,0,.35)}.coll-body{padding:14px 16px 18px;border-top:1px solid var(--line);flex:1;display:flex;flex-direction:column;justify-content:flex-start;gap:4px}.coll-title{font-family:Fraunces,serif;color:var(--forest-deep);font-size:16.5px;line-height:1.18;font-weight:700;letter-spacing:-.01em}.coll-sub{color:var(--ink-soft);font-size:11px;font-family:'Space Mono',monospace;letter-spacing:.03em}.recipes-head{padding-top:40px}.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--ink-soft);font-size:13.5px;font-weight:600;min-height:44px;padding-right:14px;margin-bottom:6px}.back-link:hover{color:var(--forest)}.search-box{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:13px 20px;margin:22px 0 16px;box-shadow:var(--shadow-sm)}.search-box input{border:none;outline:0;font-size:14.5px;width:100%;background:0 0;font-family:Manrope}.filter-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:30px}.pill{padding:9px 16px;border-radius:999px;font-size:13.5px;font-weight:700;background:#fff;border:1px solid var(--line);color:var(--ink-soft);display:flex;align-items:center;gap:6px;transition:all .15s ease}.pill:hover{border-color:var(--forest)}.pill.active{background:var(--forest);color:#fff;border-color:var(--forest)}.recipe-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}@media(max-width:980px){.recipe-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.recipe-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:460px){.recipe-grid{grid-template-columns:1fr}}.r-card{background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:transform .18s ease,box-shadow .18s ease;cursor:pointer}.r-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.r-art{aspect-ratio:4/3;position:relative;display:flex;align-items:center;justify-content:center;font-size:46px}.r-art .fav{position:absolute;top:10px;right:10px;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.85);display:flex;align-items:center;justify-content:center;font-size:15px;transition:transform .15s ease;z-index:2}.r-art .fav:hover{transform:scale(1.1)}.r-body{padding:14px 15px 17px}.r-cat{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.06em;font-weight:700;text-transform:uppercase}.r-name{font-family:Fraunces,serif;font-size:16.5px;font-weight:600;margin-top:5px;line-height:1.2}.r-time{font-size:12px;color:var(--ink-soft);margin-top:8px;display:flex;align-items:center;gap:5px}.empty-state{text-align:center;padding:60px 20px;color:var(--ink-soft)}.empty-state .big{font-size:38px;margin-bottom:10px}.list-summary{display:flex;flex-direction:column;align-items:center;text-align:center;padding:90px 20px 40px}.list-cart-icon{width:74px;height:74px;border-radius:50%;background:var(--paper);display:flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:22px}.list-summary h2{font-family:Fraunces,serif;font-size:24px;color:var(--forest)}.list-summary p{color:var(--ink-soft);font-size:14px;margin:8px 0 26px}.list-summary-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}.btn-outline{background:#fff;border:1px solid var(--line);color:var(--ink);padding:11px 22px;border-radius:999px;font-weight:700;font-size:14px;display:inline-flex;align-items:center;gap:6px;transition:border-color .15s ease}.btn-outline:hover{border-color:var(--forest)}.btn-terracotta{background:var(--terracotta);color:#fff;padding:14px 22px;border-radius:999px;min-height:44px;font-weight:700;font-size:14px;white-space:nowrap;transition:transform .15s ease,background .15s}.btn-terracotta:hover{background:#5d8a5e;transform:translateY(-1px)}.btn-terracotta[disabled]{background:var(--paper-dark);color:var(--ink-soft);cursor:not-allowed}.btn-terracotta[disabled]:hover{transform:none;background:var(--paper-dark)}.list-header{padding-top:36px;display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px}.list-header h1{font-size:30px;color:var(--forest)}.list-progress{font-family:'Space Mono',monospace;font-size:12px;color:var(--ink-soft);margin-top:6px}.list-actions{display:flex;gap:10px}.list-groups{margin-top:26px;display:flex;flex-direction:column;gap:22px}.list-items{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden}.list-item{display:flex;align-items:center;gap:13px;padding:14px 18px;border-bottom:1px solid var(--line);font-size:14.5px;cursor:pointer}.list-item:last-child{border-bottom:none}.list-item .box{width:21px;height:21px;border-radius:6px;border:2px solid var(--sage);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;transition:all .15s ease}.list-item.checked .box{background:var(--forest);border-color:var(--forest)}.list-item.checked span.txt{text-decoration:line-through;color:var(--ink-soft)}.list-item .from{font-size:11px;color:var(--ink-soft);margin-left:auto;font-family:'Space Mono',monospace;flex-shrink:0;padding-left:8px}.modal-overlay{position:fixed;inset:0;background:rgba(30,20,12,.55);z-index:100;display:none;align-items:center;justify-content:center;padding:20px}.modal-overlay.open{display:flex}.modal-box{background:var(--cream);border-radius:22px;max-width:760px;width:100%;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 30px 60px -20px rgba(0,0,0,.4);overflow:hidden}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;padding:24px 26px 0}.modal-close{width:34px;height:34px;border-radius:50%;background:var(--paper);font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.modal-search-wrap{padding:0 26px}.modal-body{overflow-y:auto;padding:4px 26px 20px;flex:1}.modal-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}@media(max-width:600px){.modal-grid{grid-template-columns:repeat(2,1fr)}}.modal-card{background:#fff;border-radius:14px;overflow:hidden;box-shadow:var(--shadow-sm);cursor:pointer;border:2px solid transparent;transition:border-color .15s ease}.modal-card.selected{border-color:var(--forest)}.modal-art{aspect-ratio:4/3;position:relative;display:flex;align-items:center;justify-content:center;font-size:34px}.modal-check{position:absolute;top:8px;right:8px;width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.9);border:2px solid rgba(0,0,0,.15);display:flex;align-items:center;justify-content:center;font-size:12px;color:transparent;z-index:2}.modal-card.selected .modal-check{background:var(--forest);border-color:var(--forest);color:#fff}.modal-info{padding:9px 11px 12px}.modal-cat{font-family:'Space Mono',monospace;font-size:9px;font-weight:700;letter-spacing:.05em;text-transform:uppercase}.modal-name{font-size:13px;font-weight:700;margin-top:3px;line-height:1.25}.modal-foot{display:flex;justify-content:space-between;align-items:center;padding:16px 26px;border-top:1px solid var(--line);background:#fff}.guide-wrap{max-width:640px;margin:0 auto;padding-top:34px}.guide-hero{border-radius:22px;padding:34px 28px;color:#fff;margin-bottom:28px;box-shadow:var(--shadow)}.guide-hero .icon{font-size:40px;margin-bottom:12px}.guide-hero h1{font-size:25px;color:#fff}.guide-hero p{margin-top:8px;font-size:14.5px;color:rgba(255,255,255,.85);line-height:1.6}.guide-tips{display:flex;flex-direction:column;gap:14px}.guide-tip{display:flex;gap:14px;background:#fff;border-radius:var(--radius);padding:18px 20px;box-shadow:var(--shadow-sm)}.guide-tip .n{width:30px;height:30px;border-radius:50%;background:var(--paper);color:var(--forest);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;font-family:Fraunces,serif}.guide-tip h3{font-size:15.5px;color:var(--forest);margin-bottom:4px}.guide-tip p{font-size:13.5px;color:var(--ink-soft);line-height:1.6;margin:0}.guide-note{background:var(--paper);border-radius:14px;padding:16px 18px;font-size:13px;color:var(--ink-soft);line-height:1.6;margin-top:18px}.guide-note b{color:var(--forest-deep)}.cardapio-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}@media(max-width:700px){.cardapio-grid{grid-template-columns:1fr}}.cardapio-card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);overflow:hidden;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}.cardapio-card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.cardapio-strip{display:grid;grid-template-columns:repeat(5,1fr);height:90px}.cardapio-strip .cs-item{background-size:cover;background-position:center;position:relative;display:flex;align-items:center;justify-content:center;font-size:20px;border-right:2px solid var(--cream)}.cardapio-strip .cs-item:last-child{border-right:none}.cardapio-body{padding:16px 18px}.cardapio-eyebrow{font-family:'Space Mono',monospace;font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--terracotta)}.cardapio-title{font-family:Fraunces,serif;font-size:19px;font-weight:600;color:var(--forest);margin-top:4px}.cardapio-sub{font-size:13px;color:var(--ink-soft);margin-top:5px;line-height:1.4}.meal-slot{display:flex;align-items:center;gap:14px;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:14px;margin-bottom:14px;cursor:pointer;transition:transform .15s ease}.meal-slot:hover{transform:translateY(-2px)}.meal-slot .ms-art{width:64px;height:64px;border-radius:12px;flex-shrink:0;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;font-size:26px}.meal-slot .ms-info{flex:1;min-width:0}.meal-slot .ms-label{font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--terracotta)}.meal-slot .ms-name{font-family:Fraunces,serif;font-size:16px;font-weight:600;color:var(--forest);margin-top:3px}.meal-slot .ms-time{font-size:12px;color:var(--ink-soft);margin-top:3px}.card-recipe{max-width:640px;margin:0 auto;padding-top:22px}.card-banner{position:relative;background:linear-gradient(100deg,#efa47c,#d97b4f);border-radius:26px 8px 26px 8px;padding:26px 34px 30px;margin-bottom:22px;box-shadow:0 12px 28px -14px rgba(140,74,38,.5)}.card-banner-heart{position:absolute;top:14px;right:18px;font-size:19px;opacity:.9;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.28);display:flex;align-items:center;justify-content:center}.card-banner h1{font-family:Caveat,cursive;font-weight:700;color:#2b2115;font-size:clamp(30px,7vw,50px);line-height:1.08;margin:0;padding-right:36px;text-shadow:0 1px 0 rgba(255,255,255,.25)}.card-banner .cb-rule{width:100px;height:3px;background:#2b2115;opacity:.5;border-radius:3px;margin-top:10px}.card-meta-photo{display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center;margin-bottom:22px}.card-meta-list{display:flex;flex-direction:column;gap:20px}.card-meta-row{display:flex;align-items:center;gap:14px}.card-meta-badge{width:52px;height:52px;border-radius:50%;border:2.5px solid #e8946a;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:22px;color:#c9703f;background:#fff}.card-meta-text .cm-label{font-size:14.5px;color:var(--ink);font-weight:500}.card-meta-text .cm-value{font-size:15px;color:var(--ink);font-weight:700;margin-top:1px}.card-photo-wrap{position:relative;aspect-ratio:1/1;border-radius:50%;overflow:hidden;box-shadow:0 10px 26px -10px rgba(0,0,0,.35);border:6px solid #fff;justify-self:center;width:100%;max-width:280px}.card-photo-wrap img{width:100%;height:100%;object-fit:cover;display:block}.card-photo-wrap .cp-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:64px;background:var(--paper)}@media(max-width:560px){.card-recipe{padding-top:16px}.card-banner{padding:22px 26px 26px;border-radius:22px 8px 22px 8px}.card-meta-photo{grid-template-columns:1fr;gap:0;margin-bottom:20px}.card-photo-wrap{order:-1;max-width:200px;margin:-28px auto 22px;border-width:5px;position:relative;z-index:2}.card-meta-list{flex-direction:row;flex-wrap:wrap;gap:14px 20px;justify-content:center}.card-meta-row{flex:1 1 150px;min-width:150px}.card-meta-badge{width:44px;height:44px;font-size:19px}.card-meta-text .cm-label{font-size:12.5px}.card-meta-text .cm-value{font-size:14px}}.card-box-label{display:inline-block;border:2.5px solid #e8946a;border-radius:12px;padding:10px 20px;font-family:Manrope;font-weight:800;font-size:15.5px;color:#2b2115;letter-spacing:.01em;margin-bottom:16px;background:#fff8f0}.card-ing-list{list-style:none;margin:0 0 26px;padding:0}.card-ing-list li{display:flex;align-items:flex-start;gap:10px;font-size:15px;color:var(--ink);padding:7px 0;line-height:1.4}.card-ing-list li .leaf{color:#5f8c60;font-size:15px;flex-shrink:0;margin-top:1px}.card-divider{display:flex;align-items:center;justify-content:center;gap:14px;margin:8px 0 26px;color:#e8946a}.card-divider .line{flex:1;max-width:90px;height:1.5px;background:#e8946a;opacity:.5}.card-divider .heart{font-size:15px}.card-steps{list-style:none;margin:0 0 26px;padding:0}.card-steps li{display:flex;align-items:flex-start;gap:11px;font-size:15px;color:var(--ink);padding:8px 0;line-height:1.5}.card-steps li .leaf{color:#5f8c60;font-size:16px;flex-shrink:0;margin-top:2px}.card-tip-banner{display:flex;align-items:center;gap:16px;background:linear-gradient(100deg,#efa47c,#d97b4f);border-radius:16px;padding:16px 22px;margin-bottom:20px;box-shadow:0 10px 22px -12px rgba(140,74,38,.45)}.card-tip-banner .ct-icon{font-size:26px;flex-shrink:0}.card-tip-banner .ct-text{font-size:14.5px;color:#2b2115;line-height:1.5}.card-tip-banner .ct-text b{font-weight:800}.card-tip-banner .ct-heart{margin-left:auto;font-size:18px;color:#2b2115;opacity:.8;flex-shrink:0}.card-safety-banner{display:flex;align-items:flex-start;gap:14px;background:var(--paper);border-radius:16px;padding:16px 20px;margin-bottom:30px;border:1px dashed var(--line)}.card-safety-banner .cs-icon{font-size:22px;flex-shrink:0}.card-safety-banner .cs-text{font-size:13px;color:var(--ink-soft);line-height:1.55}.card-safety-banner .cs-text b{color:var(--forest-deep)}.rating-card{background:#fff;border-radius:22px;box-shadow:var(--shadow-sm);padding:32px 28px;text-align:center;margin:44px 0 36px;border:1px solid var(--line)}.rating-card .rc-icon{font-size:34px;margin-bottom:10px}.rating-card h3{font-family:Fraunces,serif;font-size:21px;color:var(--forest);margin-bottom:8px}.rating-card p{font-size:14px;color:var(--ink-soft);max-width:420px;margin:0 auto 18px;line-height:1.55}.rc-stars{display:flex;justify-content:center;gap:6px;margin-bottom:6px}.rc-star{font-size:36px;line-height:1;cursor:pointer;color:var(--paper-dark);transition:transform .12s ease,color .12s ease;background:0 0;border:none;padding:2px}.rc-star:hover{transform:scale(1.15)}.rc-star.filled{color:#eda23e}.rc-thanks{margin-top:16px;padding:16px 20px;border-radius:14px;background:var(--paper);font-size:13.5px;color:var(--ink);line-height:1.55}.rc-thanks b{color:var(--terracotta)}.rating-modal-box{background:var(--cream);border-radius:22px;max-width:400px;width:100%;padding:32px 26px 26px;text-align:center;position:relative;box-shadow:0 30px 60px -20px rgba(0,0,0,.4)}.rating-modal-box .rm-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:var(--paper);font-size:14px;display:flex;align-items:center;justify-content:center}.rating-modal-box .rc-star{font-size:32px}.main-feature{position:relative;border-radius:26px;overflow:hidden;cursor:pointer;display:grid;grid-template-columns:0.9fr 1.1fr;gap:28px;align-items:center;padding:30px 34px;background:linear-gradient(135deg,#a85b33 0,var(--forest-deep) 55%,#6e3a20 100%);box-shadow:0 20px 44px -18px rgba(140,74,38,.45);margin-top:8px;margin-bottom:22px;transition:transform .2s ease,box-shadow .2s ease}.main-feature::after{content:'';position:absolute;top:-60px;right:-40px;width:260px;height:260px;border-radius:50%;background:rgba(255,255,255,.05);pointer-events:none}.main-feature:hover{transform:translateY(-3px);box-shadow:0 26px 54px -18px rgba(140,74,38,.6)}.main-feature:hover .main-feature-photo{transform:translateY(-4px) scale(1.03)}.main-feature-photo{width:100%;max-width:270px;justify-self:center;display:block;object-fit:contain;border-radius:12px;filter:drop-shadow(0 18px 30px rgba(0,0,0,.45));transition:transform .35s ease;position:relative;z-index:1}.main-feature-content{position:relative;z-index: