/* ==================== DADOS ==================== */
const CATS = {"m6":{"label":"6 a 7 meses","color":"var(--c-m6)","bg":"var(--c-m6-bg)"},"m8":{"label":"8 a 9 meses","color":"var(--c-m8)","bg":"var(--c-m8-bg)"},"m10":{"label":"10 a 11 meses","color":"var(--c-m10)","bg":"var(--c-m10-bg)"},"m12":{"label":"12 a 18 meses","color":"var(--c-m12)","bg":"var(--c-m12-bg)"},"m18":{"label":"18 a 24 meses","color":"var(--c-m18)","bg":"var(--c-m18-bg)"}};
/* Cada receita traz a idade recomendada e, quando existe risco específico, um `alerta`
   próprio — conferidos contra o Guia Alimentar do Ministério da Saúde para menores de
   2 anos e o guia de alimentação complementar da Sociedade Brasileira de Pediatria. */
const RECIPES = [{"id":1,"name":"Puré de Calabaza con Pollo Deshebrado","cat":"m6","icon":"🎃","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/36590620/pexels-photo-36590620.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de calabaza (zapallo) cocida","2 cucharadas de pollo cocido y deshebrado muy fino","2 cucharadas del agua de cocción, o la que haga falta"],"tip":"Pollo → filete de pescado blanco sin espinas bien cocido, en la misma cantidad, revisando siempre que no quede ninguna espina.","steps":["Cocina la calabaza en cubos hasta que un tenedor la atraviese fácilmente, unos 15 minutos.","Cocina el pollo hasta que no quede ninguna parte rosada por dentro y deshébralo muy fino con los dedos o con dos tenedores.","Aplasta la calabaza todavía caliente con un tenedor, sin usar licuadora, hasta que quede un puré espeso que se sostiene en la cuchara sin escurrir.","Mezcla el pollo deshebrado con el puré y ajusta la consistencia con cucharadas del agua de cocción.","Prueba la temperatura en el dorso de tu mano para asegurarte de que está tibio, nunca caliente.","Sírvelo en cucharadas pequeñas, con el bebé bien sentado y supervisado."],"alerta":"Deshebra bien el pollo, sin dejar hebras gruesas, para reducir el riesgo de atragantamiento."},{"id":2,"name":"Puré de Camote con Zanahoria","cat":"m6","icon":"🍠","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/5718130/pexels-photo-5718130.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 camote (batata) pequeño, pelado y en cubos","1/2 zanahoria pequeña, pelada y en cubos","Agua, la necesaria para cubrir al cocinar"],"tip":"Camote → papa cocida, en el mismo volumen.","steps":["Pon el camote y la zanahoria en cubos en una olla, cúbrelos con agua y cocina hasta que un tenedor los atraviese sin resistencia, unos 15 minutos.","Escurre las verduras y guarda un poco del agua de cocción.","Aplasta todo junto con un tenedor, sin colar y sin licuadora, hasta formar un puré espeso.","Agrega cucharadas del agua reservada hasta que la papilla quede cremosa, pero firme en la cuchara.","Prueba la temperatura en el dorso de la mano antes de servir.","Ofrécela en cucharadas pequeñas, con el bebé sentado a la mesa."]},{"id":3,"name":"Puré de Manzana Cocida con Canela","cat":"m6","icon":"🍎","time":"~15 min","kcal":"60 kcal (estimado)","img":"https://images.pexels.com/photos/5440962/pexels-photo-5440962.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 manzana pequeña, pelada y sin semillas, en cubos","2 cucharadas de agua para cocinar","1 pizca muy ligera de canela en polvo"],"tip":"Manzana → pera cocida, con la misma preparación y cantidad.","steps":["Corta la manzana en cubos pequeños, sin la cáscara ni las semillas.","Cocínala en una olla con el agua, a fuego bajo y tapada, hasta que la manzana se ablande por completo, unos 8 minutos.","Escurre el exceso de líquido, si hay, para que el puré no quede aguado.","Aplasta bien con un tenedor hasta formar un puré espeso, sin trozos duros.","Mezcla la pizca de canela, que da sabor sin necesidad de azúcar.","Sírvelo tibio o a temperatura ambiente, nunca caliente: pruébalo en el dorso de la mano."]},{"id":4,"name":"Papilla de Banana Aplastada con Avena","cat":"m6","icon":"🍌","time":"~5 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/9226325/pexels-photo-9226325.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 banana (plátano) madura","1 cucharada de avena en hojuelas finas","1 cucharada de agua filtrada"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad.","steps":["Aplasta la banana con un tenedor hasta formar un puré espeso, sin trozos duros.","Mezcla la avena en hojuelas finas y el agua, integrando bien.","Deja reposar 2 minutos para que la avena se hidrate y quede suave.","Revisa la consistencia: debe quedar firme en la cuchara, sin escurrir.","Sírvela enseguida, a temperatura ambiente, en cucharadas pequeñas."]},{"id":5,"name":"Papilla de Calabacita con Carne Molida","cat":"m6","icon":"🥒","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/4899794/pexels-photo-4899794.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 calabacita (zucchini) pequeña, pelada y en cubos","2 cucharadas de carne molida magra","2 cucharadas del agua de cocción, o la que haga falta"],"tip":"Carne molida → pollo cocido y deshebrado muy fino, en la misma cantidad.","steps":["Cocina la calabacita en cubos hasta que quede muy suave, unos 10 minutos.","En otra olla, cocina la carne molida por completo, sin partes rosadas, revolviendo hasta que suelte el líquido y se seque.","Desmenuza la carne todavía más con un tenedor, deshaciendo cualquier trozo más firme.","Aplasta la calabacita junto con la carne hasta formar una papilla pareja y espesa.","Ajusta la consistencia con el agua de cocción, hasta que quede firme en la cuchara.","Sírvela tibia, probando la temperatura en el dorso de la mano."],"alerta":"Cocina bien la carne hasta que no quede ninguna parte rosada, para evitar contaminación."},{"id":6,"name":"Puré de Pera Cocida","cat":"m6","icon":"🍐","time":"~15 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/12348226/pexels-photo-12348226.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 pera pequeña, madura, pelada y sin semillas, en cubos","2 cucharadas de agua para cocinar"],"tip":"Pera → manzana cocida, con la misma preparación.","steps":["Corta la pera en cubos pequeños y del mismo tamaño, quitando toda la cáscara y las semillas antes de cocinar.","Cocínala a fuego bajo con el agua hasta que quede muy suave, unos 8 minutos.","Escurre bien el exceso de líquido con un colador, para que el puré no quede demasiado aguado y siga firme en la cuchara.","Aplasta con un tenedor hasta formar un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvelo tibio en una cucharita de bebé, probándolo antes en el dorso de la mano, y ofrécelo en cucharadas pequeñas, revisando que el puré esté bien liso y sin grumos."]},{"id":7,"name":"Papilla de Papa con Pollo","cat":"m6","icon":"🥔","time":"~25 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/30635679/pexels-photo-30635679.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 papa pequeña, pelada y en cubos","2 cucharadas de pollo cocido y deshebrado muy fino","2 cucharadas del agua de cocción, o la que haga falta"],"tip":"Papa → camote (batata) cocido, en el mismo volumen.","steps":["Cocina la papa en cubos hasta que un tenedor la atraviese sin resistencia, unos 15 minutos.","Cocina el pollo hasta que no quede ninguna parte rosada y deshébralo muy fino.","Aplasta la papa todavía caliente con un tenedor hasta que quede un puré espeso.","Mezcla el pollo deshebrado y ajusta la textura con el agua de cocción.","Antes de servir, pon un poco del puré en el dorso de tu mano para asegurarte de que está tibio y no caliente, y así no quemar la boca del bebé.","Ofrécela en cucharadas pequeñas, con una cuchara de bebé, observando si el bebé acepta bien la mezcla de papa con pollo."],"alerta":"Deshebra bien el pollo, sin hebras gruesas, para reducir el riesgo de atragantamiento."},{"id":8,"name":"Puré de Mango Aplastado","cat":"m6","icon":"🥭","time":"~5 min","kcal":"65 kcal (estimado)","img":"https://images.pexels.com/photos/20105548/pexels-photo-20105548.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 mango maduro y suave, sin cáscara y sin hueso"],"tip":"Mango → papaya bien madura, en la misma cantidad.","steps":["Elige un mango bien maduro, que ceda fácilmente al presionarlo suavemente con los dedos.","Con ayuda de una cuchara, saca toda la pulpa del mango, desecha la cáscara y el hueso, y resérvala en un tazón limpio.","Aplasta bien con un tenedor hasta formar un puré espeso, quitando cualquier hebra que aparezca.","Pasa el puré entre los dedos para confirmar que no quedó ningún trozo firme ni fibra en la pulpa, que podría molestar al bebé.","Sírvelo enseguida, a temperatura ambiente, en cucharadas pequeñas."],"alerta":"Usa solo mango bien maduro; los trozos firmes de mango verde pueden ser difíciles de aplastar por completo."},{"id":9,"name":"Arroz y Frijoles Bien Aplastaditos con Verduras","cat":"m8","icon":"🍚","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/37332347/pexels-photo-37332347.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 cucharadas de arroz blanco bien cocido","2 cucharadas de frijoles (porotos) bien cocidos","2 cucharadas de verduras cocidas picadas (zanahoria y calabacita)","1 cucharada de agua o caldo casero sin sal"],"tip":"Frijoles → lentejas o garbanzos bien cocidos, en la misma cantidad.","steps":["Cocina el arroz, los frijoles y las verduras por separado hasta que queden muy suaves.","Aplasta los frijoles con un tenedor hasta formar una crema espesa, quitando las cascaritas sueltas.","Aplasta ligeramente el arroz y las verduras, dejando trocitos suaves que se noten.","Mezcla todo y ajusta la consistencia con el agua o el caldo casero sin sal.","Sírvelo tibio, probando la temperatura en el dorso de la mano."],"alerta":"Revisa que no hayan quedado cascaritas sueltas de los frijoles, que pueden molestar al bebé."},{"id":10,"name":"Puré Espeso de Papa con Pescado Deshebrado","cat":"m8","icon":"🐟","time":"~25 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/25315521/pexels-photo-25315521.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 papa mediana, cocida y pelada","3 cucharadas de pescado blanco cocido y deshebrado, sin espinas","1 chorrito de aceite de oliva"],"tip":"Pescado → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina la papa hasta que un tenedor la atraviese fácilmente, unos 20 minutos.","Cocina el pescado al vapor o en agua hasta que quede blanco y se separe en lascas.","Pasa los dedos por todo el pescado deshebrado, buscando y quitando cualquier espina antes de seguir.","Aplasta la papa dejando una textura más espesa, con trocitos suaves a la vista.","Mezcla el pescado deshebrado con el puré de papa y agrega el chorrito de aceite de oliva, que ayuda a absorber las vitaminas de los alimentos.","Sírvelo tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con una cuchara de bebé, dejando bien a la vista los trocitos suaves de pescado."],"alerta":"Revisa el pescado trozo por trozo buscando espinas: nunca te saltes este paso."},{"id":11,"name":"Panquequitos de Banana y Avena en Tiras","cat":"m8","icon":"🥞","time":"~15 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/38370352/pexels-photo-38370352.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 banana (plátano) madura, aplastada","1 huevo","3 cucharadas de avena en hojuelas finas"],"tip":"Avena → harina de arroz, para una versión sin gluten, en la misma cantidad.","steps":["Aplasta la banana con un tenedor y mezcla el huevo y la avena hasta formar una masa pareja.","Calienta un sartén antiadherente a fuego bajo, engrasado con una capa fina de aceite.","Vierte porciones pequeñas, del tamaño de una cucharada, y cocina hasta que se formen burbujas en la superficie.","Voltéalos con cuidado y cocina el otro lado hasta que se doren ligeramente, sin partes crudas en el centro.","Córtalos en tiras largas y suaves, del tamaño de un dedo, antes de servir.","Deja que se entibien y ofrécelos con el bebé sentado y supervisado."],"alerta":"Revisa que el centro del panquequito no haya quedado crudo antes de ofrecerlo, y sírvelo siempre con supervisión."},{"id":12,"name":"Sopa Espesa de Calabaza con Pollo","cat":"m8","icon":"🍲","time":"~30 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/29172200/pexels-photo-29172200.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de calabaza (zapallo) en cubos","1 filete de pollo cocido y deshebrado muy fino","1/2 cebolla pequeña, picada","1 taza de agua, o la necesaria para cubrir"],"tip":"Calabaza → camote o zanahoria cocida, en el mismo volumen.","steps":["Cocina la calabaza y la cebolla en el agua hasta que queden muy suaves, unos 15 minutos.","Aplasta todo dentro de la misma olla con un tenedor o un pisapapas, sin usar licuadora, hasta formar una crema espesa con trocitos suaves.","Vuelve a poner a fuego bajo, agrega el pollo deshebrado y calienta 3 minutos, revolviendo siempre.","Revisa que los trocitos de pollo y calabaza se aplasten fácilmente entre los dedos.","Sírvela tibia, en un tazón hondo, con el bebé bien sentado."],"alerta":"No la licúes: deja trocitos suaves para estimular la masticación en esta etapa."},{"id":13,"name":"Omelet Esponjoso en Tiras","cat":"m8","icon":"🍳","time":"~10 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/15214139/pexels-photo-15214139.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 huevo","1 cucharada de zanahoria rallada muy fina","1 chorrito de aceite de oliva"],"tip":"Zanahoria → calabacita rallada, en la misma cantidad.","steps":["Bate el huevo con un tenedor hasta que quede parejo y mezcla la zanahoria rallada.","Calienta un sartén antiadherente pequeño con el aceite de oliva a fuego bajo.","Vierte la mezcla y cocina tapado hasta que la superficie esté firme por completo, sin partes líquidas, unos 4 minutos.","Voltéalo con cuidado y cocina 1 minuto más del otro lado.","Córtalo en tiritas suaves, del tamaño de un dedo, y deja que se entibie antes de servir."],"alerta":"Revisa que el omelet se haya cocido por completo, sin partes crudas en el medio, antes de ofrecerlo."},{"id":14,"name":"Puré de Garbanzos con Zanahoria","cat":"m8","icon":"🫘","time":"~20 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/9304931/pexels-photo-9304931.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de garbanzos bien cocidos","1/2 zanahoria pequeña, cocida","1 chorrito de aceite de oliva"],"tip":"Garbanzos → lentejas bien cocidas, en la misma cantidad.","steps":["Cocina los garbanzos hasta que queden muy suaves y se aplasten fácilmente entre los dedos.","Mientras los aplastas, quita una por una las pieles sueltas de los garbanzos, para que no queden sueltas en la papilla y molesten al bebé.","Aplasta los garbanzos junto con la zanahoria cocida hasta formar un puré espeso, con trocitos suaves.","Mezcla bien 1 chorrito de aceite de oliva con el puré todavía tibio, lo suficiente para que brille, lo que ayuda a absorber las vitaminas de las verduras.","Sírvelo tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, manteniendo los trocitos suaves de garbanzo y zanahoria."],"alerta":"Quita bien las pieles sueltas de los garbanzos, que pueden molestar la garganta del bebé."},{"id":15,"name":"Bolitas de Calabaza al Horno Bien Suaves","cat":"m8","icon":"🧡","time":"~30 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/6065696/pexels-photo-6065696.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de calabaza (zapallo) cocida y aplastada","2 cucharadas de avena en hojuelas finas","1 huevo"],"tip":"Avena → harina de avena, en la misma cantidad.","steps":["Mezcla la calabaza aplastada, la avena y el huevo hasta formar una masa pareja y ligeramente húmeda.","Engrasa tus manos con un poco de aceite y forma bolitas pequeñas y aplanadas, del tamaño de un bocado.","Acomódalas en una bandeja forrada y hornea en horno precalentado a 180°C unos 15 minutos, hasta que se doren ligeramente.","Aprieta una bolita entre el pulgar y el índice: solo está lista para servir si se aplasta con facilidad.","Deja que se enfríen hasta quedar tibias antes de ofrecerlas."],"alerta":"Aplana bien las bolitas antes de hornear, para evitar la forma redonda, que es más riesgosa."},{"id":16,"name":"Papilla de Lentejas con Calabacita","cat":"m8","icon":"🥣","time":"~25 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/6275176/pexels-photo-6275176.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de lentejas bien cocidas","1/2 calabacita (zucchini) pequeña, cocida","1 chorrito de aceite de oliva"],"tip":"Lentejas → frijoles bien cocidos, en la misma cantidad.","steps":["Cocina las lentejas hasta que queden muy suaves y aplástalas con un tenedor.","Cocina la calabacita hasta que esté suave y aplástala junto con las lentejas.","Mezcla bien 1 chorrito de aceite de oliva hasta integrarlo por completo, lo que ayuda al cuerpo del bebé a absorber las vitaminas de las verduras.","Revisa la textura: debe quedar espesa, con trocitos suaves que se noten.","Sírvela tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, revisando que los trocitos de lenteja y calabacita estén suaves."]},{"id":17,"name":"Albóndigas de Pollo Bien Suaves","cat":"m10","icon":"🍗","time":"~30 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/5419345/pexels-photo-5419345.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["300 g de pechuga de pollo molida","1 huevo","3 cucharadas de harina de avena","1 cucharadita de paprika dulce","1 cucharada de perejil fresco picado"],"tip":"Harina de avena → pan rallado integral, en la misma cantidad.","steps":["Mezcla el pollo molido, el huevo, la harina de avena, la paprika dulce y el perejil hasta formar una masa pareja y sazonada.","Forma bolitas pequeñas, del tamaño de un bocado, y aplana cada una con la palma de la mano para quitarles la forma redonda.","Acomódalas en una bandeja forrada y hornea en horno precalentado a 200°C de 18 a 20 minutos, hasta que se doren y queden firmes por dentro.","Corta cada albóndiga en 2 o 3 trozos irregulares, revisando que no haya partes crudas en el centro.","Deja que las albóndigas se entibien unos minutos fuera del horno y sirve los trozos en un plato, comprobando que estén lo bastante suaves para que el bebé los muerda y mastique solo."],"alerta":"Nunca sirvas las albóndigas enteras y redondas: aplánalas antes de hornear y córtalas en trozos irregulares antes de servir, por el riesgo de atragantamiento."},{"id":18,"name":"Espagueti de Calabacita con Salsa de Tomate Casera","cat":"m10","icon":"🍝","time":"~20 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/6978187/pexels-photo-6978187.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 calabacita (zucchini) mediana, cortada en tiras finas tipo espagueti","2 tomates (jitomates) maduros, sin piel y sin semillas","1 chorrito de aceite de oliva"],"tip":"Salsa de tomate casera → puré de calabaza, si prefieres algo más suave para el paladar del bebé.","steps":["Sofríe los tomates picados en el aceite de oliva a fuego bajo hasta que se deshagan por completo y formen una salsa, unos 8 minutos.","Cocina las tiras de calabacita al vapor hasta que queden muy suaves, sin partes crujientes.","Corta las tiras de calabacita en trozos cortos, del tamaño de un bocado, antes de mezclarlas con la salsa.","Mezcla las tiras cortadas con la salsa de tomate.","Sírvelo tibio, con el bebé sentado y supervisado."],"alerta":"Corta siempre las tiras de calabacita en trozos cortos; las tiras largas pueden enredarse en la garganta del bebé."},{"id":19,"name":"Nuggets de Pollo Caseros al Horno","cat":"m10","icon":"🍗","time":"~30 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/7428286/pexels-photo-7428286.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["300 g de pechuga de pollo (más o menos 1 pechuga pequeña), molida o picada muy fina","1 huevo entero","3 cucharadas de harina de avena"],"tip":"Harina de avena → pan rallado integral, en la misma cantidad, si prefieres una cubierta más crujiente.","steps":["En un tazón, mezcla el pollo molido, el huevo y la harina de avena hasta formar una masa pareja que no se pegue mucho a las manos.","Con las manos engrasadas con un poco de aceite de oliva, forma porciones del tamaño de una cucharada con forma de nugget, aplanándolas un poco.","Acomoda los nuggets en una bandeja forrada y hornea en horno precalentado a 200°C de 18 a 20 minutos, volteándolos a la mitad del tiempo.","El nugget está listo cuando queda dorado por fuera y, al partir uno a la mitad, no queda ninguna parte rosada ni cruda por dentro.","Deja que se entibien unos minutos fuera del horno y prueba la temperatura en el dorso de la mano antes de ofrecerlos.","Sírvelos en trozos del tamaño de un dedo de adulto, para que el niño los agarre con la mano."],"alerta":"Parte siempre un nugget a la mitad para confirmar que el pollo esté bien cocido por dentro antes de servir."},{"id":20,"name":"Arroz con Verduras en Trocitos","cat":"m10","icon":"🍛","time":"~25 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/724300/pexels-photo-724300.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["3 cucharadas de arroz blanco ya cocido","2 cucharadas de zanahoria cocida, en cubitos suaves","2 cucharadas de ejotes (judías verdes) cocidos, en trocitos suaves","1 chorrito de aceite de oliva"],"tip":"Ejotes → arvejas (chícharos) bien cocidas y ligeramente aplastadas, en la misma cantidad.","steps":["Cocina la zanahoria y los ejotes al vapor o en agua hasta que queden muy suaves, de 12 a 15 minutos.","Corta las verduras en cubitos y trocitos pequeños, del tamaño que el niño pueda agarrar con los dedos.","Aprieta un trozo entre el pulgar y el índice: si se aplasta con facilidad, la textura es segura para servir.","Mezcla las verduras ya cortadas con el arroz cocido y termina con el chorrito de aceite de oliva.","Sírvelo tibio, en un tazón, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Desecha las fibras duras de los ejotes que no se suelten al cocinar, porque pueden pegarse en la garganta."},{"id":21,"name":"Croquetitas de Pescado al Horno","cat":"m10","icon":"🐠","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/37859853/pexels-photo-37859853.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["200 g de pescado blanco (como tilapia) cocido, deshebrado y sin espinas","1 papa pequeña, cocida y aplastada","1 huevo","1 chorrito de aceite de oliva (para engrasar la bandeja)"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad, los días que no tengas pescado en casa.","steps":["Antes que nada, revisa el pescado deshebrado con los dedos, buscando y quitando cualquier espina que haya quedado.","En un tazón, mezcla el pescado deshebrado, la papa aplastada y el huevo hasta formar una masa que mantenga la forma.","Forma croquetitas pequeñas y aplanadas, del tamaño de una cucharada llena.","Acomódalas en una bandeja engrasada con aceite de oliva y hornea en horno precalentado a 190°C unos 15 minutos, hasta que se doren ligeramente por fuera.","La croquetita está lista cuando se siente firme al tocarla y está dorada en los bordes.","Deja que se entibien y sírvelas en trozos pequeños, probando la temperatura en el dorso de la mano."],"alerta":"Revisa el pescado con atención antes de mezclar: las espinas pequeñas son el mayor riesgo de esta receta."},{"id":22,"name":"Sándwich Abierto de Ricota con Zanahoria Rallada","cat":"m10","icon":"🥪","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/38594711/pexels-photo-38594711.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 rebanada de pan de molde integral, fresco y suave","2 cucharadas de ricota fresca, aplastada con un tenedor","1 cucharada de zanahoria cruda rallada muy fina"],"tip":"Ricota → queso cottage batido, en la misma cantidad, para una textura todavía más lisa.","steps":["Aplasta la ricota con un tenedor hasta formar una crema lisa, sin grumos.","Mezcla la zanahoria rallada muy fina con la crema de ricota.","Unta la mezcla sobre la rebanada de pan, cubriendo bien hasta las orillas.","Corta el pan en tiras largas, del tamaño de un dedo de adulto, fáciles de agarrar con la mano.","Sírvelo a temperatura ambiente, nunca frío recién salido del refrigerador."],"alerta":"Usa siempre pan fresco y suave; el pan tostado o con corteza dura puede lastimar la boca del bebé y aumentar el riesgo de atragantamiento."},{"id":23,"name":"Omelet de Verduras en Tiras","cat":"m10","icon":"🥕","time":"~15 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/6294366/pexels-photo-6294366.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 huevos","2 cucharadas de zanahoria rallada","2 cucharadas de calabacita (zucchini) rallada","1 chorrito de aceite de oliva (para engrasar el sartén)"],"tip":"Zanahoria y calabacita ralladas → cámbialas por espinaca picada muy fina, en la misma cantidad.","steps":["Bate los huevos con un tenedor hasta que queden parejos y mezcla la zanahoria y la calabacita ralladas.","Calienta un sartén antiadherente a fuego bajo con un chorrito de aceite de oliva.","Vierte la mezcla, tapa el sartén y cocina unos 5 minutos, hasta que la superficie esté firme por completo.","Voltea el omelet con cuidado y cocina 2 minutos más del otro lado, hasta que no quede ninguna parte líquida.","Deja que se entibie y córtalo en tiras largas y suaves, del tamaño de un dedo de adulto.","Sírvelo tibio, probando la temperatura en el dorso de la mano, siempre en tiras largas como ya lo cortaste, nunca en trozos redondos que pueden ahogar al bebé."],"alerta":"Córtalo siempre en tiras largas: los trozos redondos de omelet pueden atorarse en la vía respiratoria del niño."},{"id":24,"name":"Camote en Cubos Suaves","cat":"m10","icon":"🍠","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/3233282/pexels-photo-3233282.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) pequeño, pelado y cortado en cubos","1 chorrito de aceite de oliva"],"tip":"Camote → calabaza (zapallo) en cubos, con la misma preparación y el mismo tiempo de cocción.","steps":["Cocina los cubos de camote al vapor unos 15 minutos, hasta que queden muy suaves.","Aprieta un cubo entre el pulgar y el índice: tiene que aplastarse con facilidad, sin resistencia.","Si todavía está firme, déjalo cocinar unos minutos más y vuelve a probar.","Agrega el chorrito de aceite de oliva a los cubos todavía tibios.","Sírvelos como comida para agarrar con la mano (finger food), tibios, probando en el dorso de la mano antes de ofrecerlos."],"alerta":"Nunca ofrezcas el cubo si todavía está firme al tacto; el camote mal cocido es riesgo de atragantamiento."},{"id":25,"name":"Pastel de Camote con Pollo","cat":"m12","icon":"🍠","time":"~40 min","kcal":"210 kcal (estimado)","img":"https://images.pexels.com/photos/7999009/pexels-photo-7999009.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 camotes (batatas) medianos, cocidos y aplastados","1 filete de pollo cocido y deshebrado","1/2 cebolla pequeña, picada muy fina","1 cucharada de aceite de oliva"],"tip":"Camote → papa cocida y aplastada, en el mismo volumen.","steps":["Sofríe la cebolla picada en el aceite de oliva a fuego bajo hasta que esté transparente y suave, unos 3 minutos.","Agrega el pollo deshebrado y sofríe 2 minutos más, mezclando bien.","Reparte el sofrito de pollo en el fondo de un refractario pequeño.","Cúbrelo por completo con el puré de camote.","Hornea en horno precalentado a 200°C por 10 minutos, hasta que la superficie se dore ligeramente.","Deja que se entibie y sírvelo en porciones pequeñas, con cuchara."]},{"id":26,"name":"Risotto Cremoso de Calabaza","cat":"m12","icon":"🍚","time":"~30 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/33988119/pexels-photo-33988119.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de arroz blanco o arborio","1 taza de calabaza (zapallo) cocida en cubos","1 cucharada de queso fresco blanco rallado, bajo en sodio (opcional)","2 tazas de caldo casero de verduras, sin sal"],"tip":"Queso blanco → se puede omitir sin perder cremosidad. No lo cambies por parmesano ni queso rallado de sobre: son los más salados del estante y pesan demasiado para esta etapa.","steps":["Cocina la calabaza en cubos hasta que quede muy suave y aplasta la mitad con un tenedor, dejando el resto en trocitos.","En una olla, sofríe el arroz 1 minuto y ve agregando el caldo casero poco a poco, un cucharón a la vez, revolviendo siempre.","Sigue agregando caldo y revolviendo unos 15 minutos, hasta que el arroz quede cremoso y suave.","Mezcla la calabaza aplastada y los trocitos con el arroz ya cremoso.","Si lo usas, termina con el queso rallado, mezclando hasta que se derrita.","Sírvelo tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Si es la primera vez que el niño prueba queso, ofrécele una cantidad pequeña y observa si hay señales de alergia en las horas siguientes."},{"id":27,"name":"Pasta con Salsa de Tomate Casera","cat":"m12","icon":"🍅","time":"~25 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/6327610/pexels-photo-6327610.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de pasta de tornillo o de letras, ya cocida","3 tomates (jitomates) maduros, picados","1 diente de ajo, picado muy fino","1 chorrito de aceite de oliva"],"tip":"Pasta de tornillo o de letras → arroz bien cocido, en la misma cantidad, si la prefieres sin gluten.","steps":["Sofríe el ajo en el aceite de oliva a fuego bajo durante 1 minuto, hasta que suelte el aroma, sin dejar que se dore demasiado.","Agrega los tomates picados y cocina unos 15 minutos, revolviendo de vez en cuando, hasta formar una salsa espesa.","Aplasta los trozos más grandes de tomate con una cuchara, para que no quede piel suelta en la salsa.","Mezcla la pasta ya cocida con la salsa y calienta 2 minutos más.","Sírvela tibia, en trozos cortos, nunca con pasta larga tipo espagueti."],"alerta":"Prefiere siempre pastas cortas como tornillo o letras; la pasta larga enrollada es riesgo de atragantamiento en esta etapa."},{"id":28,"name":"Pollo a la Plancha con Puré de Papa","cat":"m12","icon":"🍗","time":"~30 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/28321266/pexels-photo-28321266.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 filete de pollo, cortado en cubos pequeños","2 papas medianas, cocidas","1 cucharada de aceite de oliva"],"tip":"Papa → camote (batata) cocido y aplastado, en el mismo volumen.","steps":["Cocina las papas en agua hasta que queden muy suaves, unos 15 minutos, y aplástalas hasta formar un puré cremoso.","Calienta el aceite de oliva en un sartén a fuego medio y cocina los cubos de pollo a la plancha unos 8 minutos, volteándolos algunas veces.","El pollo está listo cuando queda dorado por fuera y, al cortar un cubo a la mitad, no queda ninguna parte rosada.","Corta los cubos de pollo a la plancha en trozos todavía más pequeños, del tamaño que el niño pueda masticar con facilidad.","Sirve el pollo sobre el puré de papa, tibio."],"alerta":"Corta siempre un cubo de pollo a la mitad para confirmar que esté bien cocido por dentro."},{"id":29,"name":"Wrap de Pollo y Verduras","cat":"m12","icon":"🌯","time":"~15 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/29535635/pexels-photo-29535635.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 tortilla de maíz o 1 wrap integral pequeño","3 cucharadas de pollo cocido y deshebrado","2 cucharadas de zanahoria rallada","1 chorrito de aceite de oliva"],"tip":"Wrap integral → tortilla de maíz, para una versión sin gluten con la misma cantidad de relleno.","steps":["Sofríe el pollo deshebrado con un chorrito de aceite de oliva por 2 minutos, solo para calentarlo y realzar el sabor, sin agregar sal.","Calienta ligeramente la tortilla o el wrap en un sartén antiadherente, sin dejar que se tueste.","Pon el pollo y la zanahoria rallada en el centro del wrap, formando una línea recta.","Enrolla el wrap con firmeza, como un taco apretado, presionando un poco para que el relleno no se salga cuando lo cortes después.","Córtalo en tiras largas a lo largo, nunca en rodajas.","Sírvelo tibio o a temperatura ambiente, ofreciendo las tiras para que el niño las agarre."],"alerta":"Nunca cortes el wrap en rodajas: un trozo redondo del tamaño de la vía respiratoria es uno de los riesgos de atragantamiento más comunes en los enrollados."},{"id":30,"name":"Panqueque Salado de Espinaca","cat":"m12","icon":"🥬","time":"~15 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/7144311/pexels-photo-7144311.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 taza de espinaca picada muy fina","2 huevos","3 cucharadas de harina de avena"],"tip":"Espinaca → acelga bien picadita, en la misma cantidad.","steps":["Bate los huevos con un tenedor y mezcla la harina de avena poco a poco, hasta formar una masa lisa y sin grumos.","Agrega la espinaca picada muy fina y mezcla bien, repartiendo los trocitos por toda la masa del panqueque.","Calienta un sartén antiadherente a fuego bajo y vierte porciones pequeñas de la masa, formando panqueques pequeños.","Cocina unos 2 minutos de cada lado, volteándolos cuando la superficie empiece a hacer burbujas y se dore por abajo.","Confirma que el centro ya no esté líquido antes de sacarlos del sartén.","Deja que los panqueques se entibien unos minutos y córtalos en tiras o trozos pequeños antes de servir, del tamaño que el bebé pueda agarrar solo."]},{"id":31,"name":"Pescado al Horno con Verduras de Colores","cat":"m12","icon":"🐟","time":"~30 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/34402767/pexels-photo-34402767.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 filete de pescado blanco sin espinas","1 zanahoria, en rodajas finas","1 calabacita (zucchini), en rodajas finas","1 chorrito de aceite de oliva"],"tip":"Pescado blanco → pollo en tiras al horno, con la misma preparación y el mismo tiempo de horno.","steps":["Acomoda el pescado y las rodajas de verdura en una bandeja para horno, y rocía todo con el aceite de oliva.","Hornea en horno precalentado a 200°C unos 20 minutos, hasta que el pescado esté opaco y las verduras suaves.","Antes de deshebrar, revisa el pescado con los dedos con mucha atención, buscando cualquier espina que haya quedado.","Aplasta las rodajas de zanahoria y calabacita entre los dedos para confirmar que estén lo bastante suaves.","Deshebra el pescado en trocitos pequeños y mézclalo con las verduras.","Sírvelo tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Revisa el pescado con atención antes de servir: las espinas pequeñas son el mayor riesgo de esta receta."},{"id":32,"name":"Sopa de Verduras con Pasta de Letras","cat":"m12","icon":"🍲","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/6853445/pexels-photo-6853445.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["1 zanahoria, picada","1 calabacita (zucchini), picada","2 cucharadas de pasta de letras","2 tazas de caldo casero de verduras, sin sal"],"tip":"Pasta de letras → arroz bien cocido, en la misma cantidad.","steps":["Cocina la zanahoria y la calabacita en el caldo casero unos 15 minutos, hasta que queden muy suaves.","Aprieta un trozo de verdura entre los dedos para confirmar que se aplasta con facilidad.","Agrega la pasta de letras y cocina el tiempo que indica el paquete, normalmente de 5 a 7 minutos.","Revisa que la pasta esté bien suave antes de apagar el fuego.","Deja que la sopa se entibie y sírvela en un tazón hondo, probando la temperatura en el dorso de la mano."],"alerta":"Sírvela siempre tibia, nunca caliente: prueba la sopa en el dorso de la mano antes de ofrecerla con cuchara."},{"id":33,"name":"Arroz de Colores con Pollo y Arvejas","cat":"m18","icon":"🍚","time":"~25 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/35553000/pexels-photo-35553000.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz blanco cocido","1 filete de pollo, en cubos pequeños","3 cucharadas de arvejas (chícharos) cocidas","1 chorrito de aceite de oliva"],"tip":"Arvejas → granos de maíz tierno cocidos y aplastados, en la misma cantidad.","steps":["Calienta el aceite de oliva en un sartén y sofríe los cubos de pollo unos 8 minutos, hasta que se doren y se cocinen por dentro.","Corta un cubo de pollo a la mitad para confirmar que no quedó ninguna parte rosada.","Aplasta ligeramente las arvejas cocidas entre los dedos, para que sean más fáciles de masticar.","Mezcla el arroz, el pollo y las arvejas en el sartén y calienta todo junto de 2 a 3 minutos.","Sírvelo tibio, en porciones pequeñas en un plato, probando la temperatura antes de ofrecerlo y revisando que el pollo y las arvejas estén lo bastante suaves para masticar."],"alerta":"Aplasta ligeramente las arvejas antes de servir: enteras y cocidas, todavía pueden ser riesgo de atragantamiento."},{"id":34,"name":"Hamburguesa Casera de Pollo","cat":"m18","icon":"🍔","time":"~25 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/8983402/pexels-photo-8983402.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 18 meses","ingredients":["300 g de pollo molido","1 huevo","2 cucharadas de harina de avena","1 cucharadita de hierbas frescas picadas, como perejil u orégano"],"tip":"Pollo molido → carne de res molida magra, en la misma cantidad.","steps":["Mezcla el pollo molido, el huevo, la harina de avena y las hierbas picadas hasta formar una masa pareja.","Forma discos pequeños y aplanados, del tamaño de la palma de la mano del niño.","Cocínalas en un sartén a fuego medio unos 5 minutos de cada lado, hasta que se doren.","Corta una hamburguesa a la mitad para confirmar que esté bien cocida, sin ninguna parte rosada ni cruda.","Deja que se entibien y córtalas en trozos pequeños antes de servir.","Sírvelas con pan suave o solas, tibias."],"alerta":"Corta siempre una hamburguesa a la mitad antes de servir, para confirmar que esté bien cocida por dentro."},{"id":35,"name":"Pescadito Empanizado en Freidora de Aire","cat":"m18","icon":"🐟","time":"~20 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/5639413/pexels-photo-5639413.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 filete de pescado blanco sin espinas, cortado en tiras","1 huevo batido","3 cucharadas de harina de avena"],"tip":"Harina de avena → pan rallado integral, en la misma cantidad.","steps":["Antes de empanizar, revisa las tiras de pescado con los dedos, buscando cualquier espina que haya quedado.","Pasa cada tira de pescado por el huevo batido y después por la harina de avena, cubriendo bien todos los lados.","Acomoda las tiras en la canasta de la freidora de aire en una sola capa, sin encimarlas.","Cocina a 180°C unos 10 minutos, volteando las tiras a la mitad del tiempo.","El pescadito está listo cuando queda dorado por fuera y se deshace fácilmente con el tenedor por dentro.","Deja que se entibie y sírvelo en tiras, del tamaño de un dedo de adulto."],"alerta":"Revisa el pescado con atención antes de empanizar: las espinas pequeñas son el mayor riesgo de esta receta."},{"id":36,"name":"Pastel Salado de Verduras","cat":"m18","icon":"🥧","time":"~40 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/5419317/pexels-photo-5419317.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 18 meses","ingredients":["2 huevos","1 taza de verduras picadas muy pequeñas (zanahoria, calabacita y maíz)","1 taza de harina de avena","1/2 taza de leche de vaca"],"tip":"Leche de vaca → leche vegetal sin azúcar, en la misma cantidad, los días sin lácteos.","steps":["Bate los huevos con la leche y mezcla la harina de avena poco a poco, hasta formar una masa pareja y sin grumos.","Agrega las verduras picadas muy pequeñas y mezcla bien, repartiéndolas por toda la masa antes de hornear.","Vierte la masa en un molde pequeño engrasado con un chorrito de aceite, extendiéndola bien para formar una capa pareja.","Hornea en horno precalentado a 190°C unos 25 minutos, hasta que se dore por encima y esté firme por dentro.","Pincha un palillo en el centro: si sale limpio, el pastel está cocido por dentro.","Deja que se entibie y córtalo en rebanadas suaves antes de servir, de un tamaño fácil de agarrar con las manos para el niño."]},{"id":37,"name":"Carne Molida con Puré y Ejotes","cat":"m18","icon":"🥩","time":"~30 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/128641/pexels-photo-128641.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["250 g de carne molida magra","2 papas medianas cocidas y aplastadas","1 taza de ejotes (judías verdes) cocidos y picados"],"tip":"Carne molida → pollo molido, en la misma cantidad, para variar la proteína.","steps":["Sofríe los 250 g de carne molida magra a fuego medio, sin sal, hasta que pierda todo el color rosado por dentro, unos 10 minutos.","Cocina las 2 papas en agua hasta que un tenedor las atraviese sin resistencia, unos 15 minutos, y aplástalas todavía calientes hasta que queden en un puré cremoso y sin grumos.","Cocina la taza de ejotes hasta que queden muy suaves y pícalos en trozos pequeños que se aplasten con facilidad entre los dedos.","Mezcla la carne molida con los ejotes picados, dejando el puré de papa como acompañamiento aparte en el plato.","Arma porciones pequeñas alternando las texturas y deja que la comida se entibie antes de servir.","Sírvelo tibio, probando la temperatura en el dorso de la mano antes de ofrecérselo al niño."],"alerta":"Revisa que los trozos de ejote se aplasten con facilidad entre el pulgar y el índice antes de servir."},{"id":38,"name":"Kibbe al Horno","cat":"m18","icon":"🧆","time":"~35 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/10790950/pexels-photo-10790950.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 18 meses","ingredients":["250 g de carne molida magra","1/2 taza de trigo bulgur hidratado","1/2 cebolla picada muy fina","1 chorrito de aceite de oliva para engrasar"],"tip":"Trigo bulgur → avena en hojuelas finas hidratada, en la misma cantidad, para una versión sin trigo.","steps":["Hidrata 1/2 taza de trigo bulgur en agua tibia por 10 minutos y exprímelo bien para quitar el exceso de agua.","Mezcla el trigo hidratado con los 250 g de carne molida magra y la 1/2 cebolla picada muy fina, amasando con las manos hasta formar una masa pareja.","Extiende la masa en una capa delgada, de unos 2 cm, en una bandeja para horno engrasada con el chorrito de aceite de oliva.","Hornea en horno precalentado a 190°C unos 25 minutos, hasta que la superficie se dore y el interior esté completamente cocido.","Déjalo reposar 5 minutos fuera del horno y córtalo en cuadritos pequeños, del tamaño de un dedo de niño.","Sírvelo tibio, nunca caliente, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Deja que la superficie del kibbe pierda el calor del horno antes de servir, porque la costra guarda la temperatura por más tiempo."},{"id":39,"name":"Risotto de Pollo con Calabacita","cat":"m18","icon":"🍚","time":"~30 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/6544216/pexels-photo-6544216.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz","1 filete de pollo en cubos pequeños","1 calabacita (zucchini) pequeña en cubos pequeños","1 taza de caldo casero de verduras sin sal, o el que haga falta"],"tip":"Calabacita → zanahoria en cubos pequeños, en la misma cantidad, cocida junto con el arroz.","steps":["Corta 1 filete de pollo en cubos pequeños y sofríelo hasta que se dore por fuera y pierda el color rosado por dentro, unos 6 minutos.","Agrega 1 taza de arroz y mezcla 1 minuto para cubrir los granos.","Ve agregando el caldo casero de verduras sin sal, un cucharón a la vez, revolviendo siempre, hasta que el arroz quede suave y cremoso, unos 18 minutos.","Corta la calabacita en cubos pequeños y agrégala al risotto en los últimos 5 minutos de cocción, hasta que quede suave pero todavía con forma.","Revisa que el arroz esté bien suave y que el caldo haya formado una crema, sin quedar seco ni aguado.","Sírvelo tibio, en porciones pequeñas en un plato, probando la temperatura en el dorso de la mano y revisando que el arroz esté suave y el pollo bien cocido."]},{"id":40,"name":"Mini Hot Cakes Saludables","cat":"m18","icon":"🥞","time":"~15 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/7144297/pexels-photo-7144297.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 banana (plátano) madura aplastada","1 huevo","1/2 taza de harina de avena","1 cucharadita de polvo para hornear"],"tip":"Harina de avena → harina de arroz, en la misma cantidad, para una versión sin gluten.","steps":["Aplasta 1 banana madura con un tenedor hasta que quede cremosa y mézclala con 1 huevo batido.","Agrega 1/2 taza de harina de avena y 1 cucharadita de polvo para hornear, revolviendo hasta formar una masa pareja sin grumos.","Calienta un sartén antiadherente engrasado a fuego bajo y vierte porciones de 1 cucharada de la masa.","Voltea cada hot cake cuando aparezcan burbujas en la superficie y dora el otro lado, más o menos 1 minuto de cada lado.","Deja que los hot cakes se entibien y córtalos en trozos pequeños antes de servir.","Sírvelos solos o con fruta aplastada encima, siempre en trozos que el niño pueda llevarse a la boca con seguridad."],"alerta":"Quédate cerca durante toda la comida, porque los hot cakes se ofrecen en trozos que el niño se lleva a la boca con la mano."},{"id":41,"name":"Puré de Calabacita con Pescado Blanco","cat":"m6","icon":"🐟","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/7543109/pexels-photo-7543109.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 calabacita (zucchini) pequeña","2 cucharadas de filete de pescado blanco cocido, sin espinas","Agua de cocción, la que haga falta"],"tip":"Pescado blanco → pollo cocido y deshebrado muy fino, en la misma cantidad.","steps":["Pela y corta 1/2 calabacita pequeña en cubos y cocínala en agua hasta que quede muy suave, unos 12 minutos, cuando un tenedor la atraviese sin resistencia.","Cocina el filete de pescado blanco al vapor o en agua hasta que esté totalmente opaco y se deshaga al tocarlo con el tenedor.","Deshebra el pescado con los dedos y revisa con cuidado, trozo por trozo, que no haya quedado ninguna espina.","Aplasta la calabacita y el pescado juntos con un tenedor hasta formar una papilla pareja, sin trozos duros, sin usar licuadora ni colador.","Ajusta la consistencia con un poco del agua de cocción, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvelo tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Revisa el pescado trozo por trozo buscando espinas antes de aplastarlo: nunca lo ofrezcas sin esta revisión."},{"id":42,"name":"Puré de Brócoli con Papa","cat":"m6","icon":"🥦","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/5725773/pexels-photo-5725773.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["3 arbolitos pequeños de brócoli","1/2 papa pequeña","Agua, la necesaria para cocinar"],"tip":"Brócoli → coliflor, con la misma preparación y cantidad.","steps":["Cocina los 3 arbolitos pequeños de brócoli y la 1/2 papa pequeña en agua hasta que queden muy suaves, unos 15 minutos, cuando un tenedor los atraviese sin resistencia.","Escurre las verduras con cuidado, guardando un poco del agua de cocción para ajustar después la consistencia del puré.","Aplasta el brócoli y la papa juntos con un tenedor hasta formar una papilla pareja, sin usar licuadora ni colador.","Ajusta la consistencia con el agua reservada, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvelo tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con una cuchara de bebé, sin grumos ni trozos firmes."]},{"id":43,"name":"Puré de Remolacha con Arroz","cat":"m6","icon":"🍠","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/17138080/pexels-photo-17138080.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/4 de remolacha (betabel) pequeña","2 cucharadas de arroz bien cocido","Agua de cocción, la que haga falta"],"tip":"Remolacha → zanahoria, en el mismo volumen, para un sabor más suave.","steps":["Pela y corta 1/4 de remolacha pequeña en cubos pequeños y cocínala en agua hasta que quede muy suave, unos 20 minutos.","Cocina 2 cucharadas de arroz hasta que quede muy suave, unos 15 minutos.","Aplasta la remolacha y el arroz juntos con un tenedor hasta formar una papilla pareja, sin grumos duros.","Ajusta la consistencia con un poco del agua de cocción de la remolacha, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvelo tibio, en cucharadas pequeñas, probando la temperatura en el dorso de la mano."]},{"id":44,"name":"Papilla de Papaya Aplastada","cat":"m6","icon":"🧡","time":"~5 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/4113829/pexels-photo-4113829.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 rebanada de papaya madura, sin semillas"],"tip":"Papaya → mango maduro, en la misma cantidad, con la misma preparación.","steps":["Elige 1 rebanada de papaya bien madura y quítale toda la cáscara y las semillas.","Corta la fruta en trozos pequeños, para que sea más fácil aplastarla bien con el tenedor hasta formar un puré liso.","Aplasta bien con un tenedor hasta formar un puré liso, sin trozos grandes.","Sírvela enseguida, a temperatura ambiente, en cucharadas pequeñas."]},{"id":45,"name":"Puré de Arvejas con Camote","cat":"m6","icon":"🟢","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/32188890/pexels-photo-32188890.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["3 cucharadas de arvejas (chícharos) cocidas","1/2 camote (batata) pequeño cocido","Agua de cocción, la que haga falta"],"tip":"Arvejas → ejotes bien cocidos, en la misma cantidad.","steps":["Cocina las 3 cucharadas de arvejas en agua hasta que queden muy suaves, unos 10 minutos.","Cocina el 1/2 camote pequeño, en cubos, hasta que un tenedor lo atraviese sin resistencia, unos 15 minutos.","Aplasta las arvejas y el camote juntos con un tenedor hasta formar una papilla pareja.","Ajusta la consistencia con el agua de cocción, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvelo tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo."],"alerta":"Aplasta bien las arvejas para deshacer la cascarita, que puede quedar entera aun después de cocida."},{"id":46,"name":"Papilla de Pescado con Calabacita","cat":"m6","icon":"🐟","time":"~20 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/14537684/pexels-photo-14537684.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 cucharadas de pescado blanco cocido y deshebrado, sin espinas","1/2 calabacita (zucchini) pequeña cocida","Agua de cocción, la que haga falta"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina el filete de pescado blanco al vapor o en agua hasta que esté totalmente opaco y se deshaga al tocarlo con el tenedor.","Deshebra el pescado con los dedos y revisa con cuidado, trozo por trozo, que no haya quedado ninguna espina.","Cocina la 1/2 calabacita pequeña, en cubos, hasta que quede muy suave, unos 10 minutos.","Aplasta el pescado deshebrado junto con la calabacita, usando un tenedor, hasta formar una papilla pareja.","Ajusta la consistencia con el agua de cocción, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvela tibia, probando la temperatura en el dorso de la mano."],"alerta":"Revisa el pescado trozo por trozo buscando espinas antes de aplastarlo: nunca lo ofrezcas sin esta revisión."},{"id":47,"name":"Puré de Ciruela Cocida","cat":"m6","icon":"🟣","time":"~15 min","kcal":"50 kcal (estimado)","img":"https://images.pexels.com/photos/2839634/pexels-photo-2839634.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 ciruelas frescas maduras, sin hueso"],"tip":"Ciruela → pera cocida, con la misma preparación, si el bebé tiene el estómago más suelto.","steps":["Lava las 2 ciruelas frescas maduras, córtalas en trozos y quítales bien el hueso.","Cocina los trozos en poca agua hasta que queden muy suaves, unos 8 minutos.","Aplasta con un tenedor hasta formar un puré liso, sin trozos de cáscara duros.","Deja que se entibie y sírvelo en cucharadas pequeñas."],"alerta":"Confirma que no quedó ningún trozo de hueso al aplastar la fruta."},{"id":48,"name":"Papilla de Coliflor con Zanahoria","cat":"m6","icon":"🥕","time":"~20 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/5313003/pexels-photo-5313003.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["3 arbolitos pequeños de coliflor","1/2 zanahoria pequeña","Agua, la necesaria para cocinar"],"tip":"Coliflor → brócoli, con la misma preparación y cantidad.","steps":["Cocina los 3 arbolitos pequeños de coliflor y la 1/2 zanahoria pequeña en agua hasta que queden muy suaves, unos 15 minutos.","Escurre las verduras con cuidado, guardando un poco del agua de cocción para ajustar después la consistencia de la papilla.","Aplasta la coliflor y la zanahoria juntas con un tenedor hasta formar una papilla pareja, sin usar licuadora.","Ajusta la consistencia con el agua reservada, hasta lograr un puré espeso que se sostiene en la cuchara sin escurrir.","Sírvela tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con una cuchara de bebé, sin trozos firmes."]},{"id":49,"name":"Crema de Maíz con Pollo","cat":"m8","icon":"🌽","time":"~25 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/6693174/pexels-photo-6693174.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de granos de maíz tierno cocidos","1 filete de pollo cocido y deshebrado","Agua o caldo casero sin sal, lo suficiente para cubrir"],"tip":"Maíz → arvejas (chícharos) bien cocidas y aplastadas, en la misma cantidad.","steps":["Cocina 1 taza de granos de maíz tierno en agua hasta que queden muy suaves, unos 10 minutos.","Aplasta el maíz con un tenedor o un pisapapas hasta deshacer bien la cascarita de cada grano, formando una crema espesa con trocitos suaves.","Cocina el filete de pollo hasta que no quede ninguna parte rosada y deshébralo muy fino con los dedos.","Mezcla el pollo deshebrado con la crema de maíz y calienta a fuego bajo 3 minutos, agregando un poco de agua o caldo casero sin sal si hace falta.","Revisa que no haya quedado ningún grano entero antes de servir.","Sírvela tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, con los trocitos suaves de maíz y pollo bien a la vista."],"alerta":"Aplasta bien cada grano de maíz: la cascarita puede quedar entera aun cocida y es riesgo de atragantamiento si se le ofrece al bebé."},{"id":50,"name":"Puré Espeso de Yuca con Carne","cat":"m8","icon":"🍽️","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/30893342/pexels-photo-30893342.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1/2 taza de yuca cocida, sin la hebra del centro","3 cucharadas de carne molida bien cocida","1 chorrito de aceite de oliva"],"tip":"Yuca → papa, en el mismo volumen, con la misma preparación.","steps":["Pela la yuca y quítale por completo la hebra fibrosa del centro antes de cocinarla.","Cocina 1/2 taza de yuca en agua hasta que un tenedor la atraviese sin resistencia, unos 20 minutos.","Aplasta la yuca todavía caliente, dejando una textura un poco espesa, con trocitos suaves.","Cocina bien 3 cucharadas de carne molida, hasta que pierda todo el color rosado, y desmenúzala fino con un tenedor.","Mezcla la carne con la yuca aplastada y agrega 1 chorrito de aceite de oliva.","Sírvelo tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, revisando que los trocitos de yuca y carne estén suaves."],"alerta":"Quita por completo la hebra fibrosa del centro de la yuca antes de cocinarla: no se ablanda y es riesgo de atragantamiento."},{"id":51,"name":"Panqueque de Zanahoria en Tiras","cat":"m8","icon":"🥕","time":"~15 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/7144275/pexels-photo-7144275.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 zanahoria rallada fina y cocida","1 huevo","3 cucharadas de avena en hojuelas finas"],"tip":"Zanahoria → calabacita rallada fina, en la misma cantidad.","steps":["Ralla fina 1 zanahoria y cocínala al vapor hasta que quede muy suave, unos 5 minutos.","Bate 1 huevo con un tenedor y mézclalo con la zanahoria cocida y 3 cucharadas de avena en hojuelas finas hasta formar una masa pareja.","Calienta un sartén antiadherente engrasado a fuego bajo y vierte porciones pequeñas de la masa.","Cocina hasta que se formen burbujas en la superficie y voltea, dorando el otro lado unos 2 minutos.","Deja que se entibie y córtalo en tiras suaves, del tamaño de un dedo de adulto.","Sírvelo tibio, quedándote cerca durante toda la comida."],"alerta":"Ofrece las tiras ya tibias y quédate al lado del niño, porque es una comida para agarrar con la mano que él mismo se lleva a la boca."},{"id":52,"name":"Sopa Cremosa de Calabacita con Pollo","cat":"m8","icon":"🍲","time":"~30 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/20150377/pexels-photo-20150377.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de calabacita (zucchini) en cubos","1 filete de pollo cocido y deshebrado","1/2 cebolla picada","Agua, lo suficiente para cubrir"],"tip":"Calabacita → calabaza (zapallo), en el mismo volumen y con la misma preparación.","steps":["Corta 1 taza de calabacita en cubos pequeños y cocínala con la 1/2 cebolla picada en agua hasta que queden muy suaves, unos 15 minutos.","Aplasta la calabacita con un tenedor o un pisapapas, dejando trocitos suaves que se noten, sin usar licuadora.","Cocina el filete de pollo hasta que no quede ninguna parte rosada y deshébralo muy fino con los dedos.","Agrega el pollo deshebrado a la calabacita aplastada y calienta a fuego bajo 3 minutos, ajustando la consistencia con el agua de cocción.","Revisa que todos los trozos se aplasten con facilidad entre los dedos antes de servir.","Sírvela tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, con los trocitos suaves de calabacita y pollo bien a la vista."]},{"id":53,"name":"Omelet de Espinaca en Tiras","cat":"m8","icon":"🍳","time":"~10 min","kcal":"105 kcal (estimado)","img":"https://images.pexels.com/photos/5639286/pexels-photo-5639286.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 huevo","1 cucharada de espinaca bien picadita","1 chorrito de aceite de oliva"],"tip":"Espinaca → acelga bien picadita, en la misma cantidad.","steps":["Lava y pica muy fino 1 cucharada de espinaca.","Bate 1 huevo con un tenedor y mezcla la espinaca picada.","Calienta un sartén antiadherente con 1 chorrito de aceite de oliva a fuego bajo.","Vierte la mezcla, tapa el sartén y cocina hasta que el omelet esté firme por completo, unos 4 minutos.","Deja que se entibie y córtalo en tiritas suaves antes de servir.","Sírvelo tibio, quedándote cerca durante toda la comida."],"alerta":"Quédate cerca durante toda la comida, porque el omelet se ofrece en tiras que el niño se lleva a la boca con la mano."},{"id":54,"name":"Puré de Frijoles Blancos con Calabaza","cat":"m8","icon":"🥣","time":"~25 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/30939663/pexels-photo-30939663.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de frijoles blancos (alubias) bien cocidos","1/2 taza de calabaza (zapallo) cocida","1 chorrito de aceite de oliva"],"tip":"Frijoles blancos → garbanzos bien cocidos, en la misma cantidad.","steps":["Cocina 3 cucharadas de frijoles blancos hasta que queden muy suaves y sin cáscara dura, o usa frijoles ya cocidos.","Aplasta bien los frijoles blancos con un tenedor hasta deshacer por completo los granos.","Cocina 1/2 taza de calabaza en cubos hasta que quede muy suave, unos 15 minutos, y aplástala también.","Mezcla los frijoles blancos y la calabaza aplastados y agrega 1 chorrito de aceite de oliva.","Revisa que no haya quedado ningún grano de frijol entero antes de servir.","Sírvelo tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, revisando que los trocitos de frijol y calabaza estén suaves."],"alerta":"Aplasta bien los granos de frijol hasta que no quede ninguno entero, porque los granos enteros son riesgo de atragantamiento en esta etapa."},{"id":55,"name":"Bolitas de Camote al Horno","cat":"m8","icon":"🧡","time":"~30 min","kcal":"95 kcal (estimado)","img":"https://images.pexels.com/photos/6072035/pexels-photo-6072035.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 8 meses","ingredients":["1 taza de camote (batata) cocido y bien aplastado","2 cucharadas de avena en hojuelas finas","1 huevo"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad, para una masa más lisa.","steps":["Cocina el camote hasta que un tenedor lo atraviese con facilidad y aplástalo bien con el tenedor, sin dejar ningún trozo duro.","En un tazón, mezcla el camote aplastado con la avena y el huevo, hasta formar una masa pareja y ligeramente húmeda.","Con las manos engrasadas, forma bolitas pequeñas y aplanadas, del tamaño de una canica.","Hornea en horno precalentado a 180°C unos 15 minutos, hasta que se doren ligeramente por fuera y estén firmes por dentro.","Deja que se enfríen hasta quedar tibias, probando en el dorso de la mano, porque el centro de la bolita guarda el calor por más tiempo.","Sírvelas como comida para agarrar con la mano, en trocitos suaves que se aplasten con facilidad entre los dedos."],"alerta":"Deja que la bolita se enfríe por dentro antes de ofrecerla: el horno guarda calor en el centro aunque la superficie ya esté fría."},{"id":56,"name":"Papilla de Garbanzos con Calabacita","cat":"m8","icon":"🫘","time":"~25 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/6252717/pexels-photo-6252717.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de garbanzos cocidos muy suaves","1/2 calabacita (zucchini) pequeña, cocida","1 chorrito (una cucharadita) de aceite de oliva"],"tip":"Garbanzos → lentejas bien cocidas y sin cáscara, en la misma cantidad.","steps":["Cocina los garbanzos en agua hasta que queden muy suaves y se deshagan con facilidad entre los dedos.","Quita una por una las pieles sueltas de los garbanzos, para evitar que se peguen en la garganta del bebé.","Cocina la calabacita en agua o al vapor hasta que quede muy suave.","Aplasta los garbanzos junto con la calabacita con un tenedor, dejando trocitos suaves que se noten, sin licuar.","Agrega 1 chorrito de aceite de oliva y mezcla bien hasta integrarlo, lo que ayuda al cuerpo del bebé a absorber las vitaminas de las verduras.","Sírvela tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, manteniendo los trocitos suaves de garbanzo y calabacita."],"alerta":"Quita bien todas las pieles sueltas de los garbanzos antes de aplastarlos, porque pueden pegarse en la garganta del bebé."},{"id":57,"name":"Albóndigas de Pescado Suaves","cat":"m10","icon":"🐟","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/35001787/pexels-photo-35001787.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["250 g de pescado blanco (como tilapia), cocido y bien deshebrado, sin espinas","1 huevo","3 cucharadas de harina de avena"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina el pescado al vapor o en agua hasta que quede muy suave y pasa los dedos por toda la carne deshebrada, quitando cualquier espina que encuentres.","Mezcla el pescado deshebrado con el huevo y la harina de avena hasta formar una masa que se moldee fácilmente.","Forma bolitas pequeñas, del tamaño de un bocado, con las manos ligeramente húmedas.","Hornea en horno precalentado a 190°C unos 18 minutos, hasta que estén firmes y ligeramente doradas por fuera.","Deja que se entibien, probando la temperatura en el dorso de la mano, antes de servir.","Ofrécelas en trocitos suaves, que se aplasten con facilidad entre los dedos."],"alerta":"Pasa los dedos por todo el pescado deshebrado antes de mezclar la masa, incluso en filetes vendidos como 'sin espinas': las espinas finas pueden pasar desapercibidas."},{"id":58,"name":"Tallarines de Zanahoria con Salsa de Tomate","cat":"m10","icon":"🍝","time":"~20 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/8156470/pexels-photo-8156470.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 zanahoria mediana, cortada en tiras finas tipo tallarín","2 tomates (jitomates) maduros, sin piel y sin semillas, picados","1 chorrito (una cucharadita) de aceite de oliva"],"tip":"Zanahoria → calabacita cortada en tiras finas, con la misma preparación.","steps":["Escalda los tomates en agua caliente por 1 minuto, quítales la piel y las semillas y pícalos bien.","Sofríe el tomate picado en el aceite de oliva a fuego bajo unos 8 minutos, hasta que se deshaga y forme una salsa espesa.","Cocina las tiras de zanahoria al vapor unos 8 minutos, hasta que queden muy suaves y se aplasten con facilidad entre los dedos.","Mezcla las tiras de zanahoria ya suaves con la salsa de tomate.","Corta las tiras en trozos cortos, de unos 2 cm, para que no queden demasiado largas en la boca del bebé.","Sírvelos tibios, probando la temperatura en el dorso de la mano."],"alerta":"Corta las tiras de zanahoria en trozos cortos antes de servir: las tiras largas pueden enredarse en la garganta al masticar."},{"id":59,"name":"Croquetitas de Arroz y Pollo al Horno","cat":"m10","icon":"🍙","time":"~30 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/39181742/pexels-photo-39181742.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arroz bien cocido","3 cucharadas de pollo cocido y deshebrado muy fino","1 huevo"],"tip":"Pollo → carne de res molida bien cocida, en la misma cantidad.","steps":["Cocina el pollo hasta que quede muy suave y deshébralo en hebras muy finas, sin partes fibrosas.","Mezcla el arroz bien cocido, el pollo deshebrado y el huevo hasta formar una masa pareja.","Forma bolitas pequeñas y aplánalas ligeramente con las manos.","Hornea en horno precalentado a 190°C unos 15 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se entibien, probando en el dorso de la mano, antes de servir.","Ofrécelas en trozos pequeños y suaves, fáciles de agarrar con las manitas."],"alerta":"Deshebra el pollo muy fino y revisa que no haya quedado ninguna hebra grande, que puede ser difícil de masticar."},{"id":60,"name":"Verduras a la Plancha en Trocitos","cat":"m10","icon":"🍆","time":"~20 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/36183197/pexels-photo-36183197.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1/2 calabacita (zucchini) en rebanadas finas","1/2 berenjena en rebanadas finas","1 zanahoria en rebanadas finas","1 chorrito (una cucharadita) de aceite de oliva"],"tip":"Berenjena → calabaza (zapallo) en rebanadas finas, con la misma preparación.","steps":["Corta la calabacita, la berenjena y la zanahoria en rebanadas muy finas y de grosor parecido.","Cocina las rebanadas a la plancha en un sartén con el aceite de oliva, a fuego medio, unos 4 minutos de cada lado, hasta que queden muy suaves.","Corta las rebanadas en trocitos pequeños, del tamaño de una uña.","Prueba cada trozo apretándolo entre el pulgar y el índice: sirve solo los que se aplastan con facilidad.","Sírvelas tibias, como comida para agarrar con la mano, repartidas en el plato."],"alerta":"Aparta cualquier trozo que siga firme en la prueba del dedo; regrésalo al sartén hasta que se ablande."},{"id":61,"name":"Croquetas de Camote con Pollo","cat":"m10","icon":"🧡","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/4617528/pexels-photo-4617528.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) mediano, cocido y bien aplastado","3 cucharadas de pollo cocido y deshebrado","1 huevo"],"tip":"Pollo → carne molida bien cocida, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese con facilidad y aplástalo bien, sin trozos duros.","Mezcla el camote aplastado, el pollo deshebrado y el huevo hasta formar una masa que no se pegue en las manos.","Forma croquetas pequeñas y alargadas, del tamaño de un dedo.","Hornea en horno precalentado a 190°C unos 18 minutos, hasta que se doren por fuera y estén firmes por dentro.","Deja que se enfríen hasta quedar tibias, probando en el dorso de la mano, antes de servir.","Ofrécelas en trozos suaves, que se aplasten con facilidad entre los dedos."],"alerta":"Revisa que el centro de la croqueta se haya enfriado bien antes de ofrecerla: el horno guarda más calor por dentro que por fuera."},{"id":62,"name":"Sándwich Abierto de Hummus con Zanahoria","cat":"m10","icon":"🥪","time":"~10 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/17430516/pexels-photo-17430516.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 rebanada de pan integral","2 cucharadas de hummus casero (garbanzos cocidos molidos con aceite de oliva)","1 cucharada de zanahoria rallada muy fina"],"tip":"Hummus → ricota aplastada, en la misma cantidad, si lo prefieres.","steps":["Muele los garbanzos cocidos con un chorrito de aceite de oliva hasta formar una pasta lisa: el hummus.","Unta una capa delgada de hummus sobre la rebanada de pan integral.","Cúbrela con la zanahoria rallada, presionando un poco para que se pegue al hummus.","Corta la rebanada en tiras largas, del tamaño de un dedo, nunca en cuadritos.","Sírvelo a temperatura ambiente, supervisando al bebé durante toda la comida."],"alerta":"Ofrécelo siempre en tiras largas: los cuadritos de migajón pueden pegarse en el paladar del bebé."},{"id":63,"name":"Omelet de Papa en Tiras","cat":"m10","icon":"🥔","time":"~15 min","kcal":"125 kcal (estimado)","img":"https://images.pexels.com/photos/14941247/pexels-photo-14941247.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["2 huevos","1/2 papa pequeña, cocida y picada muy fina","1 chorrito (una cucharadita) de aceite de oliva"],"tip":"Papa → camote (batata) cocido y picado fino, en la misma cantidad.","steps":["Cocina la papa hasta que quede muy suave y pícala en trocitos muy pequeños.","Bate los huevos con un tenedor y mezcla la papa picada.","Calienta un sartén antiadherente con el aceite de oliva a fuego bajo y vierte la mezcla.","Tapa el sartén y cocina unos 6 minutos, hasta que el omelet esté totalmente firme, sin partes líquidas.","Corta el omelet en tiras largas y suaves, del tamaño de un dedo.","Sírvelo tibio, probando la temperatura en el dorso de la mano."],"alerta":"Sírvelo siempre en tiras, nunca en cuadritos de huevo, que son más difíciles de masticar y tragar."},{"id":64,"name":"Remolacha en Cubos Suaves","cat":"m10","icon":"🍠","time":"~20 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/33893318/pexels-photo-33893318.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 remolacha (betabel) pequeña, pelada y cortada en cubos pequeños","1 chorrito (una cucharadita) de aceite de oliva"],"tip":"Remolacha → zanahoria en cubos pequeños, con la misma preparación.","steps":["Corta la remolacha en cubos pequeños, del tamaño de una arveja.","Cocina los cubos al vapor unos 15 minutos, hasta que queden muy suaves.","Confirma que cada cubo se aplaste con facilidad entre el pulgar y el índice; si todavía está firme, cocínalo unos minutos más.","Agrega 1 chorrito de aceite de oliva y mezcla con cuidado, sin aplastar los cubos, para mantener la forma ideal para que el bebé los agarre solo.","Sírvelos tibios, como comida para agarrar con la mano, ofreciendo pocos cubos a la vez y supervisando al bebé."],"alerta":"Ofrece pocos cubos a la vez y quédate cerca del bebé durante toda la comida, como con cualquier comida para agarrar con la mano."},{"id":65,"name":"Ñoquis de Camote con Salsa de Tomate","cat":"m12","icon":"🍝","time":"~40 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/6240973/pexels-photo-6240973.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 12 meses","ingredients":["2 camotes (batatas) medianos, cocidos y bien aplastados","1 taza de harina de trigo (o harina de avena)","1 huevo","1/2 taza de salsa de tomate casera, sin sal"],"tip":"Harina de trigo → harina de avena, para una versión sin gluten.","steps":["Aplasta bien los camotes cocidos hasta que no quede ningún trozo duro.","Mezcla el camote, la harina y el huevo hasta formar una masa suave que no se pegue en las manos.","Forma rollitos delgados sobre una superficie enharinada y corta trocitos pequeños, del tamaño de una aceituna.","Cocina los ñoquis en agua hirviendo hasta que suban a la superficie, lo que tarda unos 3 minutos.","Escúrrelos y mézclalos con la salsa de tomate casera sin sal, ya tibia.","Sírvelos en trozos pequeños, probando que cada uno se aplaste con facilidad entre los dedos."],"alerta":"Corta los ñoquis muy pequeños antes de cocinarlos: las piezas grandes y suaves pueden tragarse enteras."},{"id":66,"name":"Risotto de Pollo con Zanahoria","cat":"m12","icon":"🍚","time":"~30 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/29038167/pexels-photo-29038167.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de arroz","1 filete de pollo cortado en cubos pequeños","1 zanahoria cortada en cubos pequeños","2 tazas de caldo casero sin sal (de verduras o de huesos), de a poco"],"tip":"Zanahoria → calabacita (zucchini) en cubos pequeños, en la misma cantidad.","steps":["Sofríe el pollo en una olla hasta que se dore por fuera y se cocine por dentro, sin que quede rosado en el centro.","Agrega el arroz y mezcla por 1 minuto para que los granos se impregnen.","Ve agregando el caldo casero sin sal, un cucharón a la vez, revolviendo siempre y agregando más solo cuando el arroz absorba el líquido.","Añade la zanahoria en cubos en los últimos 10 minutos de cocción, hasta que esté bien suave.","Cocina hasta que el arroz esté suave y cremoso, lo que lleva unos 20 minutos en total.","Sirve tibio, en porciones pequeñas en un plato, probando la temperatura en el dorso de la mano y revisando que el arroz y la zanahoria estén bien suaves."],"alerta":"Usa siempre caldo casero sin sal: los caldos en cubito o en sobre no se deben usar antes de los 2 años."},{"id":67,"name":"Pasta con Albóndigas de Pescado","cat":"m12","icon":"🍝","time":"~30 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/31109620/pexels-photo-31109620.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de pasta corta (tipo tornillo), cocida","6 albóndigas de pescado ya preparadas (receta Albóndigas de Pescado Suaves), cortadas por la mitad","1/2 taza de salsa de tomate casera, sin sal"],"tip":"Albóndigas de pescado → albóndigas de pollo, en la misma cantidad.","steps":["Calienta las albóndigas de pescado ya preparadas junto con la salsa de tomate casera sin sal, a fuego bajo, por unos 5 minutos.","Corta cada albóndiga por la mitad, revisando una vez más que no tenga espinas.","Mezcla las albóndigas con la pasta ya cocida y suave.","Corta la pasta en trozos pequeños, si las piezas son largas.","Sirve tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo al bebé."],"alerta":"Aunque uses albóndigas ya preparadas, corta cada una por la mitad antes de servir para revisar otra vez que no tenga espinas."},{"id":68,"name":"Guiso de Pollo con Verduras","cat":"m12","icon":"🍗","time":"~35 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/37101629/pexels-photo-37101629.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de 1 año","ingredients":["1 filete de pollo cortado en cubos pequeños","1 papa cortada en cubos pequeños","1 zanahoria cortada en cubos pequeños","1 taza de caldo casero sin sal"],"tip":"Pollo → carne de res magra en cubos pequeños, con la misma preparación.","steps":["Sofríe el pollo en una olla hasta que se dore un poco por fuera.","Agrega la papa y la zanahoria en cubos y cubre con el caldo casero sin sal, lo suficiente para que se cocine sin pegarse al fondo.","Cocina a fuego bajo, con la olla semitapada, por unos 20 minutos, hasta que las verduras estén bien suaves.","Confirma el punto pinchando un trozo de papa con el tenedor: debe atravesarlo sin resistencia.","Aplasta un poco los cubos más grandes, si hace falta, para que sea más fácil masticar.","Sirve tibio, en trozos pequeños en un plato, probando la temperatura en el dorso de la mano antes de ofrecerlo para que el niño coma solo."],"alerta":"Usa solo caldo casero sin sal; nunca lo cambies por caldo industrializado en cubito o en sobre."},{"id":69,"name":"Panqueque Salado de Zanahoria","cat":"m12","icon":"🥕","time":"~15 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/38163967/pexels-photo-38163967.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 zanahoria mediana, rallada fina","2 huevos","3 cucharadas de harina de avena"],"tip":"Zanahoria → calabacita (zucchini) rallada fina, en la misma cantidad.","steps":["Bate los huevos con la harina de avena hasta formar una masa lisa, sin grumos.","Mezcla la zanahoria rallada con la masa de huevo y avena, repartiendo bien los trocitos en toda la mezcla.","Calienta un sartén antiadherente a fuego bajo y vierte porciones pequeñas de la masa.","Cocina unos 2 minutos de cada lado, volteando cuando se dore y esté firme en los bordes.","Corta cada panqueque en tiras largas, nunca en trozos redondos.","Sirve tibio, probando la temperatura en el dorso de la mano, siempre en tiras largas, nunca en trozos redondos."],"alerta":"Corta siempre en tiras: los trozos redondos del tamaño de la vía respiratoria son la forma más peligrosa de ofrecer cualquier alimento."},{"id":70,"name":"Pescado a la Plancha con Puré de Papa","cat":"m12","icon":"🐟","time":"~25 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/5374413/pexels-photo-5374413.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 filete de pescado blanco (como tilapia), sin espinas","2 papas medianas, cocidas","1 chorrito (cucharadita) de aceite de oliva"],"tip":"Pescado blanco → pollo a la plancha en cubos pequeños, con la misma preparación.","steps":["Cocina el filete de pescado en un sartén con el aceite de oliva, a fuego medio, por unos 4 minutos de cada lado, hasta que se dore y se cocine por dentro.","Desmenuza el pescado con un tenedor y pasa los dedos por toda la carne, revisando que no quede ninguna espina.","Machaca las papas cocidas con un tenedor hasta formar un puré cremoso, sin trozos duros.","Mezcla un chorrito de aceite de oliva con el puré para que quede más suave, si hace falta.","Sirve el pescado desmenuzado sobre el puré, tibio, probando la temperatura en el dorso de la mano."],"alerta":"Pasa los dedos por todo el pescado desmenuzado antes de servir, aunque el filete se venda 'sin espinas': las espinas finas pueden pasar desapercibidas."},{"id":71,"name":"Sopa de Calabaza con Pasta","cat":"m12","icon":"🍲","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/5605551/pexels-photo-5605551.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de calabaza (zapallo) en cubos","2 cucharadas de pasta de letras","2 tazas de caldo casero sin sal"],"tip":"Calabaza → camote (batata) en cubos, con la misma preparación.","steps":["Cocina la calabaza en el caldo casero sin sal hasta que esté bien suave, lo que lleva unos 15 minutos.","Agrega la pasta de letras y cocina el tiempo indicado en el empaque, revolviendo de vez en cuando.","Machaca un poco parte de la calabaza con un tenedor, directo en la olla, para espesar el caldo.","Revisa que la calabaza se deshaga fácilmente al presionarla con la cuchara.","Sirve tibia, nunca caliente, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Usa siempre caldo casero sin sal y sirve tibia: una sopa demasiado caliente es un riesgo real de quemadura en la boca del bebé."},{"id":72,"name":"Omelette Relleno de Queso y Espinaca","cat":"m12","icon":"🧀","time":"~15 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/5639284/pexels-photo-5639284.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["2 huevos","1 cucharada de queso fresco rallado, bajo en sodio","2 cucharadas de espinaca picada muy fina","1 chorrito (cucharadita) de aceite de oliva (para engrasar el sartén)"],"tip":"Queso fresco rallado → ricota machacada, en la misma cantidad.","steps":["Bate los huevos con un tenedor hasta que queden uniformes.","Calienta un sartén antiadherente con un chorrito de aceite de oliva a fuego bajo y vierte los huevos batidos.","Reparte la espinaca picada y el queso sobre la mitad del omelette.","Cuando el omelette esté firme por debajo, dobla la otra mitad por encima y cocina 1 minuto más, hasta que el queso se derrita un poco.","Corta en trozos suaves y pequeños antes de servir.","Sirve tibio, probando la temperatura en el dorso de la mano."],"alerta":"Prefiere siempre queso fresco poco salado: los quesos amarillos y los rallados tipo parmesano tienen demasiado sodio para esta etapa."},{"id":73,"name":"Arroz al Horno con Pollo y Maíz","cat":"m18","icon":"🍚","time":"~35 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/32039641/pexels-photo-32039641.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz blanco o integral ya cocido","1 filete de pollo cocido y cortado en cubos pequeños (unos 100 g)","3 cucharadas de granos de maíz cocidos","2 huevos batidos"],"tip":"Maíz → arvejas (chícharos) cocidas, en la misma cantidad.","steps":["En un tazón grande, mezcla el arroz cocido, el pollo en cubos pequeños y el maíz cocido.","Agrega los huevos batidos y mezcla bien hasta formar una masa húmeda y pareja.","Vierte en una fuente engrasada con un chorrito de aceite de oliva, formando una capa de unos 3 cm.","Hornea en el horno precalentado a 190 °C por unos 20 minutos, hasta que se dore por encima y esté firme por dentro (pincha un tenedor en el centro: debe salir limpio).","Deja entibiar unos minutos y corta en trozos pequeños y suaves, del tamaño de un dedo.","Sirve tibio, probando la temperatura en el dorso de tu mano antes de ofrecer."],"alerta":"Deja que la fuente se entibie bien antes de servir: el centro del arroz al horno guarda el calor por más tiempo que la superficie."},{"id":74,"name":"Hamburguesa Casera de Carne","cat":"m18","icon":"🍔","time":"~25 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/8880741/pexels-photo-8880741.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 18 meses","ingredients":["300 g de carne molida magra","1 huevo","2 cucharadas de harina de avena","1 cucharadita de hierbas frescas picadas (perejil o albahaca)"],"tip":"Carne molida → pollo molido, en la misma cantidad.","steps":["En un tazón, mezcla la carne molida, el huevo, la harina de avena y las hierbas picadas hasta formar una masa pareja que no se pegue a las manos.","Con las manos húmedas, forma discos pequeños y aplanados, de unos 1,5 cm de grosor.","Cocina a fuego medio en un sartén antiadherente por unos 4 minutos de cada lado, hasta que se doren por fuera y no quede ninguna parte rosada por dentro.","Corta cada hamburguesa en tiras o trozos pequeños antes de llevarla a la mesa: nunca ofrezcas el disco entero.","Sirve tibia, sola o dentro de un trozo de pan suave, con el niño bien sentado y con supervisión durante toda la comida."],"alerta":"Nunca ofrezcas la hamburguesa entera y redonda: córtala siempre en tiras o trozos pequeños antes de servir, porque el disco tiene la forma que más riesgo de atragantamiento causa."},{"id":75,"name":"Filete de Pescado a la Plancha con Verduras","cat":"m18","icon":"🐟","time":"~25 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/5192412/pexels-photo-5192412.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 filete de pescado blanco sin espinas (unos 100 g)","1/2 calabacita (zucchini) cortada en bastones finos","1/2 zanahoria cortada en bastones finos","1 cucharadita de aceite de oliva"],"tip":"Pescado blanco → pollo en tiras, con la misma preparación, si prefieres no usar pescado ese día.","steps":["Corta la calabacita y la zanahoria en bastones finos, del tamaño de un dedo, nunca en rodajas, que pueden atorarse en la garganta del niño.","Calienta el aceite de oliva en un sartén y cocina el pescado y los bastones de verdura a fuego medio.","Cocina por unos 8 a 10 minutos, volteando a la mitad del tiempo, hasta que el pescado esté bien blanco y las verduras lo bastante suaves para aplastarlas entre los dedos.","Desmenuza el pescado con un tenedor y revisa con mucho cuidado, trozo por trozo, que no haya quedado ninguna espina.","Corta los bastones de verdura en trozos más pequeños, del tamaño adecuado para la mano del niño.","Sirve tibio, en trocitos, con un adulto cerca durante toda la comida."],"alerta":"Revisa cada trozo de pescado con atención antes de servir: las espinas finas pueden pasar desapercibidas incluso en filetes ya limpios."},{"id":76,"name":"Tarta Salada de Pollo","cat":"m18","icon":"🥧","time":"~40 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/39070794/pexels-photo-39070794.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"6 porciones","ageRec":"A partir de los 18 meses","ingredients":["2 huevos","1 taza de pollo cocido y deshebrado","1 taza de harina de avena","1/2 taza de leche (de vaca o vegetal sin azúcar)"],"tip":"Leche → leche vegetal sin azúcar, en la misma cantidad.","steps":["Bate los huevos y mézclalos con el pollo deshebrado, la harina de avena y la leche hasta formar una masa uniforme y sin grumos.","Vierte la masa en un molde engrasado, formando una capa de unos 3 cm de alto.","Hornea en el horno precalentado a 190 °C por unos 25 minutos, hasta que se dore por encima y esté firme por dentro.","Pincha un palillo en el centro: si sale limpio, la tarta está lista; si sale húmedo, déjala hornear 5 minutos más.","Deja entibiar y corta en rebanadas suaves y pequeñas, del tamaño de un dedo.","Sirve tibia, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":77,"name":"Guiso de Carne con Papas","cat":"m18","icon":"🥩","time":"~35 min","kcal":"205 kcal (estimado)","img":"https://images.pexels.com/photos/36627088/pexels-photo-36627088.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["250 g de carne magra en cubos pequeños","2 papas medianas en cubos pequeños","1 zanahoria en cubos pequeños","1 taza de caldo casero sin sal (agua de cocción de verduras o caldo de carne casero)"],"tip":"Carne → pollo en cubos, con la misma preparación.","steps":["Sofríe la carne a fuego medio hasta que se dore un poco por todos los lados.","Agrega la papa, la zanahoria y el caldo casero sin sal, cubriendo los ingredientes.","Tapa la olla y cocina a fuego bajo por unos 25 minutos, hasta que la carne y las verduras estén bien suaves.","Prueba el punto pinchando un tenedor en la papa y la zanahoria: deben aplastarse con facilidad entre el pulgar y el índice.","Si hace falta, deshebra o corta la carne en trozos todavía más pequeños antes de servir.","Sirve tibio, en trozos pequeños, con el niño bien sentado durante la comida."],"alerta":"Usa siempre caldo casero sin sal: los caldos listos y los cubitos de sazón industrializados no son seguros en esta etapa."},{"id":78,"name":"Kibbeh al Horno con Calabacita","cat":"m18","icon":"🧆","time":"~35 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/2337842/pexels-photo-2337842.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"4 porciones","ageRec":"A partir de los 18 meses","ingredients":["250 g de carne molida magra","1/2 taza de trigo bulgur ya hidratado","1/2 calabacita (zucchini) rallada (alrededor de 1/2 taza)"],"tip":"Trigo bulgur → avena en hojuelas finas hidratada, en la misma cantidad.","steps":["Mezcla la carne molida, el trigo bulgur ya hidratado y la calabacita rallada hasta formar una masa pareja.","Extiende la masa en una bandeja para horno engrasada, en una capa fina de unos 1,5 cm.","Hornea en el horno precalentado a 190 °C por unos 25 minutos, hasta que se dore por encima y se cocine por completo por dentro.","Revisa que no quede ninguna parte cruda en el centro antes de sacarlo del horno.","Deja entibiar y corta en cuadritos pequeños y suaves, que se aplasten con facilidad entre los dedos.","Sirve tibio, en cuadritos pequeños en un plato, probando la temperatura en el dorso de la mano antes de ofrecerlo para que el niño coma con las manos."]},{"id":79,"name":"Risotto de Verduras de Colores","cat":"m18","icon":"🍚","time":"~30 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/32125954/pexels-photo-32125954.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz","1/2 calabacita (zucchini) en cubos pequeños","1/2 zanahoria en cubos pequeños","2 tazas de caldo casero sin sal"],"tip":"Verduras → usa las de temporada, siempre en cubos pequeños y suaves, del tamaño que se aplaste fácil entre los dedos.","steps":["Sofríe la calabacita y la zanahoria en cubos pequeños por unos 2 minutos, solo para que empiecen a ablandarse.","Agrega el arroz y sofríe 1 minuto más, revolviendo siempre, para que los granos queden bien impregnados antes de recibir el caldo.","Ve agregando el caldo casero sin sal, un cucharón a la vez, revolviendo siempre y esperando que el líquido se absorba antes del siguiente cucharón.","Sigue así por unos 18 minutos, hasta que el arroz esté cremoso y las verduras lo bastante suaves para aplastarlas entre los dedos.","Sirve tibio, en porciones pequeñas en un plato, probando la temperatura en el dorso de la mano y revisando que las verduras estén bien suaves."]},{"id":80,"name":"Panqueque de Zanahoria y Avena","cat":"m18","icon":"🥞","time":"~15 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/730922/pexels-photo-730922.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 zanahoria rallada y cocida (alrededor de 1/2 taza)","1 huevo","1/2 taza de harina de avena","1 cucharadita de polvo para hornear"],"tip":"Harina de avena → harina de arroz, para una versión sin gluten.","steps":["Mezcla la zanahoria rallada y cocida con el huevo, la harina de avena y el polvo para hornear hasta formar una masa uniforme y sin grumos.","Calienta un sartén antiadherente engrasado con un chorrito de aceite a fuego medio.","Vierte porciones pequeñas de la masa, formando panqueques de unos 6 cm de diámetro.","Voltea cada panqueque cuando aparezcan burbujitas en la superficie y dóralo unos 2 minutos más del otro lado.","Corta cada panqueque en tiras o trozos pequeños antes de servir: nunca ofrezcas el disco entero.","Sirve tibio, en tiras o trozos pequeños en un plato, probando la temperatura en el dorso de la mano antes de ofrecerlo al niño."],"alerta":"No sirvas el panqueque entero y redondo: córtalo en tiras o trozos antes de ofrecer, para reducir el riesgo de atragantamiento."},{"id":81,"name":"Puré de Calabacita con Pollo Deshebrado","cat":"m6","icon":"🥒","time":"~20 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/5440958/pexels-photo-5440958.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 calabacita (zucchini) pequeña pelada y picada (alrededor de 1 taza)","2 cucharadas de pollo cocido y deshebrado muy fino","2 a 3 cucharadas del agua de cocción"],"tip":"Calabacita → calabaza (zapallo), en el mismo volumen.","steps":["Cocina la calabacita en cubos, en agua sin sal, por unos 12 minutos, hasta que un tenedor la atraviese fácilmente.","Mientras tanto, cocina el pollo y deshébralo muy fino, sin hebras gruesas.","Machaca la calabacita todavía caliente con un tenedor, nunca en la licuadora, hasta hacer un puré espeso.","Mezcla bien el pollo deshebrado con el puré de calabacita, repartiendo las hebritas en toda la papilla hasta que se integren bien.","Ajusta la consistencia con un poco del agua de cocción, hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano antes de ofrecerlo con cuchara."]},{"id":82,"name":"Puré de Papa con Espinaca","cat":"m6","icon":"🥔","time":"~25 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/32862467/pexels-photo-32862467.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 papa pequeña pelada y picada (alrededor de 1 taza)","2 hojas de espinaca bien picadas","1/2 taza de agua"],"tip":"Papa → camote (batata), en el mismo volumen.","steps":["Cocina la papa en agua sin sal por unos 15 minutos, hasta que un tenedor la atraviese sin resistencia.","En los últimos 2 minutos de cocción, agrega la espinaca picada a la misma olla para que se ablande.","Escurre bien las verduras, guardando un poco del agua de cocción para ajustar la consistencia de la papilla.","Machaca todo con un tenedor hasta hacer una papilla lisa y espesa, nunca en la licuadora.","Ajusta la textura con el agua que guardaste, hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con una cuchara de bebé, sin grumos ni trozos firmes."]},{"id":83,"name":"Papilla de Pera con Camote","cat":"m6","icon":"🍐","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/9213960/pexels-photo-9213960.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 pera madura sin cáscara y sin semillas","1/2 camote (batata) pequeño pelado","1/2 taza de agua"],"tip":"Pera → manzana cocida, con la misma preparación.","steps":["Cocina el camote en cubos, en agua, por unos 15 minutos, hasta que un tenedor lo atraviese fácilmente.","En los últimos 5 minutos, agrega la pera en cubos para que se cocine junto y se ablande.","Escurre el camote y la pera, guardando un poco del agua de cocción para ajustar después la consistencia de la papilla.","Machaca todo con un tenedor hasta formar una papilla espesa y lisa, nunca en la licuadora.","Ajusta la consistencia con el agua que guardaste, hasta que quede un puré espeso que no se escurra de la cuchara.","Sirve tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y observa si el bebé acepta bien la papilla machacada con tenedor."]},{"id":84,"name":"Puré de Arvejas con Pescado Blanco","cat":"m6","icon":"🟢","time":"~20 min","kcal":"90 kcal (estimado)","img":"https://images.pexels.com/photos/768089/pexels-photo-768089.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["3 cucharadas de arvejas (chícharos) frescas o congeladas","2 cucharadas de filete de pescado blanco cocido, sin espinas","2 cucharadas del agua de cocción"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina las arvejas en agua sin sal por unos 8 minutos, hasta que estén bien suaves.","Cocina el filete de pescado en agua o al vapor hasta que esté completamente blanco y se deshaga al tocarlo con el tenedor.","Desmenuza el pescado con un tenedor y revisa trozo por trozo, con mucha atención, que no haya quedado ninguna espina.","Machaca las arvejas todavía calientes con un tenedor, sin licuar, hasta hacer un puré espeso y sin granos enteros.","Mezcla el pescado desmenuzado con el puré, ajustando la consistencia con el agua de cocción.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y revisa que el puré quede parejo y sin grumos."],"alerta":"Revisa con cuidado cada trozo de pescado antes de servir: las espinas finas pueden pasar desapercibidas incluso en filetes ya limpios."},{"id":85,"name":"Papilla de Melón con Avena","cat":"m6","icon":"🍈","time":"~10 min","kcal":"70 kcal (estimado)","img":"https://images.pexels.com/photos/5525779/pexels-photo-5525779.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1 rebanada de melón maduro, sin semillas y sin cáscara (alrededor de 1/2 taza picado)","1 cucharada de avena en hojuelas finas"],"tip":"Avena en hojuelas finas → harina de avena, en la misma cantidad.","steps":["Corta el melón en cubos pequeños y machácalo bien con un tenedor hasta formar una papilla.","Mezcla la avena en hojuelas finas con la papilla de melón, integrándola bien para que se reparta de forma pareja.","Deja reposar unos 2 minutos, para que la avena se hidrate y espese de forma natural.","Revuelve otra vez y revisa que la consistencia esté lo bastante espesa para no escurrirse de la cuchara.","Sirve al momento, a temperatura ambiente, en cucharadas pequeñas, observando si el bebé acepta bien la consistencia espesa de la papilla."]},{"id":86,"name":"Puré de Remolacha con Papa","cat":"m6","icon":"🍠","time":"~30 min","kcal":"75 kcal (estimado)","img":"https://images.pexels.com/photos/6607319/pexels-photo-6607319.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/4 de remolacha (betabel) pequeña pelada y picada","1/2 papa pequeña pelada y picada","1/2 taza de agua"],"tip":"Remolacha → zanahoria cocida, en el mismo volumen.","steps":["Cocina la remolacha y la papa juntas, en agua sin sal, por unos 20 minutos, hasta que un tenedor atraviese fácilmente las dos.","Escurre la remolacha y la papa, guardando un poco del agua de cocción para ajustar la papilla después.","Machaca todo con un tenedor hasta formar una papilla lisa y espesa, nunca en la licuadora.","Ajusta la consistencia con el agua que guardaste, hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y observa si el color morado no le extraña al bebé la primera vez."]},{"id":87,"name":"Papilla de Ciruela con Camote","cat":"m6","icon":"🍑","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/4828583/pexels-photo-4828583.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["2 ciruelas frescas maduras, sin hueso y sin cáscara","1/2 camote (batata) pequeño pelado","1/2 taza de agua"],"tip":"Ciruela → pera cocida, con la misma preparación.","steps":["Cocina el camote en cubos, en agua, por unos 15 minutos, hasta que un tenedor lo atraviese fácilmente.","En los últimos 5 minutos, agrega la ciruela en trozos para que se cocine junto y se ablande.","Escurre el camote y la ciruela, guardando un poco del agua de cocción para ajustar la papilla después.","Machaca todo con un tenedor hasta formar una papilla lisa, nunca en la licuadora.","Ajusta la consistencia con el agua que guardaste, hasta que quede un puré espeso que no se escurra de la cuchara.","Sirve tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y observa si el bebé acepta bien el sabor un poco ácido de la ciruela."],"alerta":"Revisa que no haya quedado ningún pedacito de hueso de la ciruela antes de servir."},{"id":88,"name":"Puré de Calabaza con Carne Molida","cat":"m6","icon":"🎃","time":"~25 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/6853444/pexels-photo-6853444.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de calabaza (zapallo) cocida y picada","2 cucharadas de carne molida magra bien cocida","2 cucharadas del agua de cocción"],"tip":"Carne molida → pollo deshebrado muy fino, en la misma cantidad.","steps":["Cocina la calabaza en cubos, en agua sin sal, por unos 15 minutos, hasta que un tenedor la atraviese fácilmente.","Cocina la carne molida a fuego bajo hasta que pierda por completo el color rosado, revolviendo para deshacer bien los grumos.","Machaca la calabaza todavía caliente con un tenedor hasta hacer un puré espeso.","Mezcla la carne molida bien deshecha con el puré de calabaza, repartiendo la carne en toda la papilla.","Ajusta la consistencia con un poco del agua de cocción, hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y revisa que no haya quedado ningún grumo duro de carne."]},{"id":89,"name":"Papilla de Mango con Avena","cat":"m6","icon":"🥭","time":"~10 min","kcal":"85 kcal (estimado)","img":"https://images.pexels.com/photos/16724965/pexels-photo-16724965.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 mango maduro, pelado y sin hueso","1 cucharada de avena en hojuelas finas"],"tip":"Mango → papaya, en la misma cantidad.","steps":["Corta el mango maduro en cubos pequeños y machácalo bien con un tenedor hasta formar una papilla.","Mezcla la avena en hojuelas finas con la papilla de mango, integrándola bien para que se reparta de forma pareja.","Deja reposar unos 2 minutos, para que la avena se hidrate y espese de forma natural.","Revuelve otra vez y revisa que la consistencia esté lo bastante espesa para no escurrirse de la cuchara.","Sirve al momento, a temperatura ambiente, en cucharadas pequeñas, observando si el bebé acepta bien la consistencia espesa de la papilla."]},{"id":90,"name":"Puré de Ejotes con Pollo","cat":"m6","icon":"🫛","time":"~20 min","kcal":"80 kcal (estimado)","img":"https://images.pexels.com/photos/4983086/pexels-photo-4983086.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 6 meses","ingredients":["1/2 taza de ejotes (judías verdes) cocidos y picados","2 cucharadas de pollo cocido y deshebrado muy fino","2 a 3 cucharadas del agua de cocción"],"tip":"Ejotes → calabacita (zucchini), en el mismo volumen.","steps":["Cocina los ejotes en agua sin sal por unos 10 minutos, hasta que un tenedor los atraviese fácilmente.","Mientras tanto, cocina el pollo y deshébralo muy fino, sin hebras gruesas.","Machaca los ejotes todavía calientes con un tenedor, nunca en la licuadora, hasta hacer un puré espeso.","Mezcla el pollo deshebrado con el puré de ejotes, revolviendo bien hasta repartir las hebras en toda la papilla.","Ajusta la consistencia con un poco del agua de cocción, hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, y revisa que el puré esté lo bastante espeso para no escurrirse."]},{"id":91,"name":"Purecito de Lentejas con Verduras","cat":"m8","icon":"🫘","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/35763746/pexels-photo-35763746.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de lentejas bien cocidas y machacadas","2 cucharadas de zanahoria cocida y machacada","2 cucharadas de calabacita (zucchini) cocida y machacada"],"tip":"Lentejas → garbanzos bien cocidos y machacados, en la misma cantidad.","steps":["Cocina 3 cucharadas de lentejas en agua sin sal hasta que estén bien suaves, unos 20 minutos.","Cocina la zanahoria y la calabacita hasta que un tenedor las atraviese fácilmente, alrededor de 10 minutos.","Machaca las lentejas y las verduras juntas con un tenedor hasta formar un puré espeso, sin trozos duros.","Prueba la temperatura en el dorso de la mano: la papilla tiene que estar tibia, nunca caliente.","Sirve en cucharadas pequeñas, ofreciendo una cucharada a la vez."]},{"id":92,"name":"Pollo con Puré de Calabaza y Maíz","cat":"m8","icon":"🌽","time":"~25 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/5605554/pexels-photo-5605554.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 cucharadas de pollo cocido y deshebrado muy fino","1/2 taza de calabaza (zapallo) cocida y machacada","2 cucharadas de granos de maíz cocidos y bien machacados"],"tip":"Maíz → arvejas (chícharos) bien cocidas y machacadas, en la misma cantidad.","steps":["Cocina la calabaza en agua hasta que esté bien suave, unos 15 minutos, y machácala con un tenedor.","Cocina el maíz hasta que esté suave y machácalo bien, hasta que no quede ningún grano entero.","Deshebra el pollo ya cocido en hebras muy finas.","Mezcla el pollo deshebrado con el puré de calabaza y maíz, formando una papilla espesa y pareja.","Sirve tibia, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Machaca bien los granos de maíz, porque un grano entero puede causar atragantamiento en esta etapa."},{"id":93,"name":"Croquetitas de Camote y Espinaca al Vapor","cat":"m8","icon":"🥬","time":"~25 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/37332307/pexels-photo-37332307.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/2 camote (batata) mediano, cocido y machacado","4 hojas de espinaca bien picadas y salteadas rápidamente","1 cucharada de harina de avena (para que tome consistencia)"],"tip":"Espinaca → acelga bien picadita y salteada, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese sin resistencia y machácalo todavía caliente.","Saltea las hojas de espinaca picadas en una olla con un chorrito de agua por 2 minutos.","Mezcla el camote, la espinaca y la harina de avena hasta formar una masa que no se pegue a las manos.","Forma con la masa bastoncitos aplanados del tamaño de un dedo, nunca bolitas redondas.","Cocina los bastoncitos al vapor por 5 minutos, hasta que estén firmes por fuera y suaves por dentro.","Sirve tibios, uno a la vez, con el niño sentado y con supervisión."],"alerta":"Forma siempre bastones aplanados, nunca bolitas redondas, para reducir el riesgo de atragantamiento."},{"id":94,"name":"Puré de Pescado con Calabacita y Zanahoria","cat":"m8","icon":"🐟","time":"~25 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/28435308/pexels-photo-28435308.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["2 cucharadas de filete de pescado blanco cocido, sin espinas","1/4 de calabacita (zucchini) cocida","1/4 de zanahoria cocida"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina el filete de pescado hasta que esté bien suave y desmenúzalo con los dedos, revisando con cuidado que no haya quedado ninguna espina.","Cocina la calabacita y la zanahoria hasta que un tenedor las atraviese fácilmente, unos 15 minutos.","Machaca las verduras y el pescado juntos con un tenedor hasta formar un puré espeso y parejo.","Pasa los dedos por la papilla una vez más para confirmar que no hay ningún pedacito de espina.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con trocitos suaves que el bebé ya pueda aplastar con la boca."],"alerta":"Antes de servir, pasa los dedos por la papilla para confirmar que no quedó ninguna espina de pescado."},{"id":95,"name":"Arroz Bien Cocido con Frijoles Machacados y Calabacita","cat":"m8","icon":"🍚","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/19781592/pexels-photo-19781592.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["3 cucharadas de arroz bien cocido","2 cucharadas de frijoles (porotos) cocidos y machacados, sin cáscara","2 cucharadas de calabacita (zucchini) cocida y machacada"],"tip":"Frijoles → lentejas bien cocidas y machacadas, en la misma cantidad.","steps":["Cocina el arroz hasta que esté bien suave, usando un poco más de agua de lo habitual.","Cocina los frijoles hasta que estén bien suaves y machácalos con un tenedor, quitando las cáscaras más gruesas.","Cocina la calabacita hasta que un tenedor la atraviese sin resistencia y machácala junto.","Mezcla el arroz, los frijoles y la calabacita hasta formar un puré espeso que se quede en la cuchara sin escurrirse.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, con trocitos suaves que el bebé pueda aplastar sin dificultad."],"alerta":"Machaca bien los frijoles y quita las cáscaras sueltas más gruesas, que pueden ser más difíciles de tragar en esta etapa."},{"id":96,"name":"Purecito de Remolacha con Pollo y Papa","cat":"m8","icon":"🍠","time":"~30 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/5472026/pexels-photo-5472026.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/4 de remolacha (betabel) cocida","2 cucharadas de pollo cocido y deshebrado muy fino","1/2 papa cocida"],"tip":"Remolacha → zanahoria cocida, en el mismo volumen.","steps":["Cocina la remolacha y la papa hasta que un tenedor las atraviese fácilmente, unos 20 minutos.","Deshebra el pollo cocido en hebras muy finas, separando cualquier trozo más grueso que todavía esté unido.","Machaca la remolacha y la papa juntas con un tenedor hasta formar un puré espeso.","Mezcla el pollo deshebrado con el puré, revolviendo bien para repartirlo.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con trocitos suaves adecuados para los 8 meses."]},{"id":97,"name":"Omelette Suave de Verduras Picaditas","cat":"m8","icon":"🍳","time":"~15 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/35652674/pexels-photo-35652674.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1 huevo entero","2 cucharadas de zanahoria rallada fina","2 cucharadas de calabacita (zucchini) rallada fina","1 chorrito de aceite de oliva (para engrasar el sartén)"],"tip":"Zanahoria y calabacita → calabaza (zapallo) rallada fina, en la misma cantidad.","steps":["Bate bien el huevo con la zanahoria y la calabacita ralladas hasta formar una mezcla pareja.","Calienta un sartén antiadherente engrasado con el chorrito de aceite de oliva a fuego bajo.","Vierte la mezcla y revuelve sin parar, como si fuera huevo revuelto, hasta que se cocine por completo y no quede ninguna parte líquida.","Deja enfriar un poco y aplasta ligeramente con el tenedor, deshaciéndolo en trozos muy pequeños y suaves.","Sirve tibio, probando la temperatura en el dorso de la mano, en cucharadas pequeñas con trocitos suaves de omelette, fáciles de aplastar con la lengua."],"alerta":"Cocina el huevo por completo, sin ninguna parte blanda o líquida, para evitar contaminación por salmonela."},{"id":98,"name":"Puré de Aguacate con Pollo y Camote","cat":"m8","icon":"🥑","time":"~20 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/34985386/pexels-photo-34985386.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/4 de aguacate (palta) maduro","2 cucharadas de pollo cocido y deshebrado muy fino","1/2 camote (batata) cocido"],"tip":"Aguacate → papa cocida y machacada, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese sin resistencia.","Machaca el camote todavía tibio y el aguacate maduro juntos con un tenedor, hasta formar un puré espeso.","Deshebra el pollo cocido en hebras muy finas y mézclalo con el puré.","Sirve de inmediato, porque el aguacate se oscurece rápido después de machacarlo."]},{"id":99,"name":"Sopa Cremosa de Verduras con Carne Molida","cat":"m8","icon":"🍲","time":"~30 min","kcal":"115 kcal (estimado)","img":"https://images.pexels.com/photos/34326239/pexels-photo-34326239.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 8 meses","ingredients":["1/4 de taza de zanahoria en cubos","1/4 de taza de calabacita (zucchini) en cubos","1/4 de taza de papa en cubos","2 cucharadas de carne molida magra, bien cocida"],"tip":"Carne molida → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina la zanahoria, la calabacita y la papa en agua hasta que estén bien suaves, unos 20 minutos.","En otra olla, cocina la carne molida hasta que no quede ninguna parte rosada.","Agrega la carne cocida a las verduras, todavía con un poco del agua de cocción.","Machaca todo con un tenedor hasta formar una sopa cremosa y espesa, sin licuar.","Sirve tibia, probando la temperatura en el dorso de la mano, en cucharadas pequeñas, con trocitos suaves de verdura y la carne ya bien deshecha."],"alerta":"Cocina la carne molida por completo, sin ninguna parte rosada, antes de machacar y servir."},{"id":100,"name":"Papilla de Mango con Yogur y Avena","cat":"m8","icon":"🥭","time":"~10 min","kcal":"100 kcal (estimado)","img":"https://images.pexels.com/photos/10645412/pexels-photo-10645412.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 mango maduro, cortado en cubos pequeños","2 cucharadas de yogur natural entero, sin azúcar","1 cucharada de avena en hojuelas finas, hidratada"],"tip":"Yogur natural → cuajada casera sin azúcar, en la misma cantidad.","steps":["Corta el mango maduro en cubos muy pequeños y suaves, del tamaño de una arveja.","Hidrata la avena en hojuelas finas con una cucharada de agua por 2 minutos, hasta que se ablande.","Mezcla el mango, el yogur natural y la avena hidratada en un tazón.","Sirve al momento, a temperatura ambiente o un poco fría, nunca caliente."],"alerta":"Ofrece yogur natural solo con la aprobación de tu pediatra, ya que es un lácteo que se introduce de forma individual a partir de los 9 meses."},{"id":101,"name":"Nuggets Caseros de Pollo al Horno","cat":"m10","icon":"🍗","time":"~30 min","kcal":"140 kcal (estimado)","img":"https://images.pexels.com/photos/34857354/pexels-photo-34857354.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de pechuga de pollo cruda molida","1 huevo","2 cucharadas de harina de avena"],"tip":"Harina de avena → harina de arroz, en la misma cantidad.","steps":["Mezcla el pollo molido, el huevo y la harina de avena hasta formar una masa pareja.","Forma discos pequeños y aplanados del tamaño de una cucharada, fáciles de agarrar para el niño.","Acomoda los discos en una bandeja para horno engrasada y llévalos al horno precalentado a 190 °C.","Hornea por unos 18 minutos, volteando a la mitad del tiempo, hasta que se doren y estén firmes por dentro.","Deja enfriar hasta que estén tibios antes de servir.","Sirve con el niño bien sentado y con supervisión todo el tiempo, porque es un alimento para agarrar con la mano."],"alerta":"Supervisa al niño todo el tiempo mientras agarra y muerde el nugget, y revisa que el centro esté bien cocido antes de servir."},{"id":102,"name":"Bastoncitos de Calabacita y Zanahoria al Vapor","cat":"m10","icon":"🥕","time":"~15 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/31744429/pexels-photo-31744429.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 calabacita (zucchini) pequeña, cortada en bastones gruesos del tamaño de un dedo","1 zanahoria pequeña, cortada en bastones gruesos del tamaño de un dedo","1 chorrito de aceite de oliva"],"tip":"Zanahoria → camote (batata) cortado en bastones, con la misma preparación.","steps":["Corta la calabacita y la zanahoria en bastones gruesos, del tamaño de un dedo de adulto, para que sea fácil agarrarlos.","Cocina los bastones al vapor por unos 12 minutos, hasta que estén bien suaves.","Haz la prueba del dedo: aprieta un bastón entre el pulgar y el índice; tiene que aplastarse con facilidad.","Si todavía está firme, vuelve a ponerlo al vapor unos minutos más.","Báñalos con el chorrito de aceite de oliva después de cocidos.","Sirve tibios, con el niño sentado y con supervisión durante toda la comida."],"alerta":"Los bastones solo pueden ir al plato después de pasar la prueba del dedo: tienen que aplastarse con facilidad entre el pulgar y el índice."},{"id":103,"name":"Croquetitas de Arroz y Pescado al Horno","cat":"m10","icon":"🐟","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/20184730/pexels-photo-20184730.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de arroz bien cocido","2 cucharadas de filete de pescado blanco cocido, sin espinas","1 huevo"],"tip":"Pescado blanco → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina el pescado y desmenúzalo con los dedos, revisando con cuidado que no haya quedado ninguna espina.","Mezcla el arroz bien cocido, el pescado desmenuzado y el huevo hasta formar una masa que mantenga la forma.","Forma con la masa discos aplanados, nunca bolitas redondas y firmes.","Acomoda los discos en una bandeja para horno engrasada y hornea a 190 °C por unos 15 minutos, hasta que se doren.","Deja enfriar hasta que estén tibios antes de servir."],"alerta":"Aplana bien las croquetitas en forma de disco, nunca en esferas redondas, y revisa dos veces que no haya espinas en la masa."},{"id":104,"name":"Puré Espeso de Papa con Carne Deshebrada","cat":"m10","icon":"🥔","time":"~30 min","kcal":"145 kcal (estimado)","img":"https://images.pexels.com/photos/17942032/pexels-photo-17942032.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1 papa mediana, cocida","3 cucharadas de carne de res magra, cocida y deshebrada en hebras cortas y finas"],"tip":"Carne de res → pollo cocido y deshebrado, en la misma cantidad.","steps":["Cocina la carne hasta que esté bien suave y deshébrala en hebras cortas y finas, fáciles de aplastar entre los dedos.","Cocina la papa hasta que un tenedor la atraviese fácilmente, sin ninguna resistencia en el centro del trozo.","Machaca la papa en trozos gruesos, dejando pedacitos pequeños y suaves, sin que se vuelva un puré liso.","Mezcla la carne deshebrada con el puré de papa, repartiendo bien las hebras entre los pedacitos.","Sirve tibio, probando la temperatura en el dorso de la mano, en trocitos suaves adecuados para los 10 meses, ya que el bebé puede masticar más."],"alerta":"Deshebra la carne en hebras muy cortas y finas, que se deshagan fácilmente entre los dedos."},{"id":105,"name":"Panquequitos de Banana con Canela y Avena","cat":"m10","icon":"🍌","time":"~15 min","kcal":"110 kcal (estimado)","img":"https://images.pexels.com/photos/4099877/pexels-photo-4099877.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 banana (plátano) madura, machacada","1 huevo","3 cucharadas de avena en hojuelas finas","1 pizca de canela en polvo","1 chorrito de aceite (para engrasar el sartén)"],"tip":"Avena → harina de arroz, en la misma cantidad.","steps":["Machaca la banana bien madura con un tenedor hasta hacerla puré.","Mezcla la banana machacada, el huevo, la avena y la pizca de canela hasta formar una masa pareja.","Calienta un sartén antiadherente engrasado con el chorrito de aceite a fuego bajo.","Pon porciones pequeñas de la masa y cocina unos 2 minutos de cada lado, hasta que se doren y estén firmes por dentro.","Corta cada panquequito en trozos pequeños antes de servir.","Sirve tibio, nunca entero, para que sea más fácil masticar."],"alerta":"Corta siempre el panquequito en trozos pequeños antes de ofrecer; no se lo des entero al niño."},{"id":106,"name":"Discos de Garbanzo con Verduras al Horno","cat":"m10","icon":"🧆","time":"~30 min","kcal":"120 kcal (estimado)","img":"https://images.pexels.com/photos/38370355/pexels-photo-38370355.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 taza de garbanzos cocidos y machacados","3 cucharadas de zanahoria rallada","1 huevo"],"tip":"Garbanzos → lentejas bien cocidas y machacadas, en la misma cantidad.","steps":["Mezcla los garbanzos machacados, la zanahoria rallada y el huevo hasta formar una masa que mantenga la forma.","Forma con la masa discos aplanados y finos, nunca bolitas redondas.","Acomoda los discos en una bandeja para horno engrasada y hornea a 190 °C por unos 18 minutos, hasta que se doren.","Deja enfriar hasta que estén tibios antes de servir.","Sirve con el niño sentado y con supervisión, porque es un alimento para agarrar con la mano."],"alerta":"Aplana bien los discos antes de hornear; nunca los sirvas en forma de bolita redonda, que es más fácil que cause atragantamiento."},{"id":107,"name":"Filete de Pescado Desmenuzado con Puré de Papa","cat":"m10","icon":"🐟","time":"~25 min","kcal":"135 kcal (estimado)","img":"https://images.pexels.com/photos/27558966/pexels-photo-27558966.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["2 cucharadas de filete de pescado blanco cocido, sin espinas","1 papa pequeña, cocida"],"tip":"Papa → camote (batata) cocido y machacado, en la misma cantidad.","steps":["Cocina el pescado hasta que esté bien suave y desmenúzalo con los dedos, revisando con cuidado que no haya quedado ninguna espina.","Cocina la papa hasta que un tenedor la atraviese sin resistencia.","Machaca la papa todavía tibia con un tenedor hasta formar un puré espeso.","Mezcla el pescado desmenuzado con el puré, repartiendo bien las hebras.","Sirve tibio, probando la temperatura en el dorso de la mano, en trocitos picaditos de pescado y papa, adecuados para los 10 meses."],"alerta":"Antes de servir, revisa una vez más con los dedos que no haya quedado ninguna espina en el pescado desmenuzado."},{"id":108,"name":"Espagueti Corto con Salsa de Tomate y Pollo","cat":"m10","icon":"🍝","time":"~20 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/7837671/pexels-photo-7837671.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de pasta corta (tipo tornillo o codito), bien cocida","3 cucharadas de salsa de tomate casera, sin sal","2 cucharadas de pollo cocido y deshebrado"],"tip":"Pasta de trigo → pasta sin gluten (de arroz o de maíz), si hace falta.","steps":["Cocina la pasta hasta que esté bien suave, unos minutos más de lo que indica el empaque.","Corta la pasta en trozos muy cortos, de menos de un centímetro.","Prepara una salsa de tomate casera sin sal, cocinando el tomate hasta que se deshaga.","Mezcla la pasta picada, la salsa de tomate y el pollo deshebrado hasta que todo quede bien cubierto.","Sirve tibio, probando la temperatura en el dorso de la mano, en trocitos pequeños y suaves, adecuados para los 10 meses."],"alerta":"Corta la pasta en trozos muy cortos antes de servir, para que el niño no jale una tira larga y se atragante."},{"id":109,"name":"Tartaleta de Camote con Queso Cottage","cat":"m10","icon":"🍠","time":"~30 min","kcal":"130 kcal (estimado)","img":"https://images.pexels.com/photos/28944771/pexels-photo-28944771.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 10 meses","ingredients":["1 camote (batata) mediano cocido y machacado (alrededor de 1 taza)","2 cucharadas de queso cottage","1 huevo entero","1 chorrito de aceite de oliva para engrasar los moldecitos"],"tip":"Queso cottage → ricota fresca machacada, en la misma cantidad.","steps":["Cocina el camote hasta que un tenedor lo atraviese sin resistencia y machácalo bien con un tenedor.","En un tazón, mezcla el camote machacado, las 2 cucharadas de queso cottage y el huevo hasta formar una masa pareja.","Engrasa moldecitos pequeños con un chorrito de aceite de oliva y reparte la masa, llenando cada moldecito hasta la mitad.","Hornea en el horno precalentado a 180 °C por unos 20 minutos, hasta que la tartaleta esté firme y un poco dorada en los bordes.","Deja entibiar fuera del horno antes de desmoldar con cuidado.","Sirve en trocitos suaves, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Espera a que la tartaleta se entibie bien antes de servir: el centro guarda el calor aun fuera del horno."},{"id":110,"name":"Cubitos de Mango y Melón para Comer con las Manos","cat":"m10","icon":"🥭","time":"~5 min","kcal":"55 kcal (estimado)","img":"https://images.pexels.com/photos/4955253/pexels-photo-4955253.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"1 porción","ageRec":"A partir de los 10 meses","ingredients":["1/2 taza de mango bien maduro, cortado en cubos pequeños y suaves","1/2 taza de melón bien maduro, cortado en cubos pequeños y suaves"],"tip":"Mango y melón → papaya bien madura en cubos, en la misma cantidad.","steps":["Elige frutas bien maduras y suaves al tacto, para reducir el riesgo de trozos duros.","Corta el mango en cubos pequeños, más o menos del tamaño de una arveja grande, nunca en forma redonda.","Corta el melón de la misma manera, en cubos pequeños e irregulares, quitando bien la cáscara y las semillas.","Sirve las dos frutas juntas en un platito plano, en cuanto las prepares.","Acompaña al niño durante toda la comida, sentado y sin moverse mientras come."],"alerta":"Corta siempre en cubos pequeños e irregulares, nunca en bolitas ni rodajas redondas, y no dejes al niño solo mientras come."},{"id":111,"name":"Arroz Gratinado con Pollo y Maíz","cat":"m12","icon":"🍚","time":"~35 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/6646164/pexels-photo-6646164.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de arroz blanco cocido","1/2 taza de pollo cocido y deshebrado","3 cucharadas de granos de maíz cocidos","2 cucharadas de queso fresco rallado, bajo en sodio"],"tip":"Maíz → arvejas (chícharos) cocidas y un poco machacadas, en la misma cantidad.","steps":["Mezcla en un tazón el arroz cocido, el pollo deshebrado y el maíz.","Pasa la mezcla a un molde pequeño engrasado, extendiéndola de forma pareja.","Espolvorea las 2 cucharadas de queso fresco rallado por encima, repartiéndolo bien.","Hornea en el horno precalentado a 200 °C por unos 15 minutos, hasta que el queso se derrita y se dore un poco.","Deja entibiar unos minutos antes de servir.","Sirve en trozos pequeños, del tamaño que el niño pueda llevarse a la boca con la mano."],"alerta":"Revisa que los granos de maíz estén bien suaves antes de servir, porque los granos duros pueden ser difíciles de masticar."},{"id":112,"name":"Carne Guisada Bien Suave con Puré de Papa","cat":"m12","icon":"🥩","time":"~40 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/29145751/pexels-photo-29145751.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["150 g de bistec de res magro, cortado en tiras pequeñas","1 chorrito de aceite de oliva","2 papas medianas cocidas y machacadas en puré"],"tip":"Carne de res → filete de pollo cocido y deshebrado, con la misma preparación.","steps":["Calienta un chorrito de aceite de oliva en una olla y dora un poco las tiras de carne.","Agrega un poco de agua, tapa la olla y cocina a fuego bajo hasta que la carne esté bien suave y se deshaga fácilmente con el tenedor, unos 25 minutos.","Corta la carne en trozos pequeños, del tamaño de una arveja.","Cocina las papas hasta que un tenedor las atraviese sin resistencia y machácalas bien en puré.","Sirve la carne picada en trozos pequeños junto con el puré tibio, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Revisa que cada trocito de carne se aplaste con facilidad entre los dedos antes de ofrecer."},{"id":113,"name":"Panqueque de Espinaca con Queso","cat":"m12","icon":"🥬","time":"~20 min","kcal":"160 kcal (estimado)","img":"https://images.pexels.com/photos/7144314/pexels-photo-7144314.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de espinaca salteada y picada","1 huevo","3 cucharadas de harina de avena","2 cucharadas de queso fresco rallado, bajo en sodio","1 chorrito de aceite o aceite de oliva para engrasar el sartén"],"tip":"Harina de avena → harina de arroz, en la misma cantidad.","steps":["Saltea la espinaca en una olla con un chorrito de aceite hasta que se marchite, y pícala bien.","En un tazón, mezcla la espinaca, el huevo, la harina de avena y el queso rallado hasta formar una masa pareja.","Calienta un sartén antiadherente engrasado con un chorrito de aceite y pon porciones pequeñas de la masa, del tamaño de una cucharada.","Cocina cada panqueque unos 2 minutos de cada lado, hasta que se dore y esté bien firme en el centro.","Deja entibiar y corta en trozos pequeños antes de servir."],"alerta":"Revisa que el centro de cada panqueque esté bien cocido antes de servir, sin partes crudas de huevo."},{"id":114,"name":"Pescado a la Plancha con Verduras Salteadas","cat":"m12","icon":"🐟","time":"~25 min","kcal":"170 kcal (estimado)","img":"https://images.pexels.com/photos/11653557/pexels-photo-11653557.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 filete de pescado blanco sin espinas (unos 100 g)","1 chorrito de aceite de oliva","1/2 zanahoria cortada en cubos pequeños","1/2 calabacita (zucchini) cortada en cubos pequeños"],"tip":"Pescado blanco → tilapia o merluza sin espinas, en la misma cantidad.","steps":["Pasa los dedos por toda la superficie del filete de pescado para asegurarte de que no tenga ninguna espina.","Cocina el pescado en un sartén con un chorrito de aceite de oliva hasta que esté bien cocido y se separe fácilmente en lascas, unos 4 minutos de cada lado.","Saltea la zanahoria y la calabacita en cubos pequeños en el aceite de oliva, hasta que estén lo bastante suaves para aplastarlas entre los dedos.","Desmenuza el pescado en lascas pequeñas, revisando otra vez que no haya espinas.","Sirve el pescado desmenuzado junto con las verduras, todavía tibio."],"alerta":"Revisa el filete con atención, pasando los dedos por toda la pieza, antes y después de cocinar, para asegurarte de que no quede ninguna espina en el plato."},{"id":115,"name":"Pasta con Albóndigas Pequeñas","cat":"m12","icon":"🍝","time":"~35 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/33433969/pexels-photo-33433969.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de pasta corta (tipo tornillo) cocida","150 g de carne molida magra","1 taza de salsa de tomate casera, sin sal"],"tip":"Carne molida de res → pollo molido, en la misma cantidad.","steps":["Forma con la carne molida bolitas pequeñas, del tamaño de una aceituna.","Cocina las albóndigas en la salsa de tomate casera sin sal, a fuego bajo, hasta que estén bien cocidas por dentro, unos 15 minutos.","Aplasta un poco cada albóndiga con el tenedor para deshacer la forma redonda y reducir el riesgo de atragantamiento.","Mezcla las albóndigas aplastadas con la pasta ya cocida y cortada en trozos pequeños.","Sirve tibio, revisando que cada trozo se aplaste con facilidad entre los dedos."],"alerta":"Nunca sirvas la albóndiga entera y redonda: aplástala o córtala en trozos antes de ofrecer, por el riesgo de atragantamiento."},{"id":116,"name":"Tarta Salada de Verduras con Huevo","cat":"m12","icon":"🥧","time":"~35 min","kcal":"165 kcal (estimado)","img":"https://images.pexels.com/photos/33433982/pexels-photo-33433982.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de 1 año","ingredients":["1/2 zanahoria rallada","1/2 calabacita (zucchini) rallada","3 huevos batidos","3 cucharadas de queso cottage"],"tip":"Queso cottage → ricota fresca machacada, en la misma cantidad.","steps":["Mezcla los huevos batidos con la zanahoria rallada, la calabacita rallada y el queso cottage.","Vierte la mezcla en un molde pequeño engrasado.","Hornea en el horno precalentado a 180 °C por unos 25 minutos, hasta que la tarta esté completamente firme en el centro.","Pincha un palillo en el centro para confirmar que no sale líquido de huevo crudo.","Deja entibiar y corta en trozos pequeños antes de servir."],"alerta":"Confirma que el centro de la tarta esté totalmente firme antes de servir, sin huevo crudo."},{"id":117,"name":"Pollo Salteado Suave con Verduras","cat":"m12","icon":"🍗","time":"~25 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/36979925/pexels-photo-36979925.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 2 años","ingredients":["1 filete de pechuga de pollo cortado en cubos pequeños","1/4 de pimiento morrón cortado en cubos pequeños","1/2 zanahoria cortada en cubos pequeños","1/4 de cebolla picada","1 chorrito de aceite de oliva"],"tip":"Pimiento morrón → calabacita (zucchini) en cubos pequeños, en la misma cantidad, para una versión más suave.","steps":["Sofríe la cebolla picada y los cubos de pimiento y zanahoria en el aceite de oliva hasta que estén suaves.","Agrega el pollo en cubos pequeños y cocina a fuego medio hasta que esté completamente blanco por dentro, sin partes crudas.","Cocina solo con el aceite de oliva, sin salsa de soya, sin sal y sin condimentos industrializados.","Revisa que los cubos de verdura se aplasten fácilmente entre los dedos antes de apagar el fuego.","Sirve tibio, en trozos pequeños como los de la comida de la familia, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Asegúrate de que el pollo esté completamente cocido por dentro, sin partes transparentes, antes de servir."},{"id":118,"name":"Risotto Cremoso de Calabaza con Pollo","cat":"m12","icon":"🎃","time":"~30 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/26219974/pexels-photo-26219974.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1 taza de arroz","1 taza de calabaza (zapallo) cocida y machacada","1/2 taza de pollo cocido y deshebrado","2 tazas de caldo casero de verduras, sin sal"],"tip":"Calabaza → camote (batata) cocido y machacado, en la misma cantidad.","steps":["Calienta el caldo casero de verduras sin sal en una olla aparte.","Sofríe el arroz y ve agregando el caldo de a poco, revolviendo siempre, hasta que el arroz esté suave, unos 18 minutos.","Mezcla la calabaza machacada y el pollo deshebrado al final de la cocción.","Revuelve hasta lograr una textura cremosa, con el pollo bien repartido.","Sirve tibio, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":119,"name":"Pastel de Pollo con Camote y Queso","cat":"m12","icon":"🍠","time":"~40 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/33674221/pexels-photo-33674221.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["2 camotes (batatas) medianos cocidos y machacados","1 taza de pollo cocido y deshebrado","1/2 zanahoria y 1/2 calabacita (zucchini) picaditas","2 cucharadas de queso fresco rallado, bajo en sodio"],"tip":"Pollo → carne molida magra bien cocida, en la misma cantidad.","steps":["Sofríe el pollo deshebrado con la zanahoria y la calabacita picaditas hasta que las verduras estén suaves.","Pon esta mezcla de pollo y verduras en el fondo de un molde pequeño engrasado, extendiéndola bien.","Cubre por completo con el camote machacado, formando una capa pareja.","Espolvorea el queso rallado por encima, cubriendo toda la superficie del camote machacado.","Hornea en el horno precalentado a 190 °C por unos 15 minutos, hasta que el queso se derrita y se dore un poco.","Deja entibiar, prueba la temperatura en el dorso de la mano y sirve en porciones pequeñas con cuchara."]},{"id":120,"name":"Ensalada Tibia de Verduras con Pollo Deshebrado","cat":"m12","icon":"🥗","time":"~20 min","kcal":"150 kcal (estimado)","img":"https://images.pexels.com/photos/9213909/pexels-photo-9213909.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de 1 año","ingredients":["1/2 papa cortada en cubos pequeños","1/2 zanahoria cortada en cubos pequeños","1/4 taza de ejotes (judías verdes) cortados en tiritas pequeñas","1/2 taza de pollo cocido y deshebrado","1 chorrito de aceite de oliva"],"tip":"Ejotes → arvejas (chícharos) cocidas, en la misma cantidad.","steps":["Cocina la papa, la zanahoria y los ejotes hasta que estén lo bastante suaves para aplastarlos entre los dedos.","Escurre bien las verduras y corta todo en cubos pequeños, del tamaño que el bebé pueda agarrar con las manos.","Mezcla las verduras con el pollo deshebrado y un chorrito de aceite de oliva.","Sirve tibia, revisando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Corta los ejotes a lo largo en tiritas pequeñas, nunca en rodajas, para reducir el riesgo de atragantamiento."},{"id":121,"name":"Lasaña Sencilla de Pollo y Calabacita","cat":"m18","icon":"🍝","time":"~45 min","kcal":"215 kcal (estimado)","img":"https://images.pexels.com/photos/37679127/pexels-photo-37679127.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["6 láminas de pasta para lasaña cocidas","1 taza de pollo cocido y deshebrado","1 calabacita (zucchini) pequeña en rebanadas muy finas","1 taza de salsa blanca ligera (hecha con leche y un poco de harina, sin sal)","3 cucharadas de queso fresco rallado, bajo en sodio"],"tip":"Pollo → carne molida magra, en la misma cantidad.","steps":["Arma la primera capa con la pasta para lasaña en el fondo de un molde pequeño engrasado.","Alterna capas de pollo deshebrado, rebanadas finas de calabacita y salsa blanca, terminando con una capa de pasta.","Termina con el queso rallado por encima, cubriendo bien la última capa de pasta.","Hornea en el horno precalentado a 190 °C por unos 25 minutos, hasta que el queso se dore y la lasaña burbujee en los bordes.","Deja entibiar unos minutos fuera del horno antes de cortar.","Corta en trozos pequeños y sirve tibia, probando la temperatura en el dorso de la mano antes de ofrecer."],"alerta":"Deja enfriar bien antes de servir: el relleno de la lasaña guarda el calor por más tiempo que la superficie."},{"id":122,"name":"Milanesa de Pollo al Horno con Puré","cat":"m18","icon":"🍗","time":"~30 min","kcal":"185 kcal (estimado)","img":"https://images.pexels.com/photos/16696798/pexels-photo-16696798.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 filete de pollo en rebanadas finas","3 cucharadas de harina de avena para empanizar","1 chorrito de aceite de oliva","2 papas cocidas y machacadas en puré"],"tip":"Harina de avena → pan rallado casero sin sal, en la misma cantidad.","steps":["Pasa el filete de pollo en rebanadas finas por la harina de avena, cubriendo bien los dos lados.","Acomoda los filetes empanizados en una bandeja para horno engrasada con un chorrito de aceite de oliva, sin encimar las piezas.","Hornea en el horno precalentado a 200 °C por unos 18 minutos, volteando a la mitad del tiempo, hasta que se doren y estén bien cocidos por dentro.","Corta en tiras pequeñas, del tamaño de un dedo, fáciles de agarrar y masticar.","Sirve tibio, junto con el puré de papa, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":123,"name":"Arroz Ligero con Carne Deshebrada y Tomate","cat":"m18","icon":"🍚","time":"~40 min","kcal":"200 kcal (estimado)","img":"https://images.pexels.com/photos/29450678/pexels-photo-29450678.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de arroz cocido","1 taza de carne de res magra cocida y deshebrada","1/2 tomate (jitomate) maduro picado, sin semillas","1 cucharada de perejil y cebollín picados"],"tip":"Carne de res → pollo cocido y deshebrado, en la misma cantidad.","steps":["Sofríe la carne deshebrada con el tomate picado sin semillas hasta formar una salsa espesa.","Mezcla con el arroz ya cocido, revolviendo bien para integrar toda la salsa de carne y tomate.","Termina con el perejil y el cebollín picados, mezclando bien antes de servir.","Sirve tibio, en trozos pequeños y suaves, probando la temperatura en el dorso de la mano antes de ofrecer."]},{"id":124,"name":"Kibbeh al Horno con Carne Molida","cat":"m18","icon":"🥙","time":"~40 min","kcal":"190 kcal (estimado)","img":"https://images.pexels.com/photos/6262222/pexels-photo-6262222.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de trigo bulgur hidratado","200 g de carne molida magra","1/4 de cebolla bien picadita","1 cucharada de hierbabuena (menta) picada"],"tip":"Trigo bulgur → camote (batata) cocido y machacado, para una versión sin gluten.","steps":["Mezcla el trigo bulgur ya hidratado con la carne molida, la cebolla picadita y la hierbabuena.","Extiende la mezcla en un molde engrasado, formando una capa pareja.","Hornea en el horno precalentado a 190 °C por unos 30 minutos, hasta que se dore por encima.","Espera a que el kibbeh se entibie antes de desmoldar, para que no se desarme al cortarlo.","Corta en trozos pequeños antes de servir, probando la temperatura en el dorso de la mano."]},{"id":125,"name":"Pescado al Horno con Papas y Hierbas","cat":"m18","icon":"🐟","time":"~35 min","kcal":"180 kcal (estimado)","img":"https://images.pexels.com/photos/5741440/pexels-photo-5741440.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 filete de pescado blanco sin espinas (unos 120 g)","2 papas medianas en rodajas finas","1 cucharada de hierbas frescas picadas (perejil o tomillo)","1 chorrito de aceite de oliva"],"tip":"Pescado blanco → tilapia o merluza sin espinas, en la misma cantidad.","steps":["Acomoda las rodajas finas de papa en un molde engrasado y báñalas con un chorrito de aceite de oliva.","Pasa los dedos por toda la superficie del filete de pescado para asegurarte de que no tenga espinas.","Pon el pescado sobre las papas y cúbrelo con las hierbas picadas.","Hornea en el horno precalentado a 200 °C por unos 25 minutos, hasta que el pescado se separe fácilmente en lascas.","Revisa una vez más que no haya espinas antes de desmenuzar el pescado.","Sirve tibio, en trozos pequeños, probando la temperatura en el dorso de la mano antes de ofrecerlo al bebé."],"alerta":"Revisa el filete con atención antes y después de hornear: las espinas pequeñas pueden pasar desapercibidas."},{"id":126,"name":"Hotcakes de Banana Rellenos de Queso Cottage","cat":"m18","icon":"🥞","time":"~20 min","kcal":"175 kcal (estimado)","img":"https://images.pexels.com/photos/5419276/pexels-photo-5419276.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 banana (plátano) madura machacada","2 huevos","4 cucharadas de harina de avena","3 cucharadas de queso cottage para rellenar"],"tip":"Queso cottage → ricota fresca machacada, en la misma cantidad.","steps":["Machaca bien la banana madura con un tenedor, hasta formar un puré.","Mezcla la banana machacada, los huevos y la harina de avena hasta formar una masa pareja.","Calienta un sartén antiadherente y cocina porciones pequeñas de la masa, unos 2 minutos de cada lado, hasta que se doren y estén firmes.","Deja que los hotcakes se entibien antes de rellenarlos.","Rellena con el queso cottage y corta en trozos pequeños antes de servir."]},{"id":127,"name":"Strogonoff de Carne Bien Suave","cat":"m18","icon":"🍲","time":"~35 min","kcal":"205 kcal (estimado)","img":"https://images.pexels.com/photos/29935503/pexels-photo-29935503.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["300 g (alrededor de 2 tazas) de carne de res magra (pulpa de pierna) cortada en cubos pequeños","1 taza de salsa de tomate casera sin sal","3 cucharadas de crema de leche fresca o yogur natural entero","1 cucharada de aceite de oliva","Cebolla y ajo picaditos al gusto (opcional)"],"tip":"Crema de leche fresca → yogur natural entero, en la misma cantidad, para una versión más ligera.","steps":["Calienta 1 cucharada de aceite de oliva en una olla y dora un poco la cebolla y el ajo picaditos, si los vas a usar.","Agrega los cubos pequeños de carne y cocina a fuego medio por unos 15 minutos, revolviendo de vez en cuando, hasta que la carne esté bien suave y se deshaga al presionarla con el tenedor.","Añade 1 taza de salsa de tomate casera sin sal y deja cocinar 10 minutos más, hasta que la salsa espese un poco.","Apaga el fuego y mezcla las 3 cucharadas de crema de leche fresca o yogur natural entero, revolviendo hasta integrar.","Sirve tibio, probando la temperatura en el dorso de la mano, acompañado de arroz, con los trozos de carne bien suaves y cortados pequeños."],"alerta":"Corta la carne en cubos pequeños y confirma que cada trozo se aplaste fácil entre los dedos antes de servir."},{"id":128,"name":"Tarta de Pollo con Maíz Cremoso","cat":"m18","icon":"🌽","time":"~40 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/39070760/pexels-photo-39070760.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"3 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de harina de trigo","1 huevo","2 cucharadas de aceite de oliva","1 taza de pollo cocido y deshebrado","1/2 taza de granos de maíz cocidos, procesados con 2 cucharadas de leche"],"tip":"Pollo deshebrado → carne molida magra bien cocida, en la misma cantidad.","steps":["Mezcla la harina, el huevo y el aceite de oliva hasta formar una masa lisa y suave, y cubre con ella el fondo de un molde pequeño engrasado.","Extiende 1 taza de pollo deshebrado sobre la masa.","Licúa el maíz cocido con 2 cucharadas de leche hasta formar una crema y viértela sobre el pollo.","Hornea en el horno precalentado a 190 °C por unos 30 minutos, hasta que la masa se dore en los bordes.","Deja entibiar unos minutos antes de desmoldar.","Corta en trozos pequeños, del tamaño de un dedo, y sirve tibia."],"alerta":"Deja que la tarta se enfríe hasta estar tibia antes de servir, porque el relleno guarda calor por dentro aunque la superficie esté fría."},{"id":129,"name":"Frijoles Negros con Cerdo, Arroz y Acelga","cat":"m18","icon":"🍲","time":"~50 min","kcal":"215 kcal (estimado)","img":"https://images.pexels.com/photos/7265077/pexels-photo-7265077.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de frijoles (porotos) negros ya cocidos","150 g de carne de cerdo magra bien cocida, cortada en cubos pequeños","1 taza de acelga picadita salteada en 1 cucharadita de aceite de oliva","1 taza de arroz cocido"],"tip":"Carne de cerdo magra → carne de res magra bien cocida, en la misma cantidad.","steps":["Cocina los frijoles hasta que los granos estén bien suaves y machaca un poco más o menos la mitad con un tenedor, dejando el resto enteros.","Cocina la carne de cerdo magra hasta que esté bien suave y se deshaga con facilidad, y luego córtala en cubos pequeños.","Mezcla la carne con los frijoles machacados y deja que se sazone 5 minutos a fuego bajo.","Saltea la acelga picadita en 1 cucharadita de aceite de oliva por 3 minutos, hasta que se marchite.","Sirve los frijoles con la carne, el arroz y la acelga, todo tibio y en trozos pequeños."],"alerta":"Confirma que los cubitos de carne se aplasten fácil entre los dedos antes de ofrecer, para evitar atragantamiento."},{"id":130,"name":"Pasta con Pesto Suave y Pollo","cat":"m18","icon":"🍝","time":"~20 min","kcal":"195 kcal (estimado)","img":"https://images.pexels.com/photos/4730661/pexels-photo-4730661.jpeg?auto=compress&cs=tinysrgb&w=800","portions":"2 porciones","ageRec":"A partir de los 18 meses","ingredients":["1 taza de pasta corta (tipo tornillo) cocida","1 taza de hojas de albahaca fresca","2 cucharadas de aceite de oliva","2 cucharadas de queso fresco machacado con el tenedor","1/2 taza de pollo cocido y deshebrado"],"tip":"Albahaca → perejil fresco, en la misma cantidad, para un sabor más suave. El pesto del bebé lleva queso fresco en lugar de parmesano: el parmesano es demasiado salado para esta etapa y deja la salsa pesada.","steps":["Cocina la pasta en agua sin sal hasta que esté bien suave, unos 10 minutos, y escúrrela.","Licúa las hojas de albahaca con el aceite de oliva y el queso fresco hasta formar una salsa cremosa y de color verde parejo.","Mezcla el pesto con la pasta todavía tibia, revolviendo bien para cubrir todos los trozos.","Agrega el pollo deshebrado y mezcla bien, repartiéndolo de forma pareja en la pasta.","Sirve tibio, cortando la pasta en trozos más pequeños si hace falta."],"alerta":"Usa pasta tipo tornillo o penne corto, más fácil de masticar y menos resbalosa que el espagueti largo."}];
